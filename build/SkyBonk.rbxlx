        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">EnemyConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EnemyConfig
	Definición de criaturas. EnemyService usa la misma IA para todas
	(aparición → persecución → anticipación → ataque → recuperación); cada
	criatura solo cambia sus números, su tipo de ataque y su modelo
	(ServerStorage/EnemyModels, construido por World/ModelFactory).

	La anticipación (AttackWindup) es el tiempo que el jugador ve la señal
	antes de que el servidor aplique el daño: los ataques se pueden esquivar.
]]

local Types = require(script.Parent.Parent.Types)

local EnemyConfig: { [string]: Types.EnemyDef } = {
	VoidSlime = {
		Id = "VoidSlime",
		DisplayName = "Slime del Vacío",
		ModelName = "VoidSlime",
		Rig = "Slime",
		Scale = 1,
		MaxHealth = 13, -- 1 golpe al empezar; 2 golpes hacia el minuto 1,7 si no se mejora el daño
		ContactDamage = 4,
		MoveSpeed = 12, -- velocidad máxima del salto; la media ronda el 75 %
		AttackKind = "Lunge",
		AttackRange = 5.5,
		HitRange = 4.2,
		AttackWindup = 0.4,
		AttackCooldown = 1.35,
		Poise = false,
		Knockback = 22,
		HopFrequency = 1.9,
		XpReward = 1,
		Color = Color3.fromRGB(132, 72, 214),
	},
	BoneWanderer = {
		Id = "BoneWanderer",
		DisplayName = "Hueso Errante",
		ModelName = "BoneWanderer",
		Rig = "Skeleton",
		Scale = 1.15,
		MaxHealth = 55,
		ContactDamage = 9,
		MoveSpeed = 10.5,
		AttackKind = "Melee",
		AttackRange = 5.5,
		HitRange = 5.8,
		AttackWindup = 0.5,
		AttackCooldown = 1.5,
		Poise = false,
		Knockback = 12,
		HopFrequency = nil,
		XpReward = 3,
		Color = Color3.fromRGB(214, 196, 150),
	},
	VoidKing = {
		Id = "VoidKing",
		DisplayName = "Rey Slime del Vacío",
		ModelName = "VoidKing",
		Rig = "Slime",
		Scale = 2.1,
		MaxHealth = 240,
		ContactDamage = 18,
		MoveSpeed = 8,
		AttackKind = "Slam",
		AttackRange = 8,
		HitRange = 10, -- radio del golpe en área alrededor del rey
		AttackWindup = 0.95,
		AttackCooldown = 2.4,
		Poise = true,
		Knockback = 4,
		HopFrequency = 1.1,
		XpReward = 15,
		Color = Color3.fromRGB(196, 54, 120),
	},
}

return EnemyConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	GameConfig
	Parámetros globales de la partida. Todo valor de balance o de presentación
	que pueda necesitar ajustes debe vivir aquí (o en WeaponConfig, EnemyConfig
	y UpgradeConfig), nunca repartido por los servicios.
]]

local GameConfig = {}

-- Geometría general. La forma exacta de la isla (lóbulos, mesetas, puente,
-- santuario) está en ServerScriptService/World/MapLayout.
GameConfig.Map = {
	Center = Vector3.new(0, 0, 0),
	-- Radio de referencia de la isla principal (sin el santuario flotante).
	PlayableRadius = 100,
	-- Más allá de este radio cualquier entidad está fuera de los límites.
	BoundsRadius = 175,
	SurfaceY = 0,
	PlayerSpawn = Vector3.new(0, 3, 0),
	-- Si el personaje baja de esta altura se considera caída fuera del mapa.
	KillY = -45,
	-- Semilla del generador procedural de decoración (mapa determinista).
	Seed = 7331,
}

-- Estadísticas base del jugador (antes de mejoras).
GameConfig.Player = {
	BaseMaxHealth = 100,
	BaseWalkSpeed = 20,
	-- Distancia a la que una gema que vuela hacia el jugador se considera recogida.
	PickupRadius = 3.5,
	-- Las gemas a menos de esta distancia empiezan a volar hacia el jugador
	-- (Imán Celeste la aumenta). Nunca supera MaxMagnetRadius.
	MagnetRadius = 11,
	MaxMagnetRadius = 30,
	-- Penalización al caer al vacío: porcentaje de la vida máxima.
	FallDamagePct = 0.2,
	-- Invulnerabilidad tras reaparecer por una caída (segundos de partida).
	FallInvulnerability = 1.5,
	-- Invulnerabilidad breve tras cada golpe: un enjambre no derrite al jugador
	-- en un instante (daño máximo ≈ golpe / HitInvulnerability por segundo).
	HitInvulnerability = 0.4,
	-- Armas con las que empieza cada partida (ids de WeaponConfig).
	StartingWeapons = { "GaleSword" },
	-- Zoom inicial de la cámara en tercera persona (studs).
	CameraStartZoom = 26,
	CameraMinZoom = 10,
	CameraMaxZoom = 52,
	CameraFieldOfView = 72,
}

--[[
	Curva de experiencia: xpToNext(n) = Base + Linear*(n-1) + Quadratic*(n-1)^2
	Nv1→2: 9, Nv2→3: 12, Nv3→4: 18, Nv4→5: 26, Nv5→6: 36, Nv6→7: 48, Nv7→8: 63 ...
	Los primeros niveles son muy rápidos (varias decisiones en el primer
	minuto) y la curva cuadrática ralentiza el ritmo a partir del minuto 3-4.
]]
GameConfig.Progression = {
	BaseXp = 9,
	LinearXp = 2.5,
	QuadraticXp = 1.1,
}

-- Aparición de enemigos (SpawnService).
GameConfig.Spawn = {
	MaxActiveEnemies = 48,
	-- El tope crece con el tiempo: 22 al empezar, +7 por minuto, hasta MaxActiveEnemies (~min 4).
	MaxActiveStart = 22,
	MaxActivePerMinute = 7,
	InitialInterval = 1.1, -- segundos entre oleadas al inicio
	MinInterval = 0.3, -- intervalo mínimo alcanzable
	IntervalMultiplierPerMinute = 0.8, -- el intervalo se multiplica por esto cada minuto
	InitialBatch = 1, -- enemigos por oleada al inicio
	BatchGrowthPerMinute = 0.5, -- enemigos extra por oleada por minuto
	MaxBatch = 6,
	OpeningWave = 4, -- enemigos que aparecen juntos al terminar el periodo de gracia
	MinRadius = 22, -- distancia mínima al jugador
	MaxRadius = 38, -- distancia máxima al jugador
	EdgeMargin = 5, -- distancia mínima al borde de la isla
	Attempts = 10, -- intentos para encontrar una posición válida por enemigo
	GracePeriod = 1.5, -- segundos sin enemigos al empezar la partida
	--[[
		Tipos de enemigo con peso según el minuto de partida:
		peso = Weight + WeightPerMinute * (minutos - FromMinute), solo si minutos >= FromMinute.
		MaxAlive limita cuántos de ese tipo puede haber a la vez.
	]]
	EnemyTypes = {
		{ Id = "VoidSlime", FromMinute = 0, Weight = 10, WeightPerMinute = 0 },
		{ Id = "BoneWanderer", FromMinute = 0.85, Weight = 2, WeightPerMinute = 1.6, MaxAlive = 16 },
		{ Id = "VoidKing", FromMinute = 2.5, Weight = 0.6, WeightPerMinute = 0.25, MaxAlive = 2 },
	},
}

--[[
	Dificultad creciente según los minutos de partida (tiempo de juego, no real):
	multiplicador = 1 + Lineal * m + Cuadrático * m^2
	Vida: x1.1 al minuto 1, x1.4 al 3, x2.0 al 5, x3.3 al 8. Compensa el aumento
	de poder del jugador a partir del minuto 4-5.
]]
GameConfig.Difficulty = {
	HealthLinear = 0.06,
	HealthQuadratic = 0.028,
	DamageLinear = 0.06,
	DamageQuadratic = 0.012,
	SpeedPerMinute = 0.03,
	MaxSpeedMultiplier = 1.35,
}

-- Experiencia y gemas (ExperienceService).
GameConfig.Experience = {
	-- 0 = las gemas no caducan (nunca se pierde experiencia por no recogerla a tiempo).
	GemLifetime = 0,
	MaxGemsPerRun = 140, -- si se supera, la más antigua se funde en la nueva (no se pierde XP)
	PickupCheckInterval = 0.1, -- frecuencia de la comprobación de proximidad
	AttractSpeed = 38, -- studs/s iniciales de una gema atraída
	AttractAcceleration = 90, -- studs/s² (acelera según se acerca)
	-- Gemas brillantes: dependen de la Suerte (mejora Fortuna Celeste).
	LuckyGemBaseChance = 0.03,
	LuckyGemChancePerLuck = 0.05,
	LuckyGemMultiplier = 3,
	MaxXpPerGrant = 1000, -- cota de seguridad por concesión
	-- Cristales de Esencia del mapa: se rompen al tocarlos y sueltan gemas.
	EssenceCrystal = {
		TouchRadius = 5,
		Gems = 5,
		XpPerGem = 2,
		RespawnTime = 50, -- segundos de partida
	},
}

-- Combate (CombatService / EnemyService).
GameConfig.Combat = {
	-- Si un arma no encuentra objetivo, vuelve a buscar tras este tiempo.
	RetargetDelay = 0.12,
	-- Frecuencia de la IA de enemigos (movimiento y ataques).
	EnemyAiInterval = 0.05,
	-- Si un enemigo se desplaza menos que esto en StuckWindow, rodea el obstáculo.
	StuckDistance = 0.6,
	StuckWindow = 0.6,
	SidestepDuration = 0.7,
	-- Aparición: el enemigo emerge y no se mueve ni ataca durante este tiempo.
	SpawnDuration = 0.55,
	-- Tras morir, el modelo permanece este tiempo (sin colisión) para la animación de muerte.
	DeathDuration = 0.8,
	-- Retroceso breve al recibir un impacto (no bloquea la IA).
	StaggerTime = 0.14,
	-- Recuperación tras atacar: se mueve más despacio.
	RecoverTime = 0.35,
	RecoverSpeedMultiplier = 0.35,
	-- Margen extra de alcance al aplicar el golpe (latencia del jugador).
	HitTolerance = 0.6,
	CritMultiplier = 2,
	-- Altura máxima de diferencia para que un golpe cuerpo a cuerpo alcance.
	MeleeVerticalReach = 6,
}

-- Seguridad de los RemoteEvents: máximo de peticiones por ventana (segundos).
GameConfig.RateLimits = {
	ClientReady = { Max = 3, Window = 5 },
	ChooseUpgrade = { Max = 6, Window = 1 },
	RequestRestart = { Max = 2, Window = 2 },
}

GameConfig.Match = {
	-- Tiempo mínimo entre la derrota y el reinicio.
	RestartCooldown = 1.0,
	-- Tiempo tras la derrota antes de limpiar enemigos y gemas.
	CleanupDelay = 2.0,
	-- Si el cliente no avisa de que está listo, la partida empieza igualmente.
	ClientReadyTimeout = 8,
	-- Frecuencia máxima de envío del HUD al cliente.
	HudSendInterval = 0.1,
	-- Frecuencia de la comprobación de caída.
	FallCheckInterval = 0.2,
	-- Frecuencia de la regeneración de vida (Savia Vital).
	RegenInterval = 0.5,
}

-- Presentación (solo cliente).
GameConfig.Effects = {
	DamageNumberLifetime = 0.6,
	MaxDamageNumbers = 24, -- números simultáneos (los demás se omiten)
	DeathBurstParticles = 12,
	HitFlashTime = 0.09,
	LevelUpBannerTime = 1.1,
	CameraShakeTime = 0.16,
	CameraShakeStrength = 0.22,
	DamageVignetteTime = 0.3,
	UpgradeCardStagger = 0.05,
	MaxRagdolls = 6, -- esqueletos desmontándose a la vez
	-- Ritmo máximo de reproducción de la animación del tajo (no se deforma).
	MaxSlashSpeed = 1.7,
}

-- Animaciones: todas son propiedad de Roblox (creador id 1), así que pueden
-- reproducirse en cualquier experiencia. Verificadas con la API de economía.
GameConfig.Animations = {
	PlayerSlashR15 = "rbxassetid://522635514", -- "R15 Sword Slash"
	SkeletonIdle = "rbxassetid://616158929", -- "Zombie_Idle"
	SkeletonWalk = "rbxassetid://616168032", -- "Zombie_Walk"
	SkeletonRun = "rbxassetid://616163682", -- "Zombie_Run"
	SkeletonAttack = "rbxassetid://522635514", -- "R15 Sword Slash"
}

--[[
	Audio. Categorías con volumen propio (SoundGroups): Music, Ambient, Ui, Combat.
	Ids: Creator Store, cuentas oficiales con licencia para Roblox
	(ProSoundEffects 7462895450 y APMOfficial 7462718749). Cada sonido puede
	tener varias variaciones; Cooldown evita repeticiones excesivas y
	PitchJitter varía ligeramente el tono.
]]
GameConfig.Audio = {
	Volumes = { Master = 1, Music = 0.32, Ambient = 0.5, Ui = 0.7, Combat = 0.8 },
	Sounds = {
		Attack = {
			Category = "Combat",
			Ids = { 9126014020, 9126013811, 9119749145 },
			Volume = 0.35,
			PitchJitter = 0.08,
			Cooldown = 0.06,
		},
		Hit = { Category = "Combat", Ids = { 9117283360 }, Volume = 0.5, PitchJitter = 0.15, Cooldown = 0.035 },
		HitHeavy = { Category = "Combat", Ids = { 9113564874 }, Volume = 0.45, PitchJitter = 0.08, Cooldown = 0.06 },
		Crit = { Category = "Combat", Ids = { 9113513328 }, Volume = 0.5, PitchJitter = 0.06, Cooldown = 0.08 },
		Chain = { Category = "Combat", Ids = { 9125648149 }, Volume = 0.3, PitchJitter = 0.15, Cooldown = 0.08 },
		EnemyDeath = {
			Category = "Combat",
			Ids = { 9113663393, 9119990151 },
			Volume = 0.4,
			PitchJitter = 0.15,
			Cooldown = 0.05,
		},
		EnemySpawn = { Category = "Combat", Ids = { 9112872239 }, Volume = 0.18, PitchJitter = 0.2, Cooldown = 0.12 },
		EnemyWindup = { Category = "Combat", Ids = { 9125640290 }, Volume = 0.22, PitchJitter = 0.12, Cooldown = 0.15 },
		BossSlam = { Category = "Combat", Ids = { 9117982785 }, Volume = 0.55, PitchJitter = 0.05, Cooldown = 0.2 },
		PlayerHurt = { Category = "Combat", Ids = { 9118167124 }, Volume = 0.45, PitchJitter = 0.08, Cooldown = 0.15 },
		GemPickup = { Category = "Ui", Ids = { 9116394545 }, Volume = 0.22, PitchJitter = 0, Cooldown = 0.05 },
		CrystalBreak = { Category = "Combat", Ids = { 9116421827 }, Volume = 0.45, PitchJitter = 0.05, Cooldown = 0.2 },
		LevelUp = { Category = "Ui", Ids = { 9117885256 }, Volume = 0.55, PitchJitter = 0, Cooldown = 0.3 },
		UiSelect = { Category = "Ui", Ids = { 9117884499 }, Volume = 0.5, PitchJitter = 0, Cooldown = 0.1 },
		UiHover = { Category = "Ui", Ids = { 9119717523 }, Volume = 0.35, PitchJitter = 0.05, Cooldown = 0.04 },
	},
	Music = {
		-- "Crystal Forest" y "Heroic Battle" (APM Music). Se mezclan según la
		-- intensidad del combate (enemigos cercanos y minuto de partida).
		Explore = { Id = 1838990319, Volume = 0.7 },
		Combat = { Id = 1837222909, Volume = 0.75 },
		CrossfadeTime = 2.5,
		CombatEnemies = 14, -- enemigos a menos de 45 studs para intensidad máxima
	},
}

GameConfig.Debug = {
	-- Ejecuta las pruebas unitarias de ServerScriptService/Tests al iniciar en Studio.
	RunSelfTestsInStudio = true,
	-- Expone _G.SkyBonkDebug (solo en Studio) para forzar experiencia, etc.
	ExposeStudioDebugApi = true,
}

return GameConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">UpgradeConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	UpgradeConfig
	Catálogo de mejoras. El cliente solo envía el `Id` de la opción elegida;
	el servidor aplica `Effects` mediante StatSheet.applyEffects.

	Campos:
	  Id          identificador estable (nunca cambiar una vez publicado)
	  Rarity      Common/Rare/Epic -> peso base en Rarities
	  MaxLevel    veces que puede elegirse (nil = ilimitado)
	  Requires    requisito con nombre evaluado en UpgradeLogic.Requirements
	  Enabled     false -> nunca aparece (efecto aún sin mecánica real)
	  IsFallback  solo se ofrece cuando no hay suficientes opciones válidas
]]

local Types = require(script.Parent.Parent.Types)

local UpgradeConfig = {}

UpgradeConfig.OfferSize = 3

-- Hasta este nivel, cada oferta incluye al menos una mejora de esta categoría:
-- el jugador nota enseguida un aumento de poder, sin depender de la suerte.
UpgradeConfig.EarlyGuarantee = { Category = "Ataque", UntilLevel = 4 }

-- Peso base de cada rareza. La Suerte multiplica el peso de Rare y Epic por
-- (1 + Suerte * LuckRarityBonus).
UpgradeConfig.LuckRarityBonus = 0.25

UpgradeConfig.Rarities = {
	Common = { DisplayName = "Común", Weight = 100, Color = Color3.fromRGB(176, 196, 214), Order = 1 },
	Rare = { DisplayName = "Rara", Weight = 45, Color = Color3.fromRGB(84, 170, 255), Order = 2 },
	Epic = { DisplayName = "Épica", Weight = 16, Color = Color3.fromRGB(196, 110, 255), Order = 3 },
}

-- Categorías: color e icono comunes en las cartas (se reconocen de un vistazo).
UpgradeConfig.Categories = {
	Ataque = { Color = Color3.fromRGB(255, 120, 90), Icon = "⚔" },
	Defensa = { Color = Color3.fromRGB(120, 210, 140), Icon = "🛡" },
	Movilidad = { Color = Color3.fromRGB(120, 200, 255), Icon = "💨" },
	Experiencia = { Color = Color3.fromRGB(190, 140, 255), Icon = "💎" },
	["Curación"] = { Color = Color3.fromRGB(255, 220, 120), Icon = "💖" },
	Habilidad = { Color = Color3.fromRGB(200, 200, 200), Icon = "✨" },
}

local list: { Types.UpgradeDef } = {
	{
		Id = "SharpEdge",
		DisplayName = "Filo Afilado",
		Description = "+20 % de daño de las armas.",
		Rarity = "Common",
		Category = "Ataque",
		Icon = "🗡",
		MaxLevel = 8,
		Effects = { { Op = "Add", Stat = "DamagePct", Value = 0.2 } },
	},
	{
		Id = "SwiftStrike",
		DisplayName = "Golpe Veloz",
		Description = "-12 % de tiempo entre tajos.",
		Rarity = "Common",
		Category = "Ataque",
		Icon = "⚡",
		MaxLevel = 6,
		Effects = { { Op = "Mul", Stat = "CooldownMult", Value = 0.88 } },
	},
	{
		Id = "AstralReach",
		DisplayName = "Alcance Astral",
		Description = "+20 % de alcance: las hojas buscan enemigos más lejanos.",
		Rarity = "Common",
		Category = "Ataque",
		Icon = "🌠",
		MaxLevel = 5,
		Effects = { { Op = "Add", Stat = "RangePct", Value = 0.2 } },
	},
	{
		Id = "KeenStrike",
		DisplayName = "Golpe Certero",
		Description = "+12 % de probabilidad de crítico (daño x2).",
		Rarity = "Common",
		Category = "Ataque",
		Icon = "💥",
		MaxLevel = 5,
		Effects = { { Op = "Add", Stat = "CritChance", Value = 0.12 } },
	},
	{
		Id = "TwinBlade",
		DisplayName = "Hoja Doble",
		Description = "+1 hoja por tajo (cada hoja busca un enemigo distinto).",
		Rarity = "Rare",
		Category = "Ataque",
		Icon = "⚔",
		MaxLevel = 4,
		Weight = 2.2, -- más hojas es la mejora más vistosa: aparece a menudo
		Requires = "WeaponAcceptsExtraProjectile",
		Effects = { { Op = "Add", Stat = "ExtraProjectiles", Value = 1 } },
	},
	{
		Id = "StormEdge",
		DisplayName = "Filo de Tormenta",
		Description = "Cada hoja salta con un rayo a +1 enemigo cercano.",
		Rarity = "Rare",
		Category = "Ataque",
		Icon = "🌩",
		MaxLevel = 3,
		Weight = 1.6,
		Requires = "WeaponAcceptsExtraChain",
		Effects = { { Op = "Add", Stat = "ExtraChain", Value = 1 } },
	},
	{
		Id = "BasaltHeart",
		DisplayName = "Corazón de Basalto",
		Description = "+20 % de vida máxima (y te cura esa cantidad).",
		Rarity = "Common",
		Category = "Defensa",
		Icon = "❤",
		MaxLevel = 5,
		Effects = { { Op = "Add", Stat = "MaxHealthPct", Value = 0.2 } },
	},
	{
		Id = "StoneSkin",
		DisplayName = "Piel de Piedra",
		Description = "-10 % de daño recibido.",
		Rarity = "Rare",
		Category = "Defensa",
		Icon = "🪨",
		MaxLevel = 5,
		Effects = { { Op = "Mul", Stat = "DamageTakenMult", Value = 0.9 } },
	},
	{
		Id = "VitalSap",
		DisplayName = "Savia Vital",
		Description = "Regeneras 1 punto de vida por segundo.",
		Rarity = "Rare",
		Category = "Defensa",
		Icon = "🌿",
		MaxLevel = 4,
		Effects = { { Op = "Add", Stat = "HealthRegen", Value = 1 } },
	},
	{
		Id = "HawkSteps",
		DisplayName = "Pasos del Halcón",
		Description = "+12 % de velocidad de movimiento.",
		Rarity = "Common",
		Category = "Movilidad",
		Icon = "🦅",
		MaxLevel = 5,
		Effects = { { Op = "Add", Stat = "MoveSpeedPct", Value = 0.12 } },
	},
	{
		Id = "CelestialMagnet",
		DisplayName = "Imán Celeste",
		Description = "+35 % de radio de atracción de las gemas.",
		Rarity = "Common",
		Category = "Experiencia",
		Icon = "🧲",
		MaxLevel = 4,
		Effects = { { Op = "Add", Stat = "MagnetPct", Value = 0.35 } },
	},
	{
		Id = "ConcentratedEssence",
		DisplayName = "Esencia Concentrada",
		Description = "+20 % de experiencia obtenida.",
		Rarity = "Rare",
		Category = "Experiencia",
		Icon = "💎",
		MaxLevel = 5,
		Effects = { { Op = "Add", Stat = "XpGainPct", Value = 0.2 } },
	},
	{
		Id = "CelestialFortune",
		DisplayName = "Fortuna Celeste",
		Description = "+1 Suerte: más mejoras raras/épicas y más gemas doradas (x3 XP).",
		Rarity = "Rare",
		Category = "Experiencia",
		Icon = "🍀",
		MaxLevel = 5,
		Effects = { { Op = "Add", Stat = "Luck", Value = 1 } },
	},
	{
		-- Sin habilidades activas todavía: queda fuera de las opciones
		-- seleccionables hasta que exista la mecánica (no mostramos mejoras vacías).
		Id = "ArcaneImpulse",
		DisplayName = "Impulso Arcano",
		Description = "-10 % de enfriamiento de habilidades activas.",
		Rarity = "Rare",
		Category = "Habilidad",
		Icon = "✨",
		MaxLevel = 5,
		Enabled = false,
		DisabledReason = "Requiere habilidades activas (fase posterior).",
		Effects = {},
	},
	{
		-- Comodín: completa la oferta cuando quedan menos de 3 mejoras válidas.
		Id = "SkyBlessing",
		DisplayName = "Bendición del Cielo",
		Description = "Recupera un 30 % de la vida máxima.",
		Rarity = "Common",
		Category = "Curación",
		Icon = "💖",
		IsFallback = true,
		Effects = { { Op = "HealPct", Value = 0.3 } },
	},
}

UpgradeConfig.List = list

local byId: { [string]: Types.UpgradeDef } = {}
for _, def in list do
	assert(byId[def.Id] == nil, "Id de mejora duplicado: " .. def.Id)
	byId[def.Id] = def
end
UpgradeConfig.ById = byId

return UpgradeConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">VisualConfig</string>
            <string name="Source"><![CDATA[--[[
	VisualConfig
	Dirección artística de SKYBONK (Fase 2.5): paletas, perfiles de aura,
	convenciones de armas, animaciones del personaje y niveles de calidad.
	Solo presentación: nada de aquí afecta al combate. Guía completa en
	docs/ART_DIRECTION.md.

	Texturas: las incluidas en el propio cliente de Roblox (rbxasset://),
	comprobadas con ContentProvider en Studio; no requieren subir assets.
]]

local VisualConfig = {}

local function particle(name: string): string
	return "rbxasset://textures/particles/" .. name .. ".dds"
end

VisualConfig.Textures = {
	Sparkle = particle("sparkles_main"),
	Fire = particle("fire_main"),
	FireSparks = particle("fire_sparks_main"),
	Smoke = particle("smoke_main"),
	Core = particle("explosion01_core_main"),
	Shockwave = particle("explosion01_shockwave_main"),
	Implosion = particle("explosion01_implosion_main"),
	Glow = particle("forcefield_glow_main"),
	Vortex = particle("forcefield_vortex_main"),
}

VisualConfig.Palette = {
	Player = Color3.fromRGB(120, 235, 255),
	PlayerCore = Color3.fromRGB(235, 252, 255),
	Danger = Color3.fromRGB(255, 70, 90),
	Void = Color3.fromRGB(132, 72, 214),
	Reward = Color3.fromRGB(255, 196, 92),
	Crit = Color3.fromRGB(255, 176, 64),
}

--[[
	Niveles de calidad. El jugador alterna con la tecla G o el botón FX.
	ParticleScale multiplica la emisión de todas las auras y ráfagas.
]]
VisualConfig.Quality = {
	High = { ParticleScale = 1, EnemyAuras = true, Ambient = true, Lights = true, Speedlines = true },
	Low = { ParticleScale = 0.35, EnemyAuras = false, Ambient = false, Lights = false, Speedlines = false },
}
VisualConfig.DefaultQuality = "High"

--[[
	Perfiles de aura. Capas (todas opcionales):
	  Rise    partículas que suben (llamas, motas)
	  Orbit   motas que giran alrededor (velocidad angular)
	  Sparks  chispas rápidas en ráfagas
	  Ring    anillo en el suelo que pulsa (Pulse = segundos por pulso)
	  Light   luz puntual (solo calidad alta y en el jugador o jefes)
	MaxDistance: más lejos de la cámara la aura se apaga (rendimiento).
]]
VisualConfig.Auras = {
	Electric = {
		Color = Color3.fromRGB(110, 200, 255),
		Accent = Color3.fromRGB(235, 250, 255),
		Radius = 2.6,
		Rise = { Texture = "Sparkle", Rate = 16, Size = 0.5, Speed = 4, Lifetime = 0.5 },
		Sparks = { Texture = "FireSparks", Rate = 22, Size = 0.35, Speed = 9, Lifetime = 0.18 },

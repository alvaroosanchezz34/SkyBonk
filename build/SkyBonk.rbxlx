      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Signal
	Señal síncrona mínima para desacoplar controladores sin dependencias circulares.
]]

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

type Handler = (...any) -> ()

type ConnectionImpl = Connection & { _fn: Handler, _signal: SignalImpl }

export type Signal = {
	Connect: (self: Signal, fn: Handler) -> Connection,
	Fire: (self: Signal, ...any) -> (),
	DisconnectAll: (self: Signal) -> (),
}

type SignalImpl = Signal & { _connections: { ConnectionImpl } }

local Signal = {}

local function disconnect(self: ConnectionImpl)
	if not self.Connected then
		return
	end
	self.Connected = false
	local list = self._signal._connections
	local index = table.find(list, self)
	if index then
		table.remove(list, index)
	end
end

local function connect(self: SignalImpl, fn: Handler): Connection
	local connection = {
		Connected = true,
		Disconnect = disconnect,
		_fn = fn,
		_signal = self,
	} :: any
	table.insert(self._connections, connection)
	return connection
end

local function fire(self: SignalImpl, ...: any)
	-- Copia para tolerar desconexiones durante la emisión.
	for _, connection in table.clone(self._connections) do
		if connection.Connected then
			local ok, err = pcall(connection._fn, ...)
			if not ok then
				warn("[Signal] Error en un manejador:", err)
			end
		end
	end
end

local function disconnectAll(self: SignalImpl)
	for _, connection in self._connections do
		connection.Connected = false
	end
	table.clear(self._connections)
end

function Signal.new(): Signal
	local signal = {
		_connections = {},
		Connect = connect,
		Fire = fire,
		DisconnectAll = disconnectAll,
	} :: any
	return signal
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Types
	Tipos compartidos entre servidor y cliente para las interfaces importantes.
]]

export type GamePhase = "Playing" | "ChoosingUpgrade" | "GameOver"

export type WeaponDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	Pattern: string,
	Damage: number,
	Cooldown: number,
	MinCooldown: number,
	Range: number,
	Projectiles: number,
	MaxProjectiles: number,
	TargetsPerProjectile: number,
	MaxTargetsPerProjectile: number,
	ProjectileSpeed: number, -- studs/s de la hoja visual (decide el instante del impacto)
	WindupTime: number, -- anticipación del tajo antes de lanzar las hojas
	ChainRange: number, -- distancia máxima de los saltos de Filo de Tormenta
	Color: Color3,
}

-- Lunge: salto corto hacia el jugador. Melee: tajo frontal. Slam: golpe en área.
export type EnemyAttackKind = "Lunge" | "Melee" | "Slam"

export type EnemyDef = {
	Id: string,
	DisplayName: string,
	ModelName: string,
	Rig: "Slime" | "Skeleton",
	Scale: number, -- escala del modelo respecto a la plantilla
	MaxHealth: number,
	ContactDamage: number,
	MoveSpeed: number,
	AttackKind: EnemyAttackKind,
	AttackRange: number, -- distancia horizontal a la que se inicia el ataque
	HitRange: number, -- distancia a la que el golpe impacta al terminar la anticipación
	AttackWindup: number, -- segundos de anticipación visible antes del daño
	AttackCooldown: number,
	Poise: boolean, -- true = los impactos no interrumpen su ataque
	Knockback: number, -- velocidad del retroceso al recibir un impacto (studs/s)
	HopFrequency: number?, -- saltos por segundo (solo slimes): modula la velocidad
	XpReward: number,
	Color: Color3,
}

-- Estadísticas modificables por las mejoras. Los porcentajes son aditivos
-- (0.15 = +15 %) y los multiplicadores se acumulan multiplicando.
export type Stats = {
	DamagePct: number,
	CooldownMult: number,
	RangePct: number,
	MaxHealthPct: number,
	MoveSpeedPct: number,
	XpGainPct: number,
	DamageTakenMult: number,
	Luck: number,
	ExtraProjectiles: number,
	ExtraChain: number,
	CritChance: number,
	HealthRegen: number,
	MagnetPct: number,
}

export type StatName =
	"DamagePct"
	| "CooldownMult"
	| "RangePct"
	| "MaxHealthPct"
	| "MoveSpeedPct"
	| "XpGainPct"
	| "DamageTakenMult"
	| "Luck"
	| "ExtraProjectiles"
	| "ExtraChain"
	| "CritChance"
	| "HealthRegen"
	| "MagnetPct"

-- "Add" suma Value a la estadística, "Mul" la multiplica y "HealPct" cura
-- al instante un porcentaje de la vida máxima (no modifica Stats).
export type UpgradeEffect = {
	Op: "Add" | "Mul" | "HealPct",
	Stat: StatName?,
	Value: number,
}

export type Rarity = "Common" | "Rare" | "Epic"

export type UpgradeDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	Rarity: Rarity,
	Category: string,
	Icon: string,
	MaxLevel: number?, -- nil = sin límite
	Weight: number?, -- multiplicador adicional de probabilidad (por defecto 1)
	Effects: { UpgradeEffect },
	Requires: string?, -- nombre de un requisito evaluado por UpgradeLogic
	Enabled: boolean?, -- false = nunca se ofrece
	DisabledReason: string?,
	IsFallback: boolean?, -- solo se ofrece para completar ofertas incompletas
}

export type WeaponState = {
	Id: string,
	Def: WeaponDef,
	NextAttackAt: number,
}

export type WeaponStats = {
	Damage: number,
	Cooldown: number,
	Range: number,
	Projectiles: number,
	TargetsPerProjectile: number,
	CritChance: number,
}

export type Offer = {
	Token: number,
	Level: number,
	Options: { string },
	Consumed: boolean,
}

export type Progress = {
	Level: number,
	Xp: number,
	TotalXp: number,
	PendingLevels: { number }, -- niveles alcanzados cuya mejora aún no se ha elegido
}

-- Opción enviada al cliente: solo el id y los niveles; los textos se leen
-- de UpgradeConfig en el cliente (únicamente para mostrarlos).
export type OfferOptionPayload = {
	Id: string,
	CurrentLevel: number,
	NextLevel: number,
}

export type OfferPayload = {
	Token: number,
	Level: number,
	Options: { OfferOptionPayload },
}

export type StatSummary = {
	Damage: number,
	Cooldown: number,
	Range: number,
	Projectiles: number,
	MoveSpeed: number,
	DamageReductionPct: number,
	XpBonusPct: number,
	Luck: number,
	CritPct: number,
	Chain: number,
	Regen: number,
	Magnet: number,
}

export type HudSnapshot = {
	Phase: GamePhase,
	Level: number,
	Xp: number,
	XpToNext: number,
	Health: number,
	MaxHealth: number,
	Kills: number,
	Elapsed: number,
	Stats: StatSummary,
}

export type GameOverPayload = {
	Elapsed: number,
	Kills: number,
	Level: number,
}

return {}
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="29">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="30">
      <Properties>
        <string name="Name">Bootstrap</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Bootstrap (servidor)
	Orden de arranque:
	  1. Configuración del mundo: carpetas de runtime, mapa, iluminación,
	     grupos de colisión y plantillas de enemigos.
	  2. Init(services) de todos los servicios (inyección de dependencias).
	  3. Start() de todos los servicios.
	  4. En Studio: pruebas unitarias y API de depuración opcional.
]]

local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local MapBuilder = require(script.Parent.World.MapBuilder)

Players.CharacterAutoLoads = false

local function ensureFolder(parent: Instance, name: string): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

-- 1. Mundo ---------------------------------------------------------------
ensureFolder(workspace, "ActiveEnemies")
ensureFolder(workspace, "ExperienceOrbs")
local enemyModels = ensureFolder(ServerStorage, "EnemyModels")

local existingMap = workspace:FindFirstChild("Map")
if existingMap == nil or existingMap:FindFirstChild("Ground") == nil then
	if existingMap then
		existingMap:Destroy()
	end
	MapBuilder.build(workspace)
end
MapBuilder.applyLighting()
-- Nota: Workspace.FallenPartsDestroyHeight no se puede escribir desde scripts;
-- se fija en default.project.json (-445), por debajo de GameConfig.Map.KillY.

PhysicsService:RegisterCollisionGroup("Players")
PhysicsService:RegisterCollisionGroup("Enemies")
-- Los enemigos no empujan al jugador (evita lanzamientos físicos); el daño
-- por contacto se calcula por distancia en EnemyService.
PhysicsService:CollisionGroupSetCollidable("Players", "Enemies", false)

-- 2-3. Servicios -----------------------------------------------------------
local ServicesFolder = script.Parent.Services
local services = {
	MatchService = require(ServicesFolder.MatchService),
	LevelService = require(ServicesFolder.LevelService),
	UpgradeService = require(ServicesFolder.UpgradeService),
	EnemyService = require(ServicesFolder.EnemyService),
	SpawnService = require(ServicesFolder.SpawnService),
	ExperienceService = require(ServicesFolder.ExperienceService),
	CombatService = require(ServicesFolder.CombatService),
}
local START_ORDER = {
	"EnemyService",
	"ExperienceService",
	"SpawnService",
	"CombatService",
	"LevelService",
	"UpgradeService",
	"MatchService", -- el último: empieza a aceptar jugadores
}

services.EnemyService.EnsureTemplates(enemyModels)
for _, name in START_ORDER do
	services[name].Init(services)
end
for _, name in START_ORDER do
	services[name].Start()
end

print("[SkyBonk] Servidor listo")

-- 4. Herramientas de Studio ------------------------------------------------
if RunService:IsStudio() then
	if GameConfig.Debug.RunSelfTestsInStudio then
		task.spawn(function()
			local TestRunner = require(script.Parent.Tests.TestRunner)
			TestRunner.runFolder(script.Parent.Tests)
		end)
	end
	if GameConfig.Debug.ExposeStudioDebugApi then
		-- Uso desde la barra de comandos (vista de servidor) durante el Play:
		--   _G.SkyBonkDebug.GrantXp(30)     concede XP al primer jugador
		--   _G.SkyBonkDebug.Kill()          derrota inmediata
		local function firstRun()
			local player = Players:GetPlayers()[1]
			return player and services.MatchService.GetRun(player)
		end
		-- selene: allow(global_usage)
		_G.SkyBonkDebug = {
			GrantXp = function(amount: number)
				local run = firstRun()
				if run then
					services.LevelService.GrantExperience(run, amount)
				end
			end,
			Kill = function()
				local run = firstRun()
				if run then
					run.Humanoid.Health = 0
				end
			end,
			EnemyCount = function(): number
				local run = firstRun()
				return if run then services.EnemyService.Count(run) else 0
			end,
			-- Elige la opción `index` de la oferta abierta.
			Choose = function(index: number?)
				local player = Players:GetPlayers()[1]
				if player then
					services.UpgradeService.DebugChoose(player, index or 1)
				end
			end,
			-- Genera enemigos de un tipo cerca del jugador (pruebas visuales).
			Spawn = function(enemyId: string, count: number?)
				local run = firstRun()
				if run == nil then
					return 0
				end
				local spawned = 0
				for _ = 1, count or 1 do
					local position = services.SpawnService.FindSpawnPosition(run)
					if
						position
						and services.EnemyService.Spawn(
							run,
							enemyId,
							position,
							services.SpawnService.DifficultyAt(run.State.Elapsed)
						)
					then
						spawned += 1
					end
				end
				return spawned
			end,
			-- Piloto automático del cliente (DebugController) para medir el ritmo.
			Autopilot = function(enabled: boolean)
				local player = Players:GetPlayers()[1]
				if player then
					player:SetAttribute("Autopilot", enabled == true)
				end
			end,
			-- Registro de tiempos: niveles alcanzados, enemigos y vida.
			Report = function(): string
				local run = firstRun()
				if run == nil then
					return "sin partida"
				end
				return string.format(
					"t=%.1fs nivel=%d xp=%d muertes=%d enemigos=%d vida=%.0f/%.0f fase=%s niveles={%s}",
					run.State.Elapsed,
					run.State.Progress.Level,
					run.State.Progress.Xp,
					run.State.Kills,
					services.EnemyService.Count(run),
					run.Humanoid.Health,
					run.Humanoid.MaxHealth,
					run.State.Phase,
					table.concat(services.LevelService.GetLevelTimes(run), ", ")
				)
			end,
		}
		-- Misma API como BindableFunction (la barra de comandos y las herramientas
		-- de Studio no comparten _G con los scripts del juego):
		--   ServerStorage.SkyBonkDebug:Invoke("Report")
		local bindable = Instance.new("BindableFunction")
		bindable.Name = "SkyBonkDebug"
		bindable.OnInvoke = function(command: string, ...)
			-- selene: allow(global_usage)
			local fn = _G.SkyBonkDebug[command]
			if fn == nil then
				return "comando desconocido: " .. tostring(command)
			end
			return fn(...)
		end
		bindable.Parent = ServerStorage
	end
end
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="31">
      <Properties>
        <string name="Name">Logic</string>
      </Properties>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">LevelLogic</string>
          <string name="Source"><![CDATA[--!strict
--[[
	LevelLogic
	Experiencia y niveles. Cada nivel alcanzado se encola una sola vez en
	PendingLevels; la experiencia sobrante se conserva.
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Types = require(Shared.Types)
local Progression = require(Shared.Progression)
local GameConfig = require(Shared.Config.GameConfig)

type Progress = Types.Progress

local LevelLogic = {}

function LevelLogic.new(): Progress
	return {
		Level = 1,
		Xp = 0,
		TotalXp = 0,
		PendingLevels = {},
	}
end

-- Añade experiencia (ya multiplicada) y devuelve cuántos niveles se han ganado.
function LevelLogic.addXp(progress: Progress, amount: number): number
	-- Rechaza NaN, infinitos, negativos y cantidades absurdas.
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return 0
	end
	amount = math.min(amount, GameConfig.Experience.MaxXpPerGrant)

	progress.Xp += amount
	progress.TotalXp += amount

	local gained = 0
	local required = Progression.xpToNext(progress.Level)
	while progress.Xp >= required do
		progress.Xp -= required
		progress.Level += 1
		table.insert(progress.PendingLevels, progress.Level)
		gained += 1
		required = Progression.xpToNext(progress.Level)
	end
	return gained
end

-- Extrae el siguiente nivel pendiente de elegir mejora (FIFO).
function LevelLogic.popPendingLevel(progress: Progress): number?
	if #progress.PendingLevels == 0 then
		return nil
	end
	return table.remove(progress.PendingLevels, 1)
end

return LevelLogic
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">RateLimiter</string>
          <string name="Source"><![CDATA[--!strict
--[[
	RateLimiter
	Limita el número de peticiones por clave (jugador) en una ventana deslizante.
	El reloj se inyecta para poder probarlo fuera de Roblox.
]]

export type RateLimiter = {
	Allow: (self: RateLimiter, key: any) -> boolean,
	Forget: (self: RateLimiter, key: any) -> (),
}

local RateLimiter = {}

function RateLimiter.new(maxRequests: number, window: number, clock: (() -> number)?): RateLimiter
	local now = clock or os.clock
	local history: { [any]: { number } } = {}

	local limiter = {}

	function limiter.Allow(_self: RateLimiter, key: any): boolean
		local t = now()
		local stamps = history[key]
		if stamps == nil then
			stamps = {}
			history[key] = stamps
		end
		-- Descarta marcas fuera de la ventana.
		local firstValid = 1
		while firstValid <= #stamps and t - stamps[firstValid] >= window do
			firstValid += 1
		end
		if firstValid > 1 then
			stamps = table.move(stamps, firstValid, #stamps, 1, {})
			history[key] = stamps
		end
		if #stamps >= maxRequests then
			return false
		end
		table.insert(stamps, t)
		return true
	end

	function limiter.Forget(_self: RateLimiter, key: any)
		history[key] = nil
	end

	return limiter :: RateLimiter
end

return RateLimiter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">RunState</string>
          <string name="Source"><![CDATA[--!strict
--[[
	RunState
	Estado autoritativo de una partida y su máquina de estados:

	  Playing ──(nivel pendiente)──► ChoosingUpgrade ──(elección válida)──► Playing
	     │                                   │
	     └──────────────(muerte)─────────────┴──────────────────────────► GameOver

	Es lógica pura (sin instancias), por lo que se prueba fuera de Roblox.
	Los servicios del servidor la envuelven con personajes, enemigos y remotes.
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Types = require(Shared.Types)
local WeaponConfig = require(Shared.Config.WeaponConfig)
local UpgradeConfig = require(Shared.Config.UpgradeConfig)
local StatSheet = require(script.Parent.StatSheet)
local LevelLogic = require(script.Parent.LevelLogic)
local UpgradeLogic = require(script.Parent.UpgradeLogic)

export type RunState = {
	Phase: Types.GamePhase,
	Elapsed: number, -- reloj de partida: solo avanza en Playing
	Kills: number,
	Progress: Types.Progress,
	Stats: Types.Stats,
	UpgradeLevels: { [string]: number },
	Weapons: { Types.WeaponState },
	ActiveOffer: Types.Offer?,
	NextOfferToken: number,
}

export type ChoiceResult = {
	Def: Types.UpgradeDef,
	HealPct: number,
}

local RunState = {}

function RunState.new(weaponIds: { string }): RunState
	local weapons: { Types.WeaponState } = {}
	for _, id in weaponIds do
		local def = WeaponConfig[id]
		assert(def ~= nil, "Arma desconocida: " .. id)
		table.insert(weapons, { Id = id, Def = def, NextAttackAt = 0 })
	end
	return {
		Phase = "Playing",
		Elapsed = 0,
		Kills = 0,
		Progress = LevelLogic.new(),
		Stats = StatSheet.new(),
		UpgradeLevels = {},
		Weapons = weapons,
		ActiveOffer = nil,
		NextOfferToken = 0,
	}
end

function RunState.isPlaying(state: RunState): boolean
	return state.Phase == "Playing"
end

function RunState.advance(state: RunState, dt: number)
	if state.Phase == "Playing" and dt > 0 then
		state.Elapsed += dt
	end
end

function RunState.addKill(state: RunState)
	if state.Phase ~= "GameOver" then
		state.Kills += 1
	end
end

-- Concede experiencia base (aplica el bonus de XP). Devuelve niveles ganados.
function RunState.grantXp(state: RunState, baseAmount: number): number
	if state.Phase == "GameOver" then
		return 0
	end
	return LevelLogic.addXp(state.Progress, StatSheet.xpGain(state.Stats, baseAmount))
end

local function contextOf(state: RunState): UpgradeLogic.Context
	return {
		Stats = state.Stats,
		Weapons = state.Weapons,
		UpgradeLevels = state.UpgradeLevels,
	}
end

--[[
	Abre una oferta si la partida está en Playing y hay niveles pendientes.
	Devuelve la oferta nueva o nil (no se superponen ofertas).
]]
function RunState.tryOpenOffer(state: RunState, rng: UpgradeLogic.Rng): Types.Offer?
	if state.Phase ~= "Playing" or state.ActiveOffer ~= nil then
		return nil
	end
	local level = LevelLogic.popPendingLevel(state.Progress)
	if level == nil then
		return nil
	end
	local options = UpgradeLogic.rollOptions(contextOf(state), rng, nil, level)
	if #options == 0 then
		-- Sin opciones ni comodines: el nivel se considera resuelto.
		return nil
	end
	state.NextOfferToken += 1
	local offer: Types.Offer = {
		Token = state.NextOfferToken,
		Level = level,
		Options = options,
		Consumed = false,
	}
	state.ActiveOffer = offer
	state.Phase = "ChoosingUpgrade"
	return offer
end

--[[
	Valida y aplica una elección. Solo se acepta si la partida está esperando
	una elección y (token, id) corresponde a la oferta activa no consumida.
]]
function RunState.choose(state: RunState, token: any, upgradeId: any): (boolean, string? | ChoiceResult)
	if state.Phase ~= "ChoosingUpgrade" then
		return false, "NotChoosing"
	end
	local ok, reason = UpgradeLogic.validateChoice(state.ActiveOffer, token, upgradeId)
	if not ok then
		return false, reason
	end

	local offer = state.ActiveOffer :: Types.Offer
	local def = UpgradeConfig.ById[upgradeId :: string]
	offer.Consumed = true
	state.ActiveOffer = nil
	state.Phase = "Playing"

	local healPct = StatSheet.applyEffects(state.Stats, def.Effects)
	state.UpgradeLevels[def.Id] = (state.UpgradeLevels[def.Id] or 0) + 1

	local result: ChoiceResult = { Def = def, HealPct = healPct }
	return true, result
end

function RunState.setGameOver(state: RunState): boolean
	if state.Phase == "GameOver" then
		return false
	end
	state.Phase = "GameOver"
	if state.ActiveOffer then
		state.ActiveOffer.Consumed = true
		state.ActiveOffer = nil
	end
	return true
end

function RunState.offerPayload(state: RunState, offer: Types.Offer): Types.OfferPayload
	local options: { Types.OfferOptionPayload } = {}
	for _, id in offer.Options do
		local current = state.UpgradeLevels[id] or 0
		table.insert(options, { Id = id, CurrentLevel = current, NextLevel = current + 1 })
	end
	return { Token = offer.Token, Level = offer.Level, Options = options }
end

return RunState
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">StatSheet</string>
          <string name="Source"><![CDATA[--!strict
--[[
	StatSheet
	Estadísticas del jugador durante una partida y cálculo de los valores
	derivados (daño de arma, vida máxima, velocidad...). Lógica pura y
	determinista: no toca instancias de Roblox.
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Types = require(Shared.Types)
local GameConfig = require(Shared.Config.GameConfig)

type Stats = Types.Stats

local StatSheet = {}

function StatSheet.new(): Stats
	return {
		DamagePct = 0,
		CooldownMult = 1,
		RangePct = 0,
		MaxHealthPct = 0,
		MoveSpeedPct = 0,
		XpGainPct = 0,
		DamageTakenMult = 1,
		Luck = 0,
		ExtraProjectiles = 0,
		ExtraChain = 0,
		CritChance = 0,
		HealthRegen = 0,
		MagnetPct = 0,
	}
end

--[[
	Aplica los efectos de una mejora. Devuelve el porcentaje de curación
	instantánea solicitado (efectos "HealPct"), que aplica quien llama porque
	depende del Humanoid.
]]
function StatSheet.applyEffects(stats: Stats, effects: { Types.UpgradeEffect }): number
	local healPct = 0
	for _, effect in effects do
		if effect.Op == "HealPct" then
			healPct += effect.Value
		else
			local statName = effect.Stat
			assert(statName ~= nil, "Efecto sin estadística")
			local current = (stats :: any)[statName]
			assert(type(current) == "number", "Estadística desconocida: " .. tostring(statName))
			if effect.Op == "Add" then
				(stats :: any)[statName] = current + effect.Value
			elseif effect.Op == "Mul" then
				(stats :: any)[statName] = current * effect.Value
			else
				error("Operación de efecto desconocida: " .. tostring(effect.Op))
			end
		end
	end
	return healPct
end

function StatSheet.projectilesFor(stats: Stats, def: Types.WeaponDef): number
	return math.clamp(def.Projectiles + stats.ExtraProjectiles, 1, def.MaxProjectiles)
end

function StatSheet.targetsFor(stats: Stats, def: Types.WeaponDef): number
	return math.clamp(def.TargetsPerProjectile + stats.ExtraChain, 1, def.MaxTargetsPerProjectile)
end

function StatSheet.weaponStats(stats: Stats, def: Types.WeaponDef): Types.WeaponStats
	return {
		Damage = def.Damage * (1 + stats.DamagePct),
		Cooldown = math.max(def.MinCooldown, def.Cooldown * stats.CooldownMult),
		Range = def.Range * (1 + stats.RangePct),
		Projectiles = StatSheet.projectilesFor(stats, def),
		TargetsPerProjectile = StatSheet.targetsFor(stats, def),
		CritChance = math.clamp(stats.CritChance, 0, 0.75),
	}
end

-- Radio en el que las gemas empiezan a volar hacia el jugador.
function StatSheet.magnetRadius(stats: Stats): number
	local player = GameConfig.Player
	return math.min(player.MaxMagnetRadius, player.MagnetRadius * (1 + stats.MagnetPct))
end

function StatSheet.maxHealth(stats: Stats): number
	return math.floor(GameConfig.Player.BaseMaxHealth * (1 + stats.MaxHealthPct) + 0.5)
end

function StatSheet.walkSpeed(stats: Stats): number
	return GameConfig.Player.BaseWalkSpeed * (1 + stats.MoveSpeedPct)
end

function StatSheet.xpGain(stats: Stats, baseAmount: number): number
	return baseAmount * (1 + stats.XpGainPct)
end

function StatSheet.damageTaken(stats: Stats, rawDamage: number): number
	return math.max(0, rawDamage * stats.DamageTakenMult)
end

function StatSheet.luckyGemChance(stats: Stats): number
	local cfg = GameConfig.Experience
	return math.clamp(cfg.LuckyGemBaseChance + cfg.LuckyGemChancePerLuck * stats.Luck, 0, 1)
end

function StatSheet.summary(stats: Stats, primaryWeapon: Types.WeaponDef?): Types.StatSummary
	local weapon = primaryWeapon and StatSheet.weaponStats(stats, primaryWeapon)
	return {
		Damage = weapon and weapon.Damage or 0,
		Cooldown = weapon and weapon.Cooldown or 0,
		Range = weapon and weapon.Range or 0,
		Projectiles = weapon and weapon.Projectiles or 0,
		MoveSpeed = StatSheet.walkSpeed(stats),
		DamageReductionPct = (1 - stats.DamageTakenMult) * 100,
		XpBonusPct = stats.XpGainPct * 100,
		Luck = stats.Luck,
		CritPct = (weapon and weapon.CritChance or 0) * 100,
		Chain = weapon and weapon.TargetsPerProjectile - 1 or 0,
		Regen = stats.HealthRegen,
		Magnet = StatSheet.magnetRadius(stats),
	}
end

return StatSheet
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">Targeting</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Targeting
	Selección de los N objetivos válidos más cercanos dentro de un alcance.
	Recorre la lista una sola vez y mantiene un pequeño top-N ordenado,
	sin crear tablas intermedias por enemigo.
]]

export type Candidate = {
	Position: Vector3,
	Dead: boolean,
}

local Targeting = {}

-- `candidates` puede contener cualquier tabla con Position y Dead (p. ej. enemigos).
function Targeting.nearest(
	candidates: { any },
	origin: Vector3,
	range: number,
	count: number,
	isValid: ((any) -> boolean)?
): { any }
	local rangeSq = range * range
	local best: { any } = {}
	local bestDist: { number } = {}
	if count <= 0 then
		return best
	end

	for _, candidate: Candidate in candidates do
		if candidate.Dead then
			continue
		end
		local offset = candidate.Position - origin
		local distSq = offset.X * offset.X + offset.Y * offset.Y + offset.Z * offset.Z
		if distSq > rangeSq then
			continue
		end
		if isValid and not isValid(candidate) then
			continue
		end
		-- Inserción ordenada en el top-N.
		local n = #best
		if n < count or distSq < bestDist[n] then
			local insertAt = n + 1
			for i = 1, n do
				if distSq < bestDist[i] then
					insertAt = i
					break
				end
			end
			table.insert(best, insertAt, candidate)
			table.insert(bestDist, insertAt, distSq)
			if #best > count then
				table.remove(best)
				table.remove(bestDist)
			end
		end
	end
	return best
end

return Targeting
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">UpgradeLogic</string>
          <string name="Source"><![CDATA[--!strict
--[[
	UpgradeLogic
	Elegibilidad, tirada aleatoria ponderada (sin repeticiones) y validación
	de elecciones de mejoras. Lógica pura: el generador aleatorio se inyecta.
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Types = require(Shared.Types)
local UpgradeConfig = require(Shared.Config.UpgradeConfig)
local StatSheet = require(script.Parent.StatSheet)

export type Rng = { NextNumber: (self: any) -> number }

export type Context = {
	Stats: Types.Stats,
	Weapons: { Types.WeaponState },
	UpgradeLevels: { [string]: number },
}

local UpgradeLogic = {}

-- Requisitos con nombre referenciados desde UpgradeConfig.Requires.
UpgradeLogic.Requirements = {
	WeaponAcceptsExtraProjectile = function(ctx: Context): boolean
		for _, weapon in ctx.Weapons do
			if StatSheet.projectilesFor(ctx.Stats, weapon.Def) < weapon.Def.MaxProjectiles then
				return true
			end
		end
		return false
	end,
	WeaponAcceptsExtraChain = function(ctx: Context): boolean
		for _, weapon in ctx.Weapons do
			if StatSheet.targetsFor(ctx.Stats, weapon.Def) < weapon.Def.MaxTargetsPerProjectile then
				return true
			end
		end
		return false
	end,
} :: { [string]: (Context) -> boolean }

local function levelOf(ctx: Context, id: string): number
	return ctx.UpgradeLevels[id] or 0
end

-- ¿Puede ofrecerse esta mejora ahora mismo? (los comodines se tratan aparte)
function UpgradeLogic.isEligible(def: Types.UpgradeDef, ctx: Context): boolean
	if def.Enabled == false or def.IsFallback then
		return false
	end
	if #def.Effects == 0 then
		return false -- nunca mostrar mejoras que no hacen nada
	end
	if def.MaxLevel ~= nil and levelOf(ctx, def.Id) >= def.MaxLevel then
		return false
	end
	if def.Requires ~= nil then
		local check = UpgradeLogic.Requirements[def.Requires]
		if check == nil then
			warn("[UpgradeLogic] Requisito desconocido:", def.Requires)
			return false
		end
		if not check(ctx) then
			return false
		end
	end
	return true
end

function UpgradeLogic.weightOf(def: Types.UpgradeDef, luck: number): number
	local rarity = UpgradeConfig.Rarities[def.Rarity]
	local weight = (rarity and rarity.Weight or 1) * (def.Weight or 1)
	if def.Rarity ~= "Common" then
		weight *= 1 + math.max(0, luck) * UpgradeConfig.LuckRarityBonus
	end
	return math.max(weight, 0)
end

-- Devuelve hasta `size` ids distintos. Si hay menos mejoras válidas que
-- `size`, completa con comodines (IsFallback) para no bloquear la partida.
-- `level` (opcional) activa la garantía de UpgradeConfig.EarlyGuarantee.
function UpgradeLogic.rollOptions(ctx: Context, rng: Rng, size: number?, level: number?): { string }
	local offerSize = size or UpgradeConfig.OfferSize
	local pool: { Types.UpgradeDef } = {}
	for _, def in UpgradeConfig.List do
		if UpgradeLogic.isEligible(def, ctx) then
			table.insert(pool, def)
		end
	end

	local result: { string } = {}
	while #result < offerSize and #pool > 0 do
		local total = 0
		for _, def in pool do
			total += UpgradeLogic.weightOf(def, ctx.Stats.Luck)
		end
		local pickIndex = #pool
		if total > 0 then
			local roll = rng:NextNumber() * total
			for index, def in pool do
				roll -= UpgradeLogic.weightOf(def, ctx.Stats.Luck)
				if roll < 0 then
					pickIndex = index
					break
				end
			end
		end
		table.insert(result, pool[pickIndex].Id)
		table.remove(pool, pickIndex)
	end

	-- Garantía de los primeros niveles: al menos una opción de la categoría indicada.
	local guarantee = UpgradeConfig.EarlyGuarantee
	if guarantee and level and level <= guarantee.UntilLevel and #result > 0 then
		local hasCategory = false
		for _, id in result do
			if UpgradeConfig.ById[id].Category == guarantee.Category then
				hasCategory = true
			end
		end
		if not hasCategory then
			local candidates: { Types.UpgradeDef } = {}
			for _, def in pool do
				if def.Category == guarantee.Category then
					table.insert(candidates, def)
				end
			end
			if #candidates > 0 then
				local pick = candidates[math.clamp(math.floor(rng:NextNumber() * #candidates) + 1, 1, #candidates)]
				result[#result] = pick.Id
			end
		end
	end

	if #result < offerSize then
		for _, def in UpgradeConfig.List do
			if #result >= offerSize then
				break
			end
			if def.IsFallback and def.Enabled ~= false and not table.find(result, def.Id) then
				table.insert(result, def.Id)
			end
		end
	end

	return result
end

-- Comprueba que (token, id) corresponde a la oferta activa y no consumida.
function UpgradeLogic.validateChoice(offer: Types.Offer?, token: any, upgradeId: any): (boolean, string?)
	if offer == nil then
		return false, "NoActiveOffer"
	end
	if type(token) ~= "number" or token ~= offer.Token then
		return false, "StaleToken"
	end
	if offer.Consumed then
		return false, "AlreadyConsumed"
	end
	if type(upgradeId) ~= "string" or table.find(offer.Options, upgradeId) == nil then
		return false, "NotOffered"
	end
	if UpgradeConfig.ById[upgradeId] == nil then
		return false, "UnknownUpgrade"
	end
	return true, nil
end

return UpgradeLogic
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">Validation</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Validation
	Comprobaciones de tipos para los argumentos que llegan por RemoteEvents.
]]

local Validation = {}

function Validation.isFiniteNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function Validation.isPositiveInteger(value: any): boolean
	return Validation.isFiniteNumber(value) and value >= 1 and value % 1 == 0 and value < 2 ^ 31
end

-- Identificadores: solo letras y números ASCII, longitud acotada.
function Validation.isIdentifier(value: any, maxLength: number?): boolean
	if type(value) ~= "string" then
		return false
	end
	local length = #value
	if length == 0 or length > (maxLength or 64) then
		return false
	end
	return string.match(value, "^[%w_]+$") ~= nil
end

return Validation
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ModuleScript" referent="39">
      <Properties>
        <string name="Name">ServerTypes</string>
        <string name="Source"><![CDATA[--!strict
--[[
	ServerTypes
	Tipos de las estructuras internas compartidas por los servicios del servidor.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Types = require(ReplicatedStorage.Shared.Types)
local RunState = require(script.Parent.Logic.RunState)

-- Una partida en curso (una por jugador).
export type Run = {
	Player: Player,
	State: RunState.RunState,
	Active: boolean, -- false cuando la partida se ha limpiado
	Character: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Connections: { RBXScriptConnection },
	Rng: Random,
	Paused: boolean,
	InvulnerableUntil: number, -- en tiempo de partida
	HudDirty: boolean,
	NextRegenAt: number,
	LastHudSentAt: number,
	NextFallCheckAt: number,
	EndedAt: number?, -- os.clock() de la derrota
}

export type Enemy = {
	Id: number,
	Def: Types.EnemyDef,
	Run: Run,
	Model: Model,
	Root: BasePart,
	Mover: LinearVelocity,
	Facing: AlignOrientation,
	Health: number,
	MaxHealth: number,
	PendingDamage: number, -- daño de hojas en vuelo que aún no ha impactado
	Damage: number,
	Speed: number,
	Dead: boolean,
	Position: Vector3, -- posición cacheada en el último tick de IA
	State: string, -- Spawning | Chase | Windup | Recover | Stagger | Dead
	StateUntil: number, -- tiempo de partida en que termina el estado actual
	NextAttackAt: number,
	AttackDir: Vector3,
	PendingHitAt: number?, -- golpe del salto del slime pendiente de comprobar
	KnockDir: Vector3,
	HopSeed: number,
	LinkExit: Vector3?, -- salida del acceso (rampa/puente) que está recorriendo
	LastProgressPosition: Vector3,
	LastProgressAt: number,
	SidestepUntil: number,
	SidestepSign: number,
}

export type Gem = {
	Part: BasePart,
	Position: Vector3,
	Value: number,
	ExpiresAt: number, -- math.huge si las gemas no caducan
	Collected: boolean,
	AttractStart: number?, -- tiempo de partida en que empezó a volar hacia el jugador
}

-- Interfaz común de los servicios: Init recibe la tabla de todos los servicios
-- (inyección de dependencias, sin requires cruzados) y Start arranca la lógica.
export type Services = { [string]: any }

return {}
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="40">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[--[[
	CombatService
	Programación centralizada de los ataques automáticos. Cada partida tiene una
	lista de armas con su próximo instante de ataque y una cola de impactos
	pendientes (todo en tiempo de partida, así que la pausa también los detiene).

	Flujo de un tajo de la Espada del Vendaval:
	  1. El arma elige objetivos y el servidor envía CombatFx (qué hojas salen,
	     hacia quién y cuánto tardan) para que el cliente anime el tajo y las hojas.
	  2. Cada impacto se aplica cuando la hoja llega (anticipación + distancia /
	     velocidad). El daño, los críticos y los saltos de rayo se calculan aquí.
	  3. Los impactos aplicados se agrupan en un único CombatHits por paso.
	El cliente nunca decide el daño: si su animación falla, el combate es el mismo.

	Para añadir un arma con otro patrón: crea su entrada en WeaponConfig con un
	`Pattern` nuevo y añade el manejador correspondiente en `Patterns`.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Net = require(Shared.Net)
local Types = require(Shared.Types)

local Logic = script.Parent.Parent.Logic
local StatSheet = require(Logic.StatSheet)
local Targeting = require(Logic.Targeting)
local ServerTypes = require(script.Parent.Parent.ServerTypes)

type Run = ServerTypes.Run
type Enemy = ServerTypes.Enemy

-- Impacto programado: se aplica en `At` (tiempo de partida).
type Impact = {
	At: number,
	Enemy: Enemy,
	Damage: number,
	Crit: boolean,
	Chain: boolean,
	From: Vector3,
}

export type Hit = {
	Model: Model,
	Position: Vector3,
	Damage: number,
	Killed: boolean,
	Crit: boolean,
	Chain: boolean,
}

-- Hoja enviada al cliente (solo presentación).
export type ShotFx = {
	Model: Model,
	Position: Vector3,
	Delay: number, -- segundos desde el tajo hasta el impacto
	Chain: { { Model: Model, Position: Vector3, Delay: number } },
}

local CombatService = {}

local services: ServerTypes.Services
local impactsByRun: { [Run]: { Impact } } = {}

-- Los saltos de rayo hacen menos daño que la hoja principal.
local CHAIN_DAMAGE = 0.7
local CHAIN_HOP_DELAY = 0.07

function CombatService.Init(allServices: ServerTypes.Services)
	services = allServices
end

function CombatService.Start() end

-- Objetivo válido: vivo, dentro del mapa y sin daño en vuelo suficiente para matarlo.
local function isValidTarget(enemy: Enemy): boolean
	return not enemy.Dead
		and enemy.Model.Parent ~= nil
		and enemy.State ~= "Spawning"
		and enemy.Health - enemy.PendingDamage > 0
		and not services.EnemyService.IsOutOfBounds(enemy.Position)
end

local function schedule(run: Run, impact: Impact)
	impact.Enemy.PendingDamage += impact.Damage
	table.insert(impactsByRun[run], impact)
end

local function rollDamage(run: Run, stats: Types.WeaponStats, scale: number): (number, boolean)
	local crit = run.Rng:NextNumber() < stats.CritChance
	local damage = stats.Damage * scale * (if crit then GameConfig.Combat.CritMultiplier else 1)
	return damage, crit
end

-- Patrones de ataque: programan impactos y devuelven la descripción visual (vacía si no hubo objetivo).
CombatService.Patterns = {
	--[[
		Hojas espectrales: cada hoja busca un enemigo distinto (el más cercano
		disponible). Con Filo de Tormenta, al impactar salta con un rayo a
		enemigos próximos a su objetivo.
	]]
	NearestTargets = function(run: Run, weapon: Types.WeaponState, stats: Types.WeaponStats): { ShotFx }
		local def = weapon.Def
		local now = run.State.Elapsed
		local enemies = services.EnemyService.GetEnemies(run)
		local origin = run.Root.Position
		local targets = Targeting.nearest(enemies, origin, stats.Range, stats.Projectiles, isValidTarget)
		local struck: { [Enemy]: boolean } = {}
		for _, target in targets do
			struck[target] = true
		end
		local shots: { ShotFx } = {}
		for _, target in targets do
			local distance = (target.Position - origin).Magnitude
			local delay = def.WindupTime + distance / def.ProjectileSpeed
			local damage, crit = rollDamage(run, stats, 1)
			schedule(
				run,
				{ At = now + delay, Enemy = target, Damage = damage, Crit = crit, Chain = false, From = origin }
			)
			local shot: ShotFx = { Model = target.Model, Position = target.Position, Delay = delay, Chain = {} }

			local hops = stats.TargetsPerProjectile - 1
			local previous = target
			local hopDelay = delay
			for _ = 1, hops do
				local nextTarget = Targeting.nearest(enemies, previous.Position, def.ChainRange, 1, function(candidate)
					return not struck[candidate] and isValidTarget(candidate)
				end)[1]
				if nextTarget == nil then
					break
				end
				struck[nextTarget] = true
				hopDelay += CHAIN_HOP_DELAY
				local chainDamage, chainCrit = rollDamage(run, stats, CHAIN_DAMAGE)
				schedule(run, {
					At = now + hopDelay,
					Enemy = nextTarget,
					Damage = chainDamage,
					Crit = chainCrit,
					Chain = true,
					From = previous.Position,
				})
				table.insert(shot.Chain, { Model = nextTarget.Model, Position = nextTarget.Position, Delay = hopDelay })
				previous = nextTarget
			end
			table.insert(shots, shot)
		end
		return shots
	end,
} :: { [string]: (Run, Types.WeaponState, Types.WeaponStats) -> { ShotFx } }

function CombatService.SetupRun(run: Run)
	impactsByRun[run] = {}
	for _, weapon in run.State.Weapons do
		weapon.NextAttackAt = 0
	end
end

-- Aplica los impactos cuyo instante ha llegado. Devuelve false si la fase ha cambiado.
local function resolveImpacts(run: Run, now: number): boolean
	local impacts = impactsByRun[run]
	if impacts == nil or #impacts == 0 then
		return true
	end
	local hits: { Hit } = {}
	local index = 1
	local stillPlaying = true
	while index <= #impacts do
		local impact = impacts[index]
		if impact.At > now then
			index += 1
			continue
		end
		table.remove(impacts, index)
		local enemy = impact.Enemy
		enemy.PendingDamage = math.max(0, enemy.PendingDamage - impact.Damage)
		local position = enemy.Position
		local model = enemy.Model
		local killed, dealt = services.EnemyService.Damage(enemy, impact.Damage, impact.From)
		if dealt > 0 then
			table.insert(hits, {
				Model = model,
				Position = position,
				Damage = dealt,
				Killed = killed,
				Crit = impact.Crit,
				Chain = impact.Chain,
			})
		end
		if run.State.Phase ~= "Playing" then
			stillPlaying = false
			break -- una muerte ha abierto la selección de mejoras (o la partida terminó)
		end
	end
	if #hits > 0 then
		Net.CombatHits:FireClient(run.Player, { Hits = hits })
	end
	return stillPlaying
end

function CombatService.Step(run: Run)
	local state = run.State
	if state.Phase ~= "Playing" or run.Root.Parent == nil or run.Humanoid.Health <= 0 then
		return
	end
	local now = state.Elapsed
	if not resolveImpacts(run, now) then
		return
	end
	for _, weapon in state.Weapons do
		if now < weapon.NextAttackAt then
			continue
		end
		local pattern = CombatService.Patterns[weapon.Def.Pattern]
		if pattern == nil then
			warn("[CombatService] Patrón desconocido:", weapon.Def.Pattern)
			weapon.NextAttackAt = math.huge
			continue
		end
		local weaponStats = StatSheet.weaponStats(state.Stats, weapon.Def)
		local origin = run.Root.Position
		local shots = pattern(run, weapon, weaponStats)
		if #shots == 0 then
			-- Sin objetivos: se vuelve a buscar en breve, no en cada frame.
			weapon.NextAttackAt = now + GameConfig.Combat.RetargetDelay
		else
			weapon.NextAttackAt = now + weaponStats.Cooldown
			Net.CombatFx:FireClient(run.Player, {
				WeaponId = weapon.Id,
				Origin = origin,
				Windup = weapon.Def.WindupTime,
				Cooldown = weaponStats.Cooldown,
				Shots = shots,
			})
		end
	end
end

function CombatService.CleanupRun(run: Run)
	local impacts = impactsByRun[run]
	if impacts then
		for _, impact in impacts do
			impact.Enemy.PendingDamage = 0
		end
	end
	impactsByRun[run] = nil
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">EnemyService</string>
          <string name="Source"><![CDATA[--[[
	EnemyService
	Ciclo de vida de los enemigos y su IA centralizada:

	  Spawning ─► Chase ─► Windup ─► Recover ─► Chase ...
	                 ▲        │ (impacto sin aplomo)
	                 └─ Stagger ◄┘
	  (cualquier estado) ─► muerte: el modelo queda DeathDuration sin colisión
	                        para la animación del cliente y después se destruye.

	• Un único tick de IA (GameConfig.Combat.EnemyAiInterval) recorre todos los
	  enemigos de cada partida; no hay scripts ni bucles por enemigo.
	• El movimiento es físico (LinearVelocity en el plano XZ + gravedad).
	• El daño al jugador se aplica AL TERMINAR la anticipación (AttackWindup) y
	  solo si sigue al alcance: los ataques se ven venir y se pueden esquivar.
	• El cliente anima a partir de los atributos del modelo (State, StateAt,
	  StateDuration, HopSeed); nada de lo que haga el cliente decide el daño.
	• La navegación usa World/MapLayout: no camina hacia el vacío y sube a las
	  mesetas o cruza el puente por sus accesos.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local EnemyConfig = require(Shared.Config.EnemyConfig)
local Net = require(Shared.Net)
local Types = require(Shared.Types)

local RunState = require(script.Parent.Parent.Logic.RunState)
local ModelFactory = require(script.Parent.Parent.World.ModelFactory)
local MapLayout = require(script.Parent.Parent.World.MapLayout)
local ServerTypes = require(script.Parent.Parent.ServerTypes)

type Run = ServerTypes.Run
type Enemy = ServerTypes.Enemy

type RunEnemies = {
	List: { Enemy },
	Dying: { { Model: Model, RemoveAt: number } },
	Frozen: boolean,
	NextAiAt: number,
	CountByType: { [string]: number },
}

export type Multipliers = { Health: number, Damage: number, Speed: number }

local EnemyService = {}

local services: ServerTypes.Services
local byRun: { [Run]: RunEnemies } = {}
local nextEnemyId = 0
local activeFolder: Folder
local templatesFolder: Folder
local EMPTY: { Enemy } = {}

local MAP_CENTER = GameConfig.Map.Center
local BOUNDS_RADIUS = GameConfig.Map.BoundsRadius
local KILL_Y = GameConfig.Map.KillY
local COMBAT = GameConfig.Combat
local TAU = math.pi * 2
-- Giros que se prueban, en orden, cuando la dirección deseada lleva al vacío.
local AVOID_ANGLES = { math.rad(35), -math.rad(35), math.rad(70), -math.rad(70), math.rad(110), -math.rad(110) }

-- Tiempo común servidor/cliente para sincronizar los saltos de los slimes.
local function serverTime(): number
	local getter = (workspace :: any).GetServerTimeNow
	if getter then
		return getter(workspace)
	end
	return os.clock()
end

function EnemyService.Init(allServices: ServerTypes.Services)
	services = allServices
	activeFolder = workspace:WaitForChild("ActiveEnemies") :: Folder
	templatesFolder = ServerStorage:WaitForChild("EnemyModels") :: Folder
end

function EnemyService.Start() end

-- Crea (una sola vez) las plantillas que falten en ServerStorage/EnemyModels.
function EnemyService.EnsureTemplates(folder: Folder)
	for _, def in EnemyConfig do
		if folder:FindFirstChild(def.ModelName) == nil then
			local builder = ModelFactory.Builders[def.Rig]
			assert(builder, "No hay constructor para el rig " .. def.Rig)
			local model = builder(def)
			model.Name = def.ModelName
			model.Parent = folder
		end
	end
end

function EnemyService.SetupRun(run: Run)
	byRun[run] = { List = {}, Dying = {}, Frozen = false, NextAiAt = 0, CountByType = {} }
end

function EnemyService.GetEnemies(run: Run): { Enemy }
	local data = byRun[run]
	return if data then data.List else EMPTY
end

function EnemyService.Count(run: Run): number
	local data = byRun[run]
	return if data then #data.List else 0
end

function EnemyService.CountOfType(run: Run, enemyId: string): number
	local data = byRun[run]
	return if data then data.CountByType[enemyId] or 0 else 0
end

local function removeFromList(data: RunEnemies, enemy: Enemy)
	local list = data.List
	local index = table.find(list, enemy)
	if index then
		-- Intercambio con el último: O(1) y sin huecos.
		list[index] = list[#list]
		list[#list] = nil
		data.CountByType[enemy.Def.Id] = math.max(0, (data.CountByType[enemy.Def.Id] or 1) - 1)
	end
end

local function despawn(enemy: Enemy)
	enemy.Dead = true
	local data = byRun[enemy.Run]
	if data then
		removeFromList(data, enemy)
	end
	enemy.Model:Destroy()
end

local function isOutOfBounds(position: Vector3): boolean
	if position.Y < KILL_Y then
		return true
	end
	local dx, dz = position.X - MAP_CENTER.X, position.Z - MAP_CENTER.Z
	return dx * dx + dz * dz > BOUNDS_RADIUS * BOUNDS_RADIUS
end
EnemyService.IsOutOfBounds = isOutOfBounds

-- Cambia de estado y lo publica en el modelo (el cliente anima a partir de esto).
local function setState(enemy: Enemy, state: string, duration: number)
	local now = enemy.Run.State.Elapsed
	enemy.State = state
	enemy.StateUntil = now + duration
	local model = enemy.Model
	-- State va al final: el cliente reacciona a su cambio y lee los otros dos.
	model:SetAttribute("StateAt", serverTime())
	model:SetAttribute("StateDuration", duration)
	model:SetAttribute("State", state)
end

local function setVelocity(enemy: Enemy, velocity: Vector3)
	enemy.Mover.PlaneVelocity = Vector2.new(velocity.X, velocity.Z)
end

local function face(enemy: Enemy, direction: Vector3)
	if direction.Magnitude > 1e-3 then
		enemy.Facing.CFrame = CFrame.lookAt(Vector3.zero, Vector3.new(direction.X, 0, direction.Z).Unit)
	end
end

--[[
	Crea un enemigo apoyado sobre `groundPosition` (punto del suelo). Emerge
	durante SpawnDuration (anclado, sin atacar) y después persigue al jugador.
]]
function EnemyService.Spawn(run: Run, enemyId: string, groundPosition: Vector3, multipliers: Multipliers): Enemy?
	local data = byRun[run]
	local def: Types.EnemyDef? = EnemyConfig[enemyId]
	if data == nil or def == nil or not run.Active then
		return nil
	end
	local template = templatesFolder:FindFirstChild(def.ModelName)
	if template == nil then
		warn("[EnemyService] Falta la plantilla", def.ModelName)
		return nil
	end

	local model = template:Clone() :: Model
	local root = model.PrimaryPart :: BasePart
	local mover = root and root:FindFirstChild("Mover") :: LinearVelocity
	local facing = root and root:FindFirstChild("Facing") :: AlignOrientation
	if not (root and mover and facing) then
		warn("[EnemyService] Plantilla incompleta", def.ModelName)
		model:Destroy()
		return nil
	end

	nextEnemyId += 1
	local now = run.State.Elapsed
	local maxHealth = def.MaxHealth * multipliers.Health
	local position = groundPosition + Vector3.new(0, root.Size.Y / 2 + 0.05, 0)
	local towardPlayer = run.Root.Position - position
	local yaw = math.atan2(-towardPlayer.X, -towardPlayer.Z)
	model:PivotTo(CFrame.new(position) * CFrame.Angles(0, yaw, 0))
	model:SetAttribute("EnemyId", def.Id)
	model:SetAttribute("Health", maxHealth)
	model:SetAttribute("MaxHealth", maxHealth)
	model:SetAttribute("HopSeed", run.Rng:NextNumber())
	root.CollisionGroup = "Enemies"
	root.Anchored = true -- emerge anclado; se libera al terminar la aparición
	model.Parent = activeFolder

	local enemy: Enemy = {
		Id = nextEnemyId,
		Def = def,
		Run = run,
		Model = model,
		Root = root,
		Mover = mover,
		Facing = facing,
		Health = maxHealth,
		MaxHealth = maxHealth,
		PendingDamage = 0,
		Damage = def.ContactDamage * multipliers.Damage,
		Speed = def.MoveSpeed * multipliers.Speed,
		Dead = false,
		Position = position,
		State = "Spawning",
		StateUntil = now,
		NextAttackAt = now + COMBAT.SpawnDuration + 0.25,
		AttackDir = Vector3.new(0, 0, -1),
		PendingHitAt = nil,
		KnockDir = Vector3.zero,
		HopSeed = model:GetAttribute("HopSeed") :: number,
		LinkExit = nil,
		LastProgressPosition = position,
		LastProgressAt = now,
		SidestepUntil = 0,
		SidestepSign = 1,
	}
	setState(enemy, "Spawning", COMBAT.SpawnDuration)
	face(enemy, towardPlayer)
	table.insert(data.List, enemy)
	data.CountByType[def.Id] = (data.CountByType[def.Id] or 0) + 1
	return enemy
end

local function kill(enemy: Enemy)
	-- `Dead` se marca antes que nada: una muerte solo genera una recompensa.
	enemy.Dead = true
	local run = enemy.Run
	local root = enemy.Root
	local position = root.Position
	local data = byRun[run]
	setVelocity(enemy, Vector3.zero)
	root.Anchored = true
	root.CanCollide = false
	enemy.Model:SetAttribute("Dead", true)
	setState(enemy, "Dead", COMBAT.DeathDuration)
	if data then
		removeFromList(data, enemy)
		-- El modelo se queda para la animación de muerte y se retira después.
		table.insert(data.Dying, { Model = enemy.Model, RemoveAt = run.State.Elapsed + COMBAT.DeathDuration })
	else
		enemy.Model:Destroy()
	end

	RunState.addKill(run.State)
	Net.EnemyDied:FireClient(run.Player, {
		Position = position,
		Color = enemy.Def.Color,
		Model = enemy.Model,
		EnemyId = enemy.Def.Id,
	})
	services.ExperienceService.SpawnGem(run, position, enemy.Def.XpReward)
	services.MatchService.MarkHudDirty(run)
end

--[[
	Aplica daño calculado por el servidor. `fromPosition` (opcional) orienta
	el retroceso. Devuelve (murió, daño aplicado).
]]
function EnemyService.Damage(enemy: Enemy, amount: number, fromPosition: Vector3?): (boolean, number)
	if enemy.Dead or enemy.Model.Parent == nil or not enemy.Run.Active then
		return false, 0
	end
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return false, 0
	end
	local dealt = math.min(amount, enemy.Health)
	enemy.Health -= dealt
	enemy.Model:SetAttribute("Health", enemy.Health)
	if enemy.Health <= 0 then
		kill(enemy)
		return true, dealt
	end
	-- Reacción al impacto: retroceso breve. Los enemigos con aplomo no se interrumpen.
	local interruptible = enemy.State == "Chase"
		or enemy.State == "Recover"
		or (enemy.State == "Windup" and not enemy.Def.Poise)
	if interruptible and enemy.Def.Knockback > 0 then
		local away = enemy.Position - (fromPosition or enemy.Run.Root.Position)
		local flat = Vector3.new(away.X, 0, away.Z)
		enemy.KnockDir = if flat.Magnitude > 1e-3 then flat.Unit else Vector3.zero
		if enemy.State == "Windup" then
			-- Ataque cancelado: no vuelve a cargarlo al instante.
			enemy.NextAttackAt = math.max(enemy.NextAttackAt, enemy.Run.State.Elapsed + 0.45)
		end
		enemy.PendingHitAt = nil -- un salto interrumpido no golpea
		setState(enemy, "Stagger", COMBAT.StaggerTime)
	end
	return false, dealt
end

function EnemyService.SetFrozen(run: Run, frozen: boolean)
	local data = byRun[run]
	if data == nil or data.Frozen == frozen then
		return
	end
	data.Frozen = frozen
	for _, enemy in data.List do
		setVelocity(enemy, Vector3.zero)
		-- Los que están emergiendo siguen anclados hasta terminar su aparición.
		enemy.Root.Anchored = frozen or enemy.State == "Spawning"
		if not enemy.Root.Anchored then
			pcall(enemy.Root.SetNetworkOwner, enemy.Root, nil)
		end
	end
end

-- ¿La dirección lleva al vacío? Si es así, prueba a girarla a lo largo del borde.
local function avoidVoid(position: Vector3, direction: Vector3): Vector3
	if direction.Magnitude < 1e-3 then
		return direction
	end
	local lookAhead = 4
	if MapLayout.isWalkable(position + direction * lookAhead, 1) then
		return direction
	end
	for _, angle in AVOID_ANGLES do
		local rotated = (CFrame.Angles(0, angle, 0) * direction)
		if MapLayout.isWalkable(position + rotated * lookAhead, 1) then
			return rotated
		end
	end
	return Vector3.zero
end

local function flatDistance(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- Punto hacia el que caminar: el jugador, o el acceso a su zona si está en otra.
local function navigationTarget(enemy: Enemy, playerPosition: Vector3, playerArea: string): Vector3
	local position = enemy.Position
	local exit = enemy.LinkExit
	if exit then
		if flatDistance(position, exit) < 3 or MapLayout.areaAt(position) == playerArea then
			enemy.LinkExit = nil
		else
			return exit
		end
	end
	local entry, linkExit = MapLayout.route(MapLayout.areaAt(position), playerArea)
	if entry and linkExit then
		-- Ya está sobre el acceso (p. ej. apareció en el puente): sigue hacia la salida.
		if flatDistance(position, entry) < 3 or MapLayout.onLink(position, entry, linkExit, MapLayout.linkWidth(entry)) then
			enemy.LinkExit = linkExit
			return linkExit
		end
		return entry
	end
	return playerPosition
end

-- Factor de velocidad del salto de los slimes (0,35 en el suelo, hasta 1,55 en el aire).
local function hopFactor(enemy: Enemy, now: number): number
	local frequency = enemy.Def.HopFrequency
	if frequency == nil then
		return 1
	end
	local wave = math.sin(TAU * (now * frequency + enemy.HopSeed))
	return 0.35 + 1.2 * math.max(0, wave)
end

local function resolveAttack(enemy: Enemy, playerAlive: boolean, playerPosition: Vector3)
	local run = enemy.Run
	if not playerAlive then
		return
	end
	local offset = playerPosition - enemy.Root.Position
	local flat = Vector3.new(offset.X, 0, offset.Z).Magnitude
	local reach = enemy.Def.HitRange + COMBAT.HitTolerance
	if flat <= reach and math.abs(offset.Y) < COMBAT.MeleeVerticalReach * enemy.Def.Scale then
		services.MatchService.DamagePlayer(run, enemy.Damage)
	end
end

local function stepEnemy(
	enemy: Enemy,
	now: number,
	sNow: number,
	playerAlive: boolean,
	playerPosition: Vector3,
	playerArea: string
)
	local def = enemy.Def
	local position = enemy.Position
	local state = enemy.State

	if state == "Spawning" then
		if now >= enemy.StateUntil then
			enemy.Root.Anchored = false
			pcall(enemy.Root.SetNetworkOwner, enemy.Root, nil)
			setState(enemy, "Chase", 0)
		end
		return
	end
	if not playerAlive then
		setVelocity(enemy, Vector3.zero)
		return
	end

	local offset = playerPosition - position
	local flat = Vector3.new(offset.X, 0, offset.Z)
	local distance = flat.Magnitude

	if state == "Windup" then
		setVelocity(enemy, Vector3.zero)
		if def.AttackKind ~= "Slam" and now < enemy.StateUntil - def.AttackWindup * 0.35 then
			-- Sigue al jugador con la mirada hasta poco antes del golpe.
			enemy.AttackDir = if distance > 1e-3 then flat.Unit else enemy.AttackDir
			face(enemy, enemy.AttackDir)
		end
		if now >= enemy.StateUntil then
			enemy.NextAttackAt = now + def.AttackCooldown
			if def.AttackKind == "Lunge" then
				-- El slime salta primero; el golpe se comprueba al final del salto.
				enemy.PendingHitAt = now + COMBAT.RecoverTime * 0.45
			else
				resolveAttack(enemy, playerAlive, playerPosition)
			end
			setState(enemy, "Recover", COMBAT.RecoverTime)
		end
		return
	end

	if state == "Stagger" then
		local remaining = math.max(0, enemy.StateUntil - now) / COMBAT.StaggerTime
		setVelocity(enemy, avoidVoid(position, enemy.KnockDir) * def.Knockback * remaining)
		if now >= enemy.StateUntil then
			setState(enemy, "Chase", 0)
		end
		return
	end

	-- Ataque: se inicia la anticipación si el jugador está al alcance.
	if
		state == "Chase"
		and distance <= def.AttackRange
		and math.abs(offset.Y) < COMBAT.MeleeVerticalReach * def.Scale
		and now >= enemy.NextAttackAt
	then
		enemy.AttackDir = if distance > 1e-3 then flat.Unit else enemy.AttackDir
		face(enemy, enemy.AttackDir)
		setVelocity(enemy, Vector3.zero)
		setState(enemy, "Windup", def.AttackWindup)
		return
	end

	local speed = enemy.Speed
	if state == "Recover" then
		local pendingHit = enemy.PendingHitAt
		if pendingHit and now >= pendingHit then
			enemy.PendingHitAt = nil
			resolveAttack(enemy, playerAlive, playerPosition)
		end
		if now >= enemy.StateUntil then
			setState(enemy, "Chase", 0)
		elseif enemy.PendingHitAt then
			-- Salto de ataque del slime: impulso corto en la dirección fijada.
			setVelocity(enemy, avoidVoid(position, enemy.AttackDir) * enemy.Speed * 1.6)
			return
		else
			speed *= COMBAT.RecoverSpeedMultiplier
		end
	end

	-- Persecución con detección de atasco (rodea el obstáculo un momento).
	if (position - enemy.LastProgressPosition).Magnitude > COMBAT.StuckDistance or distance <= def.AttackRange then
		enemy.LastProgressPosition = position
		enemy.LastProgressAt = now
	elseif now - enemy.LastProgressAt > COMBAT.StuckWindow then
		enemy.SidestepUntil = now + COMBAT.SidestepDuration
		enemy.SidestepSign = if enemy.Run.Rng:NextNumber() < 0.5 then -1 else 1
		enemy.LastProgressAt = now
		enemy.LastProgressPosition = position
	end

	if distance <= def.AttackRange * 0.4 then
		setVelocity(enemy, Vector3.zero)
		face(enemy, flat)
		return
	end
	local target = navigationTarget(enemy, playerPosition, playerArea)
	local toTarget = Vector3.new(target.X - position.X, 0, target.Z - position.Z)
	local direction = if toTarget.Magnitude > 1e-3 then toTarget.Unit else Vector3.zero
	if now < enemy.SidestepUntil and direction.Magnitude > 0 then
		local perpendicular = Vector3.new(-direction.Z, 0, direction.X) * enemy.SidestepSign
		direction = (direction * 0.35 + perpendicular).Unit
	end
	direction = avoidVoid(position, direction)
	setVelocity(enemy, direction * speed * hopFactor(enemy, sNow))
	face(enemy, if direction.Magnitude > 0 then direction else flat)
end

function EnemyService.Step(run: Run)
	local data = byRun[run]
	if data == nil or data.Frozen or run.State.Phase ~= "Playing" then
		return
	end
	local now = run.State.Elapsed
	if now < data.NextAiAt then
		return
	end
	data.NextAiAt = now + COMBAT.EnemyAiInterval

	-- Retira los cadáveres cuya animación de muerte ha terminado.
	local dying = data.Dying
	for index = #dying, 1, -1 do
		if now >= dying[index].RemoveAt then
			dying[index].Model:Destroy()
			table.remove(dying, index)
		end
	end

	local playerAlive = run.Root.Parent ~= nil and run.Humanoid.Health > 0
	local playerPosition = run.Root.Position
	local playerArea = MapLayout.areaAt(playerPosition)
	local sNow = serverTime()
	local list = data.List

	for index = #list, 1, -1 do
		local enemy = list[index]
		if enemy == nil or enemy.Dead then
			continue
		end
		if enemy.Model.Parent == nil then
			despawn(enemy)
			continue
		end
		enemy.Position = enemy.Root.Position
		if isOutOfBounds(enemy.Position) then
			-- Se cayó o salió del mapa: se elimina sin recompensa.
			despawn(enemy)
			continue
		end
		stepEnemy(enemy, now, sNow, playerAlive, playerPosition, playerArea)
		if run.State.Phase ~= "Playing" then
			return -- un golpe ha terminado la partida
		end
	end
end

function EnemyService.CleanupRun(run: Run)
	local data = byRun[run]
	if data == nil then
		return
	end
	byRun[run] = nil
	for _, enemy in data.List do
		enemy.Dead = true
		enemy.Model:Destroy()
	end
	for _, corpse in data.Dying do
		corpse.Model:Destroy()
	end
	table.clear(data.List)
	table.clear(data.Dying)
end

return EnemyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">ExperienceService</string>
          <string name="Source"><![CDATA[--[[
	ExperienceService
	Fuentes de experiencia del mapa y su recogida:

	• Gemas: aparecen donde muere un enemigo (siempre sobre suelo alcanzable).
	  Una pasada centralizada por partida (PickupCheckInterval) decide:
	    - dentro del radio de imán → la gema empieza a volar hacia el jugador
	      (atributo "Attracting" para que el cliente anime el vuelo),
	    - al llegar (PickupRadius) → se recoge una sola vez y se concede su XP.
	  No caducan; si hay demasiadas, la más antigua se funde en la nueva.
	• Cristales de Esencia (Map/Interactables): se rompen al tocarlos, sueltan
	  varias gemas y vuelven a crecer pasado un tiempo. Premian la exploración.

	Sin Touched ni bucles por gema o cristal.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Net = require(Shared.Net)

local StatSheet = require(script.Parent.Parent.Logic.StatSheet)
local MapLayout = require(script.Parent.Parent.World.MapLayout)
local ServerTypes = require(script.Parent.Parent.ServerTypes)

type Run = ServerTypes.Run
type Gem = ServerTypes.Gem

type RunGems = {
	Gems: { Gem },
	NextCheckAt: number,
}

type Crystal = {
	Model: Model,
	Position: Vector3,
	Ready: boolean,
	RespawnAt: number, -- os.clock()
}

local ExperienceService = {}

local services: ServerTypes.Services
local byRun: { [Run]: RunGems } = {}
local crystals: { Crystal } = {}
local orbsFolder: Folder
local groundParams: RaycastParams

local CFG = GameConfig.Experience
local MAP = GameConfig.Map
local NORMAL_COLOR = Color3.fromRGB(80, 240, 255)
local LUCKY_COLOR = Color3.fromRGB(255, 214, 90)
local TAU = math.pi * 2

local function setCrystalVisible(crystal: Crystal, visible: boolean)
	for _, descendant in crystal.Model:GetDescendants() do
		if descendant:IsA("BasePart") then
			local base = descendant:GetAttribute("BaseTransparency")
			if base == nil then
				base = descendant.Transparency
				descendant:SetAttribute("BaseTransparency", base)
			end
			descendant.Transparency = if visible then base else 1
		elseif descendant:IsA("PointLight") then
			descendant.Enabled = visible
		end
	end
	crystal.Model:SetAttribute("Broken", not visible)
end

function ExperienceService.Init(allServices: ServerTypes.Services)
	services = allServices
	orbsFolder = workspace:WaitForChild("ExperienceOrbs") :: Folder
	local map = workspace:WaitForChild("Map")
	groundParams = RaycastParams.new()
	groundParams.FilterType = Enum.RaycastFilterType.Include
	groundParams.FilterDescendantsInstances = { map:WaitForChild("Ground") }

	local interactables = map:FindFirstChild("Interactables")
	if interactables then
		for _, model in interactables:GetChildren() do
			if model:IsA("Model") and model:GetAttribute("EssenceCrystal") then
				table.insert(crystals, {
					Model = model,
					Position = model:GetPivot().Position,
					Ready = true,
					RespawnAt = 0,
				})
			end
		end
	end
end

function ExperienceService.Start() end

function ExperienceService.SetupRun(run: Run)
	byRun[run] = { Gems = {}, NextCheckAt = 0 }
end

local function raycastGround(position: Vector3): Vector3?
	local result = workspace:Raycast(position + Vector3.new(0, 8, 0), Vector3.new(0, -40, 0), groundParams)
	return result and result.Position
end

-- Posición alcanzable: sobre el suelo de la isla (nunca en el vacío ni dentro de rocas).
local function groundedPosition(position: Vector3): Vector3
	local hit = MapLayout.isWalkable(position, 1) and raycastGround(position)
	if hit then
		return hit + Vector3.new(0, 1.4, 0)
	end
	-- Fuera del suelo: se acerca al centro de la isla hasta encontrarlo.
	local toCenter = Vector3.new(MAP.Center.X - position.X, 0, MAP.Center.Z - position.Z)
	local distance = toCenter.Magnitude
	local direction = if distance > 1e-3 then toCenter.Unit else Vector3.zero
	for step = 4, math.max(4, distance), 4 do
		local candidate = position + direction * step
		if MapLayout.isWalkable(candidate, 1) then
			local found = raycastGround(Vector3.new(candidate.X, MAP.SurfaceY + 10, candidate.Z))
			if found then
				return found + Vector3.new(0, 1.4, 0)
			end
		end
	end
	return Vector3.new(MAP.PlayerSpawn.X, MAP.SurfaceY + 1.4, MAP.PlayerSpawn.Z)
end

local function destroyGem(gem: Gem)
	gem.Collected = true
	gem.Part:Destroy()
end

function ExperienceService.SpawnGem(run: Run, position: Vector3, baseXp: number)
	local data = byRun[run]
	if data == nil or run.State.Phase == "GameOver" then
		return
	end
	local lucky = run.Rng:NextNumber() < StatSheet.luckyGemChance(run.State.Stats)
	local value = baseXp * (if lucky then CFG.LuckyGemMultiplier else 1)

	-- Límite de gemas: la más antigua se funde en la nueva (no se pierde XP).
	if #data.Gems >= CFG.MaxGemsPerRun then
		local oldest = table.remove(data.Gems, 1)
		if oldest then
			value += oldest.Value
			destroyGem(oldest)
		end
	end

	local gemPosition = groundedPosition(position)
	local big = lucky or value >= 3
	local part = Instance.new("Part")
	part.Name = if lucky then "XpGemLucky" else "XpGem"
	part.Size = if big then Vector3.new(1.3, 1.8, 1.3) else Vector3.new(0.9, 1.3, 0.9)
	part.CFrame = CFrame.new(gemPosition) * CFrame.Angles(0, math.rad(45), math.rad(45))
	part.Color = if lucky then LUCKY_COLOR else NORMAL_COLOR
	part.Material = Enum.Material.Neon
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part:SetAttribute("Value", value)
	part.Parent = orbsFolder

	table.insert(data.Gems, {
		Part = part,
		Position = gemPosition,
		Value = value,
		ExpiresAt = if CFG.GemLifetime > 0 then run.State.Elapsed + CFG.GemLifetime else math.huge,
		Collected = false,
		AttractStart = nil,
	})
end

-- Cristales de Esencia: rotura al tocarlos y regeneración.
local function stepCrystals(run: Run, playerPosition: Vector3)
	local cfg = CFG.EssenceCrystal
	local clock = os.clock()
	local radiusSq = cfg.TouchRadius * cfg.TouchRadius
	for _, crystal in crystals do
		if not crystal.Ready then
			if clock >= crystal.RespawnAt then
				crystal.Ready = true
				setCrystalVisible(crystal, true)
			end
			continue
		end
		local offset = crystal.Position - playerPosition
		if offset.X * offset.X + offset.Y * offset.Y + offset.Z * offset.Z > radiusSq then
			continue
		end
		crystal.Ready = false
		crystal.RespawnAt = clock + cfg.RespawnTime
		setCrystalVisible(crystal, false)
		Net.WorldFx:FireAllClients({ Kind = "CrystalBreak", Position = crystal.Position })
		for index = 1, cfg.Gems do
			local angle = (index / cfg.Gems) * TAU + run.Rng:NextNumber() * 0.5
			local distance = 2.5 + run.Rng:NextNumber() * 2.5
			local spot = crystal.Position + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
			ExperienceService.SpawnGem(run, spot, cfg.XpPerGem)
		end
	end
end

function ExperienceService.Step(run: Run)
	local data = byRun[run]
	local state = run.State
	if data == nil or state.Phase ~= "Playing" then
		return
	end
	local now = state.Elapsed
	if now < data.NextCheckAt then
		return
	end
	local dt = CFG.PickupCheckInterval + math.max(0, now - data.NextCheckAt)
	data.NextCheckAt = now + CFG.PickupCheckInterval
	if run.Root.Parent == nil or run.Humanoid.Health <= 0 then
		return
	end

	local playerPosition = run.Root.Position
	local pickupSq = GameConfig.Player.PickupRadius ^ 2
	local magnetSq = StatSheet.magnetRadius(state.Stats) ^ 2
	local gems = data.Gems
	local collectedValue = 0
	local collectedPositions: { Vector3 } = {}

	for index = #gems, 1, -1 do
		local gem = gems[index]
		if gem.Collected or gem.Part.Parent == nil then
			table.remove(gems, index)
			continue
		elseif now >= gem.ExpiresAt then
			destroyGem(gem)
			table.remove(gems, index)
			continue
		end
		local offset = playerPosition - gem.Position
		local distSq = offset.X * offset.X + offset.Y * offset.Y + offset.Z * offset.Z
		if gem.AttractStart == nil and distSq <= magnetSq then
			-- Empieza a volar hacia el jugador (el cliente anima el vuelo).
			gem.AttractStart = now
			gem.Part:SetAttribute("Attracting", true)
		end
		local attractStart = gem.AttractStart
		if attractStart then
			local t = now - attractStart
			local speed = CFG.AttractSpeed + CFG.AttractAcceleration * t
			local distance = math.sqrt(distSq)
			local advance = math.min(distance, speed * dt)
			if distance > 1e-3 then
				gem.Position += offset / distance * advance
			end
			offset = playerPosition - gem.Position
			distSq = offset.X * offset.X + offset.Y * offset.Y + offset.Z * offset.Z
		end
		if distSq <= pickupSq then
			-- Se marca y elimina antes de conceder: una gema = una concesión.
			destroyGem(gem)
			table.remove(gems, index)
			collectedValue += gem.Value
			table.insert(collectedPositions, gem.Position)
		end
	end

	if collectedValue > 0 then
		Net.GemCollected:FireClient(run.Player, { Positions = collectedPositions, Value = collectedValue })
		services.LevelService.GrantExperience(run, collectedValue)
	end
	if #crystals > 0 and state.Phase == "Playing" then
		stepCrystals(run, playerPosition)
	end
end

function ExperienceService.CleanupRun(run: Run)
	local data = byRun[run]
	if data == nil then
		return
	end
	byRun[run] = nil
	for _, gem in data.Gems do
		destroyGem(gem)
	end
	table.clear(data.Gems)
end

return ExperienceService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">LevelService</string>
          <string name="Source"><![CDATA[--[[
	LevelService
	Punto único para conceder experiencia. Aplica el bonus de XP, procesa
	subidas de nivel múltiples y pide a UpgradeService que abra la oferta.
	El cliente nunca indica cuánta experiencia ha obtenido.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage.Shared.Net)
local RunState = require(script.Parent.Parent.Logic.RunState)
local ServerTypes = require(script.Parent.Parent.ServerTypes)

type Run = ServerTypes.Run

local LevelService = {}

local services: ServerTypes.Services
-- Instante (tiempo de partida) de cada subida de nivel: lo usa el informe de depuración.
local levelTimes: { [Run]: { string } } = setmetatable({}, { __mode = "k" }) :: any

function LevelService.GetLevelTimes(run: Run): { string }
	return levelTimes[run] or {}
end

function LevelService.Init(allServices: ServerTypes.Services)
	services = allServices
end

function LevelService.Start() end

-- `baseAmount` lo calcula siempre el servidor (valor de las gemas recogidas).
function LevelService.GrantExperience(run: Run, baseAmount: number)
	if not run.Active then
		return
	end
	local gained = RunState.grantXp(run.State, baseAmount)
	services.MatchService.MarkHudDirty(run)
	if gained > 0 then
		local times = levelTimes[run] or {}
		levelTimes[run] = times
		table.insert(times, string.format("Nv%d@%.0fs", run.State.Progress.Level, run.State.Elapsed))
		Net.LevelUp:FireClient(run.Player, {
			Level = run.State.Progress.Level,
			Gained = gained,
		})
		services.UpgradeService.TryOpenOffer(run)
	end
end

return LevelService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">MatchService</string>
          <string name="Source"><![CDATA[--[[
	MatchService  (el "RunService" del diseño; renombrado para no confundirlo
	con game:GetService("RunService") de Roblox)

	Responsabilidades:
	  • Crear, pausar, terminar y reiniciar partidas (una por jugador).
	  • Bucle centralizado del servidor: un único Heartbeat que avanza todas
	    las partidas y llama a Combat/Enemy/Spawn/Experience.
	  • Vida del jugador: daño recibido, caída al vacío y derrota.
	  • Envío del HUD al cliente (agrupado y limitado en frecuencia).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Progression = require(Shared.Progression)
local VisualConfig = require(Shared.Config.VisualConfig)
local Net = require(Shared.Net)
local Types = require(Shared.Types)

local Logic = script.Parent.Parent.Logic
local RunState = require(Logic.RunState)
local StatSheet = require(Logic.StatSheet)
local RateLimiter = require(Logic.RateLimiter)
local ModelFactory = require(script.Parent.Parent.World.ModelFactory)
local ServerTypes = require(script.Parent.Parent.ServerTypes)

type Run = ServerTypes.Run

local MatchService = {}

-- Marcadores del MicroProfiler (no existen fuera de Roblox, p. ej. en las pruebas con Lune).
local profileBegin = debug.profilebegin or function(_label: string) end
local profileEnd = debug.profileend or function() end

local services: ServerTypes.Services
local runs: { [Player]: Run } = {}
local starting: { [Player]: boolean } = {}
local readyLimiter = RateLimiter.new(GameConfig.RateLimits.ClientReady.Max, GameConfig.RateLimits.ClientReady.Window)
local restartLimiter =
	RateLimiter.new(GameConfig.RateLimits.RequestRestart.Max, GameConfig.RateLimits.RequestRestart.Window)

local function disconnectAll(connections: { RBXScriptConnection })
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
end

local function setCharacterCollisionGroup(character: Model)
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = "Players"
		end
	end
end

--[[
	Paquete de animaciones del personaje (VisualConfig.PlayerAnimations, de
	Roblox). Se cambian los AnimationId del script Animate estándar, que recarga
	sus pistas al detectar el cambio. Solo R15 (los ids son de R15).
]]
local function applyAnimationPack(character: Model, humanoid: Humanoid)
	if humanoid.RigType ~= Enum.HumanoidRigType.R15 then
		return
	end
	local animate = character:FindFirstChild("Animate")
	if animate == nil then
		return
	end
	for stateName, animations in VisualConfig.PlayerAnimations do
		local state = animate:FindFirstChild(stateName)
		if state then
			for animationName, id in animations do
				local animation = state:FindFirstChild(animationName)
				if animation and animation:IsA("Animation") then
					animation.AnimationId = id
				end
			end
		end
	end
end

function MatchService.Init(allServices: ServerTypes.Services)
	services = allServices
end

function MatchService.GetRun(player: Player): Run?
	return runs[player]
end

function MatchService.MarkHudDirty(run: Run)
	run.HudDirty = true
end

function MatchService.BuildHudSnapshot(run: Run): Types.HudSnapshot
	local state = run.State
	local humanoid = run.Humanoid
	local primary = state.Weapons[1]
	return {
		Phase = state.Phase,
		Level = state.Progress.Level,
		Xp = state.Progress.Xp,
		XpToNext = Progression.xpToNext(state.Progress.Level),
		Health = humanoid.Health,
		MaxHealth = humanoid.MaxHealth,
		Kills = state.Kills,
		Elapsed = state.Elapsed,
		Stats = StatSheet.summary(state.Stats, primary and primary.Def),
	}
end

local function sendHud(run: Run)
	run.HudDirty = false
	run.LastHudSentAt = os.clock()
	Net.HudUpdate:FireClient(run.Player, MatchService.BuildHudSnapshot(run))
end

--[[
	Aplica al personaje las estadísticas derivadas (vida máxima y velocidad).
	Si la vida máxima sube, cura la diferencia; `healPct` cura además un
	porcentaje de la vida máxima (mejora Bendición del Cielo).
]]
function MatchService.ApplyStats(run: Run, healPct: number?)
	local humanoid = run.Humanoid
	if humanoid.Health <= 0 then
		return
	end
	local stats = run.State.Stats
	local newMax = StatSheet.maxHealth(stats)
	local oldMax = humanoid.MaxHealth
	local health = humanoid.Health
	humanoid.MaxHealth = newMax
	if newMax > oldMax then
		health += newMax - oldMax
	end
	if healPct and healPct > 0 then
		health += newMax * healPct
	end
	humanoid.Health = math.clamp(health, 1, newMax)
	humanoid.WalkSpeed = StatSheet.walkSpeed(stats)
	run.HudDirty = true
end

-- Pausa lógica real: congela al jugador, a los enemigos, la aparición y el reloj.
function MatchService.SetPaused(run: Run, paused: boolean)
	if run.Paused == paused then
		return
	end
	run.Paused = paused
	if run.Root.Parent and run.Humanoid.Health > 0 then
		run.Root.Anchored = paused
	end
	services.EnemyService.SetFrozen(run, paused)
end

--[[
	Daño al jugador. Solo el servidor lo llama (contacto de enemigos o caídas);
	aplica la reducción de Piel de Piedra salvo que `ignoreReduction` sea true.
]]
function MatchService.DamagePlayer(run: Run, rawDamage: number, ignoreReduction: boolean?): boolean
	if not run.Active or run.State.Phase ~= "Playing" then
		return false
	end
	local humanoid = run.Humanoid
	if humanoid.Health <= 0 then
		return false
	end
	if not ignoreReduction and run.State.Elapsed < run.InvulnerableUntil then
		return false
	end
	local amount = if ignoreReduction then rawDamage else StatSheet.damageTaken(run.State.Stats, rawDamage)
	if amount <= 0 then
		return false
	end
	humanoid.Health = math.max(0, humanoid.Health - amount)
	if not ignoreReduction then
		run.InvulnerableUntil =
			math.max(run.InvulnerableUntil, run.State.Elapsed + GameConfig.Player.HitInvulnerability)
	end
	Net.PlayerDamaged:FireClient(run.Player, {
		Amount = amount,
		Health = humanoid.Health,
		MaxHealth = humanoid.MaxHealth,
	})
	run.HudDirty = true
	return true
end

local function cleanupRun(run: Run)
	if not run.Active then
		return
	end
	run.Active = false
	disconnectAll(run.Connections)
	services.CombatService.CleanupRun(run)
	services.SpawnService.CleanupRun(run)
	services.EnemyService.CleanupRun(run)
	services.ExperienceService.CleanupRun(run)
end

-- Termina la partida (derrota). Idempotente: una muerte solo se procesa una vez.
function MatchService.EndRun(run: Run, reason: string)
	if not RunState.setGameOver(run.State) then
		return
	end
	run.EndedAt = os.clock()
	if run.Paused then
		run.Paused = false
		if run.Root.Parent then
			run.Root.Anchored = false
		end
	end
	-- Los enemigos quedan congelados detrás de la pantalla de derrota.
	services.EnemyService.SetFrozen(run, true)
	sendHud(run)
	Net.GameOver:FireClient(run.Player, {
		Elapsed = run.State.Elapsed,
		Kills = run.State.Kills,
		Level = run.State.Progress.Level,
		Reason = reason,
	})
	task.delay(GameConfig.Match.CleanupDelay, function()
		if runs[run.Player] == run then
			cleanupRun(run)
		end
	end)
end

function MatchService.StartRun(player: Player)
	if starting[player] or player.Parent ~= Players then
		return
	end
	starting[player] = true

	local previous = runs[player]
	if previous then
		cleanupRun(previous)
		runs[player] = nil
	end

	local ok, err = pcall(function()
		player:LoadCharacter()
	end)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not ok or not character or not humanoid or not root or player.Parent ~= Players then
		warn("[MatchService] No se pudo cargar el personaje de", player.Name, err)
		starting[player] = nil
		return
	end

	local run: Run = {
		Player = player,
		State = RunState.new(GameConfig.Player.StartingWeapons),
		Active = true,
		Character = character,
		Humanoid = humanoid,
		Root = root :: BasePart,
		Connections = {},
		Rng = Random.new(),
		Paused = false,
		InvulnerableUntil = 0,
		HudDirty = true,
		LastHudSentAt = 0,
		NextFallCheckAt = 0,
		NextRegenAt = 0,
		EndedAt = nil,
	}

	humanoid.MaxHealth = StatSheet.maxHealth(run.State.Stats)
	humanoid.Health = humanoid.MaxHealth
	humanoid.WalkSpeed = StatSheet.walkSpeed(run.State.Stats)
	setCharacterCollisionGroup(character)
	applyAnimationPack(character, humanoid)
	-- Espada del Vendaval visible en la mano (solo decorativa: el daño lo calcula CombatService).
	local hand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	if hand and hand:IsA("BasePart") then
		ModelFactory.attachGaleSword(character, hand)
	end

	table.insert(
		run.Connections,
		humanoid.Died:Connect(function()
			MatchService.EndRun(run, "Died")
		end)
	)
	table.insert(
		run.Connections,
		character.DescendantAdded:Connect(function(descendant)
			if descendant:IsA("BasePart") then
				descendant.CollisionGroup = "Players"
			end
		end)
	)
	table.insert(
		run.Connections,
		character.AncestryChanged:Connect(function(_, parent)
			-- El personaje ha desaparecido (p. ej. destruido por el motor): derrota.
			if parent == nil and run.State.Phase ~= "GameOver" then
				MatchService.EndRun(run, "CharacterRemoved")
			end
		end)
	)

	runs[player] = run
	services.SpawnService.SetupRun(run)
	services.EnemyService.SetupRun(run)
	services.ExperienceService.SetupRun(run)
	services.CombatService.SetupRun(run)
	starting[player] = nil
	sendHud(run)
end

-- Savia Vital: regeneración periódica en tiempo de partida.
local function regenerate(run: Run)
	local regen = run.State.Stats.HealthRegen
	if regen <= 0 or run.State.Elapsed < run.NextRegenAt then
		return
	end
	local interval = GameConfig.Match.RegenInterval
	run.NextRegenAt = run.State.Elapsed + interval
	local humanoid = run.Humanoid
	if humanoid.Health > 0 and humanoid.Health < humanoid.MaxHealth then
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + regen * interval)
		run.HudDirty = true
	end
end

-- Caída fuera del mapa: reaparición controlada con penalización de vida.
local function checkFall(run: Run)
	if run.State.Elapsed < run.NextFallCheckAt then
		return
	end
	run.NextFallCheckAt = run.State.Elapsed + GameConfig.Match.FallCheckInterval
	local root = run.Root
	if root.Parent == nil or run.Humanoid.Health <= 0 then
		return
	end
	if root.Position.Y >= GameConfig.Map.KillY then
		return
	end
	local spawnPosition = GameConfig.Map.PlayerSpawn + Vector3.new(0, 3, 0)
	run.Character:PivotTo(CFrame.new(spawnPosition))
	root.AssemblyLinearVelocity = Vector3.zero
	MatchService.DamagePlayer(run, run.Humanoid.MaxHealth * GameConfig.Player.FallDamagePct, true)
	run.InvulnerableUntil = run.State.Elapsed + GameConfig.Player.FallInvulnerability
end

local function step(dt: number)
	profileBegin("SkyBonk.ServerStep")
	local now = os.clock()
	for _, run in runs do
		if not run.Active then
			continue
		end
		local state = run.State
		if state.Phase == "Playing" then
			RunState.advance(state, dt)
			services.CombatService.Step(run)
			services.SpawnService.Step(run)
			services.EnemyService.Step(run)
			services.ExperienceService.Step(run)
			if state.Phase == "Playing" then
				checkFall(run)
				regenerate(run)
			end
			-- El tiempo cambia en cada frame; el HUD lo extrapola en el cliente.
		end
		if run.Active and run.HudDirty and now - run.LastHudSentAt >= GameConfig.Match.HudSendInterval then
			sendHud(run)
		end
	end
	profileEnd()
end

local function onPlayerAdded(player: Player)
	-- Si el cliente no avisa a tiempo, la partida empieza igualmente.
	task.delay(GameConfig.Match.ClientReadyTimeout, function()
		if player.Parent == Players and runs[player] == nil then
			MatchService.StartRun(player)
		end
	end)
end

local function onPlayerRemoving(player: Player)
	local run = runs[player]
	if run then
		cleanupRun(run)
		runs[player] = nil
	end
	starting[player] = nil
	readyLimiter:Forget(player)
	restartLimiter:Forget(player)
	services.UpgradeService.ForgetPlayer(player)
end

function MatchService.Start()
	Players.CharacterAutoLoads = false

	Net.ClientReady.OnServerEvent:Connect(function(player: Player)
		if not readyLimiter:Allow(player) then
			return
		end
		local run = runs[player]
		if run == nil then
			MatchService.StartRun(player)
		elseif run.Active then
			-- Resincroniza la interfaz (p. ej. si el cliente se recargó).
			sendHud(run)
			services.UpgradeService.ResendOffer(run)
		end
	end)

	Net.RequestRestart.OnServerEvent:Connect(function(player: Player)
		if not restartLimiter:Allow(player) then
			return
		end
		local run = runs[player]
		if run ~= nil then
			if run.State.Phase ~= "GameOver" then
				return -- no se puede reiniciar una partida en curso
			end
			if os.clock() - (run.EndedAt or 0) < GameConfig.Match.RestartCooldown then
				return
			end
		end
		MatchService.StartRun(player)
	end)

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end

	RunService.Heartbeat:Connect(step)
end

return MatchService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">SpawnService</string>
          <string name="Source"><![CDATA[--[[
	SpawnService
	Aparición controlada de enemigos alrededor del jugador:
	  • a una distancia entre MinRadius y MaxRadius (nunca encima del jugador),
	  • solo sobre suelo de la isla (raycast contra Map/Ground) y lejos del borde
	    (World/MapLayout), incluidos mesetas, puente y santuario,
	  • respetando el límite de enemigos activos y el de cada tipo,
	  • con intervalo, tamaño de oleada, tipos y estadísticas que escalan con el tiempo,
	  • con un periodo de gracia corto, una primera oleada para entrar en acción
	    enseguida, y detenida fuera de Playing.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local ServerTypes = require(script.Parent.Parent.ServerTypes)
local MapLayout = require(script.Parent.Parent.World.MapLayout)

type Run = ServerTypes.Run

local SpawnService = {}

local services: ServerTypes.Services
local nextSpawnAt: { [Run]: number } = {}
local openingDone: { [Run]: boolean } = {}
local groundFolder: Instance
local raycastParams: RaycastParams

local TAU = math.pi * 2
local CFG = GameConfig.Spawn
local MAP = GameConfig.Map

function SpawnService.Init(allServices: ServerTypes.Services)
	services = allServices
	local map = workspace:WaitForChild("Map")
	groundFolder = map:WaitForChild("Ground")
	raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Include
	raycastParams.FilterDescendantsInstances = { groundFolder, map:WaitForChild("Props") }
	raycastParams.IgnoreWater = true
end

function SpawnService.Start() end

function SpawnService.SetupRun(run: Run)
	nextSpawnAt[run] = CFG.GracePeriod
	openingDone[run] = false
end

function SpawnService.CleanupRun(run: Run)
	nextSpawnAt[run] = nil
	openingDone[run] = nil
end

-- Multiplicadores de dificultad según los minutos de partida.
function SpawnService.DifficultyAt(elapsed: number)
	local m = elapsed / 60
	local difficulty = GameConfig.Difficulty
	return {
		Health = 1 + difficulty.HealthLinear * m + difficulty.HealthQuadratic * m * m,
		Damage = 1 + difficulty.DamageLinear * m + difficulty.DamageQuadratic * m * m,
		Speed = math.min(difficulty.MaxSpeedMultiplier, 1 + difficulty.SpeedPerMinute * m),
	}
end

function SpawnService.IntervalAt(elapsed: number): number
	local minutes = elapsed / 60
	return math.max(CFG.MinInterval, CFG.InitialInterval * CFG.IntervalMultiplierPerMinute ^ minutes)
end

function SpawnService.BatchAt(elapsed: number): number
	local minutes = elapsed / 60
	return math.clamp(math.floor(CFG.InitialBatch + CFG.BatchGrowthPerMinute * minutes), 1, CFG.MaxBatch)
end

-- Tipo de enemigo según el minuto de partida (pesos de GameConfig.Spawn.EnemyTypes).
function SpawnService.PickEnemyType(run: Run, elapsed: number): string?
	local minutes = elapsed / 60
	local total = 0
	local weights: { number } = {}
	for index, entry in CFG.EnemyTypes do
		local weight = 0
		if minutes >= entry.FromMinute then
			local alive = services.EnemyService.CountOfType(run, entry.Id)
			if entry.MaxAlive == nil or alive < entry.MaxAlive then
				weight = entry.Weight + entry.WeightPerMinute * (minutes - entry.FromMinute)
			end
		end
		weights[index] = weight
		total += weight
	end
	if total <= 0 then
		return nil
	end
	local roll = run.Rng:NextNumber() * total
	for index, entry in CFG.EnemyTypes do
		roll -= weights[index]
		if roll < 0 then
			return entry.Id
		end
	end
	return CFG.EnemyTypes[1].Id
end

-- Busca un punto del suelo válido; devuelve nil si ningún intento es válido.
-- Si alrededor casi todo es vacío (santuario, puente), lo intenta más cerca.
function SpawnService.FindSpawnPosition(run: Run): Vector3?
	return SpawnService.TrySpawnPosition(run, CFG.MinRadius, CFG.MaxRadius)
		or SpawnService.TrySpawnPosition(run, CFG.MinRadius * 0.55, CFG.MinRadius)
end

function SpawnService.TrySpawnPosition(run: Run, minRadius: number, maxRadius: number): Vector3?
	local origin = run.Root.Position
	for _ = 1, CFG.Attempts do
		local angle = run.Rng:NextNumber() * TAU
		local distance = run.Rng:NextNumber(minRadius, maxRadius)
		local candidate = origin + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
		local dx, dz = candidate.X - MAP.Center.X, candidate.Z - MAP.Center.Z
		if dx * dx + dz * dz > MAP.BoundsRadius * MAP.BoundsRadius then
			continue
		end
		if not MapLayout.isWalkable(candidate, CFG.EdgeMargin) then
			continue
		end
		local rayOrigin = Vector3.new(candidate.X, MAP.SurfaceY + 60, candidate.Z)
		local result = workspace:Raycast(rayOrigin, Vector3.new(0, -120, 0), raycastParams)
		-- Debe caer sobre suelo (no sobre ruinas, árboles o rocas).
		if result and result.Instance:IsDescendantOf(groundFolder) then
			local position = result.Position
			local fromPlayer = Vector3.new(position.X - origin.X, 0, position.Z - origin.Z)
			if fromPlayer.Magnitude >= minRadius * 0.9 then
				return position
			end
		end
	end
	return nil
end

-- Tope de enemigos activos en este momento de la partida.
function SpawnService.CapAt(elapsed: number): number
	return math.min(CFG.MaxActiveEnemies, math.floor(CFG.MaxActiveStart + CFG.MaxActivePerMinute * elapsed / 60))
end

local function spawnBatch(run: Run, count: number, now: number)
	local enemyService = services.EnemyService
	local multipliers = SpawnService.DifficultyAt(now)
	local cap = SpawnService.CapAt(now)
	for _ = 1, count do
		if enemyService.Count(run) >= cap then
			break
		end
		local enemyType = SpawnService.PickEnemyType(run, now)
		local position = enemyType and SpawnService.FindSpawnPosition(run)
		if enemyType == nil or position == nil then
			break
		end
		enemyService.Spawn(run, enemyType, position, multipliers)
	end
end

function SpawnService.Step(run: Run)
	local state = run.State
	local scheduled = nextSpawnAt[run]
	if scheduled == nil or state.Phase ~= "Playing" or run.Humanoid.Health <= 0 then
		return
	end
	local now = state.Elapsed
	if now < scheduled then
		return
	end
	nextSpawnAt[run] = now + SpawnService.IntervalAt(now)
	local count = SpawnService.BatchAt(now)
	if not openingDone[run] then
		openingDone[run] = true
		count = math.max(count, CFG.OpeningWave)
	end
	spawnBatch(run, count, now)
end

return SpawnService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">UpgradeService</string>
          <string name="Source"><![CDATA[--[[
	UpgradeService
	Abre las ofertas de mejoras (una por nivel pendiente, sin superponerse),
	valida las elecciones del cliente y aplica sus efectos.

	Protocolo:
	  1. Servidor -> UpgradeOffer { Token, Level, Options = { {Id, CurrentLevel, NextLevel} } }
	  2. Cliente  -> ChooseUpgrade(Token, Id)      (solo identificadores)
	  3. Servidor valida tipo, frecuencia, estado de la partida, token y opción.
	  4. Servidor aplica la mejora, cierra la oferta y responde UpgradeResolved.
	  5. Si quedan niveles pendientes se abre la siguiente oferta; si no, se
	     reanuda la partida.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Net = require(Shared.Net)

local Logic = script.Parent.Parent.Logic
local RunState = require(Logic.RunState)
local RateLimiter = require(Logic.RateLimiter)
local Validation = require(Logic.Validation)
local ServerTypes = require(script.Parent.Parent.ServerTypes)

type Run = ServerTypes.Run

local UpgradeService = {}

local services: ServerTypes.Services
local chooseLimiter = RateLimiter.new(GameConfig.RateLimits.ChooseUpgrade.Max, GameConfig.RateLimits.ChooseUpgrade.Window)

function UpgradeService.Init(allServices: ServerTypes.Services)
	services = allServices
end

-- Abre la siguiente oferta si procede. Devuelve true si hay una oferta abierta.
function UpgradeService.TryOpenOffer(run: Run): boolean
	if not run.Active then
		return false
	end
	local offer = RunState.tryOpenOffer(run.State, run.Rng)
	if offer == nil then
		return run.State.ActiveOffer ~= nil
	end
	services.MatchService.SetPaused(run, true)
	Net.UpgradeOffer:FireClient(run.Player, RunState.offerPayload(run.State, offer))
	services.MatchService.MarkHudDirty(run)
	return true
end

-- Reenvía la oferta activa (si el cliente recargó su interfaz).
function UpgradeService.ResendOffer(run: Run)
	local offer = run.State.ActiveOffer
	if offer and not offer.Consumed then
		Net.UpgradeOffer:FireClient(run.Player, RunState.offerPayload(run.State, offer))
	end
end

function UpgradeService.ForgetPlayer(player: Player)
	chooseLimiter:Forget(player)
end

local function onChooseUpgrade(player: Player, token: any, upgradeId: any)
	if not chooseLimiter:Allow(player) then
		return
	end
	-- Tipos inválidos: petición manipulada, se ignora sin respuesta.
	if not Validation.isPositiveInteger(token) or not Validation.isIdentifier(upgradeId, 40) then
		warn(string.format("[UpgradeService] Elección malformada de %s rechazada", player.Name))
		return
	end
	local run = services.MatchService.GetRun(player)
	if run == nil or not run.Active then
		return
	end

	local ok, result = RunState.choose(run.State, token, upgradeId)
	if not ok then
		Net.UpgradeResolved:FireClient(player, { Token = token, Accepted = false, Reason = result })
		return
	end

	services.MatchService.ApplyStats(run, result.HealPct)
	Net.UpgradeResolved:FireClient(player, {
		Token = token,
		Accepted = true,
		UpgradeId = upgradeId,
		NewLevel = run.State.UpgradeLevels[upgradeId],
	})

	-- Encadena la siguiente oferta si se ganaron varios niveles a la vez.
	if not UpgradeService.TryOpenOffer(run) then
		services.MatchService.SetPaused(run, false)
	end
	services.MatchService.MarkHudDirty(run)
end

-- Solo depuración en Studio: elige la opción `index` de la oferta activa por
-- la misma ruta validada que una petición del cliente.
function UpgradeService.DebugChoose(player: Player, index: number)
	local run = services.MatchService.GetRun(player)
	local offer = run and run.State.ActiveOffer
	if offer and offer.Options[index] then
		onChooseUpgrade(player, offer.Token, offer.Options[index])
	end
end

function UpgradeService.Start()
	Net.ChooseUpgrade.OnServerEvent:Connect(onChooseUpgrade)
end

return UpgradeService
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="48">
      <Properties>
        <string name="Name">Tests</string>
      </Properties>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">Progression.spec</string>
          <string name="Source"><![CDATA[-- Prueba D (curva y niveles): experiencia sobrante, varios niveles, sin duplicados.
local Shared = game:GetService("ReplicatedStorage").Shared
local Progression = require(Shared.Progression)
local LevelLogic = require(script.Parent.Parent.Logic.LevelLogic)

return function(it, expect)
	it("la curva inicial es 9, 12, 18, 26 y sigue creciendo cada vez más", function()
		expect.equal(Progression.xpToNext(1), 9)
		expect.equal(Progression.xpToNext(2), 12)
		expect.equal(Progression.xpToNext(3), 18)
		expect.equal(Progression.xpToNext(4), 26)
		-- La curva se ralentiza: el salto entre niveles altos es mayor que al principio.
		expect.truthy(
			Progression.xpToNext(15) - Progression.xpToNext(14) > Progression.xpToNext(3) - Progression.xpToNext(2)
		)
		local previous = Progression.xpToNext(3)
		for level = 4, 60 do
			local required = Progression.xpToNext(level)
			expect.truthy(required > previous, "la curva debe crecer en el nivel " .. level)
			previous = required
		end
	end)

	it("sube de nivel al alcanzar el umbral y conserva la experiencia sobrante", function()
		local progress = LevelLogic.new()
		expect.equal(LevelLogic.addXp(progress, 8), 0)
		expect.equal(progress.Level, 1)
		expect.equal(LevelLogic.addXp(progress, 3), 1) -- 11 XP: 9 para subir, sobran 2
		expect.equal(progress.Level, 2)
		expect.equal(progress.Xp, 2)
		expect.equal(#progress.PendingLevels, 1)
		expect.equal(progress.PendingLevels[1], 2)
	end)

	it("procesa varios niveles con una sola concesión grande", function()
		local progress = LevelLogic.new()
		-- 9 + 12 + 18 = 39 -> nivel 4 con 1 de sobra
		expect.equal(LevelLogic.addXp(progress, 40), 3)
		expect.equal(progress.Level, 4)
		expect.equal(progress.Xp, 1)
		expect.equal(#progress.PendingLevels, 3)
		expect.equal(LevelLogic.popPendingLevel(progress), 2)
		expect.equal(LevelLogic.popPendingLevel(progress), 3)
		expect.equal(LevelLogic.popPendingLevel(progress), 4)
		expect.equal(LevelLogic.popPendingLevel(progress), nil)
	end)

	it("rechaza cantidades inválidas (negativas, NaN, infinito)", function()
		local progress = LevelLogic.new()
		expect.equal(LevelLogic.addXp(progress, -10), 0)
		expect.equal(LevelLogic.addXp(progress, 0 / 0), 0)
		expect.equal(LevelLogic.addXp(progress, 0), 0)
		expect.equal(progress.Xp, 0)
		-- math.huge se acota a MaxXpPerGrant en lugar de bloquear el servidor.
		LevelLogic.addXp(progress, math.huge)
		expect.truthy(progress.Level > 1 and progress.Level < 1000, "nivel acotado")
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">TestRunner</string>
          <string name="Source"><![CDATA[--[[
	TestRunner
	Microframework de pruebas que funciona igual en Roblox Studio (al iniciar el
	servidor, ver Bootstrap) y fuera de Roblox con Lune (tests/run.luau).

	Cada módulo *.spec devuelve function(it, expect).
]]

local TestRunner = {}

local function format(value: any): string
	if type(value) == "string" then
		return string.format("%q", value)
	end
	return tostring(value)
end

local expect = {}

function expect.equal(actual: any, expected: any, message: string?)
	if actual ~= expected then
		error(string.format("%sse esperaba %s, se obtuvo %s", message and (message .. ": ") or "", format(expected), format(actual)), 2)
	end
end

function expect.near(actual: number, expected: number, epsilon: number?, message: string?)
	if type(actual) ~= "number" or math.abs(actual - expected) > (epsilon or 1e-6) then
		error(string.format("%sse esperaba ≈%s, se obtuvo %s", message and (message .. ": ") or "", format(expected), format(actual)), 2)
	end
end

function expect.truthy(value: any, message: string?)
	if not value then
		error((message or "se esperaba un valor verdadero") .. ", se obtuvo " .. format(value), 2)
	end
end

function expect.falsy(value: any, message: string?)
	if value then
		error((message or "se esperaba un valor falso") .. ", se obtuvo " .. format(value), 2)
	end
end

TestRunner.expect = expect

export type Report = { Passed: number, Failed: number, Failures: { string } }

function TestRunner.runSpec(name: string, spec: (any, any) -> (), report: Report)
	local cases: { { name: string, fn: () -> () } } = {}
	spec(function(caseName: string, fn: () -> ())
		table.insert(cases, { name = caseName, fn = fn })
	end, expect)
	for _, case in cases do
		local ok, err = pcall(case.fn)
		if ok then
			report.Passed += 1
			print(string.format("  ✔ %s › %s", name, case.name))
		else
			report.Failed += 1
			local line = string.format("  ✘ %s › %s\n      %s", name, case.name, tostring(err))
			table.insert(report.Failures, line)
			print(line)
		end
	end
end

-- `folder` es una instancia (o un nodo simulado en Lune) con hijos *.spec.
function TestRunner.runFolder(folder: any): Report
	local report: Report = { Passed = 0, Failed = 0, Failures = {} }
	local children = folder:GetChildren()
	table.sort(children, function(a, b)
		return a.Name < b.Name
	end)
	for _, child in children do
		if string.sub(child.Name, -5) == ".spec" then
			local ok, spec = pcall(require, child)
			if ok and type(spec) == "function" then
				TestRunner.runSpec(string.sub(child.Name, 1, -6), spec, report)
			else
				report.Failed += 1
				local line = "  ✘ " .. child.Name .. " no se pudo cargar: " .. tostring(spec)
				table.insert(report.Failures, line)
				print(line)
			end
		end
	end
	print(string.format("[SkyBonk Tests] %d correctas, %d fallidas", report.Passed, report.Failed))
	return report
end

return TestRunner
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">Upgrades.spec</string>
          <string name="Source"><![CDATA[-- Pruebas D, E y G (ofertas, aplicación de mejoras y validación de elecciones).
local Shared = game:GetService("ReplicatedStorage").Shared
local UpgradeConfig = require(Shared.Config.UpgradeConfig)
local WeaponConfig = require(Shared.Config.WeaponConfig)
local Logic = script.Parent.Parent.Logic
local RunState = require(Logic.RunState)
local StatSheet = require(Logic.StatSheet)
local UpgradeLogic = require(Logic.UpgradeLogic)

-- Generador determinista (LCG) con la interfaz de Random:NextNumber().
local function makeRng(seed: number)
	local state = seed
	return {
		NextNumber = function(_self)
			state = (state * 1103515245 + 12345) % 2147483648
			return state / 2147483648
		end,
	}
end

local function newRunWithLevels(levels: number)
	local state = RunState.new({ "GaleSword" })
	local total = 0
	for level = 1, levels do
		total += require(Shared.Progression).xpToNext(level)
	end
	RunState.grantXp(state, total)
	return state
end

return function(it, expect)
	it("todas las mejoras habilitadas tienen efectos reales y datos completos", function()
		for _, def in UpgradeConfig.List do
			expect.truthy(def.DisplayName ~= "" and def.Description ~= "", def.Id .. " sin textos")
			expect.truthy(UpgradeConfig.Rarities[def.Rarity] ~= nil, def.Id .. " rareza inválida")
			if def.Enabled ~= false then
				expect.truthy(#def.Effects > 0, def.Id .. " no hace nada")
			end
		end
		-- 14 mejoras (13 activas + Impulso Arcano desactivada) + el comodín.
		expect.equal(#UpgradeConfig.List, 15)
		for _, def in UpgradeConfig.List do
			expect.truthy(UpgradeConfig.Categories[def.Category] ~= nil, def.Id .. " sin categoría visual")
		end
	end)

	it("una oferta tiene tres opciones distintas y válidas (1000 tiradas)", function()
		local rng = makeRng(42)
		for _ = 1, 1000 do
			local state = RunState.new({ "GaleSword" })
			local options = UpgradeLogic.rollOptions({
				Stats = state.Stats,
				Weapons = state.Weapons,
				UpgradeLevels = state.UpgradeLevels,
			}, rng)
			expect.equal(#options, 3)
			local seen = {}
			for _, id in options do
				expect.falsy(seen[id], "opción repetida " .. id)
				seen[id] = true
				local def = UpgradeConfig.ById[id]
				expect.truthy(def and def.Enabled ~= false, "opción no seleccionable " .. id)
				expect.falsy(def.IsFallback, "no debe ofrecer comodines con opciones de sobra")
			end
		end
	end)

	it("Impulso Arcano (sin mecánica en Fase 1) nunca se ofrece", function()
		local rng = makeRng(7)
		local state = RunState.new({ "GaleSword" })
		for _ = 1, 2000 do
			local options = UpgradeLogic.rollOptions({
				Stats = state.Stats,
				Weapons = state.Weapons,
				UpgradeLevels = state.UpgradeLevels,
			}, rng)
			expect.falsy(table.find(options, "ArcaneImpulse"), "se ofreció ArcaneImpulse")
		end
	end)

	it("las mejoras al nivel máximo dejan de ofrecerse y se completa con el comodín", function()
		local state = RunState.new({ "GaleSword" })
		-- Agota todo menos dos mejoras.
		for _, def in UpgradeConfig.List do
			if def.MaxLevel and def.Id ~= "SharpEdge" and def.Id ~= "HawkSteps" then
				state.UpgradeLevels[def.Id] = def.MaxLevel
			end
		end
		local options = UpgradeLogic.rollOptions({
			Stats = state.Stats,
			Weapons = state.Weapons,
			UpgradeLevels = state.UpgradeLevels,
		}, makeRng(1))
		expect.equal(#options, 3)
		expect.truthy(table.find(options, "SharpEdge"))
		expect.truthy(table.find(options, "HawkSteps"))
		expect.truthy(table.find(options, "SkyBlessing"), "debe completarse con el comodín")
	end)

	it("Hoja Doble deja de ofrecerse cuando el arma alcanza su máximo de proyectiles", function()
		local state = RunState.new({ "GaleSword" })
		state.Stats.ExtraProjectiles = WeaponConfig.GaleSword.MaxProjectiles - 1
		local ctx = { Stats = state.Stats, Weapons = state.Weapons, UpgradeLevels = state.UpgradeLevels }
		expect.falsy(UpgradeLogic.isEligible(UpgradeConfig.ById.TwinBlade, ctx))
		state.Stats.ExtraProjectiles = 0
		expect.truthy(UpgradeLogic.isEligible(UpgradeConfig.ById.TwinBlade, ctx))
	end)

	it("la Suerte aumenta el peso de las rarezas Rara y Épica", function()
		local epic = UpgradeConfig.ById.TwinBlade
		local common = UpgradeConfig.ById.SharpEdge
		expect.truthy(UpgradeLogic.weightOf(epic, 3) > UpgradeLogic.weightOf(epic, 0))
		expect.equal(UpgradeLogic.weightOf(common, 3), UpgradeLogic.weightOf(common, 0))
	end)

	it("subir de nivel abre una oferta vinculada al nivel y pausa la partida", function()
		local state = newRunWithLevels(1)
		expect.equal(state.Progress.Level, 2)
		local offer = RunState.tryOpenOffer(state, makeRng(3))
		expect.truthy(offer, "debe abrirse una oferta")
		expect.equal(offer.Level, 2)
		expect.equal(state.Phase, "ChoosingUpgrade")
		-- No se superponen ofertas.
		expect.equal(RunState.tryOpenOffer(state, makeRng(3)), nil)
		-- El reloj de partida no avanza en pausa.
		RunState.advance(state, 5)
		expect.equal(state.Elapsed, 0)
	end)

	it("aplicar una mejora cambia realmente la estadística", function()
		local cases = {
			SharpEdge = function(s)
				return StatSheet.weaponStats(s, WeaponConfig.GaleSword).Damage
			end,
			SwiftStrike = function(s)
				return StatSheet.weaponStats(s, WeaponConfig.GaleSword).Cooldown
			end,
			AstralReach = function(s)
				return StatSheet.weaponStats(s, WeaponConfig.GaleSword).Range
			end,
			BasaltHeart = StatSheet.maxHealth,
			HawkSteps = StatSheet.walkSpeed,
			ConcentratedEssence = function(s)
				return StatSheet.xpGain(s, 10)
			end,
			StoneSkin = function(s)
				return StatSheet.damageTaken(s, 10)
			end,
			CelestialFortune = StatSheet.luckyGemChance,
			TwinBlade = function(s)
				return StatSheet.weaponStats(s, WeaponConfig.GaleSword).Projectiles
			end,
			StormEdge = function(s)
				return StatSheet.weaponStats(s, WeaponConfig.GaleSword).TargetsPerProjectile
			end,
			KeenStrike = function(s)
				return StatSheet.weaponStats(s, WeaponConfig.GaleSword).CritChance
			end,
			VitalSap = function(s)
				return s.HealthRegen
			end,
			CelestialMagnet = StatSheet.magnetRadius,
		}
		local expected = {
			SharpEdge = 15 * 1.2,
			SwiftStrike = 1.0 * 0.88,
			AstralReach = 30 * 1.2,
			BasaltHeart = 120,
			HawkSteps = 20 * 1.12,
			ConcentratedEssence = 12,
			StoneSkin = 9,
			TwinBlade = 2,
			StormEdge = 2,
			KeenStrike = 0.12,
			VitalSap = 1,
			CelestialMagnet = 11 * 1.35,
		}
		for id, measure in cases do
			local state = newRunWithLevels(1)
			local before = measure(state.Stats)
			local offer = RunState.tryOpenOffer(state, makeRng(9))
			-- Fuerza la opción a probar dentro de la oferta activa.
			offer.Options[1] = id
			local ok, result = RunState.choose(state, offer.Token, id)
			expect.truthy(ok, "elección rechazada: " .. id .. " " .. tostring(result))
			local after = measure(state.Stats)
			expect.truthy(after ~= before, id .. " no cambió la estadística")
			if expected[id] then
				expect.near(after, expected[id], 1e-6, id)
			end
			expect.equal(state.UpgradeLevels[id], 1)
			expect.equal(state.Phase, "Playing")
		end
	end)

	it("el comodín devuelve una curación del 30 %", function()
		local state = newRunWithLevels(1)
		local offer = RunState.tryOpenOffer(state, makeRng(5))
		offer.Options[1] = "SkyBlessing"
		local ok, result = RunState.choose(state, offer.Token, "SkyBlessing")
		expect.truthy(ok)
		expect.near(result.HealPct, 0.3)
	end)

	it("rechaza selecciones inventadas, fuera de tiempo y repetidas", function()
		local state = newRunWithLevels(2) -- dos niveles pendientes
		-- Fuera de tiempo: aún no hay oferta.
		state.Phase = "Playing"
		local ok, reason = RunState.choose(state, 1, "SharpEdge")
		expect.falsy(ok)
		expect.equal(reason, "NotChoosing")

		local offer = RunState.tryOpenOffer(state, makeRng(11))
		local notOffered
		for _, def in UpgradeConfig.List do
			if not table.find(offer.Options, def.Id) then
				notOffered = def.Id
				break
			end
		end

		ok, reason = RunState.choose(state, offer.Token, "HackDeLaMuerte")
		expect.falsy(ok)
		expect.equal(reason, "NotOffered")
		ok, reason = RunState.choose(state, offer.Token, notOffered)
		expect.falsy(ok)
		expect.equal(reason, "NotOffered")
		ok, reason = RunState.choose(state, offer.Token + 1, offer.Options[1])
		expect.falsy(ok)
		expect.equal(reason, "StaleToken")
		ok, reason = RunState.choose(state, tostring(offer.Token), offer.Options[1])
		expect.falsy(ok)
		ok, reason = RunState.choose(state, offer.Token, { offer.Options[1] })
		expect.falsy(ok)

		-- Elección válida.
		local chosen = offer.Options[1]
		ok = RunState.choose(state, offer.Token, chosen)
		expect.truthy(ok)
		expect.equal(state.UpgradeLevels[chosen], 1)

		-- Repetir la misma petición no duplica el efecto.
		ok, reason = RunState.choose(state, offer.Token, chosen)
		expect.falsy(ok)
		expect.equal(state.UpgradeLevels[chosen], 1)

		-- Segundo nivel pendiente: nueva oferta con token nuevo; el antiguo no sirve.
		local second = RunState.tryOpenOffer(state, makeRng(12))
		expect.truthy(second)
		expect.equal(second.Level, 3)
		expect.truthy(second.Token ~= offer.Token)
		ok, reason = RunState.choose(state, offer.Token, second.Options[1])
		expect.falsy(ok)
		expect.equal(reason, "StaleToken")
		expect.equal(RunState.tryOpenOffer(state, makeRng(13)), nil)
	end)

	it("tras la derrota no se conceden experiencia, muertes ni elecciones", function()
		local state = newRunWithLevels(1)
		local offer = RunState.tryOpenOffer(state, makeRng(2))
		expect.truthy(RunState.setGameOver(state))
		expect.falsy(RunState.setGameOver(state), "la derrota solo se procesa una vez")
		local ok = RunState.choose(state, offer.Token, offer.Options[1])
		expect.falsy(ok)
		expect.equal(RunState.grantXp(state, 100), 0)
		RunState.addKill(state)
		expect.equal(state.Kills, 0)
	end)
	it("hasta el nivel 4 cada oferta incluye al menos una mejora de Ataque", function()
		local rng = makeRng(7)
		for level = 2, 4 do
			for _ = 1, 300 do
				local state = RunState.new({ "GaleSword" })
				local options = UpgradeLogic.rollOptions({
					Stats = state.Stats,
					Weapons = state.Weapons,
					UpgradeLevels = state.UpgradeLevels,
				}, rng, nil, level)
				local attack = false
				for _, id in options do
					if UpgradeConfig.ById[id].Category == "Ataque" then
						attack = true
					end
				end
				expect.truthy(attack, "oferta del nivel " .. level .. " sin mejora de Ataque")
				expect.equal(#options, 3)
			end
		end
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">Utilities.spec</string>
          <string name="Source"><![CDATA[-- Prueba B (selección de objetivos) y G (validación y límite de frecuencia).
local Logic = script.Parent.Parent.Logic
local Targeting = require(Logic.Targeting)
local RateLimiter = require(Logic.RateLimiter)
local Validation = require(Logic.Validation)

return function(it, expect)
	it("elige los objetivos vivos más cercanos dentro del alcance", function()
		local enemies = {
			{ Name = "lejos", Position = Vector3.new(40, 0, 0), Dead = false },
			{ Name = "cerca", Position = Vector3.new(5, 0, 0), Dead = false },
			{ Name = "muerto", Position = Vector3.new(1, 0, 0), Dead = true },
			{ Name = "medio", Position = Vector3.new(0, 0, 12), Dead = false },
			{ Name = "borde", Position = Vector3.new(0, 0, -27.9), Dead = false },
		}
		local one = Targeting.nearest(enemies, Vector3.zero, 28, 1)
		expect.equal(#one, 1)
		expect.equal(one[1].Name, "cerca")

		local many = Targeting.nearest(enemies, Vector3.zero, 28, 10)
		expect.equal(#many, 3, "solo 3 válidos dentro del alcance")
		expect.equal(many[1].Name, "cerca")
		expect.equal(many[2].Name, "medio")
		expect.equal(many[3].Name, "borde")

		local filtered = Targeting.nearest(enemies, Vector3.zero, 28, 2, function(e)
			return e.Name ~= "cerca"
		end)
		expect.equal(filtered[1].Name, "medio")
		expect.equal(#Targeting.nearest(enemies, Vector3.zero, 28, 0), 0)
		expect.equal(#Targeting.nearest({}, Vector3.zero, 28, 3), 0)
	end)

	it("el limitador de frecuencia bloquea el spam y se recupera tras la ventana", function()
		local now = 0
		local limiter = RateLimiter.new(3, 1, function()
			return now
		end)
		expect.truthy(limiter:Allow("p"))
		expect.truthy(limiter:Allow("p"))
		expect.truthy(limiter:Allow("p"))
		expect.falsy(limiter:Allow("p"), "la cuarta petición debe rechazarse")
		expect.truthy(limiter:Allow("otro"), "las claves son independientes")
		now = 1.01
		expect.truthy(limiter:Allow("p"))
		limiter:Forget("p")
		expect.truthy(limiter:Allow("p"))
	end)

	it("valida los tipos de los argumentos remotos", function()
		expect.truthy(Validation.isPositiveInteger(3))
		expect.falsy(Validation.isPositiveInteger(0))
		expect.falsy(Validation.isPositiveInteger(1.5))
		expect.falsy(Validation.isPositiveInteger(0 / 0))
		expect.falsy(Validation.isPositiveInteger(math.huge))
		expect.falsy(Validation.isPositiveInteger("3"))
		expect.truthy(Validation.isIdentifier("SharpEdge"))
		expect.falsy(Validation.isIdentifier(""))
		expect.falsy(Validation.isIdentifier("Sharp Edge"))
		expect.falsy(Validation.isIdentifier(string.rep("a", 100)))
		expect.falsy(Validation.isIdentifier({}))
		expect.falsy(Validation.isIdentifier(nil))
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">World.spec</string>
          <string name="Source"><![CDATA[-- Prueba A (mapa válido) y comprobaciones de la plantilla del enemigo.
local Shared = game:GetService("ReplicatedStorage").Shared
local GameConfig = require(Shared.Config.GameConfig)
local EnemyConfig = require(Shared.Config.EnemyConfig)
local MapBuilder = require(script.Parent.Parent.World.MapBuilder)
local ModelFactory = require(script.Parent.Parent.World.ModelFactory)
local MapLayout = require(script.Parent.Parent.World.MapLayout)

local function countParts(root: Instance): (number, number)
	local total, colliding = 0, 0
	for _, descendant in root:GetDescendants() do
		if descendant:IsA("BasePart") then
			total += 1
			if descendant.CanCollide then
				colliding += 1
			end
		end
	end
	return total, colliding
end

return function(it, expect)
	it("el mapa tiene suelo, zona de aparición y un número de piezas ligero", function()
		local holder = Instance.new("Folder")
		local map = MapBuilder.build(holder)
		local ground = map:FindFirstChild("Ground")
		expect.truthy(ground, "falta Ground")
		expect.truthy(map:FindFirstChild("Props"), "falta Props")
		expect.truthy(map:FindFirstChild("Decor"), "falta Decor")
		local spawn = ground:FindFirstChild("PlayerSpawn")
		expect.truthy(spawn and spawn:IsA("SpawnLocation"), "falta SpawnLocation")
		local offset = spawn.CFrame.Position - GameConfig.Map.PlayerSpawn
		expect.truthy(math.abs(offset.X) < 0.01 and math.abs(offset.Z) < 0.01, "spawn desplazado")

		local total = countParts(map)
		expect.truthy(total > 300, "mapa demasiado vacío: " .. total)
		-- Presupuesto para móvil: piezas ancladas y simples (sin contar el kit, que son mallas).
		expect.truthy(total < 1500, "demasiadas piezas para móvil: " .. total)

		for _, descendant in map:GetDescendants() do
			if descendant:IsA("BasePart") then
				expect.truthy(descendant.Anchored, descendant:GetFullName() .. " no anclada")
			end
		end
		for _, descendant in map.Decor:GetDescendants() do
			if descendant:IsA("BasePart") then
				expect.falsy(descendant.CanCollide, descendant.Name .. " decorativa con colisión")
				expect.falsy(descendant.CanQuery, descendant.Name .. " decorativa consultable")
			end
		end

		-- Cada punto que MapLayout considera caminable tiene suelo debajo (raycast real).
		-- (solo en Studio: fuera de Roblox no hay raycast real)
		if RaycastParams and workspace and workspace.Raycast then
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Include
			params.FilterDescendantsInstances = { ground }
			holder.Parent = workspace
			local misses = 0
			for x = -110, 110, 10 do
				for z = -110, 150, 10 do
					local point = Vector3.new(x, 0, z)
					if MapLayout.isWalkable(point, 2) then
						local hit = workspace:Raycast(point + Vector3.new(0, 30, 0), Vector3.new(0, -60, 0), params)
						if hit == nil then
							misses += 1
						end
					end
				end
			end
			expect.equal(misses, 0, "puntos caminables sin suelo")
		end
		expect.truthy(map:FindFirstChild("Interactables"), "faltan los Cristales de Esencia")
		expect.equal(#map.Interactables:GetChildren(), #MapLayout.EssenceCrystals)
		holder:Destroy()
	end)

	it("la plantilla del Slime del Vacío tiene todas las piezas necesarias", function()
		local def = EnemyConfig.VoidSlime
		local model = ModelFactory.Builders[def.Rig](def)
		local root = model:FindFirstChild("Root")
		expect.truthy(root and model.PrimaryPart == root, "Root no es PrimaryPart")
		expect.truthy(root:FindFirstChild("RootAttachment"))
		expect.truthy(root:FindFirstChild("Mover"))
		expect.truthy(root:FindFirstChild("Facing"))
		local bar = root:FindFirstChild("HealthBar")
		expect.truthy(bar and bar:FindFirstChild("Back") and bar.Back:FindFirstChild("Fill"), "falta barra de vida")
		local body = model:FindFirstChild("Body")
		expect.truthy(body and body:FindFirstChild("BodyWeld") and body:FindFirstChild("BodyMesh"))
		local total, colliding = countParts(model)
		expect.equal(colliding, 1, "solo Root debe colisionar")
		expect.truthy(total <= 10, "demasiadas piezas por enemigo: " .. total)
		model:Destroy()
	end)
	it("la navegación sube a las mesetas por su acceso y cruza el puente en ambos sentidos", function()
		local entry, exit = MapLayout.route("Main", "Ruins")
		expect.truthy(entry and exit, "sin acceso a las Ruinas")
		expect.truthy(MapLayout.onMainIsland(entry :: Vector3, 0), "la entrada de la rampa no está en la isla")
		expect.equal(MapLayout.areaAt(exit :: Vector3), "Ruins")
		-- Bajar de una meseta: en línea recta.
		expect.equal(MapLayout.route("Ruins", "Main"), nil)
		local toSanctuary = MapLayout.route("Main", "Sanctuary")
		local fromSanctuary = MapLayout.route("Sanctuary", "Main")
		expect.truthy(toSanctuary and fromSanctuary, "el puente debe usarse en ambos sentidos")
		-- De una meseta al santuario se pasa por la isla principal (sin recursión infinita).
		expect.equal(MapLayout.route("Ruins", "Sanctuary"), nil)
		expect.truthy(MapLayout.route("Lookout", "Ruins") == nil)
		for _, crystal in MapLayout.EssenceCrystals do
			expect.truthy(MapLayout.isWalkable(crystal, 0), "cristal fuera del suelo")
		end
		-- Fuera de la isla no hay suelo.
		expect.truthy(MapLayout.isWalkable(Vector3.new(0, 1, 80), 0), "el puente debe ser caminable")
		expect.falsy(MapLayout.isWalkable(Vector3.new(25, 0, 80), 0), "vacío junto al puente marcado como suelo")
		expect.falsy(MapLayout.isWalkable(Vector3.new(150, 0, 0), 0))
	end)

	it("todas las criaturas tienen plantilla y ataques que se pueden esquivar", function()
		for id, def in EnemyConfig do
			local model = ModelFactory.Builders[def.Rig](def)
			local root = model:FindFirstChild("Root")
			expect.truthy(root and model.PrimaryPart == root, id .. ": Root no es PrimaryPart")
			expect.truthy(
				root:FindFirstChild("Mover") and root:FindFirstChild("Facing"),
				id .. ": falta la base física"
			)
			expect.truthy(def.AttackWindup >= 0.3, id .. ": anticipación demasiado corta para reaccionar")
			expect.truthy(def.HitRange > 0 and def.AttackRange > 0, id .. ": alcances inválidos")
			expect.truthy(def.XpReward >= 1, id .. ": sin experiencia")
			local _, colliding = countParts(model)
			expect.equal(colliding, 1, id .. ": solo Root debe colisionar")
			model:Destroy()
		end
	end)
end
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="54">
      <Properties>
        <string name="Name">World</string>
      </Properties>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--[[
	MapBuilder
	Construye la isla flotante a partir de World/MapLayout. Es determinista
	(semilla en GameConfig.Map.Seed).

	Composición (de dentro afuera):
	  • Plaza Rúnica (centro, aparición): losas, anillo rúnico y pilares con cristales.
	  • Ruinas del Alba (NE): meseta +7 con templo en ruinas; rampa y escalones.
	  • Colina del Viento (NO): colina caminable por todos sus lados.
	  • Bosque Cristalino (SO): árboles, setas, cristales y un estanque.
	  • Jardín de Piedra (SE): agujas de roca y el Mirador (+8) con rampa.
	  • Santuario Flotante (S): isla secundaria unida por un puente colgante.
	  • Cristales de Esencia en las zonas elevadas y alejadas (fuente de XP).
	  • Debajo: acantilados escalonados; alrededor: rocas flotantes y nubes.

	Vegetación y rocas: kit de ServerStorage/SkyBonkAssets/MapKit (modelos de
	Creator Store revisados, sin scripts). Sus mallas no colisionan; cada pieza
	sólida lleva un colisionador simple e invisible en Props, así los enemigos
	no se enganchan en las hojas y las colisiones son predecibles. Si falta el
	kit (pruebas fuera de Studio), se usan formas simples de piezas.

	Jerarquía generada:
	  Map/
	    Ground/        superficies caminables (válidas para generar enemigos)
	    Props/         obstáculos sólidos y colisionadores
	    Decor/         elementos sin colisión
	    Interactables/ Cristales de Esencia (ExperienceService)
	    PlayerSpawn (SpawnLocation, dentro de Ground)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local MapLayout = require(script.Parent.MapLayout)
local VisualConfig = require(ReplicatedStorage.Shared.Config.VisualConfig)

local MapBuilder = {}

local TAU = math.pi * 2
local SURFACE_Y = MapLayout.SurfaceY

local PALETTE = {
	Grass = Color3.fromRGB(116, 190, 88),
	GrassAlt = Color3.fromRGB(104, 178, 82),
	GrassDark = Color3.fromRGB(86, 156, 74),
	Rim = Color3.fromRGB(214, 196, 140),
	Rock1 = Color3.fromRGB(146, 126, 110),
	Rock2 = Color3.fromRGB(122, 104, 94),
	Rock3 = Color3.fromRGB(102, 88, 86),
	Rock4 = Color3.fromRGB(84, 72, 78),
	Rock5 = Color3.fromRGB(66, 58, 68),
	Cliff = Color3.fromRGB(150, 132, 112),
	Stone = Color3.fromRGB(220, 208, 186),
	StoneDark = Color3.fromRGB(170, 158, 142),
	Path = Color3.fromRGB(196, 184, 160),
	Wood = Color3.fromRGB(140, 96, 62),
	WoodDark = Color3.fromRGB(104, 70, 48),
	Rope = Color3.fromRGB(210, 190, 140),
	Trunk = Color3.fromRGB(122, 84, 58),
	Leaf1 = Color3.fromRGB(70, 150, 84),
	Leaf2 = Color3.fromRGB(96, 178, 92),
	Cloud = Color3.fromRGB(248, 250, 255),
	Water = Color3.fromRGB(96, 190, 255),
	CrystalCyan = Color3.fromRGB(98, 232, 255),
	CrystalViolet = Color3.fromRGB(178, 120, 255),
	CrystalPink = Color3.fromRGB(255, 132, 214),
	Essence = Color3.fromRGB(255, 196, 92),
	Rune = Color3.fromRGB(140, 230, 255),
}

-- Generador congruencial determinista (independiente de Random para poder
-- ejecutar este módulo también fuera de Roblox en las pruebas).
local function makeRng(seed: number)
	local state = seed % 2147483647
	if state <= 0 then
		state += 2147483646
	end
	local rng = {}
	function rng.next(): number
		state = (state * 48271) % 2147483647
		return state / 2147483647
	end
	function rng.range(min: number, max: number): number
		return min + (max - min) * rng.next()
	end
	function rng.pick<T>(list: { T }): T
		return list[math.floor(rng.next() * #list) + 1]
	end
	return rng
end

local function newPart(className: string, props: { [string]: any }, parent: Instance): BasePart
	local part = Instance.new(className) :: BasePart
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		(part :: any)[key] = value
	end
	part.Parent = parent
	return part
end

-- Elemento sin colisión ni consultas (no afecta a la física ni a los raycasts).
local function decorProps(props: { [string]: any }): { [string]: any }
	props.CanCollide = false
	props.CanQuery = false
	props.CanTouch = false
	return props
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

--[[
	Capa poligonal: N bloques que, unidos, forman un polígono regular de
	circunradio `radius` centrado en `center`. Cada bloque va del centro a la
	apotema y su cara exterior es un lado del polígono (aspecto facetado).
]]
local function polygonLayer(
	folder: Instance,
	name: string,
	center: Vector3,
	sides: number,
	radius: number,
	topY: number,
	thickness: number,
	color: Color3,
	angleOffset: number,
	material: Enum.Material?
)
	local apothem = radius * math.cos(math.pi / sides)
	local side = 2 * radius * math.sin(math.pi / sides)
	for i = 0, sides - 1 do
		local angle = angleOffset + i * TAU / sides
		local direction = Vector3.new(-math.sin(angle), 0, -math.cos(angle))
		local position = Vector3.new(center.X, topY - thickness / 2, center.Z) + direction * (apothem / 2)
		newPart("Part", {
			Name = string.format("%s_%02d", name, i + 1),
			Size = Vector3.new(side + 0.05, thickness, apothem),
			CFrame = CFrame.new(position) * CFrame.Angles(0, angle, 0),
			Color = color,
			Material = material or Enum.Material.SmoothPlastic,
		}, folder)
	end
end

-- Cuerpo rocoso invertido bajo una superficie poligonal (silueta de isla flotante).
local function cliffs(props: Instance, name: string, center: Vector3, radius: number, topY: number, rng)
	local layers = {
		{ 0.96, 5, 9, PALETTE.Rock1, 9 },
		{ 0.78, 13, 11, PALETTE.Rock2, 8 },
		{ 0.55, 23, 13, PALETTE.Rock3, 7 },
		{ 0.32, 35, 14, PALETTE.Rock4, 6 },
		{ 0.14, 47, 12, PALETTE.Rock5, 5 },
	}
	for index, layer in layers do
		local offset = Vector3.new(rng.range(-2, 2), 0, rng.range(-2, 2)) * index
		polygonLayer(
			props,
			string.format("%sCliff%d", name, index),
			center + offset,
			layer[5],
			radius * layer[1],
			topY - layer[2] + layer[3] / 2,
			layer[3],
			layer[4],
			rng.range(0, TAU)
		)
	end
end

------------------------------------------------------------------- Kit
type KitSpec = {
	Asset: string,
	Scale: { number }, -- rango de escala
	-- Trunk: cilindro (Radius en studs, Height en studs a escala media).
	-- Box: caja orientada (Radius y Height son fracciones del tamaño del modelo).
	Collider: { Kind: string, Radius: number, Height: number }?,
	Fallback: string, -- forma simple si falta el kit
}

local KIT: { [string]: KitSpec } = {
	TreeRound = {
		Asset = "Tree_Round",
		Scale = { 0.5, 0.65 },
		Collider = { Kind = "Trunk", Radius = 1.4, Height = 12 },
		Fallback = "Tree",
	},
	TreeTwist = {
		Asset = "Tree_Twist",
		Scale = { 0.55, 0.7 },
		Collider = { Kind = "Trunk", Radius = 1.2, Height = 10 },
		Fallback = "Tree",
	},
	TreePine = {
		Asset = "Tree_Pine",
		Scale = { 0.3, 0.42 },
		Collider = { Kind = "Trunk", Radius = 2.2, Height = 14 },
		Fallback = "Tree",
	},
	TreeBlossom = {
		Asset = "Tree_Blossom",
		Scale = { 0.85, 1.1 },
		Collider = { Kind = "Trunk", Radius = 0.9, Height = 8 },
		Fallback = "Tree",
	},
	TreeNormal = {
		Asset = "Tree_Normal",
		Scale = { 0.6, 0.8 },
		Collider = { Kind = "Trunk", Radius = 1.6, Height = 9 },
		Fallback = "Tree",
	},
	TreeDead = {
		Asset = "Tree_Dead",
		Scale = { 0.55, 0.7 },
		Collider = { Kind = "Trunk", Radius = 0.8, Height = 8 },
		Fallback = "Tree",
	},
	BushBig = { Asset = "Bush_Big", Scale = { 0.6, 0.85 }, Collider = nil, Fallback = "Bush" },
	BushSmall = { Asset = "Bush_Small", Scale = { 0.9, 1.3 }, Collider = nil, Fallback = "Bush" },
	GrassA = { Asset = "Grass_A", Scale = { 0.6, 0.9 }, Collider = nil, Fallback = "None" },
	GrassB = { Asset = "Grass_B", Scale = { 0.8, 1.2 }, Collider = nil, Fallback = "None" },
	GrassC = { Asset = "Grass_C", Scale = { 1, 1.5 }, Collider = nil, Fallback = "None" },
	Mushrooms = { Asset = "Mushrooms", Scale = { 0.6, 0.9 }, Collider = nil, Fallback = "None" },
	Log = {
		Asset = "Log",
		Scale = { 0.8, 1 },
		Collider = { Kind = "Box", Radius = 0.85, Height = 0.75 },
		Fallback = "Rock",
	},
	Boulder = {
		Asset = "Boulder_A",
		Scale = { 0.8, 1.3 },
		Collider = { Kind = "Box", Radius = 0.8, Height = 0.8 },
		Fallback = "Rock",
	},
	Rock = {
		Asset = "Rock_",
		Scale = { 0.7, 1.2 },
		Collider = { Kind = "Box", Radius = 0.8, Height = 0.85 },
		Fallback = "Rock",
	},
	Spire = {
		Asset = "Rock_",
		Scale = { 1.25, 1.75 },
		Collider = { Kind = "Box", Radius = 0.72, Height = 0.9 },
		Fallback = "Rock",
	},
}

local kitFolder: Instance? = nil
-- Si se fija, las rocas del kit usan este color (Jardín Corrompido).
local rockTintOverride: Color3? = nil

local function findKit(): Instance?
	local ok, serverStorage = pcall(function()
		return game:GetService("ServerStorage")
	end)
	local assets = ok and serverStorage and serverStorage:FindFirstChild("SkyBonkAssets")
	return assets and assets:FindFirstChild("MapKit")
end

local function fallbackShape(kind: string, position: Vector3, scale: number, yaw: number, decor: Instance, rng)
	if kind == "Tree" then
		newPart(
			"Part",
			decorProps({
				Name = "TreeTrunk",
				Size = Vector3.new(1.6, 7, 1.6) * scale * 1.5,
				CFrame = CFrame.new(position + Vector3.new(0, 5 * scale, 0)) * CFrame.Angles(0, yaw, 0),
				Color = PALETTE.Trunk,
			}),
			decor
		)
		newPart(
			"Part",
			decorProps({
				Name = "TreeCanopy",
				Size = Vector3.new(7, 5.5, 7) * scale * 1.5,
				CFrame = CFrame.new(position + Vector3.new(0, 11 * scale, 0)) * CFrame.Angles(0.2, yaw, 0.3),
				Color = rng.pick({ PALETTE.Leaf1, PALETTE.Leaf2 }),
			}),
			decor
		)
	elseif kind == "Bush" then
		newPart(
			"Part",
			decorProps({
				Name = "Bush",
				Size = Vector3.new(3, 2.2, 3) * scale,
				CFrame = CFrame.new(position + Vector3.new(0, 0.9 * scale, 0)) * CFrame.Angles(0, yaw, 0.2),
				Color = PALETTE.Leaf2,
			}),
			decor
		)
	elseif kind == "Rock" then
		newPart(
			"Part",
			decorProps({
				Name = "Rock",
				Size = Vector3.new(4, 3.4, 4.4) * scale,
				CFrame = CFrame.new(position + Vector3.new(0, 1.2 * scale, 0)) * CFrame.Angles(0.3, yaw, 0.25),
				Color = rng.pick({ PALETTE.Rock1, PALETTE.Rock2 }),
			}),
			decor
		)
	end
end

--[[
	Coloca una pieza del kit apoyada en `position` (base). Devuelve el tamaño
	aproximado ocupado. Los colisionadores van a Props (sólidos y consultables).
]]
local function placeKit(kind: string, position: Vector3, rng, decor: Instance, props: Instance, scaleMul: number?)
	local spec = KIT[kind]
	local scale = rng.range(spec.Scale[1], spec.Scale[2]) * (scaleMul or 1)
	local yaw = rng.range(0, TAU)
	local template: Instance? = nil
	if kitFolder then
		if spec.Asset == "Rock_" then
			template = kitFolder:FindFirstChild("Rock_" .. (math.floor(rng.next() * 10) + 1))
		else
			template = kitFolder:FindFirstChild(spec.Asset)
		end
	end
	local size = Vector3.new(4, 4, 4) * scale
	if template and template:IsA("Model") then
		local model = template:Clone()
		if scale ~= 1 then
			model:ScaleTo(scale)
		end
		model:PivotTo(CFrame.new(position) * CFrame.Angles(0, yaw, 0))
		if spec.Fallback == "Rock" then
			-- Las rocas del pack son blanco azuladas: se tiñen con la paleta cálida de la isla.
			local tint = rockTintOverride
				or rng.pick({ PALETTE.Rock1, PALETTE.Rock2, PALETTE.Cliff, PALETTE.StoneDark })
			for _, part in model:GetDescendants() do
				if part:IsA("MeshPart") and part.TextureID == "" then
					part.Color = tint
					part.Material = Enum.Material.Slate
				end
			end
		end
		local baseSize = template:GetAttribute("BaseSize")
		if typeof(baseSize) == "Vector3" then
			size = baseSize * scale
		end
		-- Para el atenuado por oclusión del cliente (AmbientController).
		model:SetAttribute("KitRadius", math.max(size.X, size.Z) / 2)
		model:SetAttribute("KitHeight", size.Y)
		model.Parent = decor
	else
		fallbackShape(spec.Fallback, position, scale, yaw, decor, rng)
	end
	local collider = spec.Collider
	if collider then
		if collider.Kind == "Trunk" then
			local height = collider.Height * scale / (spec.Scale[1] + spec.Scale[2]) * 2
			newPart("Part", {
				Name = kind .. "Collider",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(height, collider.Radius * 2, collider.Radius * 2),
				CFrame = CFrame.new(position + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2),
				Transparency = 1,
				CastShadow = false,
			}, props)
		else
			-- Caja orientada como el modelo: Radius y Height son fracciones de su tamaño.
			local height = size.Y * collider.Height
			newPart("Part", {
				Name = kind .. "Collider",
				Size = Vector3.new(size.X * collider.Radius, height, size.Z * collider.Radius),
				CFrame = CFrame.new(position + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, yaw, 0),
				Transparency = 1,
				CastShadow = false,
			}, props)
		end
	end
	return size
end

-- Zonas que deben quedar libres (plaza, rampas, puente, accesos).
local clearZones: { { Center: Vector3, Radius: number } } = {}

local function isClear(position: Vector3, radius: number): boolean
	for _, zone in clearZones do
		if (flat(position) - flat(zone.Center)).Magnitude < zone.Radius + radius then
			return false
		end
	end
	return true
end

local function reserve(center: Vector3, radius: number)
	table.insert(clearZones, { Center = center, Radius = radius })
end

local function reserveSegment(a: Vector3, b: Vector3, radius: number)
	local length = (flat(b) - flat(a)).Magnitude
	local steps = math.max(1, math.ceil(length / radius))
	for i = 0, steps do
		reserve(a:Lerp(b, i / steps), radius)
	end
end

-- Esparce piezas del kit alrededor de un centro sin invadir zonas libres.
local function scatter(
	kinds: { string },
	center: Vector3,
	minR: number,
	maxR: number,
	count: number,
	spacing: number,
	rng,
	decor,
	props,
	baseY: number?
)
	local placed = 0
	local attempts = 0
	while placed < count and attempts < count * 8 do
		attempts += 1
		local angle = rng.range(0, TAU)
		local distance = rng.range(minR, maxR)
		local position = Vector3.new(
			center.X + math.cos(angle) * distance,
			baseY or SURFACE_Y,
			center.Z + math.sin(angle) * distance
		)
		if not MapLayout.isWalkable(position, 3) or not isClear(position, spacing) then
			continue
		end
		local inMesa = false
		for _, mesa in MapLayout.Mesas do
			if
				(flat(position) - flat(mesa.Center)).Magnitude
				< mesa.Radius + (if mesa.Ramped then mesa.Height * 2.4 else 1)
			then
				inMesa = true
			end
		end
		if inMesa and baseY == nil then
			continue
		end
		placeKit(rng.pick(kinds), position, rng, decor, props)
		reserve(position, spacing * 0.5)
		placed += 1
	end
end

------------------------------------------------------------- Elementos
local function buildCrystalCluster(
	parent: Instance,
	name: string,
	base: Vector3,
	rng,
	withLight: boolean,
	color: Color3?
)
	local cluster = Instance.new("Model")
	cluster.Name = name
	local tint = color or rng.pick({ PALETTE.CrystalCyan, PALETTE.CrystalViolet, PALETTE.CrystalPink })
	for index = 1, 4 do
		local height = if index == 1 then rng.range(5, 7.5) else rng.range(2, 4.5)
		local width = if index == 1 then 1.6 else 1.1
		local shard = newPart(
			"Part",
			decorProps({
				Name = "Shard" .. index,
				Size = Vector3.new(width, height, width),
				CFrame = CFrame.new(base + Vector3.new(rng.range(-1.4, 1.4), height / 2 - 0.4, rng.range(-1.4, 1.4)))
					* CFrame.Angles(math.rad(rng.range(-25, 25)), rng.range(0, TAU), math.rad(rng.range(-25, 25))),
				Color = tint,
				Material = if index == 1 then Enum.Material.Neon else Enum.Material.Glass,
				Transparency = if index == 1 then 0 else 0.2,
				CastShadow = false,
			}),
			cluster
		)
		if index == 1 and withLight then
			local light = Instance.new("PointLight")
			light.Color = tint
			light.Range = 14
			light.Brightness = 1.6
			light.Shadows = false
			light.Parent = shard
		end
	end
	cluster.Parent = parent
	return cluster
end

-- Cristal de Esencia: se rompe al tocarlo y suelta gemas (ExperienceService).
local function buildEssenceCrystal(interactables: Instance, props: Instance, index: number, base: Vector3)
	local model = Instance.new("Model")
	model.Name = "EssenceCrystal" .. index
	newPart("Part", {
		Name = "Pedestal",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.8, 4.4, 4.4),
		CFrame = CFrame.new(base + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = PALETTE.StoneDark,
		Material = Enum.Material.Slate,
	}, props)
	local core = newPart(
		"Part",
		decorProps({
			Name = "Core",
			Size = Vector3.new(1.8, 4.2, 1.8),
			CFrame = CFrame.new(base + Vector3.new(0, 3.3, 0)) * CFrame.Angles(0, math.rad(45), 0),
			Color = PALETTE.Essence,
			Material = Enum.Material.Neon,
			CastShadow = false,
		}),
		model
	)
	for i = 1, 3 do
		local angle = i / 3 * TAU
		newPart(
			"Part",
			decorProps({
				Name = "Shard",
				Size = Vector3.new(0.8, 2.2, 0.8),
				CFrame = CFrame.new(base + Vector3.new(math.cos(angle) * 1.4, 1.8, math.sin(angle) * 1.4))
					* CFrame.Angles(math.sin(angle) * 0.5, angle, math.cos(angle) * 0.5),
				Color = PALETTE.Essence:Lerp(Color3.new(1, 1, 1), 0.3),
				Material = Enum.Material.Glass,
				Transparency = 0.15,
				CastShadow = false,
			}),
			model
		)
	end
	local light = Instance.new("PointLight")
	light.Color = PALETTE.Essence
	light.Range = 12
	light.Brightness = 1.8
	light.Shadows = false
	light.Parent = core
	model.PrimaryPart = core
	model.WorldPivot = CFrame.new(base + Vector3.new(0, 2, 0))
	model:SetAttribute("EssenceCrystal", true)
	model.Parent = interactables
	reserve(base, 4)
	return model
end

local function buildIsland(ground: Folder, props: Folder, rng)
	for index, lobe in MapLayout.Lobes do
		local top = SURFACE_Y + (index - 1) * 0.02
		local grass = if index % 2 == 0 then PALETTE.GrassAlt else PALETTE.Grass
		if index == 5 then
			grass = VisualConfig.Zones.Corrupted.Grass -- Jardín Corrompido (SE)
		end
		polygonLayer(
			ground,
			"Lobe" .. index .. "Surface",
			lobe.Center,
			lobe.Sides,
			lobe.Radius,
			top,
			4,
			grass,
			lobe.Angle,
			Enum.Material.Grass
		)
		-- Borde algo más bajo y de otro color: marca claramente el final de la isla.
		polygonLayer(
			ground,
			"Lobe" .. index .. "Rim",
			lobe.Center,
			lobe.Sides,
			lobe.Radius + 4,
			top - 0.5,
			5,
			PALETTE.Rim,
			lobe.Angle + math.pi / lobe.Sides,
			Enum.Material.Sand
		)
		cliffs(props, "Lobe" .. index, lobe.Center, lobe.Radius + 3, top - 1, rng)
	end
end

local function buildSpawnPlaza(ground: Folder, props: Folder, decor: Folder, rng): SpawnLocation
	local spawnPosition = GameConfig.Map.PlayerSpawn
	local center = Vector3.new(spawnPosition.X, SURFACE_Y, spawnPosition.Z)
	newPart("Part", {
		Name = "SpawnPlaza", -- a ras del suelo (0,08 por encima): no es un escalón para los enemigos
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 26, 26),
		CFrame = CFrame.new(center + Vector3.new(0, -0.22, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = PALETTE.Stone,
		Material = Enum.Material.Slate,
	}, ground)
	newPart(
		"Part",
		decorProps({
			Name = "SpawnRuneRing",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.65, 16, 16),
			CFrame = CFrame.new(center + Vector3.new(0, -0.2, 0)) * CFrame.Angles(0, 0, math.pi / 2),
			Color = PALETTE.Rune,
			Material = Enum.Material.Neon,
			Transparency = 0.6,
		}),
		decor
	)
	-- Cuatro pilares rúnicos con cristal: la plaza se reconoce desde cualquier punto.
	-- Van en los huecos entre los caminos (45°, 90°, 147°, 236° y 304°) para no cortarlos.
	for _, degrees in { 118, 191, 270, 354 } do
		local angle = math.rad(degrees)
		local base = center + Vector3.new(math.cos(angle) * 11, 0, math.sin(angle) * 11)
		newPart("Part", {
			Name = "RunePillar",
			Size = Vector3.new(1.8, 5, 1.8),
			CFrame = CFrame.new(base + Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, angle, 0),
			Color = PALETTE.StoneDark,
			Material = Enum.Material.Slate,
		}, props)
		newPart(
			"Part",
			decorProps({
				Name = "RuneCrystal",
				Size = Vector3.new(1, 2.2, 1),
				CFrame = CFrame.new(base + Vector3.new(0, 6.3, 0)) * CFrame.Angles(0, angle + math.pi / 4, 0),
				Color = PALETTE.Rune,
				Material = Enum.Material.Neon,
				CastShadow = false,
			}),
			decor
		)
	end
	-- Losas alrededor de la plaza.
	for i = 1, 22 do
		local angle = i / 22 * TAU + rng.range(-0.08, 0.08)
		local distance = rng.range(14, 17)
		newPart(
			"Part",
			decorProps({
				Name = "PlazaTile",
				Size = Vector3.new(rng.range(2.2, 3.4), 0.3, rng.range(2.2, 3.4)),
				CFrame = CFrame.new(center + Vector3.new(math.cos(angle) * distance, 0.1, math.sin(angle) * distance))
					* CFrame.Angles(0, angle + rng.range(-0.3, 0.3), 0),
				Color = if i % 3 == 0 then PALETTE.StoneDark else PALETTE.Path,
				Material = Enum.Material.Slate,
			}),
			decor
		)
	end
	reserve(center, 18)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "PlayerSpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0 -- sin campo de fuerza
	spawn.Size = Vector3.new(6, 0.4, 6)
	spawn.CFrame = CFrame.new(spawnPosition.X, SURFACE_Y + 0.2, spawnPosition.Z)
	spawn.Color = PALETTE.StoneDark
	spawn.Material = Enum.Material.Slate
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = ground
	return spawn
end

-- Camino de losas irregulares (decorativo, guía la exploración).
local function buildPath(decor: Folder, from: Vector3, to: Vector3, width: number, rng)
	local length = (flat(to) - flat(from)).Magnitude
	local direction = (flat(to) - flat(from)).Unit
	local side = Vector3.new(-direction.Z, 0, direction.X)
	local steps = math.floor(length / 3.2)
	for i = 0, steps do
		local t = i / math.max(1, steps)
		local base = from:Lerp(to, t)
		local offset = side * rng.range(-width / 3, width / 3)
		newPart(
			"Part",
			decorProps({
				Name = "PathStone",
				Size = Vector3.new(rng.range(2, 3.2), 0.25, rng.range(2, 3)),
				CFrame = CFrame.new(Vector3.new(base.X, base.Y + 0.08, base.Z) + offset)
					* CFrame.Angles(0, math.atan2(direction.X, direction.Z) + rng.range(-0.4, 0.4), 0),
				Color = if rng.next() < 0.3 then PALETTE.StoneDark else PALETTE.Path,
				Material = Enum.Material.Slate,
			}),
			decor
		)
	end
	reserveSegment(from, to, width / 2 + 1)
end

-- Rampa caminable de `bottom` a `top` (la cara frontal de la WedgePart es el extremo bajo).
local function buildRamp(ground: Folder, name: string, bottom: Vector3, top: Vector3, width: number, color: Color3)
	local horizontal = flat(top) - flat(bottom)
	local length = horizontal.Magnitude
	local height = top.Y - bottom.Y
	local midpoint = flat(bottom) + horizontal / 2 + Vector3.new(0, bottom.Y + height / 2, 0)
	newPart("WedgePart", {
		Name = name,
		Size = Vector3.new(width, height, length),
		CFrame = CFrame.lookAt(midpoint, midpoint - horizontal),
		Color = color,
		Material = Enum.Material.Slate,
	}, ground)
	-- Bordillos de piedra a los lados (decorativos).
	local direction = horizontal.Unit
	local sideDir = Vector3.new(-direction.Z, 0, direction.X)
	for _, sign in { -1, 1 } do
		local edgeMid = midpoint + sideDir * sign * (width / 2 + 0.4)
		newPart(
			"WedgePart",
			decorProps({
				Name = name .. "Curb",
				Size = Vector3.new(0.8, height + 0.6, length),
				CFrame = CFrame.lookAt(edgeMid + Vector3.new(0, 0.3, 0), edgeMid + Vector3.new(0, 0.3, 0) - horizontal),
				Color = PALETTE.StoneDark,
				Material = Enum.Material.Slate,
			}),
			ground.Parent:FindFirstChild("Decor") :: Instance
		)
	end
	reserveSegment(bottom, top, width / 2 + 2)
end

local function buildMesa(ground: Folder, props: Folder, mesa: MapLayout.Mesa, rng)
	local top = SURFACE_Y + mesa.Height
	-- Paredes de roca y tapa de hierba.
	polygonLayer(
		props,
		mesa.Id .. "Wall",
		mesa.Center,
		mesa.Sides,
		mesa.Radius,
		top - 0.6,
		mesa.Height + 3.4,
		PALETTE.Cliff,
		mesa.Angle,
		Enum.Material.Slate
	)
	polygonLayer(
		ground,
		mesa.Id .. "Top",
		mesa.Center,
		mesa.Sides,
		mesa.Radius - 0.4,
		top,
		0.8,
		PALETTE.GrassDark,
		mesa.Angle,
		Enum.Material.Grass
	)
	if mesa.Ramped then
		-- Rampas en todos los lados: la colina se sube desde cualquier dirección.
		local run = mesa.Height * 2.4
		local apothem = mesa.Radius * math.cos(math.pi / mesa.Sides)
		local sideLength = 2 * mesa.Radius * math.sin(math.pi / mesa.Sides)
		for i = 0, mesa.Sides - 1 do
			local angle = mesa.Angle + i * TAU / mesa.Sides
			local outward = Vector3.new(-math.sin(angle), 0, -math.cos(angle))
			local position = Vector3.new(mesa.Center.X, SURFACE_Y + mesa.Height / 2, mesa.Center.Z)
				+ outward * (apothem + run / 2 - 0.05)
			newPart("WedgePart", {
				Name = mesa.Id .. "Slope" .. (i + 1),
				Size = Vector3.new(sideLength + 0.4, mesa.Height, run),
				CFrame = CFrame.lookAt(position, position + outward),
				Color = PALETTE.Grass,
				Material = Enum.Material.Grass,
			}, ground)
		end
		reserve(mesa.Center, mesa.Radius + run * 0.6)
	end
	-- Rocas sueltas al pie de las paredes.
	if not mesa.Ramped then
		for i = 1, mesa.Sides do
			if rng.next() < 0.6 then
				local angle = mesa.Angle + (i + 0.5) * TAU / mesa.Sides
				local position = mesa.Center
					+ Vector3.new(
						math.sin(angle) * (mesa.Radius + 1.5),
						SURFACE_Y,
						math.cos(angle) * (mesa.Radius + 1.5)
					)
				if isClear(position, 2) then
					placeKit("Rock", position, rng, props.Parent:FindFirstChild("Decor") :: Instance, props)
				end
			end
		end
	end
end

-- Dirección de los escalones de piedra de las Ruinas (acceso alternativo).
local RUINS_STEP_DIR = Vector3.new(0.45, 0, 1).Unit

-- Reserva el pasillo de los escalones antes de colocar rocas al pie de la
-- meseta (una roca allí formaba un hueco del que no se podía salir).
local function reserveRuinsSteps()
	local mesa = MapLayout.mesaById("Ruins") :: MapLayout.Mesa
	for distance = mesa.Radius - 1, mesa.Radius + 12, 2.5 do
		reserve(mesa.Center + RUINS_STEP_DIR * distance, 9)
	end
end

local function buildRuins(ground: Folder, props: Folder, decor: Folder, rng)
	local mesa = MapLayout.mesaById("Ruins") :: MapLayout.Mesa
	local top = SURFACE_Y + mesa.Height
	local center = Vector3.new(mesa.Center.X, top, mesa.Center.Z)
	-- Templo: círculo de columnas (algunas rotas) alrededor de un patio abierto,
	-- con un hueco frente a la llegada de la rampa (no bloquea la entrada).
	local rampDir = (flat(MapLayout.Links[1].Exit) - flat(mesa.Center)).Unit
	local rampAngle = math.atan2(rampDir.Z, rampDir.X)
	for i = 0, 7 do
		local angle = i * TAU / 8 + 0.2
		local gap = math.abs((angle - rampAngle + math.pi) % TAU - math.pi)
		if gap < 0.55 then
			continue
		end
		local base = center + Vector3.new(math.cos(angle) * 12.5, 0, math.sin(angle) * 12.5)
		local broken = i % 3 == 1
		local height = if broken then rng.range(2.5, 4.5) else rng.range(8, 10)
		newPart("Part", {
			Name = "TempleColumnBase",
			Size = Vector3.new(3.2, 0.8, 3.2),
			CFrame = CFrame.new(base + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, angle, 0),
			Color = PALETTE.StoneDark,
			Material = Enum.Material.Slate,
		}, props)
		newPart("Part", {
			Name = "TempleColumn",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(height, 2.3, 2.3),
			CFrame = CFrame.new(base + Vector3.new(0, 0.8 + height / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2),
			Color = VisualConfig.Zones.Ruins.Stone,
			Material = Enum.Material.Limestone,
		}, props)
		-- Runa vertical luminosa en la cara que mira al patio.
		local runeCenter = base + Vector3.new(0, 0.8 + height / 2, 0)
		newPart(
			"Part",
			decorProps({
				Name = "ColumnRune",
				Size = Vector3.new(0.3, height * 0.6, 0.12),
				CFrame = CFrame.lookAt(runeCenter, Vector3.new(center.X, runeCenter.Y, center.Z))
					* CFrame.new(0, 0, -1.16),
				Color = VisualConfig.Zones.Ruins.Rune,
				Material = Enum.Material.Neon,
				CastShadow = false,
			}),
			decor
		)
		if broken then
			newPart(
				"Part",
				decorProps({
					Name = "FallenDrum",
					Shape = Enum.PartType.Cylinder,
					Size = Vector3.new(2.6, 2.2, 2.2),
					CFrame = CFrame.new(base + Vector3.new(2.6, 1.1, 1.2)) * CFrame.Angles(0, angle, 0.1),
					Color = PALETTE.Stone,
					Material = Enum.Material.Limestone,
				}),
				decor
			)
		else
			newPart(
				"Part",
				decorProps({
					Name = "Capital",
					Size = Vector3.new(3, 0.8, 3),
					CFrame = CFrame.new(base + Vector3.new(0, 1.2 + height, 0)) * CFrame.Angles(0, angle, 0),
					Color = PALETTE.StoneDark,
					Material = Enum.Material.Slate,
				}),
				decor
			)
		end
	end
	-- Arco en ruinas sobre la llegada de la rampa (marca la entrada).
	local link = MapLayout.Links[1]
	local entryDir = (flat(link.Exit) - flat(mesa.Center)).Unit
	local archCenter = center + entryDir * 9
	local archSide = Vector3.new(-entryDir.Z, 0, entryDir.X)
	for _, sign in { -1, 1 } do
		newPart("Part", {
			Name = "ArchPillar",
			Size = Vector3.new(2.6, 11, 2.6),
			CFrame = CFrame.new(archCenter + archSide * sign * 6 + Vector3.new(0, 5.5, 0)),
			Color = PALETTE.Stone,
			Material = Enum.Material.Limestone,
		}, props)
	end
	newPart(
		"Part",
		decorProps({
			Name = "ArchLintel",
			Size = Vector3.new(15, 2.2, 3.2),
			CFrame = CFrame.lookAt(archCenter + Vector3.new(0, 12, 0), archCenter + Vector3.new(0, 12, 0) + entryDir)
				* CFrame.Angles(0, 0, math.rad(5)),
			Color = PALETTE.StoneDark,
			Material = Enum.Material.Slate,
		}),
		decor
	)
	-- Altar central (el cristal de esencia va encima).
	newPart("Part", {
		Name = "Altar",
		Size = Vector3.new(7, 0.6, 7),
		CFrame = CFrame.new(Vector3.new(66, top + 0.3, 44)) * CFrame.Angles(0, math.rad(45), 0),
		Color = PALETTE.Stone,
		Material = Enum.Material.Slate,
	}, ground)
	-- Muros derruidos al pie de la meseta.
	local walls = {
		{ Vector3.new(36, SURFACE_Y, 52), 10, 3.5, 0.4 },
		{ Vector3.new(78, SURFACE_Y, 18), 8, 4.5, 1.2 },
		{ Vector3.new(44, SURFACE_Y, 62), 7, 2.5, -0.6 },
	}
	for index, wall in walls do
		local position: Vector3 = wall[1]
		newPart("Part", {
			Name = "RuinedWall" .. index,
			Size = Vector3.new(wall[2], wall[3], 1.8),
			CFrame = CFrame.new(position + Vector3.new(0, wall[3] / 2, 0)) * CFrame.Angles(0, wall[4], 0),
			Color = PALETTE.StoneDark,
			Material = Enum.Material.Slate,
		}, props)
		reserve(position, 4)
	end
	-- Escalones de piedra (acceso alternativo saltando, ~2,3 studs cada uno).
	local stepDir = RUINS_STEP_DIR
	for i = 1, 3 do
		local position = mesa.Center + stepDir * (mesa.Radius + 7.5 - i * 2.6)
		local height = i * 2.3
		newPart("Part", {
			Name = "StoneStep" .. i,
			Size = Vector3.new(4.2, height, 4.2),
			CFrame = CFrame.new(position.X, SURFACE_Y + height / 2, position.Z) * CFrame.Angles(0, rng.range(0, 1), 0),
			Color = if i % 2 == 0 then PALETTE.Rock1 else PALETTE.Rock2,
			Material = Enum.Material.Slate,
		}, ground)
		reserve(Vector3.new(position.X, 0, position.Z), 3)
	end
end

local function buildBridge(ground: Folder, props: Folder, decor: Folder)
	local bridge = MapLayout.Bridge
	local from, to = bridge.From, bridge.To
	local horizontal = flat(to) - flat(from)
	local length = horizontal.Magnitude
	local direction = horizontal.Unit
	local side = Vector3.new(-direction.Z, 0, direction.X)
	local plankLength = 2.4
	local count = math.ceil(length / plankLength)
	for i = 0, count - 1 do
		local t = (i + 0.5) / count
		local position = from:Lerp(to, t)
		-- Ligera curva colgante del puente.
		local sag = math.sin(t * math.pi) * -0.8
		newPart("Part", {
			Name = "BridgePlank",
			Size = Vector3.new(bridge.Width, 0.5, plankLength - 0.15),
			CFrame = CFrame.lookAt(position + Vector3.new(0, sag, 0), position + Vector3.new(0, sag, 0) + horizontal)
				* CFrame.Angles(math.atan2(to.Y - from.Y, length), 0, 0),
			Color = if i % 2 == 0 then PALETTE.Wood else PALETTE.WoodDark,
			Material = Enum.Material.WoodPlanks,
		}, ground)
	end
	-- Postes y cuerdas (fuera del ancho caminable).
	local postCount = math.floor(length / 7)
	local previous: { [number]: Vector3 } = {}
	for i = 0, postCount do
		local t = i / postCount
		local base = from:Lerp(to, t) + Vector3.new(0, math.sin(t * math.pi) * -0.8, 0)
		for _, sign in { -1, 1 } do
			local postBase = base + side * sign * (bridge.Width / 2 + 0.3)
			newPart("Part", {
				Name = "BridgePost",
				Size = Vector3.new(0.6, 3.4, 0.6),
				CFrame = CFrame.new(postBase + Vector3.new(0, 1.2, 0)),
				Color = PALETTE.WoodDark,
				Material = Enum.Material.Wood,
			}, props)
			local topPoint = postBase + Vector3.new(0, 2.6, 0)
			local last = previous[sign]
			if last then
				local mid = (last + topPoint) / 2 - Vector3.new(0, 0.3, 0)
				newPart(
					"Part",
					decorProps({
						Name = "BridgeRope",
						Size = Vector3.new(0.18, 0.18, (topPoint - last).Magnitude),
						CFrame = CFrame.lookAt(mid, topPoint),
						Color = PALETTE.Rope,
						Material = Enum.Material.Fabric,
					}),
					decor
				)
			end
			previous[sign] = topPoint
		end
	end
	reserveSegment(from - direction * 6, to + direction * 4, bridge.Width / 2 + 2)
end

local function buildSanctuary(ground: Folder, props: Folder, decor: Folder, rng)
	local s = MapLayout.Sanctuary
	local top = s.Center.Y
	polygonLayer(
		ground,
		"SanctuarySurface",
		s.Center,
		s.Sides,
		s.Radius,
		top,
		4,
		VisualConfig.Zones.Celestial.Stone,
		s.Angle,
		Enum.Material.Marble
	)
	polygonLayer(
		ground,
		"SanctuaryRim",
		s.Center,
		s.Sides,
		s.Radius + 3,
		top - 0.5,
		5,
		PALETTE.Rim,
		s.Angle + math.pi / s.Sides,
		Enum.Material.Sand
	)
	cliffs(props, "Sanctuary", s.Center, s.Radius + 2, top - 1, rng)
	-- Círculo de piedras erguidas alrededor del obelisco.
	local center = Vector3.new(s.Center.X, top, s.Center.Z)
	for i = 0, 5 do
		local angle = i * TAU / 6 + 0.3
		local base = center + Vector3.new(math.cos(angle) * 13, 0, math.sin(angle) * 13)
		local height = rng.range(4.5, 7)
		newPart("Part", {
			Name = "StandingStone",
			Size = Vector3.new(2, height, 1.3),
			CFrame = CFrame.new(base + Vector3.new(0, height / 2, 0))
				* CFrame.Angles(rng.range(-0.08, 0.08), -angle, rng.range(-0.08, 0.08)),
			Color = PALETTE.Rock1,
			Material = Enum.Material.Slate,
		}, props)
	end
	-- Obelisco de cristal: punto de interés visible desde la isla principal.
	newPart("Part", {
		Name = "ObeliskBase",
		Size = Vector3.new(4, 1.2, 4),
		CFrame = CFrame.new(center + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, math.rad(45), 0),
		Color = PALETTE.StoneDark,
		Material = Enum.Material.Slate,
	}, props)
	local obelisk = newPart(
		"Part",
		decorProps({
			Name = "Obelisk",
			Size = Vector3.new(1.6, 11, 1.6),
			CFrame = CFrame.new(center + Vector3.new(0, 7.2, 0)) * CFrame.Angles(0, math.rad(45), 0),
			Color = PALETTE.CrystalViolet,
			Material = Enum.Material.Neon,
			CastShadow = false,
		}),
		decor
	)
	local light = Instance.new("PointLight")
	light.Color = PALETTE.CrystalViolet
	light.Range = 20
	light.Brightness = 2
	light.Shadows = false
	light.Parent = obelisk
	reserve(center, 3.5)
	scatter(
		{ "TreeBlossom", "TreeBlossom", "BushBig", "GrassA", "GrassB", "Mushrooms" },
		center,
		9,
		17,
		9,
		4,
		rng,
		decor,
		props,
		top
	)
end

local function buildEdgeDetails(props: Folder, decor: Folder, rng)
	-- Piedras y cristales repartidos por el borde de cada lóbulo (silueta viva).
	for _, lobe in MapLayout.Lobes do
		local count = math.floor(lobe.Radius / 6)
		for _ = 1, count do
			local angle = rng.range(0, TAU)
			local radius = lobe.Radius * math.cos(math.pi / lobe.Sides) - rng.range(1.5, 3.5)
			local position = Vector3.new(
				lobe.Center.X + math.cos(angle) * radius,
				SURFACE_Y,
				lobe.Center.Z + math.sin(angle) * radius
			)
			-- Solo en el borde exterior real (no en solapes entre lóbulos).
			if MapLayout.onMainIsland(position + (flat(position) - flat(lobe.Center)).Unit * 6, 0) then
				continue
			end
			if not isClear(position, 2) then
				continue
			end
			if rng.next() < 0.25 then
				buildCrystalCluster(decor, "EdgeCrystal", position, rng, false)
			else
				placeKit(rng.pick({ "Rock", "Rock", "GrassA", "BushSmall" }), position, rng, decor, props, 0.8)
			end
		end
	end
end

local function buildFloatingRocks(decor: Folder, rng)
	for index = 1, 9 do
		local angle = (index / 9) * TAU + rng.range(-0.25, 0.25)
		local distance = rng.range(170, 250)
		local center = Vector3.new(math.sin(angle) * distance, rng.range(-25, 40), math.cos(angle) * distance)
		local size = rng.range(9, 22)
		local yaw = rng.range(0, TAU)
		local rock = Instance.new("Model")
		rock.Name = "FloatingRock" .. index
		newPart(
			"Part",
			decorProps({
				Name = "GrassTop",
				Size = Vector3.new(size, 2, size * 0.85),
				CFrame = CFrame.new(center) * CFrame.Angles(0, yaw, 0),
				Color = PALETTE.Grass,
				Material = Enum.Material.Grass,
			}),
			rock
		)
		newPart(
			"Part",
			decorProps({
				Name = "RockBody",
				Size = Vector3.new(size * 0.7, size * 0.7, size * 0.7),
				CFrame = CFrame.new(center - Vector3.new(0, size * 0.42, 0))
					* CFrame.Angles(math.rad(45), yaw, math.rad(35)),
				Color = PALETTE.Rock2,
			}),
			rock
		)
		newPart(
			"Part",
			decorProps({
				Name = "Crystal",
				Size = Vector3.new(1.4, size * 0.35, 1.4),
				CFrame = CFrame.new(center + Vector3.new(size * 0.15, size * 0.17 + 1, 0))
					* CFrame.Angles(0.2, yaw, 0.25),
				Color = rng.pick({ PALETTE.CrystalCyan, PALETTE.CrystalViolet }),
				Material = Enum.Material.Neon,
				CastShadow = false,
			}),
			rock
		)
		rock.Parent = decor
	end
end

local function buildClouds(decor: Folder, rng)
	for index = 1, 10 do
		local angle = rng.range(0, TAU)
		local distance = rng.range(90, 300)
		local center = Vector3.new(math.sin(angle) * distance, rng.range(-85, -40), math.cos(angle) * distance)
		local cloud = Instance.new("Model")
		cloud.Name = "Cloud" .. index
		for puff = 1, 3 do
			local size = rng.range(16, 30)
			newPart(
				"Part",
				decorProps({
					Name = "Puff" .. puff,
					Shape = Enum.PartType.Ball,
					Size = Vector3.new(size, size, size),
					CFrame = CFrame.new(
						center + Vector3.new((puff - 2) * size * 0.6, rng.range(-2, 3), rng.range(-4, 4))
					),
					Color = PALETTE.Cloud,
					Transparency = 0.15,
					CastShadow = false,
				}),
				cloud
			)
		end
		cloud.Parent = decor
	end
end

local function buildPond(decor: Folder, center: Vector3, radius: number)
	newPart(
		"Part",
		decorProps({
			Name = "PondBank",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.3, radius * 2 + 3, radius * 2 + 3),
			CFrame = CFrame.new(center + Vector3.new(0, 0.07, 0)) * CFrame.Angles(0, 0, math.pi / 2),
			Color = PALETTE.Rim,
			Material = Enum.Material.Sand,
		}),
		decor
	)
	newPart(
		"Part",
		decorProps({
			Name = "PondWater",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.32, radius * 2, radius * 2),
			CFrame = CFrame.new(center + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.pi / 2),
			Color = PALETTE.Water,
			Material = Enum.Material.Glass,
			Transparency = 0.25,
			Reflectance = 0.15,
		}),
		decor
	)
	reserve(center, radius + 1)
end

------------------------------------------------------------ Zonas (Fase 2.5)
-- Farolillo de piedra con luz cálida (Bosque Sakura).
local function buildLantern(props: Folder, decor: Folder, base: Vector3, withLight: boolean)
	local zone = VisualConfig.Zones.Forest
	newPart("Part", {
		Name = "LanternBase",
		Size = Vector3.new(1.6, 0.6, 1.6),
		CFrame = CFrame.new(base + Vector3.new(0, 0.3, 0)),
		Color = PALETTE.StoneDark,
		Material = Enum.Material.Slate,
	}, props)
	newPart("Part", {
		Name = "LanternPost",
		Size = Vector3.new(0.6, 2.4, 0.6),
		CFrame = CFrame.new(base + Vector3.new(0, 1.8, 0)),
		Color = PALETTE.Stone,
		Material = Enum.Material.Slate,
	}, props)
	local lamp = newPart(
		"Part",
		decorProps({
			Name = "LanternLamp",
			Size = Vector3.new(1.2, 1, 1.2),
			CFrame = CFrame.new(base + Vector3.new(0, 3.5, 0)),
			Color = zone.Lantern,
			Material = Enum.Material.Neon,
			CastShadow = false,
		}),
		decor
	)
	for _, sign in { 1, -1 } do
		newPart(
			"WedgePart",
			decorProps({
				Name = "LanternRoof",
				Size = Vector3.new(2, 0.6, 1),
				CFrame = CFrame.new(base + Vector3.new(0, 4.3, 0.5 * sign))
					* CFrame.Angles(0, if sign > 0 then 0 else math.pi, 0),
				Color = PALETTE.StoneDark,
				Material = Enum.Material.Slate,
			}),
			decor
		)
	end
	if withLight then
		local light = Instance.new("PointLight")
		light.Color = zone.Lantern
		light.Range = 14
		light.Brightness = 1.4
		light.Shadows = false
		light.Parent = lamp
	end
	reserve(base, 2)
end

-- Emisor ambiental (pétalos, luciérnagas, humo): el cliente lo apaga en calidad baja.
local function ambientEmitter(decor: Folder, name: string, cframe: CFrame, size: Vector3, props: { [string]: any })
	local holder = newPart(
		"Part",
		decorProps({
			Name = name,
			Size = size,
			CFrame = cframe,
			Transparency = 1,
			CastShadow = false,
		}),
		decor
	)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = name .. "Emitter"
	emitter.LightInfluence = 0
	for key, value in props do
		(emitter :: any)[key] = value
	end
	emitter:SetAttribute("Ambient", true)
	emitter.Parent = holder
	return emitter
end

-- Torii en la llegada del puente al Santuario Celestial (fuera del ancho caminable).
local function buildTorii(props: Folder, decor: Folder, base: Vector3, facing: Vector3)
	local zone = VisualConfig.Zones.Celestial
	local dark = Color3.fromRGB(34, 26, 30)
	local side = Vector3.new(-facing.Z, 0, facing.X)
	local orientation = CFrame.lookAt(base, base + facing)
	for _, sign in { -1, 1 } do
		local foot = base + side * sign * 6
		newPart("Part", {
			Name = "ToriiPillar",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(11, 1.3, 1.3),
			CFrame = CFrame.new(foot + Vector3.new(0, 5.5, 0)) * CFrame.Angles(0, 0, math.pi / 2),
			Color = zone.Torii,
		}, props)
		newPart("Part", {
			Name = "ToriiFoot",
			Size = Vector3.new(1.8, 0.8, 1.8),
			CFrame = CFrame.new(foot + Vector3.new(0, 0.4, 0)),
			Color = dark,
			Material = Enum.Material.Slate,
		}, props)
	end
	-- Travesaño inferior (nuki), superior (kasagi) y puntas levantadas.
	local beams = {
		{ "ToriiNuki", Vector3.new(14, 0.7, 0.8), 8.4, zone.Torii },
		{ "ToriiShimaki", Vector3.new(15, 0.6, 1.2), 10.1, zone.Torii },
		{ "ToriiKasagi", Vector3.new(16, 0.9, 1.4), 10.8, dark },
	}
	for _, info in beams do
		newPart(
			"Part",
			decorProps({
				Name = info[1],
				Size = info[2],
				CFrame = orientation * CFrame.new(0, info[3], 0),
				Color = info[4],
			}),
			decor
		)
	end
	for _, sign in { -1, 1 } do
		newPart(
			"WedgePart",
			decorProps({
				Name = "ToriiTip",
				Size = Vector3.new(1.4, 0.8, 1.6),
				CFrame = orientation * CFrame.new(sign * 8.6, 11.1, 0) * CFrame.Angles(0, sign * math.pi / 2, 0),
				Color = dark,
			}),
			decor
		)
	end
	newPart(
		"Part",
		decorProps({
			Name = "ToriiPlaque",
			Size = Vector3.new(1.6, 2, 0.3),
			CFrame = orientation * CFrame.new(0, 9.3, 0),
			Color = zone.Gold,
			Material = Enum.Material.Neon,
			CastShadow = false,
		}),
		decor
	)
end

--[[
	Cascada que cae desde el borde de la isla al vacío: un arroyo sobre el
	borde y dos haces (Beam) con textura en movimiento, más espuma arriba y
	bruma abajo. Todo decorativo.
]]
local function buildWaterfall(decor: Folder, spring: Vector3, edge: Vector3, height: number)
	local horizontal = flat(edge) - flat(spring)
	local direction = horizontal.Unit
	local streamStart = flat(spring) + Vector3.new(0, SURFACE_Y + 0.1, 0)
	local streamEnd = flat(edge) + Vector3.new(0, SURFACE_Y + 0.1, 0)
	newPart(
		"Part",
		decorProps({
			Name = "Stream",
			Size = Vector3.new(3.4, 0.16, horizontal.Magnitude),
			CFrame = CFrame.lookAt((streamStart + streamEnd) / 2, streamEnd),
			Color = PALETTE.Water,
			Material = Enum.Material.Glass,
			Transparency = 0.2,
			Reflectance = 0.1,
		}),
		decor
	)
	local topPosition = flat(edge) + direction * 3.5 + Vector3.new(0, SURFACE_Y - 0.4, 0)
	local top = newPart(
		"Part",
		decorProps({
			Name = "WaterfallTop",
			Size = Vector3.new(1, 1, 1),
			CFrame = CFrame.lookAt(topPosition, topPosition + direction),
			Transparency = 1,
		}),
		decor
	)
	local a0 = Instance.new("Attachment")
	a0.Parent = top
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -height, -6) -- cae algo hacia fuera, despegada del acantilado
	a1.Parent = top
	-- Capa 1: lámina continua (sin textura). Capa 2: reflejos que fluyen hacia abajo.
	local layers = {
		{ Width = 5.5, Texture = "", Length = 1, Speed = 0, Transparency = 0.3, Light = 0.25 },
		{
			Width = 3.6,
			Texture = VisualConfig.Textures.Glow,
			Length = 2.6,
			Speed = 3.2,
			Transparency = 0.25,
			Light = 0.7,
		},
	}
	for index, layer in layers do
		local beam = Instance.new("Beam")
		beam.Name = "Waterfall" .. index
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Texture = layer.Texture
		beam.TextureMode = Enum.TextureMode.Wrap
		beam.TextureLength = layer.Length
		beam.TextureSpeed = layer.Speed
		beam.Width0 = layer.Width
		beam.Width1 = layer.Width * 1.7
		beam.FaceCamera = true
		beam.LightEmission = layer.Light
		beam.LightInfluence = 0.5
		beam.Segments = 12
		beam.Color = ColorSequence.new(Color3.fromRGB(235, 250, 255), PALETTE.Water)
		beam.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, layer.Transparency),
			NumberSequenceKeypoint.new(0.6, layer.Transparency + 0.15),
			NumberSequenceKeypoint.new(1, 1),
		})
		beam.Parent = top
	end
	ambientEmitter(decor, "WaterfallFoam", CFrame.new(topPosition), Vector3.new(4, 0.5, 2), {
		Texture = VisualConfig.Textures.Smoke,
		Color = ColorSequence.new(Color3.new(1, 1, 1)),
		Size = NumberSequence.new(1.2, 2.8),
		Transparency = NumberSequence.new(0.5, 1),
		Lifetime = NumberRange.new(0.6, 1),
		Speed = NumberRange.new(1, 3),
		Rate = 10,
		SpreadAngle = Vector2.new(40, 40),
	})
	ambientEmitter(
		decor,
		"WaterfallMist",
		CFrame.new(topPosition + direction * 2 - Vector3.new(0, height * 0.7, 0)),
		Vector3.new(8, 4, 8),
		{
			Texture = VisualConfig.Textures.Smoke,
			Color = ColorSequence.new(Color3.fromRGB(230, 245, 255)),
			Size = NumberSequence.new(4, 9),
			Transparency = NumberSequence.new(0.6, 1),
			Lifetime = NumberRange.new(2, 3),
			Speed = NumberRange.new(0.5, 1.5),
			Rate = 4,
		}
	)
	reserve(spring, 4)
	reserveSegment(spring, edge, 3)
end

-- Jardín Corrompido: grietas de vacío y cristales rojo/violeta con humo oscuro.
local function buildCorruption(decor: Folder, center: Vector3, rng)
	local zone = VisualConfig.Zones.Corrupted
	for index = 1, 9 do
		local angle = rng.range(0, TAU)
		local distance = rng.range(6, 30)
		local position =
			Vector3.new(center.X + math.cos(angle) * distance, SURFACE_Y + 0.11, center.Z + math.sin(angle) * distance)
		if not MapLayout.isWalkable(position, 3) then
			continue
		end
		-- Grieta en zigzag: tres segmentos de neón finos a ras de suelo.
		local previous = position
		for _ = 1, 3 do
			local nextPoint = previous + Vector3.new(rng.range(-3, 3), 0, rng.range(-3, 3))
			newPart(
				"Part",
				decorProps({
					Name = "VoidCrack",
					Size = Vector3.new(0.3, 0.06, (nextPoint - previous).Magnitude + 0.2),
					CFrame = CFrame.lookAt((previous + nextPoint) / 2, nextPoint),
					Color = if index % 2 == 0 then zone.Crystal else zone.Crystal2,
					Material = Enum.Material.Neon,
					CastShadow = false,
				}),
				decor
			)
			previous = nextPoint
		end
	end
	for index, spot in
		{ Vector3.new(30, 0, -34), Vector3.new(60, 0, -36), Vector3.new(38, 0, -66), Vector3.new(64, 0, -52) }
	do
		local tint = if index % 2 == 0 then zone.Crystal else zone.Crystal2
		local cluster = buildCrystalCluster(decor, "VoidCrystal" .. index, spot, rng, index <= 1, tint)
		cluster:SetAttribute("Float", 0.25)
		reserve(spot, 3)
		if index <= 2 then
			ambientEmitter(decor, "VoidSmoke", CFrame.new(spot + Vector3.new(0, 1, 0)), Vector3.new(3, 1, 3), {
				Texture = VisualConfig.Textures.Smoke,
				Color = ColorSequence.new(Color3.fromRGB(60, 20, 70)),
				LightEmission = 0,
				Size = NumberSequence.new(2, 4),
				Transparency = NumberSequence.new(0.55, 1),
				Lifetime = NumberRange.new(1.5, 2.5),
				Speed = NumberRange.new(1, 2),
				Rate = 3,
				EmissionDirection = Enum.NormalId.Top,
			})
		end
	end
end

-- Construye el mapa completo dentro de `parent` y devuelve la carpeta Map.
function MapBuilder.build(parent: Instance): Folder
	local rng = makeRng(GameConfig.Map.Seed)
	table.clear(clearZones)
	kitFolder = findKit()

	local map = Instance.new("Folder")
	map.Name = "Map"
	local ground = Instance.new("Folder")
	ground.Name = "Ground"
	ground.Parent = map
	local props = Instance.new("Folder")
	props.Name = "Props"
	props.Parent = map
	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = map
	local interactables = Instance.new("Folder")
	interactables.Name = "Interactables"
	interactables.Parent = map

	buildIsland(ground, props, rng)
	buildSpawnPlaza(ground, props, decor, rng)

	-- Accesos y caminos (reservan su espacio antes de repartir decoración).
	for index, link in MapLayout.Links do
		if link.To ~= "Sanctuary" then
			buildRamp(ground, "Ramp" .. index, link.Entry, link.Exit, link.Width, PALETTE.Path)
		end
	end
	buildBridge(ground, props, decor)
	buildPath(decor, Vector3.new(8, SURFACE_Y, 8), MapLayout.Links[1].Entry, 5, rng)
	buildPath(decor, Vector3.new(0, SURFACE_Y, 14), MapLayout.Links[3].Entry, 5, rng)
	buildPath(decor, Vector3.new(8, SURFACE_Y, -10), MapLayout.Links[2].Entry, 4, rng)
	buildPath(decor, Vector3.new(-10, SURFACE_Y, -9), Vector3.new(-30, SURFACE_Y, -45), 4, rng)
	buildPath(decor, Vector3.new(-12, SURFACE_Y, 8), Vector3.new(-40, SURFACE_Y, 26), 4, rng)

	reserveRuinsSteps()
	for _, mesa in MapLayout.Mesas do
		buildMesa(ground, props, mesa, rng)
	end
	buildRuins(ground, props, decor, rng)
	buildSanctuary(ground, props, decor, rng)

	for index, position in MapLayout.EssenceCrystals do
		buildEssenceCrystal(interactables, props, index, position)
	end

	-- Bosque Cristalino (SO): arboleda densa con claros, setas, cristales y estanque.
	local forest = Vector3.new(-38, SURFACE_Y, -58)
	buildPond(decor, Vector3.new(-56, SURFACE_Y, -48), 6)
	for index, spot in
		{ Vector3.new(-24, 0, -44), Vector3.new(-48, 0, -78), Vector3.new(-62, 0, -60), Vector3.new(-30, 0, -74) }
	do
		buildCrystalCluster(decor, "ForestCrystal" .. index, spot, rng, index <= 2)
		reserve(spot, 3)
	end
	-- Bosque Sakura: predominan los árboles en flor; farolillos en los claros.
	for index, spot in
		{ Vector3.new(-22, 0, -36), Vector3.new(-44, 0, -42), Vector3.new(-36, 0, -66), Vector3.new(-58, 0, -70) }
	do
		buildLantern(props, decor, spot, index % 2 == 1)
	end
	buildWaterfall(decor, Vector3.new(-62, SURFACE_Y, -50), Vector3.new(-79.5, SURFACE_Y, -51), 70)
	scatter(
		{ "TreeBlossom", "TreeBlossom", "TreeBlossom", "TreeRound", "TreeNormal", "TreePine" },
		forest,
		6,
		34,
		16,
		7,
		rng,
		decor,
		props
	)
	scatter({ "Mushrooms", "BushBig", "BushSmall", "GrassA", "GrassB", "Log" }, forest, 4, 36, 18, 3, rng, decor, props)

	-- Colina del Viento (NO): pinos, rocas y hierba alta.
	local hills = Vector3.new(-56, SURFACE_Y, 38)
	scatter({ "TreePine", "TreePine", "TreeRound", "Boulder" }, hills, 24, 38, 8, 7, rng, decor, props)
	scatter({ "GrassA", "GrassB", "GrassC", "BushSmall", "Rock" }, hills, 20, 40, 14, 3, rng, decor, props)
	placeKit("TreeBlossom", Vector3.new(-60, SURFACE_Y + 4, 41), rng, decor, props, 1.3)

	-- Jardín Corrompido (SE): agujas de roca oscura, cristales del vacío y grietas.
	local rocks = Vector3.new(44, SURFACE_Y, -42)
	buildCorruption(decor, rocks, rng)
	rockTintOverride = VisualConfig.Zones.Corrupted.Rock
	scatter({ "Spire" }, rocks, 10, 30, 7, 9, rng, decor, props)
	scatter({ "Rock", "Boulder", "TreeDead", "GrassC" }, rocks, 6, 34, 12, 4, rng, decor, props)
	rockTintOverride = nil

	-- Cascada de las Ruinas (NE) y torii del Santuario Celestial.
	buildWaterfall(decor, Vector3.new(74, SURFACE_Y, 58), Vector3.new(82.5, SURFACE_Y, 65), 80)
	buildTorii(props, decor, Vector3.new(0, MapLayout.Sanctuary.Center.Y, 101.5), Vector3.new(0, 0, 1))
	ambientEmitter(
		decor,
		"Fireflies",
		CFrame.new(MapLayout.Sanctuary.Center + Vector3.new(0, 3, 0)),
		Vector3.new(30, 4, 30),
		{
			Texture = VisualConfig.Textures.Glow,
			Color = ColorSequence.new(VisualConfig.Zones.Celestial.Gold),
			LightEmission = 1,
			Size = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.5, 0.5),
				NumberSequenceKeypoint.new(1, 0),
			}),
			Lifetime = NumberRange.new(2.5, 4),
			Speed = NumberRange.new(0.3, 1),
			SpreadAngle = Vector2.new(180, 180),
			Rate = 8,
		}
	)

	-- Alrededores de las Ruinas (NE).
	scatter(
		{ "TreeTwist", "TreeDead", "Boulder", "BushBig" },
		Vector3.new(58, SURFACE_Y, 36),
		22,
		36,
		8,
		6,
		rng,
		decor,
		props
	)

	-- Toques sueltos cerca del centro (sin cerrar el espacio de combate).
	scatter({ "GrassA", "GrassB", "GrassC", "BushSmall" }, Vector3.zero, 22, 48, 14, 3, rng, decor, props)
	scatter({ "TreeRound", "TreeNormal", "Boulder" }, Vector3.zero, 34, 52, 5, 9, rng, decor, props)

	buildEdgeDetails(props, decor, rng)
	buildFloatingRocks(decor, rng)
	buildClouds(decor, rng)

	map.Parent = parent
	return map
end

-- Iluminación de fantasía luminosa, atmósfera y nubes volumétricas.
function MapBuilder.applyLighting()
	local Lighting = game:GetService("Lighting")
	Lighting.ClockTime = 15.3
	Lighting.GeographicLatitude = 28
	Lighting.Brightness = 2.8
	Lighting.Ambient = Color3.fromRGB(96, 98, 128)
	Lighting.OutdoorAmbient = Color3.fromRGB(146, 146, 176)
	Lighting.EnvironmentDiffuseScale = 0.55
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.25

	local function ensure(className: string, name: string, parent: Instance): Instance
		local existing = parent:FindFirstChild(name)
		if existing and existing.ClassName == className then
			return existing
		end
		local created = Instance.new(className)
		created.Name = name
		created.Parent = parent
		return created
	end

	local atmosphere = ensure("Atmosphere", "SkyAtmosphere", Lighting) :: Atmosphere
	atmosphere.Density = 0.34
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(200, 222, 255)
	atmosphere.Decay = Color3.fromRGB(150, 120, 200)
	atmosphere.Glare = 0.35
	atmosphere.Haze = 1.6

	local sky = ensure("Sky", "SkyboxSky", Lighting) :: Sky
	sky.SunAngularSize = 16
	sky.MoonAngularSize = 8
	sky.CelestialBodiesShown = true

	local bloom = ensure("BloomEffect", "SkyBloom", Lighting) :: BloomEffect
	bloom.Intensity = 0.6
	bloom.Size = 26
	bloom.Threshold = 1.5

	local grading = ensure("ColorCorrectionEffect", "SkyColorGrade", Lighting) :: ColorCorrectionEffect
	grading.Saturation = 0.18
	grading.Contrast = 0.08
	grading.Brightness = 0.01
	grading.TintColor = Color3.fromRGB(255, 248, 238)

	local rays = ensure("SunRaysEffect", "SkySunRays", Lighting) :: SunRaysEffect
	rays.Intensity = 0.07
	rays.Spread = 0.75

	local clouds = ensure("Clouds", "SkyClouds", workspace.Terrain) :: Clouds
	clouds.Cover = 0.5
	clouds.Density = 0.5
	clouds.Color = Color3.fromRGB(255, 250, 255)
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">MapLayout</string>
          <string name="Source"><![CDATA[--!strict
--[[
	MapLayout
	Descripción de la isla (datos puros, sin instancias). La usan:
	  • MapBuilder: para construir la geometría,
	  • SpawnService / ExperienceService: para validar posiciones,
	  • EnemyService: para no caminar hacia el vacío y para subir a las
	    mesetas o cruzar el puente por sus accesos (rampas y pasarelas).

	Zonas (áreas de navegación):
	  Main        isla principal: unión de varios lóbulos poligonales (silueta irregular)
	  Ruins       meseta de las Ruinas del Alba (+7), rampa y escalones de piedra
	  Lookout     mirador de roca (+8) con rampa
	  Sanctuary   santuario flotante unido a la isla por un puente
	La Colina del Viento es caminable por todos sus lados y pertenece a Main.
]]

local MapLayout = {}

export type Lobe = { Center: Vector3, Radius: number, Sides: number, Angle: number }
export type Mesa = {
	Id: string,
	Center: Vector3,
	Radius: number,
	Sides: number,
	Height: number,
	Angle: number,
	Ramped: boolean, -- true = rampas en todos los lados (forma parte de Main)
}
export type Link = {
	From: string,
	To: string,
	Entry: Vector3, -- punto de acceso en la zona From
	Exit: Vector3, -- punto de llegada en la zona To
	Width: number,
	Bidirectional: boolean,
}

MapLayout.SurfaceY = 0

MapLayout.Lobes = {
	{ Center = Vector3.new(0, 0, 0), Radius = 60, Sides = 16, Angle = 0 },
	{ Center = Vector3.new(52, 0, 34), Radius = 44, Sides = 13, Angle = 0.3 },
	{ Center = Vector3.new(-52, 0, 34), Radius = 42, Sides = 12, Angle = 0.1 },
	{ Center = Vector3.new(-34, 0, -52), Radius = 46, Sides = 14, Angle = 0.5 },
	{ Center = Vector3.new(44, 0, -50), Radius = 40, Sides = 11, Angle = 0.2 },
} :: { Lobe }

MapLayout.Mesas = {
	{
		Id = "Ruins",
		Center = Vector3.new(62, 0, 40),
		Radius = 19,
		Sides = 8,
		Height = 7,
		Angle = math.pi / 8,
		Ramped = false,
	},
	{
		Id = "Lookout",
		Center = Vector3.new(52, 0, -62),
		Radius = 10,
		Sides = 7,
		Height = 8,
		Angle = 0.3,
		Ramped = false,
	},
	{
		Id = "WindHill",
		Center = Vector3.new(-56, 0, 38),
		Radius = 15,
		Sides = 9,
		Height = 4,
		Angle = 0,
		Ramped = true,
	},
} :: { Mesa }

-- Santuario flotante (isla secundaria) y el puente que lo une a la principal.
MapLayout.Sanctuary = { Center = Vector3.new(0, 2, 120), Radius = 20, Sides = 12, Angle = 0.15 }
MapLayout.Bridge = { From = Vector3.new(0, 0, 54), To = Vector3.new(0, 2, 103), Width = 9 }

-- Accesos entre zonas. Las mesetas solo necesitan acceso para subir (se puede
-- bajar saltando); el puente se usa en ambos sentidos.
MapLayout.Links = {
	{
		From = "Main",
		To = "Ruins",
		Entry = Vector3.new(30, 0, 30),
		Exit = Vector3.new(47, 7, 36),
		Width = 10,
		Bidirectional = false,
	},
	{
		From = "Main",
		To = "Lookout",
		Entry = Vector3.new(32, 0, -48),
		Exit = Vector3.new(45, 8, -57),
		Width = 7,
		Bidirectional = false,
	},
	{
		From = "Main",
		To = "Sanctuary",
		Entry = Vector3.new(0, 0, 48),
		Exit = Vector3.new(0, 2, 108),
		Width = 9,
		Bidirectional = true,
	},
} :: { Link }

-- Cristales de Esencia: fuente de experiencia que premia la exploración.
MapLayout.EssenceCrystals = {
	Vector3.new(66, 7, 44), -- cima de las Ruinas del Alba
	Vector3.new(53, 8, -63), -- mirador
	Vector3.new(-6, 2, 126), -- santuario
	Vector3.new(9, 2, 116), -- santuario
	Vector3.new(-56, 4, 38), -- Colina del Viento
	Vector3.new(-46, 0, -70), -- Bosque Cristalino
}

local function flatDistance(a: Vector3, b: Vector3): number
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- Distancia al centro por debajo de la cual un punto está seguro dentro de
-- un polígono regular (su apotema), menos un margen.
local function insidePolygon(position: Vector3, center: Vector3, radius: number, sides: number, margin: number): boolean
	return flatDistance(position, center) <= radius * math.cos(math.pi / sides) - margin
end

local function onBridge(position: Vector3, margin: number): boolean
	local bridge = MapLayout.Bridge
	local a, b = bridge.From, bridge.To
	local ab = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
	local ap = Vector3.new(position.X - a.X, 0, position.Z - a.Z)
	local length = ab.Magnitude
	local t = ap:Dot(ab) / (length * length)
	if t < -0.05 or t > 1.05 then
		return false
	end
	local closest = ab * math.clamp(t, 0, 1)
	return (ap - closest).Magnitude <= bridge.Width / 2 - margin
end

function MapLayout.onMainIsland(position: Vector3, margin: number?): boolean
	local m = margin or 0
	for _, lobe in MapLayout.Lobes do
		if insidePolygon(position, lobe.Center, lobe.Radius, lobe.Sides, m) then
			return true
		end
	end
	return false
end

function MapLayout.onSanctuary(position: Vector3, margin: number?): boolean
	local s = MapLayout.Sanctuary
	return insidePolygon(position, s.Center, s.Radius, s.Sides, margin or 0)
end

-- ¿Hay suelo caminable bajo este punto (vista en planta)?
function MapLayout.isWalkable(position: Vector3, margin: number?): boolean
	local m = margin or 0
	return MapLayout.onMainIsland(position, m) or MapLayout.onSanctuary(position, m) or onBridge(position, m * 0.5)
end

function MapLayout.mesaById(id: string): Mesa?
	for _, mesa in MapLayout.Mesas do
		if mesa.Id == id then
			return mesa
		end
	end
	return nil
end

-- Zona de navegación en la que está un punto (se usa la altura para las mesetas).
function MapLayout.areaAt(position: Vector3): string
	for _, mesa in MapLayout.Mesas do
		if not mesa.Ramped and position.Y > MapLayout.SurfaceY + mesa.Height - 2.5 then
			if insidePolygon(position, mesa.Center, mesa.Radius, mesa.Sides, -1) then
				return mesa.Id
			end
		end
	end
	if MapLayout.onSanctuary(position, -2) then
		return "Sanctuary"
	end
	return "Main"
end

-- ¿Está el punto sobre el tramo entrada→salida de un acceso (rampa o puente)?
function MapLayout.onLink(position: Vector3, entry: Vector3, exit: Vector3, width: number): boolean
	local ab = Vector3.new(exit.X - entry.X, 0, exit.Z - entry.Z)
	local ap = Vector3.new(position.X - entry.X, 0, position.Z - entry.Z)
	local t = ap:Dot(ab) / ab:Dot(ab)
	if t <= 0 or t >= 1 then
		return false
	end
	return (ap - ab * t).Magnitude <= width / 2 + 1
end

function MapLayout.linkWidth(entry: Vector3): number
	for _, link in MapLayout.Links do
		if link.Entry == entry or link.Exit == entry then
			return link.Width
		end
	end
	return 6
end

--[[
	Siguiente punto de paso para ir de la zona `from` a la zona `to`, o nil si
	se puede ir en línea recta. Devuelve (entrada, salida) del acceso a usar.
]]
function MapLayout.route(from: string, to: string): (Vector3?, Vector3?)
	if from == to then
		return nil, nil
	end
	-- Bajar de una meseta: en línea recta (se puede saltar al suelo).
	if from ~= "Main" and from ~= "Sanctuary" and to == "Main" then
		return nil, nil
	end
	for _, link in MapLayout.Links do
		if link.From == from and link.To == to then
			return link.Entry, link.Exit
		end
		if link.Bidirectional and link.From == to and link.To == from then
			return link.Exit, link.Entry
		end
	end
	-- Entre dos zonas sin acceso directo se pasa primero por Main.
	if from ~= "Main" and to ~= "Main" then
		return MapLayout.route(from, "Main")
	end
	return nil, nil
end

return MapLayout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">ModelFactory</string>
          <string name="Source"><![CDATA[--[[
	ModelFactory
	Plantillas de enemigos y la Espada del Vendaval. EnemyService clona las
	plantillas desde ServerStorage/EnemyModels.

	Todas las criaturas comparten la misma base física, que es lo que mueve la IA:
	  Root (colisionador esférico invisible) + RootAttachment + Mover
	  (LinearVelocity en el plano) + Facing (AlignOrientation) + HealthBar.
	La esfera sube sola escalones bajos (borde de la plaza, altar, tablones del
	puente); una caja sin fricción se quedaba atascada contra ellos.
	Lo visible va soldado al Root sin masa ni colisión, así que el cliente puede
	animarlo libremente sin afectar a la física ni al combate.

	  Slime     cuerpo elipsoidal; el cliente anima BodyWeld.C0 y BodyMesh.Scale.
	  Skeleton  rig R15 del asset ServerStorage/SkyBonkAssets/SkeletonRig
	            (mallas oficiales de Roblox, sin scripts) con AnimationController;
	            el cliente reproduce las animaciones de Roblox (paquete Zombie).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Types = require(ReplicatedStorage.Shared.Types)
local VisualConfig = require(ReplicatedStorage.Shared.Config.VisualConfig)

local ModelFactory = {}

local function weld(part0: BasePart, part1: BasePart, name: string): Weld
	local w = Instance.new("Weld")
	w.Name = name
	w.Part0 = part0
	w.Part1 = part1
	w.C0 = part0.CFrame:Inverse() * part1.CFrame
	w.Parent = part1
	return w
end

local function visualPart(props: { [string]: any }, parent: Instance): BasePart
	local part = Instance.new(props.ClassName or "Part") :: BasePart
	props.ClassName = nil
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		(part :: any)[key] = value
	end
	part.Parent = parent
	return part
end

local function buildHealthBar(root: BasePart, height: number, width: number)
	local gui = Instance.new("BillboardGui")
	gui.Name = "HealthBar"
	gui.Adornee = root
	gui.Size = UDim2.new(width, 0, 0.38, 0)
	gui.StudsOffset = Vector3.new(0, height, 0)
	gui.MaxDistance = 110
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.ResetOnSpawn = false
	-- Oculta hasta el primer impacto (menos ruido visual con muchos enemigos).
	gui.Enabled = false

	local back = Instance.new("Frame")
	back.Name = "Back"
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Color3.fromRGB(26, 18, 40)
	back.BorderSizePixel = 0
	back.Parent = gui
	local backCorner = Instance.new("UICorner")
	backCorner.CornerRadius = UDim.new(0.5, 0)
	backCorner.Parent = back

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(236, 84, 120)
	fill.BorderSizePixel = 0
	fill.Parent = back
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0.5, 0)
	fillCorner.Parent = fill

	gui.Parent = root
end

-- Base física común: colisionador esférico, movimiento en el plano y orientación.
local function buildPhysicsRoot(model: Model, diameter: number): BasePart
	local size = Vector3.new(diameter, diameter, diameter)
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Shape = Enum.PartType.Ball
	root.Size = size
	root.CFrame = CFrame.new(0, size.Y / 2, 0)
	root.Transparency = 1
	root.Anchored = false
	root.CanCollide = true
	root.CanTouch = false
	root.CastShadow = false
	-- Sin fricción ni rebote: se desliza de forma estable por el terreno.
	root.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0, 0, 100, 100)
	root.Parent = model
	model.PrimaryPart = root

	local attachment = Instance.new("Attachment")
	attachment.Name = "RootAttachment"
	attachment.Parent = root

	-- Movimiento horizontal (la gravedad sigue actuando en Y).
	local mover = Instance.new("LinearVelocity")
	mover.Name = "Mover"
	mover.Attachment0 = attachment
	mover.RelativeTo = Enum.ActuatorRelativeTo.World
	mover.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	mover.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	mover.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	mover.PlaneVelocity = Vector2.new(0, 0)
	mover.ForceLimitMode = Enum.ForceLimitMode.Magnitude
	mover.MaxForce = 30000 * (size.X * size.Z) / 11.56
	mover.Parent = root

	-- Mantiene a la criatura erguida y mirando hacia su objetivo.
	local facing = Instance.new("AlignOrientation")
	facing.Name = "Facing"
	facing.Mode = Enum.OrientationAlignmentMode.OneAttachment
	facing.Attachment0 = attachment
	facing.Responsiveness = 22
	facing.MaxTorque = 1e7
	facing.RigidityEnabled = false
	facing.CFrame = CFrame.new()
	facing.Parent = root
	return root
end

-- Slime del Vacío (y Rey Slime con Scale > 1): cuerpo elipsoidal y detalles soldados.
function ModelFactory.buildSlime(def: Types.EnemyDef): Model
	local s = def.Scale
	local model = Instance.new("Model")
	model.Name = def.ModelName
	local root = buildPhysicsRoot(model, 3 * s)
	local function at(x: number, y: number, z: number): CFrame
		return CFrame.new(x * s, y * s, z * s)
	end

	local body = visualPart({
		Name = "Body",
		Size = Vector3.new(4, 3, 4) * s,
		CFrame = at(0, 1.5, 0),
		Color = def.Color,
		Transparency = 0.08,
		Reflectance = 0.05,
		CastShadow = true,
	}, model)
	local mesh = Instance.new("SpecialMesh")
	mesh.Name = "BodyMesh"
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = body
	-- El cliente anima BodyWeld.C0 y BodyMesh.Scale (saltos, anticipación, golpes), solo visualmente.
	weld(root, body, "BodyWeld")

	local core = visualPart({
		Name = "Core",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.4, 1.4, 1.4) * s,
		CFrame = at(0, 1.5, 0),
		Color = def.Color:Lerp(Color3.new(1, 1, 1), 0.45),
		Material = Enum.Material.Neon,
	}, model)
	weld(body, core, "CoreWeld")

	for _, side in { -1, 1 } do
		local eye = visualPart({
			Name = "Eye",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.85, 0.85, 0.85) * s,
			CFrame = at(side * 0.75, 2, -1.55),
			Color = Color3.fromRGB(250, 248, 255),
		}, model)
		weld(body, eye, "EyeWeld")
		local pupil = visualPart({
			Name = "Pupil",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.42, 0.42, 0.42) * s,
			CFrame = at(side * 0.75, 2, -1.92),
			Color = Color3.fromRGB(24, 10, 40),
		}, model)
		weld(body, pupil, "PupilWeld")
		-- Brillo de anime en la pupila: le da vida y expresión al slime.
		local shine = visualPart({
			Name = "EyeShine",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.16, 0.16, 0.16) * s,
			CFrame = at(side * 0.75 + 0.1, 2.12, -2.08),
			Color = Color3.new(1, 1, 1),
			Material = Enum.Material.Neon,
		}, model)
		weld(body, shine, "ShineWeld")
	end

	if s > 1.5 then
		-- Rey Slime: corona de cristal dorado (se reconoce de lejos como amenaza).
		for index = 0, 4 do
			local angle = index / 5 * math.pi * 2
			local spike = visualPart({
				Name = "CrownSpike",
				Size = Vector3.new(0.45, 1.2, 0.45) * s,
				CFrame = at(math.cos(angle) * 0.75, 3.2, math.sin(angle) * 0.75)
					* CFrame.Angles(math.sin(angle) * 0.25, 0, -math.cos(angle) * 0.25),
				Color = Color3.fromRGB(255, 214, 90),
				Material = Enum.Material.Neon,
			}, model)
			weld(body, spike, "CrownWeld")
		end
	else
		local crown = visualPart({
			Name = "CrownCrystal",
			Size = Vector3.new(0.7, 1.5, 0.7) * s,
			CFrame = at(0.3, 3.1, 0.2) * CFrame.Angles(0.25, 0.6, -0.3),
			Color = Color3.fromRGB(80, 230, 255),
			Material = Enum.Material.Neon,
		}, model)
		weld(body, crown, "CrownWeld")
	end

	buildHealthBar(root, 2.7 * s, 3.6 * s)
	return model
end

local function findSkeletonAsset(): Model?
	-- ServerStorage puede no existir en las pruebas fuera de Studio.
	local ok, serverStorage = pcall(function()
		return game:GetService("ServerStorage")
	end)
	local assets = ok and serverStorage and serverStorage:FindFirstChild("SkyBonkAssets")
	local rig = assets and assets:FindFirstChild("SkeletonRig")
	return if rig and rig:IsA("Model") then rig else nil
end

--[[
	Hueso Errante: rig R15 sobre la base física. Si falta el asset (p. ej. en
	las pruebas fuera de Studio), se usa un cuerpo simple de piezas para que la
	lógica siga funcionando.
]]
function ModelFactory.buildSkeleton(def: Types.EnemyDef): Model
	local s = def.Scale
	local model = Instance.new("Model")
	model.Name = def.ModelName
	local height = 5.2 * s
	-- La esfera hace de "pies"; el rig (sin colisión) va encima.
	local root = buildPhysicsRoot(model, 2.6 * s)

	local asset = findSkeletonAsset()
	if asset == nil then
		local body = visualPart({
			Name = "Body",
			Size = Vector3.new(2, height * 0.9, 1.2),
			CFrame = CFrame.new(0, height * 0.45, 0),
			Color = def.Color,
		}, model)
		weld(root, body, "BodyWeld")
		buildHealthBar(root, height - root.Size.Y / 2 + 0.8, 3)
		return model
	end

	local rig = asset:Clone()
	rig.Name = "Rig"
	if s ~= 1 then
		rig:ScaleTo(s)
	end
	local hrp = rig:FindFirstChild("HumanoidRootPart") :: BasePart
	assert(hrp, "SkeletonRig sin HumanoidRootPart")
	-- Coloca el rig mirando hacia -Z (el frente del Root) y con los pies a ras de su base.
	local boxCFrame, boxSize = rig:GetBoundingBox()
	local feetOffset = hrp.Position.Y - (boxCFrame.Position.Y - boxSize.Y / 2)
	local target = CFrame.new(0, feetOffset + 0.05, 0)
	rig:PivotTo(target * hrp.CFrame:Inverse() * rig:GetPivot())
	for _, descendant in rig:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.CanQuery = false
			descendant.CanTouch = false
			descendant.Massless = true
		end
	end
	rig.Parent = model
	weld(root, hrp, "RigWeld")

	-- Ojos de vacío: dan identidad al esqueleto y se leen bien a distancia.
	local head = rig:FindFirstChild("Head") :: BasePart?
	if head then
		for _, side in { -1, 1 } do
			local eye = visualPart({
				Name = "VoidEye",
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(0.32, 0.32, 0.32) * s,
				CFrame = head.CFrame * CFrame.new(side * 0.22 * s, 0.1 * s, -0.5 * s),
				Color = Color3.fromRGB(190, 120, 255),
				Material = Enum.Material.Neon,
			}, model)
			weld(head, eye, "EyeWeld")
		end
		-- Llama del vacío sobre el cráneo (el cliente la apaga en calidad baja).
		local flame = Instance.new("ParticleEmitter")
		flame.Name = "SkullFlame"
		flame.Texture = VisualConfig.Textures.Fire
		flame.Color = ColorSequence.new(Color3.fromRGB(220, 160, 255), Color3.fromRGB(120, 50, 220))
		flame.LightEmission = 1
		flame.LightInfluence = 0
		flame.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7 * s), NumberSequenceKeypoint.new(1, 0) })
		flame.Transparency = NumberSequence.new(0.2, 1)
		flame.Lifetime = NumberRange.new(0.3, 0.5)
		flame.Speed = NumberRange.new(2, 3)
		flame.SpreadAngle = Vector2.new(15, 15)
		flame.Rate = 10
		flame.EmissionDirection = Enum.NormalId.Top
		flame.Parent = head
	end

	buildHealthBar(root, height - root.Size.Y / 2 + 0.9, 3.2 * s)
	return model
end

ModelFactory.Builders = {
	Slime = ModelFactory.buildSlime,
	Skeleton = ModelFactory.buildSkeleton,
} :: { [string]: (Types.EnemyDef) -> Model }

--[[
	Espada del Vendaval: modelo decorativo soldado a la mano derecha. El
	cliente la ilumina según las mejoras (más hojas, rayo) y reproduce el tajo.
]]
function ModelFactory.attachGaleSword(character: Model, hand: BasePart): Model
	local existing = character:FindFirstChild("GaleSword")
	if existing then
		existing:Destroy()
	end
	local palette = VisualConfig.Weapons.GaleSword
	local gold = palette.Guard
	local sword = Instance.new("Model")
	sword.Name = "GaleSword"
	-- La empuñadura es la raíz; la hoja apunta a -Z. Medidas en studs.
	local grip = visualPart({
		Name = "Grip",
		Size = Vector3.new(0.26, 0.26, 1.15),
		CFrame = CFrame.new(),
		Color = Color3.fromRGB(46, 36, 72),
		Material = Enum.Material.Fabric,
	}, sword)
	sword.PrimaryPart = grip
	local function piece(props: { [string]: any }, name: string): BasePart
		local part = visualPart(props, sword)
		weld(grip, part, name)
		return part
	end
	-- Anillas doradas de la empuñadura y pomo con gema.
	for index, z in { 0.38, -0.05, -0.42 } do
		piece({
			Name = "GripBand" .. index,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.08, 0.32, 0.32),
			CFrame = CFrame.new(0, 0, z) * CFrame.Angles(0, math.pi / 2, 0),
			Color = gold,
			Material = Enum.Material.Metal,
		}, "BandWeld")
	end
	piece({
		Name = "Pommel",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.4, 0.4, 0.4),
		CFrame = CFrame.new(0, 0, 0.7),
		Color = gold,
		Material = Enum.Material.Metal,
	}, "PommelWeld")
	piece({
		Name = "PommelGem",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.24, 0.24, 0.24),
		CFrame = CFrame.new(0, 0, 0.86),
		Color = palette.Edge,
		Material = Enum.Material.Neon,
	}, "GemWeld")
	-- Guarda alada: barra central + dos alas inclinadas hacia la empuñadura.
	piece({
		Name = "Guard",
		Size = Vector3.new(0.9, 0.18, 0.28),
		CFrame = CFrame.new(0, 0, -0.62),
		Color = gold,
		Material = Enum.Material.Metal,
	}, "GuardWeld")
	for _, side in { -1, 1 } do
		piece({
			ClassName = "WedgePart",
			Name = "GuardWing",
			Size = Vector3.new(0.12, 0.42, 0.75),
			CFrame = CFrame.new(side * 0.72, 0, -0.5) * CFrame.Angles(0, side * math.rad(28), side * math.rad(90)),
			Color = gold,
			Material = Enum.Material.Metal,
		}, "WingWeld")
	end
	piece({
		Name = "GuardGem",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.3, 0.3, 0.3),
		CFrame = CFrame.new(0, 0, -0.66),
		Color = palette.Edge,
		Material = Enum.Material.Neon,
	}, "GuardGemWeld")
	-- Hoja de un solo filo: cuerpo, filo de energía y punta en cuña.
	local blade = piece({
		Name = "Blade",
		Size = Vector3.new(0.1, 0.36, 3.1),
		CFrame = CFrame.new(0, 0.02, -2.3),
		Color = palette.Blade,
		Material = Enum.Material.Glass,
		Transparency = 0.1,
		Reflectance = 0.15,
	}, "BladeWeld")
	piece({
		Name = "Edge",
		Size = Vector3.new(0.12, 0.08, 3.2),
		CFrame = CFrame.new(0, -0.18, -2.35),
		Color = palette.Edge,
		Material = Enum.Material.Neon,
	}, "EdgeWeld")
	piece({
		ClassName = "WedgePart",
		Name = "Tip",
		Size = Vector3.new(0.1, 0.44, 0.9),
		CFrame = CFrame.new(0, -0.02, -4.28) * CFrame.Angles(0, math.pi, 0),
		Color = palette.Blade,
		Material = Enum.Material.Glass,
		Transparency = 0.1,
	}, "TipWeld")
	piece({
		Name = "Rune",
		Size = Vector3.new(0.12, 0.06, 1.5),
		CFrame = CFrame.new(0, 0.1, -1.7),
		Color = VisualConfig.Palette.PlayerCore,
		Material = Enum.Material.Neon,
		Transparency = 0.2,
	}, "RuneWeld")
	-- Puntos de la estela del tajo (el cliente activa la Trail durante el golpe).
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailBase"
	a0.Position = Vector3.new(0, 0, 1.3)
	a0.Parent = blade
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailTip"
	a1.Position = Vector3.new(0, 0, -2.2)
	a1.Parent = blade

	local gripAttachment = hand:FindFirstChild("RightGripAttachment") :: Attachment?
	local gripOffset = if gripAttachment then gripAttachment.CFrame else CFrame.new(0, -1, 0)
	-- La hoja apunta hacia delante con el brazo en reposo
	-- (las demás piezas siguen a la empuñadura por sus soldaduras).
	grip.CFrame = hand.CFrame * gripOffset * CFrame.Angles(-math.pi / 2, 0, 0) * CFrame.new(0, 0, -0.1)
	local handWeld = Instance.new("Weld")
	handWeld.Name = "HandWeld"
	handWeld.Part0 = hand
	handWeld.Part1 = grip
	handWeld.C0 = hand.CFrame:Inverse() * grip.CFrame
	handWeld.Parent = grip
	sword.Parent = character
	return sword
end

return ModelFactory

      <token name="DevTouchMovementMode">0</token>
    </Properties>
    <Item class="StarterCharacterScripts" referent="219">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="Script" referent="220">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Sustituye al script "Health" por defecto de Roblox: en SkyBonk la vida no se
-- regenera sola; solo el servidor la modifica (daño, mejoras y curaciones).
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="221">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="222">
        <Properties>
          <string name="Name">ClientBootstrap</string>
          <string name="Source"><![CDATA[--[[
	ClientBootstrap
	Arranca los controladores del cliente (Init -> Start) y avisa al servidor
	de que la interfaz está lista para empezar la partida.
]]

-- Espera a que termine la replicación inicial y a que Roblox copie el
-- contenido de StarterPlayerScripts a PlayerScripts: este script puede
-- ejecutarse antes de que existan sus carpetas hermanas.
if not game:IsLoaded() then
	game.Loaded:Wait()
end

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local root = script.Parent

local function waitFor(parent: Instance, path: { string }): Instance
	local current = parent
	for _, name in path do
		current = current:WaitForChild(name)
	end
	return current
end

local REQUIRED_CLIENT_MODULES = {
	{ "UI", "Theme" },
	{ "Util", "Sfx" },
	{ "Util", "FxPool" },
	{ "Util", "AuraSystem" },
	{ "Controllers", "InputController" },
	{ "Controllers", "CameraController" },
	{ "Controllers", "HUDController" },
	{ "Controllers", "UpgradeController" },
	{ "Controllers", "GameOverController" },
	{ "Controllers", "CombatEffectsController" },
	{ "Controllers", "EnemyVisualsController" },
	{ "Controllers", "MusicController" },
	{ "Controllers", "DebugController" },
	{ "Controllers", "CharacterFxController" },
	{ "Controllers", "AmbientController" },
}
for _, path in REQUIRED_CLIENT_MODULES do
	waitFor(root, path)
end
local Shared = ReplicatedStorage:WaitForChild("Shared")
for _, path in
	{
		{ "Net" },
		{ "Signal" },
		{ "Types" },
		{ "Progression" },
		{ "Remotes" },
		{ "Config", "GameConfig" },
		{ "Config", "WeaponConfig" },
		{ "Config", "EnemyConfig" },
		{ "Config", "UpgradeConfig" },
		{ "Config", "VisualConfig" },
	}
do
	waitFor(Shared, path)
end

local Net = require(Shared.Net)
local Theme = require(root.UI.Theme)

local ControllersFolder = root.Controllers
local controllers = {
	InputController = require(ControllersFolder.InputController),
	CameraController = require(ControllersFolder.CameraController),
	HUDController = require(ControllersFolder.HUDController),
	UpgradeController = require(ControllersFolder.UpgradeController),
	GameOverController = require(ControllersFolder.GameOverController),
	CombatEffectsController = require(ControllersFolder.CombatEffectsController),
	EnemyVisualsController = require(ControllersFolder.EnemyVisualsController),
	MusicController = require(ControllersFolder.MusicController),
	DebugController = require(ControllersFolder.DebugController),
	CharacterFxController = require(ControllersFolder.CharacterFxController),
	AmbientController = require(ControllersFolder.AmbientController),
}
local START_ORDER = {
	"InputController",
	"CameraController",
	"HUDController",
	"UpgradeController",
	"GameOverController",
	"CombatEffectsController",
	"EnemyVisualsController",
	"MusicController",
	"DebugController",
	"CharacterFxController",
	"AmbientController",
}

Theme.StartAutoScale()
for _, name in START_ORDER do
	controllers[name].Init(controllers)
end
for _, name in START_ORDER do
	local ok, err = pcall(controllers[name].Start)
	if not ok then
		warn("[SkyBonk] Error al iniciar", name, err)
	end
end

Net.ClientReady:FireServer()
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="223">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="224">
          <Properties>
            <string name="Name">AmbientController</string>
            <string name="Source"><![CDATA[--[[
	AmbientController
	Vida ambiental del mundo (solo cliente, solo visual):

	  • Ciclo de luz local: la hora oscila entre la tarde y el atardecer dorado
	    (VisualConfig.DayCycle); la atmósfera se calienta hacia el atardecer.
	  • Gradación de color por zona (Bosque Sakura, Jardín Corrompido, Santuario
	    Celestial, Ruinas): un tinte suave que ayuda a reconocer dónde estás.
	  • Pétalos de sakura alrededor del jugador mientras está en el bosque.
	  • Cristales con el atributo "Float" flotan y oscilan.
	  • En calidad baja se apagan los emisores marcados "Ambient" y los pétalos.
	  • Atenuado por oclusión: árboles y rocas altos que quedan entre la cámara y
	    el personaje se vuelven semitransparentes (las piezas decorativas no
	    colisionan, así que la cámara de Roblox no las esquiva).
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local VisualConfig = require(ReplicatedStorage.Shared.Config.VisualConfig)
local AuraSystem = require(script.Parent.Parent.Util.AuraSystem)

local AmbientController = {}

local player = Players.LocalPlayer
local floaters: { { Model: Model, Base: CFrame, Amplitude: number, Phase: number } } = {}
local ambientEmitters: { ParticleEmitter } = {}
type Occluder = { Parts: { BasePart }, Center: Vector3, Radius: number, Alpha: number }
local occluders: { Occluder } = {}
local OCCLUDED_ALPHA = 0.72
local petals: ParticleEmitter
local petalPart: Part
local zoneGrade: ColorCorrectionEffect
local currentTint = Color3.new(1, 1, 1)
local startClock = os.clock()

local function collect(map: Instance)
	table.clear(floaters)
	table.clear(ambientEmitters)
	table.clear(occluders)
	for _, descendant in map:GetDescendants() do
		local height = descendant:GetAttribute("KitHeight")
		if descendant:IsA("Model") and type(height) == "number" and height > 5 then
			local parts = {}
			for _, part in descendant:GetDescendants() do
				if part:IsA("BasePart") then
					table.insert(parts, part)
				end
			end
			table.insert(occluders, {
				Parts = parts,
				Center = descendant:GetPivot().Position + Vector3.new(0, height / 2, 0),
				Radius = math.max(descendant:GetAttribute("KitRadius") or 2, height * 0.35),
				Alpha = 0,
			})
		end
		if descendant:IsA("Model") and descendant:GetAttribute("Float") then
			table.insert(floaters, {
				Model = descendant,
				Base = descendant:GetPivot(),
				Amplitude = descendant:GetAttribute("Float"),
				Phase = math.random() * math.pi * 2,
			})
		elseif descendant:IsA("ParticleEmitter") and descendant:GetAttribute("Ambient") then
			table.insert(ambientEmitters, descendant)
		end
	end
end

local function applyQuality()
	local ambient = AuraSystem.GetQuality().Ambient
	for _, emitter in ambientEmitters do
		emitter.Enabled = ambient
	end
end

local function zoneAt(position: Vector3): any?
	local best, bestDistance = nil, math.huge
	for _, zone in VisualConfig.Zones do
		if zone.Center then
			local d = Vector3.new(position.X - zone.Center.X, 0, position.Z - zone.Center.Z).Magnitude
			if d < zone.Radius and d < bestDistance then
				best, bestDistance = zone, d
			end
		end
	end
	return best
end

local function update(dt: number)
	local now = os.clock()
	-- Ciclo de luz (ida y vuelta, sin llegar a la noche).
	local cycle = VisualConfig.DayCycle
	local t = (math.sin((now - startClock) / cycle.Period * math.pi * 2 - math.pi / 2) + 1) / 2
	Lighting.ClockTime = cycle.From + (cycle.To - cycle.From) * t
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		atmosphere.Color = Color3.fromRGB(200, 222, 255):Lerp(Color3.fromRGB(255, 214, 196), t * 0.7)
	end

	for _, floater in floaters do
		local model = floater.Model
		if model.Parent then
			model:PivotTo(
				floater.Base
					* CFrame.new(0, math.sin(now * 1.3 + floater.Phase) * floater.Amplitude, 0)
					* CFrame.Angles(0, now * 0.3, 0)
			)
		end
	end

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local zone = root and zoneAt(root.Position)
	local targetTint = if zone and zone.Tint then zone.Tint else Color3.new(1, 1, 1)
	currentTint = currentTint:Lerp(targetTint, math.min(1, dt * 1.5))
	zoneGrade.TintColor = currentTint

	-- Oclusión: distancia de cada pieza alta al segmento cámara → cabeza.
	local camera = Workspace.CurrentCamera
	if root and camera then
		local from = camera.CFrame.Position
		local to = root.Position + Vector3.new(0, 1.5, 0)
		local segment = to - from
		local lengthSq = segment:Dot(segment)
		for _, occluder in occluders do
			local target = 0
			if lengthSq > 1 then
				local t = math.clamp((occluder.Center - from):Dot(segment) / lengthSq, 0, 1)
				local closest = from + segment * t
				if t < 0.94 and (occluder.Center - closest).Magnitude < occluder.Radius then
					target = OCCLUDED_ALPHA
				end
			end
			if math.abs(target - occluder.Alpha) > 0.01 then
				occluder.Alpha += math.clamp(target - occluder.Alpha, -dt * 4, dt * 4)
				for _, part in occluder.Parts do
					part.LocalTransparencyModifier = occluder.Alpha
				end
			end
		end
	end

	local inForest = zone == VisualConfig.Zones.Forest and AuraSystem.GetQuality().Ambient
	petals.Enabled = inForest == true
	if root and inForest then
		petalPart.CFrame = CFrame.new(root.Position + Vector3.new(0, 18, 0))
	end
end

function AmbientController.Init(_controllers) end

function AmbientController.Start()
	zoneGrade = Instance.new("ColorCorrectionEffect")
	zoneGrade.Name = "SkyBonkZoneGrade"
	zoneGrade.Parent = Lighting

	petalPart = Instance.new("Part")
	petalPart.Name = "SakuraPetals"
	petalPart.Size = Vector3.new(70, 1, 70)
	petalPart.Transparency = 1
	petalPart.Anchored = true
	petalPart.CanCollide = false
	petalPart.CanQuery = false
	petalPart.CanTouch = false
	petalPart.Parent = Workspace
	petals = Instance.new("ParticleEmitter")
	petals.Texture = VisualConfig.Textures.Glow
	petals.Color = ColorSequence.new(VisualConfig.Zones.Forest.Leaf, Color3.fromRGB(255, 220, 235))
	petals.LightInfluence = 0.6
	petals.Size = NumberSequence.new(0.35)
	petals.Squash = NumberSequence.new(-0.6) -- pétalo aplanado
	petals.Lifetime = NumberRange.new(5, 7)
	petals.Speed = NumberRange.new(2, 4)
	petals.EmissionDirection = Enum.NormalId.Bottom
	petals.SpreadAngle = Vector2.new(30, 30)
	petals.Rotation = NumberRange.new(0, 360)
	petals.RotSpeed = NumberRange.new(-120, 120)
	petals.Acceleration = Vector3.new(1.5, -0.5, 0.8)
	petals.Rate = 14
	petals.Enabled = false
	petals.Parent = petalPart

	task.spawn(function()
		local map = Workspace:WaitForChild("Map", 30)
		if map then
			task.wait(1) -- el mapa termina de replicarse
			collect(map)
			applyQuality()
		end
	end)
	AuraSystem.QualityChanged:Connect(applyQuality)
	RunService.RenderStepped:Connect(function(dt)
		debug.profilebegin("SkyBonk.Ambient")
		update(dt)
		debug.profileend()
	end)
end

return AmbientController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="225">
          <Properties>
            <string name="Name">CameraController</string>
            <string name="Source"><![CDATA[--[[
	CameraController
	Cámara en tercera persona estándar de Roblox (modo Classic) con zoom
	inicial alejado para ver a los enemigos cercanos, límites de zoom y
	una sacudida muy suave al recibir daño (vía Humanoid.CameraOffset, sin
	pelear con los scripts de cámara por defecto).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local VisualConfig = require(Shared.Config.VisualConfig)
local Net = require(Shared.Net)

local CameraController = {}

local player = Players.LocalPlayer
local shakeUntil = 0
local shakeConnection: RBXScriptConnection? = nil

local function applyZoom()
	local cfg = GameConfig.Player
	player.CameraMaxZoomDistance = cfg.CameraMaxZoom
	-- Truco estándar: fijar el mínimo al zoom deseado fuerza la distancia
	-- inicial; después se restaura el mínimo real.
	player.CameraMinZoomDistance = cfg.CameraStartZoom
	task.delay(0.2, function()
		player.CameraMinZoomDistance = cfg.CameraMinZoom
	end)
	local camera = Workspace.CurrentCamera
	if camera then
		camera.FieldOfView = cfg.CameraFieldOfView
	end
end

local shakeStrength = 0
local shakeDuration = 1

-- Sacudida breve: `strength` en studs y `duration` en segundos (por defecto, la de recibir daño).
local function shake(strength: number?, duration: number?)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil then
		return
	end
	local newStrength = strength or GameConfig.Effects.CameraShakeStrength
	local newDuration = duration or GameConfig.Effects.CameraShakeTime
	if os.clock() >= shakeUntil or newStrength >= shakeStrength then
		shakeStrength = newStrength
		shakeDuration = newDuration
		shakeUntil = os.clock() + newDuration
	end
	if shakeConnection then
		return
	end
	shakeConnection = RunService.RenderStepped:Connect(function()
		local remaining = shakeUntil - os.clock()
		if remaining <= 0 or humanoid.Parent == nil then
			humanoid.CameraOffset = Vector3.zero
			if shakeConnection then
				shakeConnection:Disconnect()
				shakeConnection = nil
			end
			return
		end
		local strength = shakeStrength * (remaining / shakeDuration)
		humanoid.CameraOffset = Vector3.new(
			(math.random() - 0.5) * strength,
			(math.random() - 0.5) * strength,
			(math.random() - 0.5) * strength
		)
	end)
end

CameraController.Shake = function(strength: number, duration: number)
	shake(strength, duration)
end

--[[
	Golpe de campo de visión (críticos, subida de nivel, jefe): abre el FOV
	`amount` grados y vuelve suavemente al valor base. Nunca se acumula por
	encima del mayor golpe activo y siempre termina en el FOV base.
]]
local fovKick = 0
local fovConnection: RBXScriptConnection? = nil
function CameraController.FovKick(amount: number, recover: number?)
	fovKick = math.max(fovKick, amount)
	local rate = fovKick / (recover or VisualConfig.Camera.FovRecover)
	if fovConnection then
		return
	end
	fovConnection = RunService.RenderStepped:Connect(function(dt)
		local camera = Workspace.CurrentCamera
		fovKick = math.max(0, fovKick - rate * dt)
		if camera then
			camera.FieldOfView = GameConfig.Player.CameraFieldOfView + fovKick
		end
		if fovKick <= 0 and fovConnection then
			fovConnection:Disconnect()
			fovConnection = nil
		end
	end)
end

-- Restablece cualquier efecto de cámara (muerte, reinicio).
function CameraController.Reset()
	fovKick = 0
	shakeUntil = 0
	local camera = Workspace.CurrentCamera
	if camera then
		camera.FieldOfView = GameConfig.Player.CameraFieldOfView
	end
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.CameraOffset = Vector3.zero
	end
end

function CameraController.Init(_controllers) end

function CameraController.Start()
	player.CameraMode = Enum.CameraMode.Classic
	player.CharacterAdded:Connect(function()
		CameraController.Reset()
		applyZoom()
	end)
	if player.Character then
		applyZoom()
	end
	Net.PlayerDamaged.OnClientEvent:Connect(function()
		shake()
	end)
end

return CameraController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="226">
          <Properties>
            <string name="Name">CharacterFxController</string>
            <string name="Source"><![CDATA[--[[
	CharacterFxController
	Presentación anime del personaje local (solo visual, sin efecto en el juego):

	  • Aura según la build real (VisualConfig.PlayerAuraRules, a partir del HUD):
	    Eléctrica (rayo), Ígnea (crítico), Arcana (experiencia/suerte), Celestial
	    (defensa y ráfaga al subir de nivel) y Vacío (vida crítica).
	  • Inclinación procedural: el torso se inclina hacia la curva y hacia atrás
	    al frenar (Motor6D Root.C0; las animaciones usan Transform, no C0).
	  • Estelas de viento al correr deprisa, impulso al saltar y polvo al aterrizar.
	  • Retroceso breve al recibir daño.
	  • Muerte: disolución y desaturación; reaparición: columna de luz.
	El paquete de animaciones (Ninja, de Roblox) lo aplica el servidor al
	script Animate del personaje (MatchService).
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local VisualConfig = require(Shared.Config.VisualConfig)
local Net = require(Shared.Net)
local AuraSystem = require(script.Parent.Parent.Util.AuraSystem)
local FxPool = require(script.Parent.Parent.Util.FxPool)

local CharacterFxController = {}

local MOTION = VisualConfig.Motion
local RULES = VisualConfig.PlayerAuraRules
local player = Players.LocalPlayer

local controllers
local aura: any = nil
-- Articulación raíz del cuerpo: Motor6D (avatares antiguos) o AnimationConstraint
-- (articulaciones actuales de Roblox, cuyo C0 es de solo lectura: se gira su
-- Attachment0, que está en el HumanoidRootPart).
local rootJoint: Motor6D? = nil
local rootAttachment: Attachment? = nil
local rootBaseC0 = CFrame.new()
local humanoid: Humanoid? = nil
local hrp: BasePart? = nil
local lastVelocity = Vector3.zero
local lean = Vector2.zero -- (cabeceo, alabeo)
local recoil = 0
local windTrails: { Trail } = {}
local levelBurstUntil = 0
local deathGrade: ColorCorrectionEffect
local characterConnections: { RBXScriptConnection } = {}

local function chooseProfile(): (string, number)
	local snapshot = controllers.HUDController.GetSnapshot()
	if os.clock() < levelBurstUntil then
		return "Celestial", 1.4
	end
	if snapshot == nil or snapshot.MaxHealth <= 0 then
		return RULES.Default, 0.4
	end
	local stats = snapshot.Stats or {}
	-- La intensidad crece con el nivel: el personaje se ve cada vez más poderoso.
	local intensity = math.clamp(0.35 + snapshot.Level * 0.05, 0.35, 1)
	if snapshot.Health / snapshot.MaxHealth < RULES.CriticalHealthPct then
		return "Void", 1
	elseif (stats.Chain or 0) >= RULES.ChainForElectric then
		return "Electric", math.min(1.2, intensity + 0.2)
	elseif (stats.CritPct or 0) >= RULES.CritPctForFire then
		return "Fire", intensity
	elseif (stats.XpBonusPct or 0) >= RULES.XpBonusForArcane or (stats.Luck or 0) >= 2 then
		return "Arcane", intensity
	elseif (stats.Regen or 0) >= RULES.DefenseForCelestial or (stats.DamageReductionPct or 0) >= 20 then
		return "Celestial", intensity
	end
	return RULES.Default, intensity
end

local function makeWindTrail(root: BasePart, offset: Vector3): Trail
	local a0 = Instance.new("Attachment")
	a0.Name = "WindA0"
	a0.Position = offset
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Name = "WindA1"
	a1.Position = offset + Vector3.new(0, 0.35, 0)
	a1.Parent = root
	local trail = Instance.new("Trail")
	trail.Name = "WindTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.22
	trail.LightEmission = 0.8
	trail.FaceCamera = true
	trail.Color = ColorSequence.new(Color3.new(1, 1, 1), VisualConfig.Palette.Player)
	trail.Transparency = NumberSequence.new(0.35, 1)
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.Enabled = false
	trail.Parent = root
	return trail
end

local function lightPillar(position: Vector3, color: Color3, height: number)
	local pillar = Instance.new("Part")
	pillar.Name = "LightPillar"
	pillar.Shape = Enum.PartType.Cylinder
	pillar.Size = Vector3.new(height, 0.6, 0.6)
	pillar.CFrame = CFrame.new(position + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	pillar.Material = Enum.Material.Neon
	pillar.Color = color
	pillar.Transparency = 0.25
	pillar.Anchored = true
	pillar.CanCollide = false
	pillar.CanQuery = false
	pillar.CanTouch = false
	pillar.CastShadow = false
	pillar.Parent = FxPool.Folder()
	local grow = TweenService:Create(pillar, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(height, 6, 6),
	})
	grow:Play()
	task.delay(0.18, function()
		TweenService:Create(pillar, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = Vector3.new(height, 0.2, 0.2),
			Transparency = 1,
		}):Play()
	end)
	task.delay(0.75, function()
		pillar:Destroy()
	end)
end

local function onCharacter(character: Model)
	for _, connection in characterConnections do
		connection:Disconnect()
	end
	table.clear(characterConnections)
	table.clear(windTrails)
	if aura then
		aura:Destroy()
		aura = nil
	end
	local hum = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if hum == nil or root == nil then
		return
	end
	humanoid, hrp = hum, root
	local lowerTorso = character:WaitForChild("LowerTorso", 3)
	local joint = lowerTorso and lowerTorso:FindFirstChild("Root")
	rootJoint, rootAttachment = nil, nil
	if joint and joint:IsA("Motor6D") then
		rootJoint = joint
		rootBaseC0 = joint.C0
	elseif joint and joint:IsA("AnimationConstraint") and joint.Attachment0 then
		rootAttachment = joint.Attachment0
		rootBaseC0 = joint.Attachment0.CFrame
	end
	lean = Vector2.zero
	recoil = 0
	lastVelocity = Vector3.zero

	-- Aura: el suelo está a HipHeight + media altura del HumanoidRootPart.
	local floorOffset = hum.HipHeight + root.Size.Y / 2
	local profile, intensity = chooseProfile()
	aura = AuraSystem.Attach(root, profile, { Height = 5.4, FloorOffset = floorOffset, Intensity = intensity })

	for _, offset in { Vector3.new(-1.1, 0.4, 0.5), Vector3.new(1.1, 0.4, 0.5), Vector3.new(0, 1.6, 0.6) } do
		table.insert(windTrails, makeWindTrail(root, offset))
	end

	-- Reaparición: columna de luz y ráfaga del aura; la pantalla recupera el color.
	TweenService:Create(deathGrade, TweenInfo.new(0.6), { Saturation = 0, Brightness = 0, Contrast = 0 }):Play()
	local feet = root.Position - Vector3.new(0, floorOffset, 0)
	lightPillar(feet, VisualConfig.Palette.PlayerCore, 40)
	FxPool.Ring(feet + Vector3.new(0, 0.2, 0), 2, 16, 0.5, VisualConfig.Palette.Player, 0.2, 0.2)
	FxPool.Emit("Sparkles", root.Position, 30)
	aura:Burst(1)

	table.insert(
		characterConnections,
		hum.StateChanged:Connect(function(_, new)
			if new == Enum.HumanoidStateType.Jumping then
				FxPool.Ring(
					root.Position - Vector3.new(0, floorOffset - 0.2, 0),
					1.5,
					7,
					0.3,
					Color3.new(1, 1, 1),
					0.4,
					0.12
				)
			elseif new == Enum.HumanoidStateType.Landed then
				if -lastVelocity.Y >= MOTION.LandingMinFall then
					local ground = root.Position - Vector3.new(0, floorOffset - 0.2, 0)
					FxPool.Emit("Dust", ground, math.floor(math.clamp(-lastVelocity.Y / 3, 6, 18)))
					FxPool.Ring(ground, 2, 9, 0.35, Color3.fromRGB(235, 225, 205), 0.45, 0.12)
					recoil = math.max(recoil, MOTION.HitRecoil * 0.6) -- amortigua el aterrizaje
				end
			end
		end)
	)
	table.insert(
		characterConnections,
		hum.Died:Connect(function()
			-- Disolución: partículas del vacío sobre cada pieza y pantalla desaturada.
			for _, part in character:GetChildren() do
				if part:IsA("BasePart") then
					FxPool.Emit("DeathBurst", part.Position, 3, VisualConfig.Palette.Void)
				end
			end
			FxPool.Emit("Sparkles", root.Position, 24)
			TweenService
				:Create(deathGrade, TweenInfo.new(0.8), { Saturation = -0.7, Brightness = -0.05, Contrast = 0.1 })
				:Play()
			controllers.CameraController.Reset()
			if aura then
				aura:SetProfile("Void")
				aura:Burst(0.6)
			end
		end)
	)
end

local function update(dt: number)
	local root, hum = hrp, humanoid
	if root == nil or hum == nil or root.Parent == nil then
		return
	end
	local velocity = root.AssemblyLinearVelocity
	local flat = Vector3.new(velocity.X, 0, velocity.Z)
	local speed = flat.Magnitude
	if dt > 0 and hum.Health > 0 then
		-- Inclinación: aceleración en el espacio del personaje.
		local accel = (flat - Vector3.new(lastVelocity.X, 0, lastVelocity.Z)) / dt
		local localAccel = root.CFrame:VectorToObjectSpace(accel)
		local localVel = root.CFrame:VectorToObjectSpace(flat)
		-- X negativo = hacia delante (al correr); positivo = hacia atrás (al frenar o recibir un golpe).
		local targetPitch = math.clamp(localVel.Z * 0.006 + localAccel.Z * 0.004, -MOTION.MaxLean, MOTION.MaxLean)
		local targetRoll = math.clamp(-localAccel.X * 0.006, -MOTION.MaxLean, MOTION.MaxLean)
		local alpha = math.min(1, dt * MOTION.LeanResponsiveness)
		lean = lean:Lerp(Vector2.new(targetPitch, targetRoll), alpha)
		recoil = math.max(0, recoil - dt * 1.5)
		local tilt = rootBaseC0 * CFrame.Angles(lean.X + recoil, 0, lean.Y)
		if rootJoint and rootJoint.Parent then
			rootJoint.C0 = tilt
		elseif rootAttachment and rootAttachment.Parent then
			rootAttachment.CFrame = tilt
		end
	end
	lastVelocity = velocity

	local fast = speed >= MOTION.SpeedlineSpeed and AuraSystem.GetQuality().Speedlines and hum.Health > 0
	for _, trail in windTrails do
		if trail.Enabled ~= fast then
			trail.Enabled = fast
		end
	end
end

function CharacterFxController.Init(allControllers)
	controllers = allControllers
end

function CharacterFxController.Start()
	AuraSystem.Start()
	deathGrade = Instance.new("ColorCorrectionEffect")
	deathGrade.Name = "SkyBonkDeathGrade"
	deathGrade.Parent = Lighting

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
	Net.LevelUp.OnClientEvent:Connect(function()
		levelBurstUntil = os.clock() + RULES.LevelUpBurst
		if aura then
			aura:SetProfile("Celestial")
			aura:Burst(RULES.LevelUpBurst)
		end
		controllers.CameraController.FovKick(VisualConfig.Camera.LevelUpFovKick, 0.6)
	end)
	Net.PlayerDamaged.OnClientEvent:Connect(function()
		recoil = math.max(recoil, MOTION.HitRecoil)
	end)
	controllers.InputController.ToggleFx:Connect(function()
		AuraSystem.ToggleQuality()
	end)
	-- El aura se revisa 4 veces por segundo (la build cambia al elegir mejoras).
	task.spawn(function()
		while true do
			task.wait(0.25)
			if aura and humanoid and humanoid.Health > 0 then
				local profile, intensity = chooseProfile()
				aura:SetProfile(profile)
				aura:SetIntensity(intensity)
			end
		end
	end)
	RunService.RenderStepped:Connect(function(dt)
		debug.profilebegin("SkyBonk.CharacterFx")
		update(dt)
		debug.profileend()
	end)
end

return CharacterFxController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="227">
          <Properties>
            <string name="Name">CombatEffectsController</string>
            <string name="Source"><![CDATA[--[[
	CombatEffectsController
	Presentación local de lo que calcula el servidor. Nada de lo que ocurre
	aquí afecta al resultado de la partida.

	  • Espada del Vendaval: tajo (animación de Roblox "R15 Sword Slash") con
	    estela; la velocidad del tajo sigue al enfriamiento real sin pasar de
	    MaxSlashSpeed. Las hojas salen al final de la anticipación y llegan a su
	    objetivo cuando el servidor aplica el impacto (CombatHits).
	  • Filo de Tormenta: rayos entre los objetivos encadenados.
	  • Impactos confirmados: chispas, números de daño (críticos destacados),
	    sonido y reacción del enemigo (EnemyVisualsController).
	  • Gemas: aparición con salto, flotación, vuelo hacia el jugador mientras
	    el servidor las atrae, y destello al recogerlas.
	  • Subida de nivel, rotura de Cristales de Esencia y daño recibido.
	  • La espada brilla más con cada hoja extra y chispea con Filo de Tormenta.

	Todo se anima desde un único RenderStepped; hojas, rayos y números de daño
	se reutilizan mediante pools.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local WeaponConfig = require(Shared.Config.WeaponConfig)
local Net = require(Shared.Net)
local VisualConfig = require(Shared.Config.VisualConfig)
local Sfx = require(script.Parent.Parent.Util.Sfx)
local FxPool = require(script.Parent.Parent.Util.FxPool)

local CombatEffectsController = {}

local FX = GameConfig.Effects
local EXP = GameConfig.Experience
local player = Players.LocalPlayer

local controllers
local effectsFolder: Folder
local numbersAnchor: Part
local damageHighlight: Highlight

type Blade = {
	Part: BasePart,
	Trail: Trail,
	From: Vector3,
	Target: Model?,
	Fallback: Vector3,
	Start: number,
	Duration: number,
	Windup: number,
	Spin: number,
	Chain: { any },
}
type Bolt = { Parts: { BasePart }, Until: number }
type GemVisual = { Part: BasePart, Base: CFrame, Phase: number, Born: number, Speed: number, Flying: boolean }
type NumberEntry = { Attachment: Attachment, Gui: BillboardGui, Label: TextLabel, Busy: boolean }

local blades: { Blade } = {}
local bladePool: { Blade } = {}
local bolts: { Bolt } = {}
local boltPool: { BasePart } = {}
local gemVisuals: { [BasePart]: GemVisual } = {}
local numberPool: { NumberEntry } = {}
local numbersInUse = 0
local gemComboUntil = 0
local gemCombo = 0

-- Animación del tajo del jugador.
local slashAnimations: { Animation } = {}
local slashTracks: { AnimationTrack } = {}
local slashIndex = 0
local swordTrail: Trail? = nil
local swordTrailUntil = 0
local swordGlow = 0
local slashSide = 1 -- alterna tajos de izquierda a derecha y al revés
local lastCritKickAt = 0
local SWORD = VisualConfig.Weapons.GaleSword

local function character(): Model?
	return player.Character
end

local function rootPart(): BasePart?
	local c = character()
	return c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function modelPosition(model: Model?): Vector3?
	if model == nil or model.Parent == nil then
		return nil
	end
	local root = model.PrimaryPart
	return root and root.Position
end

------------------------------------------------------------------ Números
local function acquireNumber(): NumberEntry?
	if numbersInUse >= FX.MaxDamageNumbers then
		return nil -- demasiados a la vez: se omite (no se tapa el combate)
	end
	local entry = table.remove(numberPool)
	if entry == nil then
		local attachment = Instance.new("Attachment")
		attachment.Parent = numbersAnchor
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(110, 44)
		gui.AlwaysOnTop = true
		gui.LightInfluence = 0
		gui.MaxDistance = 140
		gui.Adornee = attachment
		gui.Parent = attachment
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextSize = 26
		label.TextStrokeTransparency = 0.2
		label.Parent = gui
		entry = { Attachment = attachment, Gui = gui, Label = label, Busy = false }
	end
	numbersInUse += 1
	return entry
end

local function showDamageNumber(position: Vector3, amount: number, killed: boolean, crit: boolean, chain: boolean)
	local entry = acquireNumber()
	if entry == nil then
		return
	end
	entry.Attachment.WorldPosition = position
		+ Vector3.new((math.random() - 0.5) * 1.6, 2.6, (math.random() - 0.5) * 1.6)
	local text = tostring(math.max(1, math.floor(amount + 0.5)))
	entry.Label.Text = if crit then text .. "!" else text
	entry.Label.TextColor3 = if crit
		then Color3.fromRGB(255, 150, 60)
		elseif killed then Color3.fromRGB(255, 214, 90)
		elseif chain then Color3.fromRGB(170, 190, 255)
		else Color3.fromRGB(255, 255, 255)
	local size = if crit then 36 elseif killed then 29 elseif chain then 21 else 24
	entry.Label.TextSize = size * 0.6
	entry.Label.TextTransparency = 0
	entry.Label.TextStrokeTransparency = 0.2
	entry.Gui.StudsOffset = Vector3.zero
	entry.Gui.Enabled = true
	local life = FX.DamageNumberLifetime * (if crit then 1.3 else 1)
	TweenService
		:Create(entry.Label, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { TextSize = size })
		:Play()
	local info = TweenInfo.new(life, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(entry.Gui, info, { StudsOffset = Vector3.new(0, 2.4, 0) }):Play()
	TweenService:Create(
		entry.Label,
		TweenInfo.new(life * 0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, life * 0.5),
		{
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		}
	):Play()
	task.delay(life, function()
		entry.Gui.Enabled = false
		numbersInUse -= 1
		table.insert(numberPool, entry)
	end)
end

------------------------------------------------------------------- Hojas
local function acquireBlade(color: Color3, scale: number): Blade
	local blade = table.remove(bladePool)
	if blade == nil then
		local part = Instance.new("Part")
		part.Name = "GaleBlade"
		part.Material = Enum.Material.Neon
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = part
		local a0 = Instance.new("Attachment")
		a0.Name = "A0"
		a0.Parent = part
		local a1 = Instance.new("Attachment")
		a1.Name = "A1"
		a1.Parent = part
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 0.18
		trail.LightEmission = 1
		trail.FaceCamera = true
		trail.Transparency = NumberSequence.new(0.1, 1)
		trail.WidthScale = NumberSequence.new(1, 0.2)
		trail.Parent = part
		blade = {
			Part = part,
			Trail = trail,
			From = Vector3.zero,
			Target = nil,
			Fallback = Vector3.zero,
			Start = 0,
			Duration = 0.2,
			Windup = 0.1,
			Spin = 0,
			Chain = {},
		}
	end
	local b = blade :: Blade
	-- Hoja en forma de media luna: ancha y plana (se lee como un corte de viento).
	b.Part.Size = Vector3.new(2.6 * scale, 0.2, 0.9 * scale)
	local a0 = b.Part:FindFirstChild("A0") :: Attachment
	local a1 = b.Part:FindFirstChild("A1") :: Attachment
	a0.Position = Vector3.new(-1.2 * scale, 0, 0)
	a1.Position = Vector3.new(1.2 * scale, 0, 0)
	b.Part.Color = color
	b.Trail.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	return b
end

local function releaseBlade(blade: Blade)
	blade.Trail.Enabled = false
	blade.Part.Parent = nil
	blade.Target = nil
	blade.Chain = {}
	table.insert(bladePool, blade)
end

-- Rayo quebrado entre dos puntos (Filo de Tormenta).
local function drawBolt(from: Vector3, to: Vector3)
	local parts: { BasePart } = {}
	local segments = 4
	local previous = from
	for i = 1, segments do
		local t = i / segments
		local point = from:Lerp(to, t)
		if i < segments then
			point += Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 1.6
		end
		local part = table.remove(boltPool)
		if part == nil then
			local created = Instance.new("Part")
			created.Name = "Bolt"
			created.Material = Enum.Material.Neon
			created.Color = Color3.fromRGB(190, 200, 255)
			created.Anchored = true
			created.CanCollide = false
			created.CanQuery = false
			created.CanTouch = false
			created.CastShadow = false
			part = created
		end
		local p = part :: BasePart
		local length = (point - previous).Magnitude
		p.Size = Vector3.new(0.18, 0.18, length)
		p.CFrame = CFrame.lookAt((previous + point) / 2, point)
		p.Transparency = 0
		p.Parent = effectsFolder
		table.insert(parts, p)
		previous = point
	end
	table.insert(bolts, { Parts = parts, Until = os.clock() + 0.12 })
	FxPool.Emit("Spark", to, 6)
end

-- La hoja ha llegado: chispa y rayos (el daño y el número llegan con CombatHits).
local function onBladeArrived(blade: Blade, position: Vector3)
	FxPool.Emit("HitSparks", position, 5)
	local previous = position
	for _, link in blade.Chain do
		local delay = math.max(0, link.Delay - blade.Duration - blade.Windup)
		local fromPoint = previous
		task.delay(delay, function()
			local target = modelPosition(link.Model) or link.Position
			drawBolt(fromPoint + Vector3.new(0, 0.6, 0), target + Vector3.new(0, 0.6, 0))
			Sfx.PlayAt("Chain", target, 1.1)
		end)
		previous = modelPosition(link.Model) or link.Position
	end
end

------------------------------------------------------------ Tajo jugador
local function swordOf(c: Model?): Model?
	return c and c:FindFirstChild("GaleSword") :: Model?
end

local function ensureSwordTrail(): Trail?
	local sword = swordOf(character())
	local blade = sword and sword:FindFirstChild("Blade")
	if blade == nil then
		return nil
	end
	local existing = blade:FindFirstChild("SlashTrail") :: Trail?
	if existing then
		return existing
	end
	local trail = Instance.new("Trail")
	trail.Name = "SlashTrail"
	trail.Attachment0 = blade:FindFirstChild("TrailBase") :: Attachment
	trail.Attachment1 = blade:FindFirstChild("TrailTip") :: Attachment
	trail.Lifetime = 0.16
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(Color3.fromRGB(150, 240, 255), Color3.new(1, 1, 1))
	trail.Transparency = NumberSequence.new(0.15, 1)
	trail.Enabled = false
	trail.Parent = blade
	return trail
end

local function loadSlashTracks()
	table.clear(slashTracks)
	local c = character()
	local humanoid = c and c:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if humanoid == nil or animator == nil or humanoid.RigType ~= Enum.HumanoidRigType.R15 then
		return -- R6: la espada y las hojas siguen funcionando, sin animación de brazo
	end
	for _, anim in slashAnimations do
		local ok, t = pcall(animator.LoadAnimation, animator, anim)
		if ok and t then
			t.Priority = Enum.AnimationPriority.Action
			t.Looped = false
			table.insert(slashTracks, t)
		end
	end
end

local function playSlash(cooldown: number)
	if #slashTracks == 0 then
		loadSlashTracks()
	end
	slashIndex = slashIndex % math.max(1, #slashTracks) + 1
	local t = slashTracks[slashIndex]
	if t then
		-- El tajo ocupa como mucho el 85 % del enfriamiento y nunca va más rápido de MaxSlashSpeed.
		local length = if t.Length > 0 then t.Length else 0.6
		local speed = math.clamp(length / math.max(0.15, cooldown * 0.85), 1, FX.MaxSlashSpeed)
		t:Play(0.05, 1, speed)
	end
	swordTrail = swordTrail or ensureSwordTrail()
	if swordTrail and swordTrail.Parent then
		swordTrail.Enabled = true
		swordTrailUntil = os.clock() + 0.28
	else
		swordTrail = nil
	end
end

local function swordTip(): Vector3?
	local sword = swordOf(character())
	local blade = sword and sword:FindFirstChild("Blade") :: BasePart?
	return blade and (blade.CFrame * CFrame.new(0, 0, -1.2)).Position
end

local function onCombatFx(attack)
	if type(attack) ~= "table" or type(attack.Shots) ~= "table" or typeof(attack.Origin) ~= "Vector3" then
		return
	end
	local weapon = WeaponConfig[attack.WeaponId]
	local color = weapon and weapon.Color or Color3.new(1, 1, 1)
	local windup = if type(attack.Windup) == "number" then attack.Windup else 0.1
	local cooldown = if type(attack.Cooldown) == "number" then attack.Cooldown else 1
	playSlash(cooldown)
	task.delay(windup * 0.6, function()
		Sfx.Play("Attack", 1 + (#attack.Shots - 1) * 0.04)
	end)
	-- Corte en media luna en el instante del tajo, orientado al primer objetivo.
	local firstShot = attack.Shots[1]
	task.delay(windup * 0.8, function()
		local root = rootPart()
		if root == nil or firstShot == nil or typeof(firstShot.Position) ~= "Vector3" then
			return
		end
		local chest = root.Position + Vector3.new(0, 1.1, 0)
		local target = Vector3.new(firstShot.Position.X, chest.Y, firstShot.Position.Z)
		if (target - chest).Magnitude < 0.5 then
			return
		end
		local facing = CFrame.lookAt(chest, target)
		slashSide = -slashSide
		local radius = 3.2 * (1 + swordGlow * 0.1)
		FxPool.Slash(
			facing * CFrame.new(0, 0, -2.4),
			radius,
			SWORD.Slash,
			slashSide * (0.3 + math.random() * 0.25),
			0.2
		)
	end)
	local now = os.clock()
	local scale = 1 + swordGlow * 0.08
	for index, shot in attack.Shots do
		if typeof(shot.Position) ~= "Vector3" or type(shot.Delay) ~= "number" then
			continue
		end
		local blade = acquireBlade(color, scale)
		local origin = (rootPart() and (rootPart() :: BasePart).Position or attack.Origin) + Vector3.new(0, 1.4, 0)
		blade.From = origin
		blade.Target = if typeof(shot.Model) == "Instance" then shot.Model else nil
		blade.Fallback = shot.Position
		blade.Start = now + windup + (index - 1) * 0.015
		blade.Duration = math.max(0.06, shot.Delay - windup)
		blade.Spin = math.random() * math.pi
		blade.Chain = if type(shot.Chain) == "table" then shot.Chain else {}
		blade.Windup = windup
		blade.Part.CFrame = CFrame.lookAt(origin, shot.Position)
		blade.Part.Parent = effectsFolder
		blade.Trail:Clear()
		blade.Trail.Enabled = false
		table.insert(blades, blade)
	end
end

local function onCombatHits(payload)
	if type(payload) ~= "table" or type(payload.Hits) ~= "table" then
		return
	end
	local anyCrit, anyKill = false, false
	for _, hit in payload.Hits do
		if typeof(hit.Position) ~= "Vector3" or type(hit.Damage) ~= "number" then
			continue
		end
		local model = if typeof(hit.Model) == "Instance" then hit.Model else nil
		local position = modelPosition(model) or hit.Position
		showDamageNumber(position, hit.Damage, hit.Killed == true, hit.Crit == true, hit.Chain == true)
		local impact = position + Vector3.new(0, 1, 0)
		if hit.Crit then
			-- Crítico: estrella dorada, destello mayor y un pequeño golpe de FOV.
			anyCrit = true
			FxPool.Emit("CritSparks", impact, 10)
			FxPool.Star(impact, SWORD.SlashCrit, 6)
			FxPool.ImpactFlash(impact, SWORD.SlashCrit, 3)
			local now = os.clock()
			if now - lastCritKickAt > 0.4 then
				lastCritKickAt = now
				controllers.CameraController.FovKick(VisualConfig.Camera.CritFovKick, 0.25)
			end
		elseif hit.Chain then
			FxPool.ImpactFlash(impact, Color3.fromRGB(190, 200, 255), 1.6)
		else
			FxPool.ImpactFlash(impact, Color3.new(1, 1, 1), 1.4 + math.random() * 0.8)
		end
		if hit.Killed then
			anyKill = true
			FxPool.Ring(position - Vector3.new(0, 1.3, 0), 1, 6, 0.25, SWORD.Edge, 0.35, 0.12)
		end
		if model then
			controllers.EnemyVisualsController.OnHit(model, hit.Crit == true)
		end
	end
	if anyCrit then
		Sfx.Play("Crit", 1)
	elseif anyKill then
		Sfx.Play("HitHeavy", 0.95 + math.random() * 0.1)
	else
		Sfx.Play("Hit", 1)
	end
end

------------------------------------------------------------------- Gemas
local function trackGem(part: Instance)
	if part:IsA("BasePart") and not gemVisuals[part] then
		gemVisuals[part] = {
			Part = part,
			Base = part.CFrame,
			Phase = math.random() * math.pi * 2,
			Born = os.clock(),
			Speed = EXP.AttractSpeed,
			Flying = false,
		}
		if part.Name == "XpGemLucky" then
			local sparkle = Instance.new("Sparkles")
			sparkle.SparkleColor = Color3.fromRGB(255, 220, 120)
			sparkle.Parent = part
		end
	end
end

local function untrackGem(part: Instance)
	gemVisuals[part :: BasePart] = nil
end

local function onGemCollected(info)
	if type(info) ~= "table" or type(info.Positions) ~= "table" then
		return
	end
	local now = os.clock()
	gemCombo = if now < gemComboUntil then math.min(gemCombo + 1, 14) else 0
	gemComboUntil = now + 0.7
	-- La escala sube con las recogidas seguidas: recompensa sonora sin saturar.
	Sfx.Play("GemPickup", 1 + gemCombo * 0.045)
	local root = rootPart()
	if root then
		FxPool.Emit("GemPop", root.Position + Vector3.new(0, 0.5, 0), math.min(4 + #info.Positions * 2, 14))
	end
end

-------------------------------------------------------------- Mundo y jugador
local function onWorldFx(event)
	if type(event) ~= "table" or typeof(event.Position) ~= "Vector3" then
		return
	end
	if event.Kind == "CrystalBreak" then
		local gold = Color3.fromRGB(255, 196, 92)
		FxPool.Emit("DeathBurst", event.Position + Vector3.new(0, 3, 0), 30, gold)
		FxPool.Emit("Sparkles", event.Position + Vector3.new(0, 2, 0), 24)
		FxPool.Ring(event.Position + Vector3.new(0, 0.3, 0), 2, 16, 0.5, gold, 0.2, 0.25)
		Sfx.PlayAt("CrystalBreak", event.Position, 1, 120)
	end
end

local function onLevelUp()
	local root = rootPart()
	Sfx.Play("LevelUp")
	if root == nil then
		return
	end
	local position = root.Position
	FxPool.Emit("Sparkles", position, 46)
	local ground = position - Vector3.new(0, 2.8, 0)
	FxPool.Ring(ground, 4, 30, 0.6, Color3.fromRGB(255, 214, 90), 0.15, 0.3)
	FxPool.Ring(ground, 2, 18, 0.45, Color3.fromRGB(140, 240, 255), 0.3, 0.2)
	-- Columna de luz breve sobre el jugador.
	local pillar = Instance.new("Part")
	pillar.Name = "LevelPillar"
	pillar.Shape = Enum.PartType.Cylinder
	pillar.Size = Vector3.new(40, 5, 5)
	pillar.CFrame = CFrame.new(ground + Vector3.new(0, 20, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	pillar.Material = Enum.Material.Neon
	pillar.Color = Color3.fromRGB(255, 230, 150)
	pillar.Transparency = 0.35
	pillar.Anchored = true
	pillar.CanCollide = false
	pillar.CanQuery = false
	pillar.CanTouch = false
	pillar.CastShadow = false
	pillar.Parent = effectsFolder
	TweenService:Create(pillar, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(40, 0.4, 0.4),
		Transparency = 1,
	}):Play()
	task.delay(0.55, function()
		pillar:Destroy()
	end)
end

local highlightToken = 0
local function onPlayerDamaged()
	Sfx.Play("PlayerHurt")
	local c = character()
	if c == nil then
		return
	end
	highlightToken += 1
	local token = highlightToken
	damageHighlight.Adornee = c
	damageHighlight.Enabled = true
	task.delay(0.15, function()
		if token == highlightToken then
			damageHighlight.Enabled = false
		end
	end)
end

local function onEnemyDied(info)
	if type(info) ~= "table" or typeof(info.Position) ~= "Vector3" then
		return
	end
	local color = if typeof(info.Color) == "Color3" then info.Color else Color3.fromRGB(150, 80, 230)
	local model = if typeof(info.Model) == "Instance" then info.Model else nil
	controllers.EnemyVisualsController.OnDied(model, info.Position, color, info.EnemyId)
end

-- Brillo de la espada según las mejoras (más hojas = más brillo; rayo = chispas).
local function onHud(snapshot)
	if type(snapshot) ~= "table" or type(snapshot.Stats) ~= "table" then
		return
	end
	local projectiles = snapshot.Stats.Projectiles or 1
	local chain = snapshot.Stats.Chain or 0
	swordGlow = math.max(0, projectiles - 1) + chain
	local sword = swordOf(character())
	local edge = sword and sword:FindFirstChild("Edge") :: BasePart?
	if edge then
		edge.Size = Vector3.new(0.12 + 0.04 * swordGlow, 0.12 + 0.04 * swordGlow, 3.2)
		edge.Color = if chain > 0 then Color3.fromRGB(180, 190, 255) else Color3.fromRGB(120, 235, 255)
		local sparks = edge:FindFirstChild("StormSparks") :: ParticleEmitter?
		if chain > 0 and sparks == nil then
			local emitter = Instance.new("ParticleEmitter")
			emitter.Name = "StormSparks"
			emitter.Color = ColorSequence.new(Color3.fromRGB(200, 210, 255))
			emitter.Size = NumberSequence.new(0.18, 0)
			emitter.Lifetime = NumberRange.new(0.1, 0.2)
			emitter.Speed = NumberRange.new(2, 5)
			emitter.SpreadAngle = Vector2.new(180, 180)
			emitter.LightEmission = 1
			emitter.Parent = edge
			sparks = emitter
		end
		if sparks then
			sparks.Rate = chain * 10
		end
	end
end

--------------------------------------------------------- Bucle visual
local function update(dt: number)
	debug.profilebegin("SkyBonk.CombatFx")
	local now = os.clock()

	-- Hojas en vuelo: persiguen la posición actual del objetivo.
	for index = #blades, 1, -1 do
		local blade = blades[index]
		local t = (now - blade.Start) / blade.Duration
		if t < 0 then
			-- Aún en la anticipación: la hoja espera en la punta de la espada.
			local tip = swordTip()
			if tip then
				blade.From = tip
			end
			continue
		end
		local target = (modelPosition(blade.Target) or blade.Fallback) + Vector3.new(0, 0.8, 0)
		if t >= 1 then
			table.remove(blades, index)
			onBladeArrived(blade, target)
			releaseBlade(blade)
		else
			if not blade.Trail.Enabled then
				blade.Trail.Enabled = true
			end
			local eased = 1 - (1 - t) * (1 - t)
			local position = blade.From:Lerp(target, eased) + Vector3.new(0, math.sin(t * math.pi) * 1.2, 0)
			blade.Part.CFrame = CFrame.lookAt(position, target)
				* CFrame.Angles(0, 0, blade.Spin + t * 6)
				* CFrame.Angles(0, math.pi / 2, 0)
		end
	end

	for index = #bolts, 1, -1 do
		local bolt = bolts[index]
		if now >= bolt.Until then
			for _, part in bolt.Parts do
				part.Parent = nil
				table.insert(boltPool, part)
			end
			table.remove(bolts, index)
		end
	end

	if swordTrail and now >= swordTrailUntil then
		swordTrail.Enabled = false
	end

	-- Gemas: aparición con salto, flotación y vuelo hacia el jugador cuando las atrae.
	local root = rootPart()
	for part, visual in gemVisuals do
		if part.Parent == nil then
			gemVisuals[part] = nil
			continue
		end
		if part:GetAttribute("Attracting") and root then
			visual.Flying = true
			visual.Speed += EXP.AttractAcceleration * dt
			local target = root.Position
			local offset = target - visual.Base.Position
			local distance = offset.Magnitude
			local step = math.min(distance, visual.Speed * dt)
			if distance > 1e-3 then
				visual.Base = CFrame.new(visual.Base.Position + offset / distance * step)
			end
			part.CFrame = visual.Base * CFrame.Angles(0, now * 12, 0)
			continue
		end
		local age = now - visual.Born
		local pop = if age < 0.3 then math.sin(age / 0.3 * math.pi) * 1.4 else 0
		part.CFrame = visual.Base
			* CFrame.new(0, pop + math.sin(now * 3 + visual.Phase) * 0.25, 0)
			* CFrame.Angles(0, now * 2.5, 0)
	end
	debug.profileend()
end

function CombatEffectsController.Init(allControllers)
	controllers = allControllers
end

function CombatEffectsController.Start()
	FxPool.Start()
	effectsFolder = FxPool.Folder()

	numbersAnchor = Instance.new("Part")
	numbersAnchor.Name = "NumbersAnchor"
	numbersAnchor.Size = Vector3.new(0.2, 0.2, 0.2)
	numbersAnchor.Transparency = 1
	numbersAnchor.Anchored = true
	numbersAnchor.CanCollide = false
	numbersAnchor.CanQuery = false
	numbersAnchor.CanTouch = false
	numbersAnchor.CFrame = CFrame.new()
	numbersAnchor.Parent = effectsFolder

	damageHighlight = Instance.new("Highlight")
	damageHighlight.Name = "DamageHighlight"
	damageHighlight.FillColor = Color3.fromRGB(255, 60, 60)
	damageHighlight.FillTransparency = 0.45
	damageHighlight.OutlineTransparency = 1
	damageHighlight.DepthMode = Enum.HighlightDepthMode.Occluded
	damageHighlight.Enabled = false
	damageHighlight.Parent = effectsFolder

	-- Solo el tajo (0,5 s): la estocada de Roblox dura 1,5 s y no cabe en el enfriamiento.
	for _, id in { GameConfig.Animations.PlayerSlashR15 } do
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		table.insert(slashAnimations, anim)
	end
	player.CharacterAdded:Connect(function()
		table.clear(slashTracks)
		swordTrail = nil
	end)

	task.spawn(function()
		local list: { Instance } = Sfx.Preload()
		for _, anim in slashAnimations do
			table.insert(list, anim)
		end
		pcall(function()
			game:GetService("ContentProvider"):PreloadAsync(list)
		end)
	end)

	local orbs = Workspace:WaitForChild("ExperienceOrbs")
	orbs.ChildAdded:Connect(trackGem)
	orbs.ChildRemoved:Connect(untrackGem)
	for _, child in orbs:GetChildren() do
		trackGem(child)
	end

	Net.CombatFx.OnClientEvent:Connect(onCombatFx)
	Net.CombatHits.OnClientEvent:Connect(onCombatHits)
	Net.EnemyDied.OnClientEvent:Connect(onEnemyDied)
	Net.GemCollected.OnClientEvent:Connect(onGemCollected)
	Net.LevelUp.OnClientEvent:Connect(onLevelUp)
	Net.PlayerDamaged.OnClientEvent:Connect(onPlayerDamaged)
	Net.WorldFx.OnClientEvent:Connect(onWorldFx)
	Net.HudUpdate.OnClientEvent:Connect(onHud)

	RunService.RenderStepped:Connect(update)
end

return CombatEffectsController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="228">
          <Properties>
            <string name="Name">DebugController</string>
            <string name="Source"><![CDATA[--[[
	DebugController (solo Roblox Studio)
	Piloto automático para medir el ritmo de la partida con física real.
	Se activa desde la barra de comandos del servidor:
	    _G.SkyBonkDebug.Autopilot(true)
	que marca al jugador con el atributo "Autopilot". Mientras está activo:
	  • desactiva los controles y mueve al personaje como un jugador básico
	    (huye de los enemigos cercanos, recoge gemas, evita el borde),
	  • elige mejoras a través de la interfaz real (InputController.SelectOption).
	Fuera de Studio no hace nada.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local DebugController = {}

local player = Players.LocalPlayer
local controllers
local controls: any = nil
local active = false
local nextChoiceAt = 0
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

local PREFERENCE =
	{ "TwinBlade", "SharpEdge", "SwiftStrike", "StormEdge", "KeenStrike", "CelestialMagnet", "BasaltHeart", "VitalSap" }

local function setControls(enabled: boolean)
	if controls == nil then
		local ok, module = pcall(function()
			return require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript)
		end)
		controls = ok and module:GetControls() or nil
	end
	if controls then
		if enabled then
			controls:Enable()
		else
			controls:Disable()
		end
	end
end

local function groundAhead(position: Vector3): boolean
	local map = Workspace:FindFirstChild("Map")
	if map == nil then
		return true
	end
	rayParams.FilterDescendantsInstances = { map }
	return Workspace:Raycast(position + Vector3.new(0, 6, 0), Vector3.new(0, -40, 0), rayParams) ~= nil
end

local function steer()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if humanoid == nil or root == nil or humanoid.Health <= 0 then
		return
	end
	local position = root.Position
	local flee = Vector3.zero
	local threats = 0
	for _, model in Workspace.ActiveEnemies:GetChildren() do
		local enemyRoot = (model :: Model).PrimaryPart
		if enemyRoot and not model:GetAttribute("Dead") then
			local away = Vector3.new(position.X - enemyRoot.Position.X, 0, position.Z - enemyRoot.Position.Z)
			local distance = away.Magnitude
			if distance < 11 and distance > 0.01 then
				flee += away.Unit * (11 - distance)
				threats += 1
			end
		end
	end
	local target, best = nil, 32
	for _, gem in Workspace.ExperienceOrbs:GetChildren() do
		local d = ((gem :: BasePart).Position - position).Magnitude
		if d < best then
			best = d
			target = (gem :: BasePart).Position
		end
	end
	local healthy = humanoid.Health > humanoid.MaxHealth * 0.45
	local direction = Vector3.zero
	if target and (threats == 0 or (healthy and best < 14)) then
		direction = Vector3.new(target.X - position.X, 0, target.Z - position.Z).Unit
	elseif threats > 0 then
		direction = flee.Unit
	else
		-- Sin peligro ni gemas: se acerca despacio al centro para atraer enemigos.
		local toCenter = Vector3.new(-position.X, 0, -position.Z)
		if toCenter.Magnitude > 25 then
			direction = toCenter.Unit * 0.6
		end
	end
	if direction.Magnitude > 0 and not groundAhead(position + direction.Unit * 6) then
		direction = Vector3.new(-position.X, 0, -position.Z).Unit
	end
	humanoid:Move(direction, false)
end

local function chooseUpgrade()
	if not controllers.UpgradeController.IsOpen() or os.clock() < nextChoiceAt then
		return
	end
	nextChoiceAt = os.clock() + 0.6
	local ids = controllers.UpgradeController.GetOptionIds()
	local pick = 1
	for _, preferred in PREFERENCE do
		local index = table.find(ids, preferred)
		if index then
			pick = index
			break
		end
	end
	controllers.InputController.SelectOption:Fire(pick)
end

function DebugController.Init(allControllers)
	controllers = allControllers
end

function DebugController.Start()
	if not RunService:IsStudio() then
		return
	end
	local function refresh()
		local enabled = player:GetAttribute("Autopilot") == true
		if enabled ~= active then
			active = enabled
			setControls(not enabled)
			print("[SkyBonk] Piloto automático", if enabled then "activado" else "desactivado")
		end
	end
	player:GetAttributeChangedSignal("Autopilot"):Connect(refresh)
	refresh()
	RunService.Heartbeat:Connect(function()
		if not active then
			return
		end
		if controllers.UpgradeController.IsOpen() then
			chooseUpgrade()
		else
			nextChoiceAt = math.max(nextChoiceAt, os.clock() + 0.4)
			steer()
		end
	end)
end

return DebugController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="229">
          <Properties>
            <string name="Name">EnemyVisualsController</string>
            <string name="Source"><![CDATA[--[[
	EnemyVisualsController
	Animación de todos los enemigos a partir del estado que publica el
	servidor en cada modelo (State, StateAt, StateDuration, HopSeed). Solo
	presentación: nada de lo que ocurre aquí afecta al combate.

	Slimes (procedural, sobre BodyWeld.C0 y BodyMesh.Scale):
	  aparición (emergen del suelo), saltos sincronizados con el movimiento real
	  del servidor (mismo reloj y semilla), anticipación (se agachan y se tiñen),
	  salto de ataque, golpe en área del Rey (anillo de peligro), retroceso al
	  recibir un impacto y muerte (se aplastan, estallan y se desvanecen).
	Esqueletos (Animator + animaciones de Roblox):
	  reposo / andar / correr según la velocidad real, tajo sincronizado con la
	  anticipación, inclinación al recibir un impacto, aparición desde el suelo
	  y muerte desmontándose (piezas locales con física, como máximo MaxRagdolls).

	Un único RenderStepped recorre todos los enemigos.
]]

local ContentProvider = game:GetService("ContentProvider")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local VisualConfig = require(Shared.Config.VisualConfig)
local EnemyConfig = require(Shared.Config.EnemyConfig)
local Sfx = require(script.Parent.Parent.Util.Sfx)
local FxPool = require(script.Parent.Parent.Util.FxPool)
local AuraSystem = require(script.Parent.Parent.Util.AuraSystem)

local EnemyVisualsController = {}

local TAU = math.pi * 2
local COMBAT = GameConfig.Combat
local FX = GameConfig.Effects
local ANIMS = GameConfig.Animations
local WARNING = Color3.fromRGB(255, 70, 90)
local player = Players.LocalPlayer

type Visual = {
	Model: Model,
	Def: any,
	Kind: string,
	Root: BasePart,
	Scale: number,
	State: string,
	StateAt: number,
	StateDuration: number,
	HopSeed: number,
	Bar: BillboardGui?,
	Fill: Frame?,
	FlashUntil: number,
	LastPosition: Vector3,
	Speed: number,
	Dying: boolean,
	DyingAt: number,
	Connections: { RBXScriptConnection },
	-- Slime
	Weld: Weld?,
	BaseC0: CFrame,
	Mesh: SpecialMesh?,
	Body: BasePart?,
	BodyColor: Color3,
	Extras: { BasePart }, -- ojos, núcleo, corona (se ocultan al aparecer/morir)
	Telegraph: Part?,
	Aura: any?, -- aura del jefe (AuraSystem)
	-- Esqueleto
	RigWeld: Weld?,
	RigBaseC0: CFrame,
	Animator: Animator?,
	Tracks: { [string]: AnimationTrack },
	Loop: string?,
	Parts: { BasePart },
}

local visuals: { [Model]: Visual } = {}
local controllersRef: any = nil
local animations: { [string]: Animation } = {}
local ragdolls = 0

local function serverNow(): number
	return Workspace:GetServerTimeNow()
end

local function easeOutBack(t: number): number
	local c1, c3 = 1.70158, 2.70158
	return 1 + c3 * (t - 1) ^ 3 + c1 * (t - 1) ^ 2
end

local function animation(id: string): Animation
	local existing = animations[id]
	if existing then
		return existing
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = id
	animations[id] = anim
	return anim
end

local function setLocalTransparency(parts: { BasePart }, value: number)
	for _, part in parts do
		part.LocalTransparencyModifier = value
	end
end

------------------------------------------------------------ Esqueletos
local function loadTracks(visual: Visual)
	local animator = visual.Animator
	if animator == nil or next(visual.Tracks) ~= nil then
		return
	end
	local function load(name: string, id: string, priority: Enum.AnimationPriority, looped: boolean)
		local ok, track = pcall(animator.LoadAnimation, animator, animation(id))
		if ok and track then
			track.Priority = priority
			track.Looped = looped
			visual.Tracks[name] = track
		end
	end
	load("Idle", ANIMS.SkeletonIdle, Enum.AnimationPriority.Idle, true)
	load("Walk", ANIMS.SkeletonWalk, Enum.AnimationPriority.Movement, true)
	load("Run", ANIMS.SkeletonRun, Enum.AnimationPriority.Movement, true)
	load("Attack", ANIMS.SkeletonAttack, Enum.AnimationPriority.Action, false)
end

local function playLoop(visual: Visual, name: string, speed: number)
	local track = visual.Tracks[name]
	if track == nil then
		return
	end
	if visual.Loop ~= name then
		local previous = visual.Loop and visual.Tracks[visual.Loop]
		if previous then
			previous:Stop(0.2)
		end
		track:Play(0.2)
		visual.Loop = name
	end
	track:AdjustSpeed(speed)
end

-- El esqueleto se desmonta: copia local de sus huesos con física y se oculta el original.
local function ragdoll(visual: Visual)
	if ragdolls >= FX.MaxRagdolls then
		return false
	end
	ragdolls += 1
	local folder = FxPool.Folder()
	local pieces: { BasePart } = {}
	local origin = visual.Root.Position
	for _, part in visual.Parts do
		if part.Parent == nil then
			continue
		end
		local piece = part:Clone()
		for _, child in piece:GetChildren() do
			if not child:IsA("SpecialMesh") and not child:IsA("SurfaceAppearance") and not child:IsA("Decal") then
				child:Destroy()
			end
		end
		piece.CFrame = part.CFrame
		piece.Anchored = false
		piece.CanCollide = part.Size.Magnitude > 0.6
		piece.Massless = false
		piece.LocalTransparencyModifier = 0
		piece.CollisionGroup = "Default"
		piece.Parent = folder
		local away = piece.Position - origin
		local flatAway = Vector3.new(away.X, 0, away.Z)
		local push = if flatAway.Magnitude > 1e-3
			then flatAway.Unit
			else Vector3.new(math.random() - 0.5, 0, math.random() - 0.5).Unit
		piece.AssemblyLinearVelocity = push * (8 + math.random() * 8) + Vector3.new(0, 10 + math.random() * 10, 0)
		piece.AssemblyAngularVelocity = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 14
		table.insert(pieces, piece)
	end
	setLocalTransparency(visual.Parts, 1)
	task.delay(1.1, function()
		for _, piece in pieces do
			TweenService:Create(piece, TweenInfo.new(0.5), { Transparency = 1 }):Play()
		end
		task.delay(0.55, function()
			for _, piece in pieces do
				piece:Destroy()
			end
			ragdolls -= 1
		end)
	end)
	return true
end

------------------------------------------------------------- Registro
local function readState(visual: Visual)
	local model = visual.Model
	visual.State = model:GetAttribute("State") or "Chase"
	visual.StateAt = model:GetAttribute("StateAt") or serverNow()
	visual.StateDuration = model:GetAttribute("StateDuration") or 0
end

local function onStateChanged(visual: Visual)
	local previous = visual.State
	readState(visual)
	local state = visual.State
	local def = visual.Def
	local position = visual.Root.Position
	if state == "Windup" then
		Sfx.PlayAt("EnemyWindup", position, if def.AttackKind == "Slam" then 0.7 else 1.1)
		if def.AttackKind == "Slam" then
			-- Zona de peligro del Rey: crece durante la anticipación.
			-- Va por encima del anillo del aura (más alto y más opaco): el peligro
			-- siempre se lee, aunque haya efectos alrededor.
			visual.Telegraph = FxPool.Ring(
				position - Vector3.new(0, visual.Root.Size.Y / 2 - 0.3, 0),
				1,
				def.HitRange * 2,
				visual.StateDuration,
				WARNING,
				0.35,
				0.22
			)
			FxPool.Ring(
				position - Vector3.new(0, visual.Root.Size.Y / 2 - 0.28, 0),
				def.HitRange * 2,
				def.HitRange * 2,
				visual.StateDuration,
				WARNING,
				0.7,
				0.16
			)
			if visual.Aura then
				visual.Aura:Burst(visual.StateDuration)
			end
		elseif visual.Kind == "Skeleton" then
			local track = visual.Tracks.Attack
			if track then
				-- El tajo llega a su punto álgido (≈55 % de la animación) al terminar la anticipación.
				local speed = math.clamp(track.Length * 0.55 / math.max(visual.StateDuration, 0.05), 0.4, 2.5)
				track:Play(0.05, 1, if track.Length > 0 then speed else 1)
			end
		end
	elseif state == "Recover" and previous == "Windup" and def.AttackKind == "Slam" then
		local ground = position - Vector3.new(0, visual.Root.Size.Y / 2 - 0.2, 0)
		FxPool.Ring(ground, 2, def.HitRange * 2.3, 0.45, Color3.fromRGB(255, 160, 120), 0.2, 0.3)
		FxPool.Emit("Dust", ground, 26)
		Sfx.PlayAt("BossSlam", position, 1, 120)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and (root.Position - position).Magnitude < def.HitRange * 2 then
			EnemyVisualsController.Shake(0.5, 0.25)
		end
	elseif state == "Spawning" then
		FxPool.Ring(
			position - Vector3.new(0, visual.Root.Size.Y / 2 - 0.1, 0),
			1,
			7 * visual.Scale,
			0.5,
			def.Color,
			0.25
		)
	end
end

local function updateBar(visual: Visual)
	local model = visual.Model
	local health = model:GetAttribute("Health")
	local maxHealth = model:GetAttribute("MaxHealth")
	if visual.Fill and type(health) == "number" and type(maxHealth) == "number" and maxHealth > 0 then
		visual.Fill.Size = UDim2.fromScale(math.clamp(health / maxHealth, 0, 1), 1)
		if visual.Bar then
			-- La barra aparece al recibir el primer impacto (menos ruido con muchos enemigos).
			visual.Bar.Enabled = health < maxHealth and not visual.Dying
		end
	end
end

local function track(model: Instance)
	if not model:IsA("Model") or visuals[model] then
		return
	end
	local root = model:WaitForChild("Root", 5) :: BasePart?
	local enemyId = model:GetAttribute("EnemyId")
	local def = enemyId and EnemyConfig[enemyId]
	if root == nil or def == nil or model.Parent == nil then
		return
	end
	local bar = root:FindFirstChild("HealthBar") :: BillboardGui?
	local back = bar and bar:FindFirstChild("Back")
	local visual: Visual = {
		Model = model,
		Def = def,
		Kind = def.Rig,
		Root = root,
		Scale = def.Scale,
		State = "Chase",
		StateAt = serverNow(),
		StateDuration = 0,
		HopSeed = model:GetAttribute("HopSeed") or math.random(),
		Bar = bar,
		Fill = back and back:FindFirstChild("Fill") :: Frame?,
		FlashUntil = 0,
		LastPosition = root.Position,
		Speed = 0,
		Dying = false,
		DyingAt = 0,
		Connections = {},
		Weld = nil,
		BaseC0 = CFrame.new(),
		Mesh = nil,
		Body = nil,
		BodyColor = def.Color,
		Extras = {},
		Telegraph = nil,
		RigWeld = nil,
		RigBaseC0 = CFrame.new(),
		Animator = nil,
		Tracks = {},
		Loop = nil,
		Parts = {},
	}
	if def.Rig == "Slime" then
		local body = model:FindFirstChild("Body") :: BasePart?
		visual.Body = body
		visual.Weld = body and body:FindFirstChild("BodyWeld") :: Weld?
		visual.BaseC0 = if visual.Weld then visual.Weld.C0 else CFrame.new()
		visual.Mesh = body and body:FindFirstChild("BodyMesh") :: SpecialMesh?
		visual.BodyColor = if body then body.Color else def.Color
		for _, child in model:GetChildren() do
			if child:IsA("BasePart") and child ~= body and child ~= root then
				table.insert(visual.Extras, child)
			end
		end
	else
		local rig = model:FindFirstChild("Rig")
		local hrp = rig and rig:FindFirstChild("HumanoidRootPart")
		visual.RigWeld = hrp and hrp:FindFirstChild("RigWeld") :: Weld?
		visual.RigBaseC0 = if visual.RigWeld then visual.RigWeld.C0 else CFrame.new()
		local controller = rig and rig:FindFirstChildOfClass("AnimationController")
		visual.Animator = controller and controller:FindFirstChildOfClass("Animator")
		for _, descendant in model:GetDescendants() do
			if descendant:IsA("BasePart") and descendant ~= root then
				table.insert(visual.Parts, descendant)
			end
		end
		loadTracks(visual)
	end
	readState(visual)
	table.insert(
		visual.Connections,
		model:GetAttributeChangedSignal("State"):Connect(function()
			onStateChanged(visual)
		end)
	)
	table.insert(
		visual.Connections,
		model:GetAttributeChangedSignal("Health"):Connect(function()
			updateBar(visual)
		end)
	)
	visuals[model] = visual
	local entering = visual.State == "Spawning"
	if entering then
		visual.State = "" -- fuerza el efecto de aparición
		onStateChanged(visual)
		Sfx.PlayAt("EnemySpawn", root.Position, 1, 70)
	end
	if def.Scale > 1.5 then
		-- Jefe: aura propia siempre visible (es información, no decoración).
		visual.Aura = AuraSystem.Attach(root, "Boss", {
			Scale = def.Scale * 0.5,
			Height = root.Size.Y * 1.4,
			FloorOffset = root.Size.Y / 2,
			Intensity = 1,
		})
		if entering then
			EnemyVisualsController.BossEntrance(visual)
		end
	end
	local flame = model:FindFirstChild("SkullFlame", true) :: ParticleEmitter?
	if flame then
		flame.Enabled = AuraSystem.GetQuality().EnemyAuras
	end
	updateBar(visual)
end

-- Entrada del jefe: erupción, temblor, golpe de FOV y franjas de cine con rótulo.
function EnemyVisualsController.BossEntrance(visual: Visual)
	local position = visual.Root.Position
	local ground = position - Vector3.new(0, visual.Root.Size.Y / 2 - 0.2, 0)
	FxPool.Ring(ground, 2, 34, 0.9, visual.Def.Color, 0.15, 0.3)
	FxPool.Ring(ground, 1, 20, 0.6, Color3.fromRGB(255, 200, 90), 0.3, 0.2)
	FxPool.Emit("Dust", ground, 30)
	FxPool.Emit("DeathBurst", position, 30, visual.Def.Color)
	Sfx.PlayAt("BossSlam", position, 0.6, 200)
	EnemyVisualsController.Shake(0.45, 0.5)
	if controllersRef then
		controllersRef.CameraController.FovKick(VisualConfig.Camera.BossFovKick, 0.9)
		controllersRef.HUDController.Cinematic(
			"¡" .. string.upper(visual.Def.DisplayName) .. "!",
			"Un jefe ha despertado · esquiva su golpe en área",
			VisualConfig.Camera.LetterboxTime
		)
	end
	if visual.Aura then
		visual.Aura:Burst(1.5)
	end
end

local function untrack(model: Instance)
	local visual = visuals[model :: Model]
	if visual == nil then
		return
	end
	if visual.Aura then
		visual.Aura:Destroy()
		visual.Aura = nil
	end
	for _, connection in visual.Connections do
		connection:Disconnect()
	end
	for _, t in visual.Tracks do
		t:Stop(0)
		t:Destroy()
	end
	visuals[model :: Model] = nil
end

------------------------------------------------------------ Público
local shakeFn: ((number, number) -> ())? = nil

function EnemyVisualsController.Shake(strength: number, duration: number)
	if shakeFn then
		shakeFn(strength, duration)
	end
end

-- Impacto confirmado por el servidor: destello y aplastamiento breve.
function EnemyVisualsController.OnHit(model: Model, crit: boolean)
	local visual = visuals[model]
	if visual == nil or visual.Dying then
		return
	end
	visual.FlashUntil = os.clock() + FX.HitFlashTime * (if crit then 1.6 else 1)
	if visual.Kind == "Slime" then
		if visual.Body then
			visual.Body.Color = Color3.new(1, 1, 1)
		end
	else
		FxPool.Flash(model, if crit then Color3.fromRGB(255, 190, 90) else Color3.new(1, 1, 1), FX.HitFlashTime)
	end
end

function EnemyVisualsController.OnDied(model: Model?, position: Vector3, color: Color3, enemyId: string?)
	local def = enemyId and EnemyConfig[enemyId]
	local big = def and def.Scale > 1.5
	FxPool.Emit("DeathBurst", position, if big then 40 else FX.DeathBurstParticles, color)
	Sfx.PlayAt("EnemyDeath", position, if big then 0.7 else 0.9 + math.random() * 0.25, 110)
	if big then
		-- Muerte del jefe: doble onda, estrella dorada y golpe de FOV.
		FxPool.Ring(position - Vector3.new(0, 2, 0), 4, 30, 0.7, color, 0.25, 0.3)
		FxPool.Ring(position - Vector3.new(0, 2, 0), 2, 18, 0.5, Color3.fromRGB(255, 200, 90), 0.3, 0.2)
		FxPool.Star(position + Vector3.new(0, 2, 0), Color3.fromRGB(255, 200, 90), 14)
		FxPool.Emit("Sparkles", position, 40)
		EnemyVisualsController.Shake(0.5, 0.3)
		if controllersRef then
			controllersRef.CameraController.FovKick(VisualConfig.Camera.BossFovKick, 0.6)
		end
	end
	local deadVisual = model and visuals[model]
	if deadVisual and deadVisual.Aura then
		deadVisual.Aura:Destroy()
		deadVisual.Aura = nil
	end
	local visual = model and visuals[model]
	if visual == nil or visual.Dying then
		return
	end
	visual.Dying = true
	visual.DyingAt = os.clock()
	if visual.Bar then
		visual.Bar.Enabled = false
	end
	if visual.Telegraph then
		visual.Telegraph.Transparency = 1
	end
	if visual.Kind == "Skeleton" then
		for _, t in visual.Tracks do
			t:Stop(0.1)
		end
		if not ragdoll(visual) then
			-- Sin cupo de piezas con física: se hunde y se desvanece.
			for _, part in visual.Parts do
				TweenService:Create(part, TweenInfo.new(0.4), { LocalTransparencyModifier = 1 }):Play()
			end
		end
	end
end

------------------------------------------------------------- Bucle
local function updateSlime(visual: Visual, now: number, sNow: number, dt: number)
	local weld, mesh, body = visual.Weld, visual.Mesh, visual.Body
	if weld == nil or mesh == nil or body == nil then
		return
	end
	local s = visual.Scale
	local halfHeight = 1.5 * s
	local sx, sy, offsetY = 1, 1, 0
	local tint: Color3? = nil
	local elapsed = sNow - visual.StateAt
	local duration = math.max(visual.StateDuration, 0.01)
	local p = math.clamp(elapsed / duration, 0, 1)
	local state = visual.State
	local def = visual.Def
	local extrasAlpha = 0

	if visual.Dying then
		local t = math.clamp((now - visual.DyingAt) / 0.35, 0, 1)
		sx = 1 + 0.6 * t
		sy = math.max(0.05, 1 - 0.95 * t)
		extrasAlpha = t
		body.LocalTransparencyModifier = t * t
	elseif state == "Spawning" then
		local e = easeOutBack(p)
		sx, sy = 0.05 + 0.95 * e, 0.05 + 0.95 * e
		offsetY = -halfHeight * (1 - p)
		extrasAlpha = 1 - p
	elseif state == "Windup" then
		local crouch = p * p
		sy = 1 - 0.32 * crouch
		sx = 1 + 0.22 * crouch
		offsetY = math.sin(now * 60) * 0.06 * crouch * s
		tint = WARNING:Lerp(visual.BodyColor, 1 - 0.65 * crouch)
	elseif state == "Recover" and def.AttackKind == "Lunge" then
		local jump = elapsed / (COMBAT.RecoverTime * 0.45)
		if jump < 1 then
			offsetY = math.sin(jump * math.pi) * 1.9 * s
			sy = 1 + 0.25 * math.sin(jump * math.pi)
			sx = 1 - 0.12 * math.sin(jump * math.pi)
		else
			local land = math.clamp((jump - 1) * 3, 0, 1)
			sy = 1 - 0.2 * (1 - land)
			sx = 1 + 0.14 * (1 - land)
		end
	elseif state == "Recover" and def.AttackKind == "Slam" then
		local slam = math.clamp(elapsed / 0.25, 0, 1)
		sy = 0.55 + 0.45 * slam
		sx = 1.35 - 0.35 * slam
	elseif state == "Stagger" then
		sx = 1.22 - 0.22 * p
		sy = 0.82 + 0.18 * p
	else
		local moving = visual.Speed > 1 and not visual.Root.Anchored
		local frequency = def.HopFrequency
		if moving and frequency then
			-- Mismo reloj y semilla que el servidor: el salto coincide con el avance real.
			local wave = math.sin(TAU * (sNow * frequency + visual.HopSeed))
			if wave > 0 then
				offsetY = wave * 1.05 * s
				sy = 1 + 0.12 * wave
				sx = 1 - 0.06 * wave
			else
				local land = -wave
				sy = 1 - 0.17 * land
				sx = 1 + 0.1 * land
			end
		else
			local breathe = math.sin(now * 3 + visual.HopSeed * TAU)
			sy = 1 + 0.04 * breathe
			sx = 1 - 0.02 * breathe
		end
	end

	-- El cuerpo se escala desde su centro: se corrige la altura para que apoye en el suelo.
	offsetY -= (1 - sy) * halfHeight
	weld.C0 = visual.BaseC0 * CFrame.new(0, offsetY, 0)
	mesh.Scale = Vector3.new(sx, sy, sx)
	if extrasAlpha > 0 or visual.Extras[1] and visual.Extras[1].LocalTransparencyModifier > 0 then
		setLocalTransparency(visual.Extras, extrasAlpha)
	end
	if visual.FlashUntil > now then
		body.Color = Color3.new(1, 1, 1)
	elseif tint then
		body.Color = tint
	elseif body.Color ~= visual.BodyColor then
		body.Color = visual.BodyColor
	end
	local telegraph = visual.Telegraph
	if telegraph and (state ~= "Windup" or visual.Dying) then
		visual.Telegraph = nil
	end
	local _ = dt
end

local function updateSkeleton(visual: Visual, _now: number, sNow: number)
	local weld = visual.RigWeld
	if weld == nil or visual.Dying then
		return
	end
	if next(visual.Tracks) == nil then
		loadTracks(visual)
	end
	local elapsed = sNow - visual.StateAt
	local duration = math.max(visual.StateDuration, 0.01)
	local p = math.clamp(elapsed / duration, 0, 1)
	local state = visual.State
	local offset = CFrame.new()
	if state == "Spawning" then
		-- Emerge del suelo.
		offset = CFrame.new(0, -5.2 * visual.Scale * (1 - easeOutBack(p) ^ 0.7), 0)
		setLocalTransparency(visual.Parts, (1 - p) * 0.6)
	elseif state == "Stagger" then
		offset = CFrame.Angles(math.sin(p * math.pi) * 0.32, 0, 0)
	elseif visual.Parts[1] and visual.Parts[1].LocalTransparencyModifier > 0 then
		setLocalTransparency(visual.Parts, 0)
	end
	weld.C0 = visual.RigBaseC0 * offset

	if state == "Chase" or state == "Recover" or state == "Stagger" then
		local speed = visual.Speed
		if speed > 13 then
			playLoop(visual, "Run", math.clamp(speed / 16, 0.7, 1.5))
		elseif speed > 0.8 then
			playLoop(visual, "Walk", math.clamp(speed / 8.5, 0.5, 1.8))
		else
			playLoop(visual, "Idle", 1)
		end
	elseif state == "Windup" or state == "Spawning" then
		playLoop(visual, "Idle", 1)
	end
end

local function update(dt: number)
	debug.profilebegin("SkyBonk.EnemyVisuals")
	local now = os.clock()
	local sNow = serverNow()
	for model, visual in visuals do
		if model.Parent == nil then
			untrack(model)
			continue
		end
		-- Velocidad horizontal medida (suavizada) para decidir la animación.
		local position = visual.Root.Position
		local delta = position - visual.LastPosition
		visual.LastPosition = position
		if dt > 0 then
			local instant = Vector3.new(delta.X, 0, delta.Z).Magnitude / dt
			visual.Speed += (instant - visual.Speed) * math.min(1, dt * 10)
		end
		if visual.Kind == "Slime" then
			updateSlime(visual, now, sNow, dt)
		else
			updateSkeleton(visual, now, sNow)
		end
	end
	debug.profileend()
end

function EnemyVisualsController.Init(controllers)
	controllersRef = controllers
	shakeFn = controllers.CameraController.Shake
end

function EnemyVisualsController.Start()
	AuraSystem.QualityChanged:Connect(function()
		local enabled = AuraSystem.GetQuality().EnemyAuras
		for model in visuals do
			local flame = model:FindFirstChild("SkullFlame", true) :: ParticleEmitter?
			if flame then
				flame.Enabled = enabled
			end
		end
	end)
	task.spawn(function()
		local list = {}
		for _, id in { ANIMS.SkeletonIdle, ANIMS.SkeletonWalk, ANIMS.SkeletonRun, ANIMS.SkeletonAttack } do
			table.insert(list, animation(id))
		end
		pcall(ContentProvider.PreloadAsync, ContentProvider, list)
	end)
	local enemies = Workspace:WaitForChild("ActiveEnemies")
	enemies.ChildAdded:Connect(function(child)
		task.spawn(track, child)
	end)
	enemies.ChildRemoved:Connect(untrack)
	for _, child in enemies:GetChildren() do
		task.spawn(track, child)
	end
	RunService.RenderStepped:Connect(update)
end

return EnemyVisualsController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="230">
          <Properties>
            <string name="Name">GameOverController</string>
            <string name="Source"><![CDATA[--[[
	GameOverController
	Pantalla de derrota (StarterGui equivalente: GameOverScreen): tiempo
	sobrevivido, enemigos derrotados, nivel alcanzado y botón para volver a
	jugar. El servidor decide si el reinicio es válido. (La Fase 1 no tiene
	menú principal, por eso no se muestra el botón "Volver al menú".)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Net = require(Shared.Net)
local Theme = require(script.Parent.Parent.UI.Theme)
local Sfx = require(script.Parent.Parent.Util.Sfx)

local GameOverController = {}

local C = Theme.Colors
local New = Theme.New

local controllers
local gui: ScreenGui
local overlay: Frame
local panel: Frame
local values: { [string]: TextLabel } = {}
local restartButton: TextButton
local restartLabel: TextLabel
local shownAt = 0
local requested = false

local function tween(instance: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?)
	TweenService:Create(instance, TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
end

local function requestRestart()
	if not gui.Enabled or requested then
		return
	end
	-- Mismo enfriamiento que el servidor para evitar peticiones inútiles.
	if os.clock() - shownAt < GameConfig.Match.RestartCooldown then
		return
	end
	requested = true
	restartLabel.Text = "Cargando..."
	Sfx.Play("UiSelect")
	Net.RequestRestart:FireServer()
	-- Si el servidor no responde (petición rechazada), se permite reintentar.
	task.delay(3, function()
		if gui.Enabled and requested then
			requested = false
			restartLabel.Text = controllers.InputController.IsTouchOnly() and "VOLVER A JUGAR" or "VOLVER A JUGAR  [R]"
		end
	end)
end

local function hide()
	gui.Enabled = false
	requested = false
end

local function show(summary)
	if type(summary) ~= "table" then
		return
	end
	values.Time.Text = Theme.FormatTime(tonumber(summary.Elapsed) or 0)
	values.Kills.Text = tostring(tonumber(summary.Kills) or 0)
	values.Level.Text = tostring(tonumber(summary.Level) or 1)
	restartLabel.Text = controllers.InputController.IsTouchOnly() and "VOLVER A JUGAR" or "VOLVER A JUGAR  [R]"
	requested = false
	shownAt = os.clock()
	gui.Enabled = true
	overlay.BackgroundTransparency = 1
	panel.Position = UDim2.fromScale(0.5, 0.58)
	tween(overlay, 0.5, { BackgroundTransparency = 0.35 })
	tween(panel, 0.45, { Position = UDim2.fromScale(0.5, 0.5) }, Enum.EasingStyle.Back)
end

local function statRow(order: number, label: string, key: string)
	local row = New("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = C.PanelLight,
		BackgroundTransparency = 0.3,
		Parent = panel:FindFirstChild("Rows"),
	}, { Theme.Corner(8) })
	Theme.Label({
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(0.65, -14, 1, 0),
		Text = label,
		TextSize = 19,
		TextColor3 = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})
	values[key] = Theme.Label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 0),
		Size = UDim2.new(0.35, 0, 1, 0),
		Text = "-",
		Font = Theme.Fonts.Title,
		TextSize = 24,
		TextColor3 = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})
end

function GameOverController.Init(allControllers)
	controllers = allControllers
end

function GameOverController.Start()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui = Theme.ScreenGui("GameOverScreen", 20, playerGui)
	gui.Enabled = false

	overlay = New("Frame", {
		Name = "Overlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(20, 6, 18),
		BackgroundTransparency = 1,
		Active = true,
		Parent = gui,
	})
	panel = New("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(460, 400),
		BackgroundColor3 = C.Panel,
		Parent = gui,
	}, {
		Theme.Corner(16),
		Theme.Stroke(C.Danger, 3, 0.1),
		New("UIGradient", { Rotation = 90, Color = ColorSequence.new(C.PanelLight, C.Panel) }),
	})
	Theme.Scaled(panel)

	Theme.Label({
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.new(1, 0, 0, 52),
		Text = "HAS CAÍDO",
		Font = Theme.Fonts.Title,
		TextSize = 48,
		TextColor3 = C.Danger,
		TextStrokeTransparency = 0.3,
		Parent = panel,
	})
	Theme.Label({
		Position = UDim2.fromOffset(0, 70),
		Size = UDim2.new(1, 0, 0, 24),
		Text = "La isla reclama a otro aventurero...",
		TextSize = 17,
		TextColor3 = C.TextDim,
		Parent = panel,
	})
	New("Frame", {
		Name = "Rows",
		Position = UDim2.fromOffset(30, 108),
		Size = UDim2.new(1, -60, 0, 140),
		BackgroundTransparency = 1,
		Parent = panel,
	}, {
		New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }),
	})
	statRow(1, "Tiempo sobrevivido", "Time")
	statRow(2, "Enemigos derrotados", "Kills")
	statRow(3, "Nivel alcanzado", "Level")

	restartButton = New("TextButton", {
		Name = "RestartButton",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(320, 64),
		BackgroundColor3 = C.Gold,
		AutoButtonColor = true,
		Text = "",
		Parent = panel,
	}, {
		Theme.Corner(12),
		Theme.Stroke(C.Shadow, 3, 0.2),
	})
	restartLabel = Theme.Label({
		Size = UDim2.fromScale(1, 1),
		Text = "VOLVER A JUGAR",
		Font = Theme.Fonts.Title,
		TextSize = 26,
		TextColor3 = C.Shadow,
		TextStrokeTransparency = 1,
		Parent = restartButton,
	})
	restartButton.Activated:Connect(requestRestart)

	Net.GameOver.OnClientEvent:Connect(show)
	Net.HudUpdate.OnClientEvent:Connect(function(snapshot)
		-- Una partida nueva cierra la pantalla de derrota.
		if gui.Enabled and type(snapshot) == "table" and snapshot.Phase == "Playing" then
			hide()
		end
	end)
	controllers.InputController.Confirm:Connect(requestRestart)
end

return GameOverController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="231">
          <Properties>
            <string name="Name">HUDController</string>
            <string name="Source"><![CDATA[--[[
	HUDController
	Interfaz durante la partida (StarterGui equivalente: MainHUD):
	  • nivel, barra de experiencia, tiempo y enemigos derrotados (arriba),
	  • vida actual/máxima (arriba a la izquierda),
	  • panel de estadísticas plegable (Tab / C o botón táctil),
	  • rótulo de subida de nivel y viñeta roja al recibir daño,
	  • barra del jefe, franjas de cine para su entrada y botón de calidad FX.
	Solo muestra el estado que envía el servidor; no decide nada.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Net = require(Shared.Net)
local Types = require(Shared.Types)
local Theme = require(script.Parent.Parent.UI.Theme)
local AuraSystem = require(script.Parent.Parent.Util.AuraSystem)

local HUDController = {}

local C = Theme.Colors
local New = Theme.New

local controllers
local gui: ScreenGui
local refs: { [string]: any } = {}
local snapshot: Types.HudSnapshot? = nil
local elapsedBase = 0
local elapsedReceivedAt = 0
local lastShownSecond = -1
local statsVisible = true

local STAT_ROWS = {
	{ Key = "Damage", Label = "Daño", Format = "%.1f" },
	{ Key = "Cooldown", Label = "Enfriamiento", Format = "%.2f s" },
	{ Key = "Range", Label = "Alcance", Format = "%.1f" },
	{ Key = "Projectiles", Label = "Hojas", Format = "%d" },
	{ Key = "Chain", Label = "Saltos de rayo", Format = "%d" },
	{ Key = "CritPct", Label = "Crítico", Format = "%.0f %%" },
	{ Key = "MoveSpeed", Label = "Velocidad", Format = "%.1f" },
	{ Key = "DamageReductionPct", Label = "Reducción daño", Format = "%.0f %%" },
	{ Key = "Regen", Label = "Regeneración", Format = "%.0f/s" },
	{ Key = "Magnet", Label = "Imán", Format = "%.0f" },
	{ Key = "XpBonusPct", Label = "Bonus XP", Format = "+%.0f %%" },
	{ Key = "Luck", Label = "Suerte", Format = "%d" },
}

local function tween(instance: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?)
	local t = TweenService:Create(
		instance,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		goal
	)
	t:Play()
	return t
end

local function buildTopPanel()
	local panel = New("Frame", {
		Name = "TopPanel",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(560, 62),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Theme.Scaled(panel)

	local badge = New("Frame", {
		Name = "LevelBadge",
		Size = UDim2.fromOffset(62, 62),
		BackgroundColor3 = C.Panel,
		Parent = panel,
	}, {
		Theme.Corner(14),
		Theme.Stroke(C.Gold, 3, 0),
	})
	Theme.Label({
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.fromOffset(0, 5),
		Text = "NIVEL",
		Font = Theme.Fonts.Bold,
		TextSize = 12,
		TextColor3 = C.Gold,
		Parent = badge,
	})
	refs.LevelScale = New("UIScale", { Parent = badge })
	refs.Level = Theme.Label({
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.fromOffset(0, 21),
		Text = "1",
		Font = Theme.Fonts.Numbers,
		TextSize = 30,
		Parent = badge,
	})

	local xpBar, xpFill, xpText = Theme.Bar({
		Name = "XpBar",
		Position = UDim2.fromOffset(72, 4),
		Size = UDim2.new(1, -72, 0, 24),
		Parent = panel,
	}, C.Xp, C.XpDark)
	refs.XpBar, refs.XpFill, refs.XpText = xpBar, xpFill, xpText

	local infoRow = New("Frame", {
		Name = "InfoRow",
		Position = UDim2.fromOffset(72, 32),
		Size = UDim2.new(1, -72, 0, 28),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.25,
		Parent = panel,
	}, { Theme.Corner(8) })
	refs.Timer = Theme.Label({
		Size = UDim2.new(0.5, -8, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		Text = "⏱ 00:00",
		Font = Theme.Fonts.Bold,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = infoRow,
	})
	refs.Kills = Theme.Label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 0),
		Size = UDim2.new(0.5, -8, 1, 0),
		Text = "☠ 0",
		Font = Theme.Fonts.Bold,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = infoRow,
	})
end

-- Columna izquierda escalada: vida + estadísticas (sin solaparse a ninguna escala).
local function buildLeftColumn()
	refs.LeftColumn = New("Frame", {
		Name = "LeftColumn",
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.fromOffset(250, 380),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		New("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
		}),
	})
	Theme.Scaled(refs.LeftColumn)
end

local function buildHealthPanel()
	local panel = New("Frame", {
		Name = "HealthPanel",
		LayoutOrder = 1,
		Size = UDim2.fromOffset(250, 40),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.15,
		Parent = refs.LeftColumn,
	}, {
		Theme.Corner(10),
		Theme.Stroke(C.PanelStroke, 2, 0.4),
	})
	Theme.Label({
		Size = UDim2.fromOffset(34, 40),
		Text = "❤",
		TextSize = 22,
		TextColor3 = C.Health,
		Parent = panel,
	})
	local bar, fill, text = Theme.Bar({
		Name = "HealthBar",
		Position = UDim2.fromOffset(36, 8),
		Size = UDim2.new(1, -46, 0, 24),
		Parent = panel,
	}, C.Health, C.HealthDark)
	refs.HealthBar, refs.HealthFill, refs.HealthText = bar, fill, text
end

local function buildStatsPanel()
	local panel = New("Frame", {
		Name = "StatsPanel",
		LayoutOrder = 2,
		Size = UDim2.fromOffset(210, 36 + #STAT_ROWS * 22),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.2,
		Parent = refs.LeftColumn,
	}, {
		Theme.Corner(10),
		Theme.Stroke(C.PanelStroke, 2, 0.5),
	})

	local header = New("TextButton", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 1,
		Text = "",
		Parent = panel,
	})
	refs.StatsHeaderLabel = Theme.Label({
		Size = UDim2.new(1, -16, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		Text = "ESTADÍSTICAS  ▾",
		Font = Theme.Fonts.Title,
		TextSize = 16,
		TextColor3 = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = header,
	})
	header.Activated:Connect(function()
		HUDController.ToggleStats()
	end)

	local rows = New("Frame", {
		Name = "Rows",
		Position = UDim2.fromOffset(10, 30),
		Size = UDim2.new(1, -20, 0, #STAT_ROWS * 22),
		BackgroundTransparency = 1,
		Parent = panel,
	}, {
		New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	refs.StatValues = {}
	for index, row in STAT_ROWS do
		local line = New("Frame", {
			LayoutOrder = index,
			Size = UDim2.new(1, 0, 0, 22),
			BackgroundTransparency = 1,
			Parent = rows,
		})
		Theme.Label({
			Size = UDim2.fromScale(0.62, 1),
			Text = row.Label,
			TextSize = 15,
			TextColor3 = C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = line,
		})
		refs.StatValues[row.Key] = Theme.Label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.fromScale(0.38, 1),
			Text = "-",
			Font = Theme.Fonts.Bold,
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = line,
		})
	end
	refs.StatsPanel = panel
	refs.StatsRows = rows
end

local function buildBannerAndVignette()
	refs.Banner = Theme.Label({
		Name = "LevelUpBanner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(600, 80),
		Text = "",
		Font = Theme.Fonts.Title,
		TextSize = 54,
		TextColor3 = C.Gold,
		TextStrokeTransparency = 0.2,
		TextTransparency = 1,
		Parent = gui,
	})
	Theme.Scaled(refs.Banner)

	-- Viñeta: cuatro bordes rojos con degradado hacia el centro.
	local vignette = New("Frame", {
		Name = "DamageVignette",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	-- Solo los bordes y semitransparente: avisa del golpe sin tapar el combate.
	local edges = {
		{ UDim2.fromScale(1, 0.1), UDim2.fromScale(0, 0), 90 },
		{ UDim2.fromScale(1, 0.1), UDim2.fromScale(0, 0.9), -90 },
		{ UDim2.fromScale(0.07, 1), UDim2.fromScale(0, 0), 0 },
		{ UDim2.fromScale(0.07, 1), UDim2.fromScale(0.93, 0), 180 },
	}
	for _, edge in edges do
		New("Frame", {
			Size = edge[1],
			Position = edge[2],
			BackgroundColor3 = C.Danger,
			BorderSizePixel = 0,
			Parent = vignette,
		}, {
			New("UIGradient", {
				Rotation = edge[3],
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.55),
					NumberSequenceKeypoint.new(1, 1),
				}),
			}),
		})
	end
	refs.Vignette = vignette
end

--------------------------------------------- Jefe, cinemática y calidad
-- Barra del jefe (Rey Slime): se muestra mientras haya uno vivo.
local function buildBossBar()
	local panel = New("Frame", {
		Name = "BossBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 80),
		Size = UDim2.fromOffset(460, 44),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	Theme.Scaled(panel)
	refs.BossName = Theme.Label({
		Size = UDim2.new(1, 0, 0, 20),
		Text = "REY SLIME DEL VACÍO",
		Font = Theme.Fonts.Title,
		TextSize = 22,
		TextColor3 = C.Boss:Lerp(Color3.new(1, 1, 1), 0.35),
		TextStrokeTransparency = 0.2,
		Parent = panel,
	})
	local _, fill, barText = Theme.Bar({
		Name = "Bar",
		Position = UDim2.fromOffset(0, 22),
		Size = UDim2.new(1, 0, 0, 16),
		Parent = panel,
	}, C.Boss, C.Shadow)
	barText.Text = ""
	refs.BossPanel, refs.BossFill = panel, fill
end

local bossModel: Model? = nil
local bossConnection: RBXScriptConnection? = nil

local function setBoss(model: Model?)
	if bossConnection then
		bossConnection:Disconnect()
		bossConnection = nil
	end
	bossModel = model
	refs.BossPanel.Visible = model ~= nil
	if model == nil then
		return
	end
	local function refresh()
		local health = model:GetAttribute("Health")
		local maxHealth = model:GetAttribute("MaxHealth")
		if type(health) == "number" and type(maxHealth) == "number" and maxHealth > 0 then
			tween(refs.BossFill, 0.15, { Size = UDim2.fromScale(math.clamp(health / maxHealth, 0, 1), 1) })
		end
		if model:GetAttribute("Dead") or model.Parent == nil then
			setBoss(nil)
		end
	end
	bossConnection = model.AttributeChanged:Connect(refresh)
	refresh()
end

local function watchBosses()
	local enemies = workspace:WaitForChild("ActiveEnemies")
	enemies.ChildAdded:Connect(function(child)
		task.defer(function()
			if child:GetAttribute("EnemyId") == "VoidKing" then
				setBoss(child :: Model)
			end
		end)
	end)
	enemies.ChildRemoved:Connect(function(child)
		if child == bossModel then
			setBoss(nil)
			-- Si queda otro rey vivo, pasa a mostrarse el suyo.
			for _, other in enemies:GetChildren() do
				if other:GetAttribute("EnemyId") == "VoidKing" and not other:GetAttribute("Dead") then
					setBoss(other :: Model)
					break
				end
			end
		end
	end)
end

-- Franjas de cine con rótulo (entrada del jefe). No bloquea el control.
local function buildCinematic()
	-- ZIndex 0: las franjas quedan por detrás del HUD (vida y XP siguen visibles).
	local layer = New("Frame", {
		Name = "Cinematic",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 0,
		Parent = gui,
	})
	refs.CinemaTop = New("Frame", {
		Size = UDim2.new(1, 0, 0.08, 0),
		Position = UDim2.fromScale(0, -0.08),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = layer,
	})
	refs.CinemaBottom = New("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Size = UDim2.new(1, 0, 0.08, 0),
		Position = UDim2.fromScale(0, 1.08),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = layer,
	})
	refs.CinemaTitle = Theme.Label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.22),
		Size = UDim2.fromOffset(700, 70),
		Text = "",
		Font = Theme.Fonts.Title,
		TextSize = 56,
		TextColor3 = C.Boss:Lerp(Color3.new(1, 1, 1), 0.3),
		TextStrokeTransparency = 0,
		TextTransparency = 1,
		Parent = layer,
	})
	refs.CinemaSubtitle = Theme.Label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.29),
		Size = UDim2.fromOffset(700, 30),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextSize = 20,
		TextTransparency = 1,
		Parent = layer,
	})
	refs.Cinematic = layer
end

local cinemaToken = 0
function HUDController.Cinematic(title: string, subtitle: string, duration: number)
	cinemaToken += 1
	local token = cinemaToken
	local layer = refs.Cinematic
	layer.Visible = true
	refs.CinemaTitle.Text = title
	refs.CinemaSubtitle.Text = subtitle
	refs.CinemaTitle.Size = UDim2.fromOffset(500, 50)
	tween(refs.CinemaTop, 0.3, { Position = UDim2.fromScale(0, 0) })
	tween(refs.CinemaBottom, 0.3, { Position = UDim2.fromScale(0, 1) })
	tween(refs.CinemaTitle, 0.35, { TextTransparency = 0, Size = UDim2.fromOffset(700, 70) }, Enum.EasingStyle.Back)
	tween(refs.CinemaSubtitle, 0.4, { TextTransparency = 0 })
	task.delay(duration, function()
		if token ~= cinemaToken then
			return
		end
		tween(refs.CinemaTop, 0.35, { Position = UDim2.fromScale(0, -0.08) })
		tween(refs.CinemaBottom, 0.35, { Position = UDim2.fromScale(0, 1.08) })
		tween(refs.CinemaTitle, 0.3, { TextTransparency = 1 })
		tween(refs.CinemaSubtitle, 0.3, { TextTransparency = 1 })
		task.delay(0.4, function()
			if token == cinemaToken then
				layer.Visible = false
			end
		end)
	end)
end

-- Botón de calidad de efectos (también tecla G).
local function buildFxButton()
	local button = New("TextButton", {
		Name = "FxButton",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -12),
		Size = UDim2.fromOffset(118, 34),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.15,
		AutoButtonColor = true,
		Text = "",
		Parent = gui,
	}, {
		Theme.Corner(8),
		Theme.Stroke(C.PanelStroke, 2, 0.4),
	})
	Theme.Scaled(button)
	local label = Theme.Label({
		Size = UDim2.fromScale(1, 1),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextSize = 15,
		Parent = button,
	})
	local function refresh()
		local high = AuraSystem.GetQualityName() == "High"
		label.Text = if high then "✨ FX: ALTO  [G]" else "FX: BAJO  [G]"
		label.TextColor3 = if high then C.Accent else C.TextDim
	end
	button.Activated:Connect(function()
		AuraSystem.ToggleQuality()
	end)
	AuraSystem.QualityChanged:Connect(refresh)
	refresh()
end

function HUDController.ToggleStats()
	statsVisible = not statsVisible
	refs.StatsRows.Visible = statsVisible
	refs.StatsPanel.Size = UDim2.fromOffset(210, if statsVisible then 36 + #STAT_ROWS * 22 else 30)
	refs.StatsHeaderLabel.Text = if statsVisible then "ESTADÍSTICAS  ▾" else "ESTADÍSTICAS  ▸"
end

local function applySnapshot(data: Types.HudSnapshot)
	local previous = snapshot
	snapshot = data
	elapsedBase = data.Elapsed
	elapsedReceivedAt = os.clock()

	refs.Level.Text = tostring(data.Level)
	local xpRatio = math.clamp(data.Xp / math.max(data.XpToNext, 1), 0, 1)
	if previous and previous.Level ~= data.Level then
		refs.XpFill.Size = UDim2.fromScale(0, 1)
	end
	tween(refs.XpFill, 0.15, { Size = UDim2.fromScale(xpRatio, 1) })
	refs.XpText.Text = string.format("XP  %d / %d", math.floor(data.Xp), data.XpToNext)

	local healthRatio = math.clamp(data.Health / math.max(data.MaxHealth, 1), 0, 1)
	tween(refs.HealthFill, 0.12, { Size = UDim2.fromScale(healthRatio, 1) })
	refs.HealthText.Text = string.format("%d / %d", math.ceil(data.Health), math.floor(data.MaxHealth))

	refs.Kills.Text = "☠ " .. data.Kills

	for _, row in STAT_ROWS do
		local value = (data.Stats :: any)[row.Key]
		if type(value) == "number" then
			refs.StatValues[row.Key].Text = string.format(row.Format, value)
		end
	end
end

local function showLevelBanner(level: number)
	-- Destello de la barra de XP y del distintivo de nivel.
	local fill = refs.XpFill
	fill.BackgroundColor3 = Color3.new(1, 1, 1)
	tween(fill, 0.35, { BackgroundColor3 = C.Xp })
	local badgeScale = refs.LevelScale
	if badgeScale then
		badgeScale.Scale = 1.35
		tween(badgeScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	local banner = refs.Banner
	banner.Text = "¡NIVEL " .. level .. "!"
	banner.TextTransparency = 0
	banner.TextStrokeTransparency = 0.2
	banner.Size = UDim2.fromOffset(420, 60)
	tween(banner, 0.25, { Size = UDim2.fromOffset(600, 80) }, Enum.EasingStyle.Back)
	task.delay(GameConfig.Effects.LevelUpBannerTime, function()
		if banner.Text == "¡NIVEL " .. level .. "!" then
			tween(banner, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
	end)
end

local vignetteToken = 0
local function flashVignette()
	vignetteToken += 1
	local token = vignetteToken
	refs.Vignette.Visible = true
	task.delay(GameConfig.Effects.DamageVignetteTime, function()
		if token == vignetteToken then
			refs.Vignette.Visible = false
		end
	end)
end

function HUDController.GetSnapshot(): Types.HudSnapshot?
	return snapshot
end

function HUDController.Init(allControllers)
	controllers = allControllers
end

function HUDController.Start()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui = Theme.ScreenGui("MainHUD", 1, playerGui)
	buildTopPanel()
	buildLeftColumn()
	buildHealthPanel()
	buildStatsPanel()
	buildBannerAndVignette()
	buildBossBar()
	buildCinematic()
	buildFxButton()
	task.spawn(watchBosses)
	if controllers.InputController.IsTouchOnly() then
		HUDController.ToggleStats() -- plegado por defecto en móvil
	end

	controllers.InputController.ToggleStats:Connect(HUDController.ToggleStats)
	Net.HudUpdate.OnClientEvent:Connect(applySnapshot)
	Net.LevelUp.OnClientEvent:Connect(function(info)
		if type(info) == "table" and type(info.Level) == "number" then
			showLevelBanner(info.Level)
		end
	end)
	Net.PlayerDamaged.OnClientEvent:Connect(flashVignette)

	-- El tiempo se extrapola localmente entre actualizaciones del servidor.
	RunService.RenderStepped:Connect(function()
		local data = snapshot
		if data == nil then
			return
		end
		local elapsed = elapsedBase
		if data.Phase == "Playing" then
			elapsed += os.clock() - elapsedReceivedAt
		end
		local second = math.floor(elapsed)
		if second ~= lastShownSecond then
			lastShownSecond = second
			refs.Timer.Text = "⏱ " .. Theme.FormatTime(elapsed)
		end
	end)
end

return HUDController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="232">
          <Properties>
            <string name="Name">InputController</string>
            <string name="Source"><![CDATA[--[[
	InputController
	Atajos de teclado y mando para la interfaz. El movimiento, el salto y la
	cámara usan los controles estándar de Roblox (teclado/ratón, joystick y
	botón de salto táctiles), que ya cumplen los requisitos.

	Señales:
	  SelectOption(index)  teclas 1/2/3 (o botones X/Y/B del mando)
	  Confirm()            Enter / R / botón A (reiniciar tras la derrota)
	  ToggleStats()        Tab / C
	  ToggleFx()           G (efectos completos / reducidos)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Signal = require(ReplicatedStorage.Shared.Signal)

local InputController = {}

InputController.SelectOption = Signal.new()
InputController.Confirm = Signal.new()
InputController.ToggleStats = Signal.new()
InputController.ToggleFx = Signal.new()

local OPTION_KEYS: { [Enum.KeyCode]: number } = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.KeypadOne] = 1,
	[Enum.KeyCode.KeypadTwo] = 2,
	[Enum.KeyCode.KeypadThree] = 3,
	[Enum.KeyCode.ButtonX] = 1,
	[Enum.KeyCode.ButtonY] = 2,
	[Enum.KeyCode.ButtonB] = 3,
}

local CONFIRM_KEYS: { [Enum.KeyCode]: boolean } = {
	[Enum.KeyCode.Return] = true,
	[Enum.KeyCode.KeypadEnter] = true,
	[Enum.KeyCode.R] = true,
	[Enum.KeyCode.ButtonA] = true,
}

local STATS_KEYS: { [Enum.KeyCode]: boolean } = {
	[Enum.KeyCode.Tab] = true,
	[Enum.KeyCode.C] = true,
}

-- Dispositivo táctil sin teclado (móvil/tableta).
function InputController.IsTouchOnly(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

function InputController.Init(_controllers) end

function InputController.Start()
	UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		if gameProcessed then
			return -- escribiendo en el chat, etc.
		end
		local key = input.KeyCode
		local option = OPTION_KEYS[key]
		if option then
			InputController.SelectOption:Fire(option)
		elseif CONFIRM_KEYS[key] then
			InputController.Confirm:Fire()
		elseif STATS_KEYS[key] then
			InputController.ToggleStats:Fire()
		elseif key == Enum.KeyCode.G then
			InputController.ToggleFx:Fire()
		end
	end)
end

return InputController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="233">
          <Properties>
            <string name="Name">MusicController</string>
            <string name="Source"><![CDATA[--[[
	MusicController
	Música de la partida en el grupo "Music": una pista de exploración y otra
	de combate que se mezclan según la intensidad (enemigos cercanos y minuto
	de partida). Se calcula 4 veces por segundo; los volúmenes se suavizan en
	cada frame para que el cambio no sea brusco. Se atenúa en la pantalla de
	mejoras y tras la derrota.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Net = require(Shared.Net)
local Sfx = require(script.Parent.Parent.Util.Sfx)

local MusicController = {}

local MUSIC = GameConfig.Audio.Music
local player = Players.LocalPlayer
local controllers
local explore: Sound
local combat: Sound
local intensity = 0 -- 0 exploración, 1 combate
local targetIntensity = 0
local duck = 1 -- atenuación (mejoras / derrota)
local targetDuck = 1
local nextEvaluateAt = 0
local gameOver = false

local function makeTrack(name: string, id: number): Sound
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = "rbxassetid://" .. id
	sound.Looped = true
	sound.Volume = 0
	sound.SoundGroup = Sfx.GetGroup("Music")
	sound.Parent = Sfx.GetGroup("Music")
	return sound
end

local function evaluate()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local snapshot = controllers.HUDController.GetSnapshot()
	if root == nil or snapshot == nil then
		targetIntensity = 0
		return
	end
	local nearby = 0
	local position = root.Position
	for _, model in Workspace.ActiveEnemies:GetChildren() do
		local enemyRoot = (model :: Model).PrimaryPart
		if enemyRoot and not model:GetAttribute("Dead") and (enemyRoot.Position - position).Magnitude < 45 then
			nearby += 1
		end
	end
	local fromEnemies = math.clamp(nearby / MUSIC.CombatEnemies, 0, 1)
	local fromTime = math.clamp((snapshot.Elapsed - 20) / 160, 0, 0.6)
	targetIntensity = math.clamp(math.max(fromEnemies, fromTime), 0, 1)
	local upgrades = controllers.UpgradeController.IsOpen()
	targetDuck = if gameOver then 0.25 elseif upgrades then 0.55 else 1
end

function MusicController.Init(allControllers)
	controllers = allControllers
end

function MusicController.Start()
	explore = makeTrack("ExploreMusic", MUSIC.Explore.Id)
	combat = makeTrack("CombatMusic", MUSIC.Combat.Id)
	explore:Play()
	combat:Play()

	Net.GameOver.OnClientEvent:Connect(function()
		gameOver = true
	end)
	Net.HudUpdate.OnClientEvent:Connect(function(snapshot)
		if type(snapshot) == "table" and snapshot.Phase ~= "GameOver" then
			gameOver = false
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		local now = os.clock()
		if now >= nextEvaluateAt then
			nextEvaluateAt = now + 0.25
			evaluate()
		end
		local rate = dt / MUSIC.CrossfadeTime
		intensity += math.clamp(targetIntensity - intensity, -rate, rate)
		duck += math.clamp(targetDuck - duck, -dt * 2, dt * 2)
		-- Mezcla de potencia constante: no hay hueco de volumen a mitad del cambio.
		explore.Volume = MUSIC.Explore.Volume * math.cos(intensity * math.pi / 2) * duck
		combat.Volume = MUSIC.Combat.Volume * math.sin(intensity * math.pi / 2) * duck
	end)
end

return MusicController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="234">
          <Properties>
            <string name="Name">UpgradeController</string>
            <string name="Source"><![CDATA[--[[
	UpgradeController
	Pantalla de subida de nivel (StarterGui equivalente: UpgradeSelection).
	Muestra las opciones que envía el servidor y devuelve SOLO el token de la
	oferta y el id elegido. Los textos se leen de UpgradeConfig únicamente
	para mostrarlos. Admite ratón, toque y teclas 1/2/3.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local UpgradeConfig = require(Shared.Config.UpgradeConfig)
local Net = require(Shared.Net)
local Types = require(Shared.Types)
local Theme = require(script.Parent.Parent.UI.Theme)
local Sfx = require(script.Parent.Parent.Util.Sfx)

local UpgradeController = {}

local C = Theme.Colors
local New = Theme.New

local CARD_WIDTH, CARD_HEIGHT = 270, 340

local controllers
local gui: ScreenGui
local overlay: Frame
local container: Frame
local title: TextLabel
local subtitle: TextLabel
local cardRow: Frame
local hint: TextLabel

type Card = { Button: TextButton, Scale: UIScale, Stroke: UIStroke, Id: string }

local cards: { Card } = {}
local activeOffer: Types.OfferPayload? = nil
local waitingResponse = false

local function tween(instance: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?)
	local t = TweenService:Create(
		instance,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		goal
	)
	t:Play()
	return t
end

local function clearCards()
	for _, card in cards do
		card.Button:Destroy()
	end
	table.clear(cards)
end

local function setCardsEnabled(enabled: boolean)
	for _, card in cards do
		card.Button.Active = enabled
		card.Button.AutoButtonColor = false
		card.Stroke.Transparency = if enabled then 0 else 0.5
	end
end

local function choose(index: number)
	local offer = activeOffer
	local card = cards[index]
	if offer == nil or card == nil or waitingResponse then
		return
	end
	waitingResponse = true
	setCardsEnabled(false)
	Sfx.Play("UiSelect")
	tween(card.Scale, 0.12, { Scale = 1.08 }, Enum.EasingStyle.Back)
	Net.ChooseUpgrade:FireServer(offer.Token, card.Id)
end

local function levelText(option: Types.OfferOptionPayload, def: Types.UpgradeDef): string
	if def.IsFallback then
		return "Bendición instantánea"
	end
	if option.CurrentLevel == 0 then
		return "¡NUEVA!"
	end
	local maxText = if def.MaxLevel then " / " .. def.MaxLevel else ""
	return string.format("Nv. %d → %d%s", option.CurrentLevel, option.NextLevel, maxText)
end

local function buildCard(index: number, option: Types.OfferOptionPayload, showKeys: boolean): Card?
	local def = UpgradeConfig.ById[option.Id]
	if def == nil then
		return nil -- id desconocido para este cliente: no se muestra
	end
	local rarity = UpgradeConfig.Rarities[def.Rarity]
	local rarityColor = rarity and rarity.Color or C.PanelStroke
	local category = UpgradeConfig.Categories[def.Category]
	local categoryColor = category and category.Color or rarityColor

	local button = New("TextButton", {
		Name = "Card" .. index,
		LayoutOrder = index,
		Size = UDim2.fromOffset(CARD_WIDTH, CARD_HEIGHT),
		BackgroundColor3 = C.Panel,
		AutoButtonColor = false,
		Text = "",
		Selectable = true,
		Parent = cardRow,
	}, {
		Theme.Corner(14),
		New("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(C.PanelLight, C.Panel),
		}),
	})
	local stroke = Theme.Stroke(rarityColor, 3, 0)
	stroke.Parent = button
	local scale = New("UIScale", { Scale = 0.85, Parent = button })

	New("Frame", {
		Name = "RarityBand",
		Size = UDim2.new(1, -24, 0, 6),
		Position = UDim2.fromOffset(12, 10),
		BackgroundColor3 = rarityColor,
		BorderSizePixel = 0,
		Parent = button,
	}, { Theme.Corner(3) })

	local iconCircle = New("Frame", {
		Name = "Icon",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 26),
		Size = UDim2.fromOffset(76, 76),
		BackgroundColor3 = categoryColor:Lerp(C.Panel, 0.5),
		Parent = button,
	}, {
		New("UICorner", { CornerRadius = UDim.new(1, 0) }),
		Theme.Stroke(categoryColor, 3, 0),
	})
	-- Distintivo de categoría (Ataque, Defensa, Movilidad, Experiencia): color + icono.
	New("Frame", {
		Name = "CategoryChip",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 22),
		Size = UDim2.fromOffset(34, 34),
		BackgroundColor3 = categoryColor,
		Parent = button,
	}, {
		New("UICorner", { CornerRadius = UDim.new(1, 0) }),
		Theme.Label({
			Size = UDim2.fromScale(1, 1),
			Text = category and category.Icon or "",
			TextSize = 18,
			Font = Theme.Fonts.Bold,
			TextColor3 = C.Shadow,
		}),
	})
	Theme.Label({
		Size = UDim2.fromScale(1, 1),
		Text = def.Icon,
		TextSize = 38,
		Font = Theme.Fonts.Bold,
		Parent = iconCircle,
	})

	Theme.Label({
		Name = "UpgradeName",
		Position = UDim2.fromOffset(12, 108),
		Size = UDim2.new(1, -24, 0, 32),
		Text = def.DisplayName,
		Font = Theme.Fonts.Title,
		TextSize = 25,
		TextWrapped = true,
		Parent = button,
	})
	Theme.Label({
		Name = "Rarity",
		Position = UDim2.fromOffset(12, 140),
		Size = UDim2.new(1, -24, 0, 20),
		Text = string.format("%s · %s", rarity and rarity.DisplayName or def.Rarity, def.Category),
		Font = Theme.Fonts.Bold,
		TextSize = 16,
		TextColor3 = categoryColor,
		Parent = button,
	})
	Theme.Label({
		Name = "Description",
		Position = UDim2.fromOffset(16, 170),
		Size = UDim2.new(1, -32, 0, 110),
		Text = def.Description,
		TextSize = 19,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = C.Text,
		Parent = button,
	})
	New("Frame", {
		Name = "LevelTag",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.new(1, -36, 0, 34),
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = 0.3,
		Parent = button,
	}, {
		Theme.Corner(8),
		Theme.Label({
			Size = UDim2.fromScale(1, 1),
			Text = levelText(option, def),
			Font = Theme.Fonts.Bold,
			TextSize = 17,
			TextColor3 = if option.CurrentLevel == 0 then C.Gold else C.Text,
		}),
	})
	if showKeys then
		New("Frame", {
			Name = "KeyHint",
			Position = UDim2.fromOffset(10, 22),
			Size = UDim2.fromOffset(30, 30),
			BackgroundColor3 = C.Shadow,
			Parent = button,
		}, {
			Theme.Corner(8),
			Theme.Stroke(C.TextDim, 1, 0.3),
			Theme.Label({
				Size = UDim2.fromScale(1, 1),
				Text = tostring(index),
				Font = Theme.Fonts.Bold,
				TextSize = 17,
			}),
		})
	end

	local card: Card = { Button = button, Scale = scale, Stroke = stroke, Id = def.Id }
	button.MouseEnter:Connect(function()
		if button.Active and not waitingResponse then
			Sfx.Play("UiHover", 1.1)
			tween(scale, 0.12, { Scale = 1.05 })
		end
	end)
	button.MouseLeave:Connect(function()
		if not waitingResponse then
			tween(scale, 0.12, { Scale = 1 })
		end
	end)
	button.Activated:Connect(function()
		local position = table.find(cards, card)
		if position then
			choose(position)
		end
	end)
	return card
end

local function hide()
	activeOffer = nil
	waitingResponse = false
	if not gui.Enabled then
		return
	end
	tween(overlay, 0.14, { BackgroundTransparency = 1 })
	tween(container, 0.14, { Position = UDim2.fromScale(0.5, 0.56) })
	task.delay(0.14, function()
		if activeOffer == nil then
			gui.Enabled = false
			clearCards()
		end
	end)
end

local function show(offer: Types.OfferPayload)
	if type(offer) ~= "table" or type(offer.Token) ~= "number" or type(offer.Options) ~= "table" then
		return
	end
	clearCards()
	activeOffer = offer
	waitingResponse = false
	local showKeys = not controllers.InputController.IsTouchOnly()

	title.Text = "¡SUBISTE DE NIVEL!"
	subtitle.Text = string.format("Nivel %d · Elige una mejora", offer.Level)
	hint.Visible = showKeys
	for index, option in offer.Options do
		local card = buildCard(index, option, showKeys)
		if card then
			table.insert(cards, card)
		end
	end

	gui.Enabled = true
	overlay.BackgroundTransparency = 1
	container.Position = UDim2.fromScale(0.5, 0.56)
	tween(overlay, 0.18, { BackgroundTransparency = 0.45 })
	tween(container, 0.22, { Position = UDim2.fromScale(0.5, 0.5) }, Enum.EasingStyle.Back)
	for index, card in cards do
		task.delay((index - 1) * GameConfig.Effects.UpgradeCardStagger, function()
			if card.Button.Parent then
				tween(card.Scale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end)
	end
end

local function onResolved(result)
	if type(result) ~= "table" then
		return
	end
	local offer = activeOffer
	if offer == nil or result.Token ~= offer.Token then
		return
	end
	if result.Accepted then
		hide()
	else
		-- Rechazada (p. ej. petición repetida): se permite volver a elegir.
		waitingResponse = false
		setCardsEnabled(true)
		for _, card in cards do
			tween(card.Scale, 0.1, { Scale = 1 })
		end
	end
end

function UpgradeController.IsOpen(): boolean
	return activeOffer ~= nil
end

-- Ids de las cartas visibles, en orden (lo usa el piloto automático de Studio).
function UpgradeController.GetOptionIds(): { string }
	local ids = {}
	for _, card in cards do
		table.insert(ids, card.Id)
	end
	return ids
end

function UpgradeController.Init(allControllers)
	controllers = allControllers
end

function UpgradeController.Start()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui = Theme.ScreenGui("UpgradeSelection", 10, playerGui)
	gui.Enabled = false

	overlay = New("Frame", {
		Name = "Overlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Active = true, -- bloquea clics al mundo mientras se elige
		Parent = gui,
	})
	container = New("Frame", {
		Name = "Container",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(3 * CARD_WIDTH + 2 * 20, 470),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Theme.Scaled(container)
	title = Theme.Label({
		Size = UDim2.new(1, 0, 0, 56),
		Text = "",
		Font = Theme.Fonts.Title,
		TextSize = 46,
		TextColor3 = C.Gold,
		TextStrokeTransparency = 0.3,
		Parent = container,
	})
	subtitle = Theme.Label({
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 0, 26),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextSize = 20,
		TextColor3 = C.Text,
		Parent = container,
	})
	cardRow = New("Frame", {
		Name = "Cards",
		Position = UDim2.fromOffset(0, 92),
		Size = UDim2.new(1, 0, 0, CARD_HEIGHT),
		BackgroundTransparency = 1,
		Parent = container,
	}, {
		New("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 20),
		}),
	})
	hint = Theme.Label({
		Position = UDim2.fromOffset(0, 92 + CARD_HEIGHT + 8),
		Size = UDim2.new(1, 0, 0, 24),
		Text = "Pulsa 1, 2 o 3 · o haz clic en una carta",
		TextSize = 16,
		TextColor3 = C.TextDim,
		Parent = container,
	})

	Net.UpgradeOffer.OnClientEvent:Connect(show)
	Net.UpgradeResolved.OnClientEvent:Connect(onResolved)
	Net.GameOver.OnClientEvent:Connect(function()
		if activeOffer then
			hide()
		end
	end)
	controllers.InputController.SelectOption:Connect(function(index: number)
		if activeOffer then
			choose(index)
		end
	end)
end

return UpgradeController
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="235">
        <Properties>
          <string name="Name">UI</string>
        </Properties>
        <Item class="ModuleScript" referent="236">
          <Properties>
            <string name="Name">Theme</string>
            <string name="Source"><![CDATA[--[[
	Theme
	Estilo visual común (fantasía low-poly) y utilidades para construir la
	interfaz por código: colores, fuentes, esquinas, bordes y escalado
	adaptable a la resolución (PC y móvil).
]]

local Workspace = game:GetService("Workspace")

local Theme = {}

-- Estilo anime fantasy (Fase 2.5): azul noche, acentos cian (jugador) y dorado (recompensa).
Theme.Colors = {
	Panel = Color3.fromRGB(14, 18, 42),
	PanelLight = Color3.fromRGB(30, 38, 84),
	PanelStroke = Color3.fromRGB(110, 200, 255),
	Accent = Color3.fromRGB(120, 235, 255),
	Boss = Color3.fromRGB(214, 60, 120),
	Gold = Color3.fromRGB(255, 208, 96),
	Text = Color3.fromRGB(240, 244, 255),
	TextDim = Color3.fromRGB(170, 182, 220),
	Xp = Color3.fromRGB(80, 230, 255),
	XpDark = Color3.fromRGB(20, 60, 90),
	Health = Color3.fromRGB(236, 72, 96),
	HealthDark = Color3.fromRGB(70, 20, 34),
	Danger = Color3.fromRGB(255, 70, 70),
	Shadow = Color3.fromRGB(8, 8, 20),
}

Theme.Fonts = {
	Title = Enum.Font.Bangers, -- rótulos (estilo cómic/manga)
	Numbers = Enum.Font.FredokaOne, -- cifras y números de daño (máxima legibilidad)
	Body = Enum.Font.GothamMedium,
	Bold = Enum.Font.GothamBold,
}

-- Resolución de diseño. La interfaz se escala para caber en pantallas pequeñas
-- sin que el texto baje de un tamaño legible.
local DESIGN_SIZE = Vector2.new(1280, 720)
local MIN_SCALE, MAX_SCALE = 0.72, 1.3

local scales: { UIScale } = {}
local currentScale = 1

-- Crea una instancia con propiedades e hijos.
function Theme.New(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Theme.Corner(radius: number?): UICorner
	return Theme.New("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function Theme.Stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return Theme.New("UIStroke", {
		Color = color or Theme.Colors.PanelStroke,
		Thickness = thickness or 2,
		Transparency = transparency or 0.2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Theme.Label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		TextColor3 = Theme.Colors.Text,
		Font = Theme.Fonts.Body,
		TextSize = 18,
		TextStrokeTransparency = 0.6,
		TextStrokeColor3 = Theme.Colors.Shadow,
	}
	for key, value in props do
		defaults[key] = value
	end
	return Theme.New("TextLabel", defaults)
end

--[[
	Barra estilizada: fondo oscuro, relleno con degradado horizontal (más claro
	en la punta), brillo superior y borde luminoso del color del relleno.
	Devuelve (contenedor, relleno, texto).
]]
function Theme.Bar(props: { [string]: any }, fillColor: Color3, backColor: Color3): (Frame, Frame, TextLabel)
	local container = Theme.New("Frame", props, {
		Theme.Corner(6),
		Theme.Stroke(fillColor:Lerp(Color3.new(1, 1, 1), 0.2), 2, 0.25),
	})
	container.BackgroundColor3 = backColor
	container.BorderSizePixel = 0
	container.ClipsDescendants = false
	local fill = Theme.New("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = fillColor,
		BorderSizePixel = 0,
		Parent = container,
	}, {
		Theme.Corner(6),
		Theme.New("UIGradient", {
			Color = ColorSequence.new(
				fillColor:Lerp(Color3.new(0, 0, 0), 0.25),
				fillColor:Lerp(Color3.new(1, 1, 1), 0.35)
			),
		}),
	})
	Theme.New("Frame", {
		Name = "Shine",
		Size = UDim2.new(1, -6, 0.32, 0),
		Position = UDim2.fromOffset(3, 2),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.78,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = fill,
	}, { Theme.Corner(4) })
	local text = Theme.Label({
		Name = "Text",
		Size = UDim2.fromScale(1, 1),
		Font = Theme.Fonts.Bold,
		TextSize = 16,
		ZIndex = 3,
		Parent = container,
	})
	return container, fill, text
end

-- ScreenGui estándar (no se reinicia al reaparecer y respeta zonas seguras).
function Theme.ScreenGui(name: string, displayOrder: number, parent: Instance): ScreenGui
	return Theme.New("ScreenGui", {
		Name = name,
		DisplayOrder = displayOrder,
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = parent,
	})
end

local function computeScale(): number
	local camera = Workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or DESIGN_SIZE
	local scale = math.min(viewport.X / DESIGN_SIZE.X, viewport.Y / DESIGN_SIZE.Y)
	return math.clamp(scale, MIN_SCALE, MAX_SCALE)
end

-- Añade un UIScale adaptable a un panel (no a overlays de pantalla completa).
function Theme.Scaled(panel: GuiObject): UIScale
	local uiScale = Theme.New("UIScale", { Scale = currentScale, Parent = panel })
	table.insert(scales, uiScale)
	return uiScale
end

function Theme.GetScale(): number
	return currentScale
end

function Theme.StartAutoScale()
	local function update()
		currentScale = computeScale()
		for index = #scales, 1, -1 do
			local uiScale = scales[index]
			if uiScale.Parent then
				uiScale.Scale = currentScale
			else
				table.remove(scales, index)
			end
		end
	end
	local function bindCamera()
		local camera = Workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
		end
		update()
	end
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)
	bindCamera()
end

-- Panel con degradado vertical y línea de acento superior.
function Theme.Panel(props: { [string]: any }, accent: Color3?): Frame
	local panel = Theme.New("Frame", props, {
		Theme.Corner(10),
		Theme.Stroke(accent or Theme.Colors.PanelStroke, 2, 0.35),
		Theme.New("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(Theme.Colors.PanelLight, Theme.Colors.Panel),
		}),
	})
	panel.BackgroundColor3 = Color3.new(1, 1, 1)
	panel.BorderSizePixel = 0
	Theme.New("Frame", {
		Name = "AccentLine",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.new(0.6, 0, 0, 2),
		BackgroundColor3 = accent or Theme.Colors.Accent,
		BorderSizePixel = 0,
		Parent = panel,
	})
	return panel
end

function Theme.FormatTime(seconds: number): string
	local total = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", total // 60, total % 60)
end

return Theme
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="237">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="238">
          <Properties>
            <string name="Name">AuraSystem</string>
            <string name="Source"><![CDATA[--[[
	AuraSystem
	Auras modulares (solo presentación, solo en el cliente). Cada aura se
	construye con las capas de su perfil (VisualConfig.Auras):

	  Rise    partículas que ascienden desde un volumen cilíndrico alrededor del cuerpo
	  Orbit   motas fijadas a un punto que gira: orbitan alrededor del personaje
	  Sparks  chispas rápidas que saltan desde la superficie
	  Ring    anillo en el suelo que pulsa (doble en perfiles de alto nivel)
	  Light   luz puntual (solo calidad alta)

	API:
	  local aura = AuraSystem.Attach(rootPart, "Electric", { Scale = 1, Height = 5 })
	  aura:SetProfile("Fire")  aura:SetIntensity(0.6)  aura:Burst()  aura:Destroy()
	  AuraSystem.SetQuality("Low")

	Todas las auras se animan desde un único RenderStepped; las que quedan lejos
	de la cámara (MaxDistance) apagan sus emisores. Las piezas son locales: no se
	replican ni tienen colisión, masa ni consultas.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local VisualConfig = require(ReplicatedStorage.Shared.Config.VisualConfig)
local Signal = require(ReplicatedStorage.Shared.Signal)

local AuraSystem = {}
AuraSystem.__index = AuraSystem

local TEXTURES = VisualConfig.Textures
local active: { any } = {}
local quality = VisualConfig.Quality[VisualConfig.DefaultQuality]
local qualityName = VisualConfig.DefaultQuality
-- Se dispara con el nombre del nivel de calidad ("High" / "Low").
AuraSystem.QualityChanged = Signal.new()
local connection: RBXScriptConnection? = nil

local function localPart(name: string, size: Vector3): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Transparency = 1
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	return part
end

local function weldTo(part: BasePart, target: BasePart, offset: CFrame)
	part.CFrame = target.CFrame * offset
	local weld = Instance.new("Weld")
	weld.Part0 = target
	weld.Part1 = part
	weld.C0 = offset
	weld.Parent = part
	return weld
end

local function makeEmitter(layer: any, color: Color3, accent: Color3, parent: Instance, dark: boolean?): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = TEXTURES[layer.Texture] or TEXTURES.Sparkle
	emitter.Color = ColorSequence.new(accent, color)
	emitter.LightEmission = if dark then 0 else 0.9
	emitter.LightInfluence = 0
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, layer.Size * 0.6),
		NumberSequenceKeypoint.new(0.3, layer.Size),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, if dark then 0.35 else 0.15),
		NumberSequenceKeypoint.new(0.7, 0.5),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = NumberRange.new(layer.Lifetime * 0.7, layer.Lifetime)
	emitter.Speed = NumberRange.new(layer.Speed * 0.6, layer.Speed)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-90, 90)
	emitter.Rate = 0
	emitter.Parent = parent
	return emitter
end

local function makeRing(color: Color3): Part
	local ring = localPart("AuraRing", Vector3.new(0.12, 4, 4))
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.Neon
	ring.Color = color
	return ring
end

export type Options = { Scale: number?, Height: number?, FloorOffset: number?, Intensity: number?, Light: boolean? }

--[[
	Crea un aura alrededor de `root` (HumanoidRootPart o Root de un enemigo).
	Height: altura del cuerpo (studs) para el volumen de emisión.
]]
function AuraSystem.Attach(root: BasePart, profileName: string, options: Options?)
	local opts = options or {}
	local self = setmetatable({}, AuraSystem)
	self.Root = root
	self.Scale = opts.Scale or 1
	self.Height = opts.Height or 5
	-- Distancia del centro de `root` al suelo (para el anillo).
	self.FloorOffset = opts.FloorOffset or self.Height / 2
	self.Intensity = opts.Intensity or 1
	self.AllowLight = opts.Light ~= false
	self.BurstUntil = 0
	self.Phase = math.random() * 10
	self.Visible = true

	local folder = Instance.new("Folder")
	folder.Name = "Aura"
	self.Folder = folder

	-- Volumen alrededor del cuerpo (las partículas nacen en su superficie).
	local volume = localPart("AuraVolume", Vector3.new(4, self.Height, 4))
	weldTo(volume, root, CFrame.new(0, 0, 0))
	volume.Parent = folder
	self.Volume = volume

	-- Punto que gira para las motas en órbita.
	local orbitPart = localPart("AuraOrbit", Vector3.new(0.2, 0.2, 0.2))
	self.OrbitWeld = weldTo(orbitPart, root, CFrame.new())
	orbitPart.Parent = folder
	self.OrbitPart = orbitPart

	self.Rings = {}
	folder.Parent = root
	self:SetProfile(profileName)
	table.insert(active, self)
	return self
end

function AuraSystem:_clearLayers()
	for _, emitter in self.Emitters or {} do
		emitter:Destroy()
	end
	for _, ring in self.Rings do
		ring.Part:Destroy()
	end
	if self.Light then
		self.Light:Destroy()
		self.Light = nil
	end
	self.Emitters = {}
	self.Rings = {}
end

function AuraSystem:SetProfile(profileName: string)
	if self.ProfileName == profileName then
		return
	end
	local profile = VisualConfig.Auras[profileName]
	assert(profile, "Perfil de aura desconocido: " .. tostring(profileName))
	self:_clearLayers()
	self.ProfileName = profileName
	self.Profile = profile
	local scale = self.Scale
	local radius = profile.Radius * scale
	self.Volume.Size = Vector3.new(radius * 2, self.Height, radius * 2)

	local emitters = {}
	if profile.Rise then
		local rise = makeEmitter(profile.Rise, profile.Color, profile.Accent, self.Volume, profile.Rise.Dark)
		rise.Shape = Enum.ParticleEmitterShape.Cylinder
		rise.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		rise.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
		rise.EmissionDirection = Enum.NormalId.Top
		rise.SpreadAngle = Vector2.new(12, 12)
		rise.Acceleration = Vector3.new(0, profile.Rise.Speed * 0.6, 0)
		emitters.Rise = rise
	end
	if profile.Sparks then
		local sparks = makeEmitter(profile.Sparks, profile.Accent, profile.Color, self.Volume)
		sparks.Shape = Enum.ParticleEmitterShape.Cylinder
		sparks.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		sparks.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
		sparks.SpreadAngle = Vector2.new(40, 40)
		sparks.Drag = 4
		emitters.Sparks = sparks
	end
	if profile.Orbit then
		-- Emite desde un punto desplazado del eje que gira: las motas trazan una órbita.
		local attachment = Instance.new("Attachment")
		attachment.Position = Vector3.new(radius, 0, 0)
		attachment.Parent = self.OrbitPart
		local orbit = makeEmitter(profile.Orbit, profile.Color, profile.Accent, attachment)
		orbit.LockedToPart = true
		orbit.SpreadAngle = Vector2.new(180, 180)
		orbit.Speed = NumberRange.new(0.2, profile.Orbit.Speed * 0.3)
		emitters.Orbit = orbit
	end
	self.Emitters = emitters

	if profile.Ring then
		local count = if profile.Ring.Double then 2 else 1
		for index = 1, count do
			local ring = makeRing(if index == 1 then profile.Color else profile.Accent)
			local weld =
				weldTo(ring, self.Root, CFrame.new(0, -self.FloorOffset + 0.12, 0) * CFrame.Angles(0, 0, math.pi / 2))
			ring.Parent = self.Folder
			table.insert(self.Rings, { Part = ring, Weld = weld, Offset = (index - 1) * 0.5 })
		end
	end
	if profile.Light and self.AllowLight then
		local light = Instance.new("PointLight")
		light.Color = profile.Color
		light.Range = profile.Light.Range * scale
		light.Brightness = profile.Light.Brightness
		light.Shadows = false
		light.Parent = self.Volume
		self.Light = light
	end
	self:_applyRates()
end

function AuraSystem:_applyRates()
	local profile = self.Profile
	local burst = os.clock() < self.BurstUntil
	local intensity = self.Intensity * (if burst then 1.8 else 1)
	local scale = quality.ParticleScale * (if self.Visible then 1 else 0)
	for name, emitter in self.Emitters do
		local layer = profile[name]
		emitter.Rate = layer.Rate * intensity * scale * math.max(1, self.Scale * 0.8)
	end
	if self.Light then
		self.Light.Enabled = quality.Lights and self.Visible
		self.Light.Brightness = profile.Light.Brightness * math.min(intensity, 1.5)
	end
	for _, ring in self.Rings do
		ring.Part.LocalTransparencyModifier = if self.Visible and intensity > 0.05 then 0 else 1
	end
end

function AuraSystem:SetIntensity(intensity: number)
	if math.abs((self.Intensity or 0) - intensity) < 0.02 then
		return
	end
	self.Intensity = intensity
	self:_applyRates()
end

-- Ráfaga breve (subida de nivel, entrada del jefe): más emisión y un destello de chispas.
function AuraSystem:Burst(duration: number?)
	self.BurstUntil = os.clock() + (duration or 0.8)
	for _, emitter in self.Emitters do
		emitter:Emit(math.floor(10 * quality.ParticleScale + 0.5))
	end
	self:_applyRates()
	task.delay((duration or 0.8) + 0.05, function()
		if self.Folder and self.Folder.Parent then
			self:_applyRates()
		end
	end)
end

function AuraSystem:Destroy()
	local index = table.find(active, self)
	if index then
		table.remove(active, index)
	end
	if self.Folder then
		self.Folder:Destroy()
		self.Folder = nil
	end
end

function AuraSystem.SetQuality(name: string)
	if VisualConfig.Quality[name] == nil then
		return
	end
	quality = VisualConfig.Quality[name]
	qualityName = name
	for _, aura in active do
		aura:_applyRates()
	end
	AuraSystem.QualityChanged:Fire(name)
end

function AuraSystem.ToggleQuality(): string
	AuraSystem.SetQuality(if qualityName == "High" then "Low" else "High")
	return qualityName
end

function AuraSystem.GetQuality()
	return quality
end

function AuraSystem.GetQualityName(): string
	return qualityName
end

local function update()
	local camera = Workspace.CurrentCamera
	local cameraPosition = camera and camera.CFrame.Position or Vector3.zero
	local now = os.clock()
	for index = #active, 1, -1 do
		local aura = active[index]
		local root = aura.Root
		if root.Parent == nil or aura.Folder == nil or aura.Folder.Parent == nil then
			aura:Destroy()
			continue
		end
		local visible = (root.Position - cameraPosition).Magnitude <= aura.Profile.MaxDistance
		if visible ~= aura.Visible then
			aura.Visible = visible
			aura:_applyRates()
		end
		if not visible then
			continue
		end
		-- Órbita y anillos pulsantes.
		aura.OrbitWeld.C0 =
			CFrame.Angles(0, now * (aura.Profile.Orbit and aura.Profile.Orbit.Spin or 1) + aura.Phase, 0)
		local ringCfg = aura.Profile.Ring
		if ringCfg then
			for _, ring in aura.Rings do
				local t = ((now + aura.Phase) / ringCfg.Pulse + ring.Offset) % 1
				local size = ringCfg.Size * aura.Scale * (0.55 + 0.45 * t)
				ring.Part.Size = Vector3.new(0.12, size, size)
				ring.Part.Transparency = ringCfg.Transparency + (1 - ringCfg.Transparency) * t
			end
		end
	end
end

function AuraSystem.Start()
	if connection == nil then
		connection = RunService.RenderStepped:Connect(function()
			debug.profilebegin("SkyBonk.Auras")
			update()
			debug.profileend()
		end)
	end
end

return AuraSystem
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="239">
          <Properties>
            <string name="Name">FxPool</string>
            <string name="Source"><![CDATA[--[[
	FxPool
	Efectos visuales reutilizables del cliente (solo presentación):
	  • emisores de partículas con nombre, emitidos en cualquier posición,
	  • anillos en el suelo que se expanden y desvanecen (aparición, nivel, golpes),
	  • resaltes (Highlight) cortos para indicar impactos,
	  • formas propias: corte en media luna (Beam curvado), estrella de crítico
	    y destello de impacto.
	Todo se reutiliza: no se crean instancias por impacto ni por enemigo, y
	las animaciones de los anillos se actualizan desde un único Heartbeat.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local VisualConfig = require(ReplicatedStorage.Shared.Config.VisualConfig)
local TEXTURE_GLOW = VisualConfig.Textures.Glow

local FxPool = {}

local folder: Folder
local anchor: Part
local emitters: { [string]: ParticleEmitter } = {}
local ringPool: { Part } = {}
local activeRings: { { Part: Part, Start: number, Duration: number, From: number, To: number, Transparency: number, Height: number } } =
	{}
local highlightPool: { Highlight } = {}
local activeHighlights: { { Highlight: Highlight, Until: number } } = {}

local EMITTERS: { [string]: { [string]: any } } = {
	HitSparks = {
		Color = ColorSequence.new(Color3.fromRGB(190, 250, 255), Color3.new(1, 1, 1)),
		Size = NumberSequence.new(0.55, 0),
		Lifetime = NumberRange.new(0.18, 0.32),
		Speed = NumberRange.new(14, 24),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 7,
		LightEmission = 1,
	},
	CritSparks = {
		Color = ColorSequence.new(Color3.fromRGB(255, 200, 90), Color3.fromRGB(255, 120, 60)),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) }),
		Lifetime = NumberRange.new(0.25, 0.4),
		Speed = NumberRange.new(18, 30),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 6,
		LightEmission = 1,
	},
	DeathBurst = {
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) }),
		Lifetime = NumberRange.new(0.35, 0.65),
		Speed = NumberRange.new(10, 20),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -35, 0),
		Drag = 3,
		LightEmission = 0.6,
	},
	Dust = {
		Color = ColorSequence.new(Color3.fromRGB(230, 220, 200)),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 2.4) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) }),
		Lifetime = NumberRange.new(0.4, 0.7),
		Speed = NumberRange.new(6, 12),
		SpreadAngle = Vector2.new(80, 80),
		EmissionDirection = Enum.NormalId.Top,
		Drag = 4,
		LightEmission = 0,
	},
	Sparkles = {
		Color = ColorSequence.new(Color3.fromRGB(255, 220, 110), Color3.fromRGB(120, 240, 255)),
		Size = NumberSequence.new(0.7, 0),
		Lifetime = NumberRange.new(0.6, 1.1),
		Speed = NumberRange.new(6, 16),
		SpreadAngle = Vector2.new(70, 70),
		EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, 10, 0),
		LightEmission = 1,
	},
	GemPop = {
		Color = ColorSequence.new(Color3.fromRGB(120, 245, 255), Color3.new(1, 1, 1)),
		Size = NumberSequence.new(0.35, 0),
		Lifetime = NumberRange.new(0.2, 0.35),
		Speed = NumberRange.new(5, 9),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 5,
		LightEmission = 1,
	},
	Spark = {
		Color = ColorSequence.new(Color3.fromRGB(200, 230, 255), Color3.fromRGB(140, 120, 255)),
		Size = NumberSequence.new(0.4, 0),
		Lifetime = NumberRange.new(0.1, 0.2),
		Speed = NumberRange.new(16, 26),
		SpreadAngle = Vector2.new(180, 180),
		LightEmission = 1,
	},
}

function FxPool.Folder(): Folder
	return folder
end

-- Emite `count` partículas del emisor `name` en `position` (color opcional).
function FxPool.Emit(name: string, position: Vector3, count: number, color: Color3?)
	local emitter = emitters[name]
	if emitter == nil then
		return
	end
	anchor.CFrame = CFrame.new(position)
	if color then
		emitter.Color = ColorSequence.new(color, color:Lerp(Color3.new(1, 1, 1), 0.6))
	end
	emitter:Emit(count)
end

-- Anillo plano en el suelo que crece de `from` a `to` studs de diámetro.
function FxPool.Ring(
	position: Vector3,
	from: number,
	to: number,
	duration: number,
	color: Color3,
	transparency: number?,
	height: number?
)
	local ring = table.remove(ringPool)
	if ring == nil then
		local part = Instance.new("Part")
		part.Name = "FxRing"
		part.Shape = Enum.PartType.Cylinder
		part.Material = Enum.Material.Neon
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		ring = part
	end
	local r = ring :: Part
	r.Color = color
	r.Size = Vector3.new(height or 0.2, from, from)
	r.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2)
	r.Transparency = transparency or 0.3
	r.Parent = folder
	table.insert(activeRings, {
		Part = r,
		Start = os.clock(),
		Duration = duration,
		From = from,
		To = to,
		Transparency = transparency or 0.3,
		Height = height or 0.2,
	})
	return r
end

-- Resalte breve sobre un modelo (máximo 8 a la vez: el resto se omite).
function FxPool.Flash(model: Instance, color: Color3, duration: number)
	local highlight = table.remove(highlightPool)
	if highlight == nil then
		if #activeHighlights >= 8 then
			return
		end
		local created = Instance.new("Highlight")
		created.DepthMode = Enum.HighlightDepthMode.Occluded
		created.OutlineTransparency = 1
		created.FillTransparency = 0.25
		created.Parent = folder
		highlight = created
	end
	local h = highlight :: Highlight
	h.FillColor = color
	h.Adornee = model
	h.Enabled = true
	table.insert(activeHighlights, { Highlight = h, Until = os.clock() + duration })
end

------------------------------------------------- Efectos con forma propia
-- Cada efecto se reutiliza desde su pool y se anima en el bucle central.
type Shape = { Kind: string, Root: BasePart, Parts: { any }, Start: number, Duration: number, Data: any }
local shapePools: { [string]: { Shape } } = { Slash = {}, Star = {}, Flash = {} }
local activeShapes: { Shape } = {}

local function fxPart(name: string): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	return part
end

local function makeSlash(): Shape
	local root = fxPart("FxSlash")
	-- A0 a la izquierda con su eje X hacia delante; A1 a la derecha con el eje
	-- X hacia atrás: la curva de Bézier del Beam se abomba hacia delante.
	local a0 = Instance.new("Attachment")
	a0.Parent = root
	local a1 = Instance.new("Attachment")
	a1.Parent = root
	local beams = {}
	for index, style in { { Width = 3.2, Light = 0.6 }, { Width = 0.9, Light = 1 } } do
		local beam = Instance.new("Beam")
		beam.Name = "SlashBeam" .. index
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Texture = TEXTURE_GLOW
		beam.TextureMode = Enum.TextureMode.Stretch
		beam.LightEmission = style.Light
		beam.LightInfluence = 0
		beam.Segments = 16
		beam.FaceCamera = false
		beam.Enabled = false
		beam.Parent = root
		beams[index] = { Beam = beam, Width = style.Width }
	end
	return { Kind = "Slash", Root = root, Parts = beams, Start = 0, Duration = 0.2, Data = { A0 = a0, A1 = a1 } }
end

local function makeStar(): Shape
	local root = fxPart("FxStar")
	local rays = {}
	for index = 1, 4 do
		local ray = fxPart("StarRay")
		ray.Material = Enum.Material.Neon
		ray.Parent = root
		rays[index] = ray
	end
	return { Kind = "Star", Root = root, Parts = rays, Start = 0, Duration = 0.22, Data = {} }
end

local function makeFlash(): Shape
	local root = fxPart("FxFlash")
	root.Shape = Enum.PartType.Ball
	root.Material = Enum.Material.Neon
	return { Kind = "Flash", Root = root, Parts = {}, Start = 0, Duration = 0.1, Data = {} }
end

local function acquireShape(kind: string): Shape
	local shape = table.remove(shapePools[kind])
	if shape == nil then
		shape = if kind == "Slash" then makeSlash() elseif kind == "Star" then makeStar() else makeFlash()
	end
	local s = shape :: Shape
	s.Start = os.clock()
	s.Root.Parent = folder
	table.insert(activeShapes, s)
	return s
end

--[[
	Corte en media luna delante de `origin` (CFrame mirando al objetivo).
	`radius` = semiancho del arco; `tilt` inclina el plano (variedad de tajos).
]]
function FxPool.Slash(origin: CFrame, radius: number, color: Color3, tilt: number, duration: number?)
	local shape = acquireShape("Slash")
	shape.Duration = duration or 0.2
	shape.Root.CFrame = origin * CFrame.Angles(0, 0, tilt)
	local forward, up = Vector3.new(0, 0, -1), Vector3.new(0, 1, 0)
	shape.Data.A0.CFrame = CFrame.fromMatrix(Vector3.new(-radius, 0, 0), forward, up)
	shape.Data.A1.CFrame = CFrame.fromMatrix(Vector3.new(radius, 0, 0), -forward, up)
	shape.Data.Radius = radius
	for index, entry in shape.Parts do
		local beam: Beam = entry.Beam
		beam.Color = if index == 1 then ColorSequence.new(color) else ColorSequence.new(Color3.new(1, 1, 1), color)
		beam.CurveSize0 = radius * 1.25
		beam.CurveSize1 = radius * 1.25
		beam.Enabled = true
	end
end

-- Estrella de crítico: cuatro rayos que se abren y se desvanecen.
function FxPool.Star(position: Vector3, color: Color3, size: number?)
	local shape = acquireShape("Star")
	shape.Data.Size = size or 5
	shape.Root.CFrame = CFrame.new(position) * CFrame.Angles(0, math.random() * math.pi, 0)
	for _, ray in shape.Parts do
		ray.Color = color
	end
end

-- Destello esférico breve en el punto de impacto.
function FxPool.ImpactFlash(position: Vector3, color: Color3, size: number?)
	local shape = acquireShape("Flash")
	shape.Data.Size = size or 2.2
	shape.Root.Color = color
	shape.Root.CFrame = CFrame.new(position)
end

local function updateShapes(now: number)
	for index = #activeShapes, 1, -1 do
		local shape = activeShapes[index]
		local t = (now - shape.Start) / shape.Duration
		if t >= 1 then
			shape.Root.Parent = nil
			if shape.Kind == "Slash" then
				for _, entry in shape.Parts do
					entry.Beam.Enabled = false
				end
			end
			table.insert(shapePools[shape.Kind], shape)
			table.remove(activeShapes, index)
			continue
		end
		if shape.Kind == "Slash" then
			-- Ejecución rápida (se abre) y desaparición (se estrecha y desvanece).
			local open = 1 - (1 - math.min(1, t * 2.5)) ^ 2
			for _, entry in shape.Parts do
				local beam: Beam = entry.Beam
				beam.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(math.clamp(0.5 - open * 0.45, 0.02, 0.5), 0.1 + t * 0.9),
					NumberSequenceKeypoint.new(math.clamp(0.5 + open * 0.45, 0.5, 0.98), 0.1 + t * 0.9),
					NumberSequenceKeypoint.new(1, 1),
				})
				-- Centro más ancho que las puntas: forma de media luna.
				beam.Width0 = entry.Width * (0.15 + 0.1 * (1 - t))
				beam.Width1 = beam.Width0
				beam.CurveSize0 = shape.Data.Radius * (1.1 + 0.4 * open)
				beam.CurveSize1 = beam.CurveSize0
			end
		elseif shape.Kind == "Star" then
			local size = shape.Data.Size * (0.4 + 0.6 * (1 - (1 - t) ^ 3))
			for rayIndex, ray in shape.Parts do
				local thickness = 0.35 * (1 - t) + 0.05
				ray.Size = Vector3.new(thickness, thickness, size * (if rayIndex <= 2 then 1 else 0.6))
				ray.CFrame = shape.Root.CFrame * CFrame.Angles(0, (rayIndex - 1) * math.pi / 4, 0)
				ray.Transparency = t * t
			end
		else
			local size = shape.Data.Size * (0.5 + 0.5 * t)
			shape.Root.Size = Vector3.new(size, size, size)
			shape.Root.Transparency = 0.2 + 0.8 * t
		end
	end
end

local function update()
	debug.profilebegin("SkyBonk.FxPool")
	local now = os.clock()
	updateShapes(now)
	for index = #activeRings, 1, -1 do
		local entry = activeRings[index]
		local t = (now - entry.Start) / entry.Duration
		if t >= 1 then
			entry.Part.Parent = nil
			table.insert(ringPool, entry.Part)
			table.remove(activeRings, index)
		else
			local eased = 1 - (1 - t) ^ 3
			local diameter = entry.From + (entry.To - entry.From) * eased
			entry.Part.Size = Vector3.new(entry.Height, diameter, diameter)
			entry.Part.Transparency = entry.Transparency + (1 - entry.Transparency) * t
		end
	end
	for index = #activeHighlights, 1, -1 do
		local entry = activeHighlights[index]
		if now >= entry.Until then
			entry.Highlight.Enabled = false
			entry.Highlight.Adornee = nil
			table.insert(highlightPool, entry.Highlight)
			table.remove(activeHighlights, index)
		end
	end
	debug.profileend()
end

function FxPool.Start()
	folder = Instance.new("Folder")
	folder.Name = "ClientEffects"
	folder.Parent = Workspace

	anchor = Instance.new("Part")
	anchor.Name = "FxAnchor"
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Parent = folder

	for name, props in EMITTERS do
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = name
		emitter.Enabled = false
		emitter.LockedToPart = false
		for key, value in props do
			(emitter :: any)[key] = value
		end
		emitter.Parent = anchor
		emitters[name] = emitter
	end
	RunService.Heartbeat:Connect(update)
end

return FxPool
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="240">
          <Properties>
            <string name="Name">Sfx</string>
            <string name="Source"><![CDATA[--[[
	Sfx
	Sonidos locales definidos en GameConfig.Audio.Sounds.

	• Categorías con su SoundGroup (Music, Ambient, Ui, Combat) y volumen
	  configurable (GameConfig.Audio.Volumes, Sfx.SetVolume).
	• Variaciones: se elige un id distinto del último en cada reproducción.
	• PitchJitter: pequeñas diferencias de tono para evitar fatiga auditiva.
	• Cooldown por sonido: limita repeticiones cuando muchos eventos coinciden.
	• `Sfx.PlayAt` atenúa el volumen con la distancia a la cámara (sonidos del mundo).
	Cada variación se crea una sola vez y se reproduce con
	SoundService:PlayLocalSound, que permite solapamientos sin clonar.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local Sfx = {}

local AUDIO = GameConfig.Audio
local folder: Folder? = nil
local groups: { [string]: SoundGroup } = {}
local variants: { [string]: { Sound } } = {}
local lastVariant: { [string]: number } = {}
local lastPlayed: { [string]: number } = {}

local function getFolder(): Folder
	if folder == nil then
		local created = Instance.new("Folder")
		created.Name = "SkyBonkSounds"
		created.Parent = SoundService
		folder = created
	end
	return folder :: Folder
end

function Sfx.GetGroup(category: string): SoundGroup
	local existing = groups[category]
	if existing then
		return existing
	end
	local group = Instance.new("SoundGroup")
	group.Name = category
	group.Volume = (AUDIO.Volumes :: any)[category] or 1
	group.Parent = getFolder()
	groups[category] = group
	return group
end

function Sfx.SetVolume(category: string, volume: number)
	if category == "Master" then
		for name, group in groups do
			group.Volume = ((AUDIO.Volumes :: any)[name] or 1) * volume
		end
		return
	end
	Sfx.GetGroup(category).Volume = volume * AUDIO.Volumes.Master
end

local function getVariants(name: string): { Sound }?
	local existing = variants[name]
	if existing then
		return existing
	end
	local info = (AUDIO.Sounds :: any)[name]
	if info == nil then
		return nil
	end
	local list = {}
	for index, id in info.Ids do
		local sound = Instance.new("Sound")
		sound.Name = name .. index
		sound.SoundId = "rbxassetid://" .. id
		sound.Volume = info.Volume
		sound.SoundGroup = Sfx.GetGroup(info.Category)
		sound.Parent = getFolder()
		table.insert(list, sound)
	end
	variants[name] = list
	return list
end

--[[
	Reproduce un sonido. `pitch` multiplica la velocidad (1 = normal) y
	`volumeScale` el volumen. Devuelve false si se omitió por el enfriamiento.
]]
function Sfx.Play(name: string, pitch: number?, volumeScale: number?): boolean
	local list = getVariants(name)
	local info = (AUDIO.Sounds :: any)[name]
	if list == nil or #list == 0 then
		return false
	end
	local now = os.clock()
	if now - (lastPlayed[name] or -1) < (info.Cooldown or 0) then
		return false
	end
	lastPlayed[name] = now

	local index = 1
	if #list > 1 then
		index = math.random(1, #list - 1)
		if index >= (lastVariant[name] or 0) then
			index += 1
		end
	end
	lastVariant[name] = index
	local sound = list[index]
	local jitter = info.PitchJitter or 0
	sound.PlaybackSpeed = (pitch or 1) * (1 + (math.random() * 2 - 1) * jitter)
	sound.Volume = info.Volume * (volumeScale or 1)
	SoundService:PlayLocalSound(sound)
	return true
end

-- Sonido del mundo: más bajo cuanto más lejos de la cámara (silencio a `range` studs).
function Sfx.PlayAt(name: string, position: Vector3, pitch: number?, range: number?): boolean
	local camera = Workspace.CurrentCamera
	local maxRange = range or 90
	local scale = 1
	if camera then
		local distance = (camera.CFrame.Position - position).Magnitude
		scale = math.clamp(1 - (distance - 20) / (maxRange - 20), 0, 1)
	end
	if scale <= 0.03 then
		return false
	end
	return Sfx.Play(name, pitch, scale)
end

function Sfx.Preload(): { Instance }
	local all = {}
	for name in AUDIO.Sounds do
		for _, sound in getVariants(name) or {} do
			table.insert(all, sound)
		end
	end
	return all
end

return Sfx
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>

      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Signal
	Señal síncrona mínima para desacoplar controladores sin dependencias circulares.
]]

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

type Handler = (...any) -> ()

type ConnectionImpl = Connection & { _fn: Handler, _signal: SignalImpl }

export type Signal = {
	Connect: (self: Signal, fn: Handler) -> Connection,
	Fire: (self: Signal, ...any) -> (),
	DisconnectAll: (self: Signal) -> (),
}

type SignalImpl = Signal & { _connections: { ConnectionImpl } }

local Signal = {}

local function disconnect(self: ConnectionImpl)
	if not self.Connected then
		return
	end
	self.Connected = false
	local list = self._signal._connections
	local index = table.find(list, self)
	if index then
		table.remove(list, index)
	end
end

local function connect(self: SignalImpl, fn: Handler): Connection
	local connection = {
		Connected = true,
		Disconnect = disconnect,
		_fn = fn,
		_signal = self,
	} :: any
	table.insert(self._connections, connection)
	return connection
end

local function fire(self: SignalImpl, ...: any)
	-- Copia para tolerar desconexiones durante la emisión.
	for _, connection in table.clone(self._connections) do
		if connection.Connected then
			local ok, err = pcall(connection._fn, ...)
			if not ok then
				warn("[Signal] Error en un manejador:", err)
			end
		end
	end
end

local function disconnectAll(self: SignalImpl)
	for _, connection in self._connections do
		connection.Connected = false
	end
	table.clear(self._connections)
end

function Signal.new(): Signal
	local signal = {
		_connections = {},
		Connect = connect,
		Fire = fire,
		DisconnectAll = disconnectAll,
	} :: any
	return signal
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Types
	Tipos compartidos entre servidor y cliente para las interfaces importantes.
]]

export type GamePhase = "Playing" | "ChoosingUpgrade" | "GameOver"

export type WeaponDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	Pattern: string,
	Damage: number,
	Cooldown: number,
	MinCooldown: number,
	Range: number,
	Projectiles: number,
	MaxProjectiles: number,
	TargetsPerProjectile: number,
	Color: Color3,
}

export type EnemyDef = {
	Id: string,
	DisplayName: string,
	ModelName: string,
	MaxHealth: number,
	ContactDamage: number,
	MoveSpeed: number,
	AttackRange: number,
	AttackCooldown: number,
	XpReward: number,
	Color: Color3,
}

-- Estadísticas modificables por las mejoras. Los porcentajes son aditivos
-- (0.15 = +15 %) y los multiplicadores se acumulan multiplicando.
export type Stats = {
	DamagePct: number,
	CooldownMult: number,
	RangePct: number,
	MaxHealthPct: number,
	MoveSpeedPct: number,
	XpGainPct: number,
	DamageTakenMult: number,
	Luck: number,
	ExtraProjectiles: number,
}

export type StatName =
	"DamagePct"
	| "CooldownMult"
	| "RangePct"
	| "MaxHealthPct"
	| "MoveSpeedPct"
	| "XpGainPct"
	| "DamageTakenMult"
	| "Luck"
	| "ExtraProjectiles"

-- "Add" suma Value a la estadística, "Mul" la multiplica y "HealPct" cura
-- al instante un porcentaje de la vida máxima (no modifica Stats).
export type UpgradeEffect = {
	Op: "Add" | "Mul" | "HealPct",
	Stat: StatName?,
	Value: number,
}

export type Rarity = "Common" | "Rare" | "Epic"

export type UpgradeDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	Rarity: Rarity,
	Category: string,
	Icon: string,
	MaxLevel: number?, -- nil = sin límite
	Weight: number?, -- multiplicador adicional de probabilidad (por defecto 1)
	Effects: { UpgradeEffect },
	Requires: string?, -- nombre de un requisito evaluado por UpgradeLogic
	Enabled: boolean?, -- false = nunca se ofrece
	DisabledReason: string?,
	IsFallback: boolean?, -- solo se ofrece para completar ofertas incompletas
}

export type WeaponState = {
	Id: string,
	Def: WeaponDef,
	NextAttackAt: number,
}

export type WeaponStats = {
	Damage: number,
	Cooldown: number,
	Range: number,
	Projectiles: number,
	TargetsPerProjectile: number,
}

export type Offer = {
	Token: number,
	Level: number,
	Options: { string },
	Consumed: boolean,
}

export type Progress = {
	Level: number,
	Xp: number,
	TotalXp: number,
	PendingLevels: { number }, -- niveles alcanzados cuya mejora aún no se ha elegido
}

-- Opción enviada al cliente: solo el id y los niveles; los textos se leen
-- de UpgradeConfig en el cliente (únicamente para mostrarlos).
export type OfferOptionPayload = {
	Id: string,
	CurrentLevel: number,
	NextLevel: number,
}

export type OfferPayload = {
	Token: number,
	Level: number,
	Options: { OfferOptionPayload },
}

export type StatSummary = {
	Damage: number,
	Cooldown: number,
	Range: number,
	Projectiles: number,
	MoveSpeed: number,
	DamageReductionPct: number,
	XpBonusPct: number,
	Luck: number,
}

export type HudSnapshot = {
	Phase: GamePhase,
	Level: number,
	Xp: number,
	XpToNext: number,
	Health: number,
	MaxHealth: number,
	Kills: number,
	Elapsed: number,
	Stats: StatSummary,
}

export type GameOverPayload = {
	Elapsed: number,
	Kills: number,
	Level: number,
}

return {}
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="26">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="27">
      <Properties>
        <string name="Name">Bootstrap</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Bootstrap (servidor)
	Orden de arranque:
	  1. Configuración del mundo: carpetas de runtime, mapa, iluminación,
	     grupos de colisión y plantillas de enemigos.
	  2. Init(services) de todos los servicios (inyección de dependencias).
	  3. Start() de todos los servicios.
	  4. En Studio: pruebas unitarias y API de depuración opcional.
]]

local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local MapBuilder = require(script.Parent.World.MapBuilder)

Players.CharacterAutoLoads = false

local function ensureFolder(parent: Instance, name: string): Folder
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

-- 1. Mundo ---------------------------------------------------------------
ensureFolder(workspace, "ActiveEnemies")
ensureFolder(workspace, "ExperienceOrbs")
local enemyModels = ensureFolder(ServerStorage, "EnemyModels")

local existingMap = workspace:FindFirstChild("Map")
if existingMap == nil or existingMap:FindFirstChild("Ground") == nil then
	if existingMap then
		existingMap:Destroy()
	end
	MapBuilder.build(workspace)
end
MapBuilder.applyLighting()
-- Nota: Workspace.FallenPartsDestroyHeight no se puede escribir desde scripts;
-- se fija en default.project.json (-445), por debajo de GameConfig.Map.KillY.

PhysicsService:RegisterCollisionGroup("Players")
PhysicsService:RegisterCollisionGroup("Enemies")
-- Los enemigos no empujan al jugador (evita lanzamientos físicos); el daño
-- por contacto se calcula por distancia en EnemyService.
PhysicsService:CollisionGroupSetCollidable("Players", "Enemies", false)

-- 2-3. Servicios -----------------------------------------------------------
local ServicesFolder = script.Parent.Services
local services = {
	MatchService = require(ServicesFolder.MatchService),
	LevelService = require(ServicesFolder.LevelService),
	UpgradeService = require(ServicesFolder.UpgradeService),
	EnemyService = require(ServicesFolder.EnemyService),
	SpawnService = require(ServicesFolder.SpawnService),
	ExperienceService = require(ServicesFolder.ExperienceService),
	CombatService = require(ServicesFolder.CombatService),
}
local START_ORDER = {
	"EnemyService",
	"ExperienceService",
	"SpawnService",
	"CombatService",
	"LevelService",
	"UpgradeService",
	"MatchService", -- el último: empieza a aceptar jugadores
}

services.EnemyService.EnsureTemplates(enemyModels)
for _, name in START_ORDER do
	services[name].Init(services)
end
for _, name in START_ORDER do
	services[name].Start()
end

print("[SkyBonk] Servidor listo")

-- 4. Herramientas de Studio ------------------------------------------------
if RunService:IsStudio() then
	if GameConfig.Debug.RunSelfTestsInStudio then
		task.spawn(function()
			local TestRunner = require(script.Parent.Tests.TestRunner)
			TestRunner.runFolder(script.Parent.Tests)
		end)
	end
	if GameConfig.Debug.ExposeStudioDebugApi then
		-- Uso desde la barra de comandos (vista de servidor) durante el Play:
		--   _G.SkyBonkDebug.GrantXp(30)     concede XP al primer jugador
		--   _G.SkyBonkDebug.Kill()          derrota inmediata
		local function firstRun()
			local player = Players:GetPlayers()[1]
			return player and services.MatchService.GetRun(player)
		end
		-- selene: allow(global_usage)
		_G.SkyBonkDebug = {
			GrantXp = function(amount: number)
				local run = firstRun()
				if run then
					services.LevelService.GrantExperience(run, amount)
				end
			end,
			Kill = function()
				local run = firstRun()
				if run then
					run.Humanoid.Health = 0
				end
			end,
			EnemyCount = function(): number
				local run = firstRun()
				return if run then services.EnemyService.Count(run) else 0
			end,
		}
	end
end
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="28">
      <Properties>
        <string name="Name">Logic</string>
      </Properties>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">LevelLogic</string>
          <string name="Source"><![CDATA[--!strict
--[[
	LevelLogic
	Experiencia y niveles. Cada nivel alcanzado se encola una sola vez en
	PendingLevels; la experiencia sobrante se conserva.
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Types = require(Shared.Types)
local Progression = require(Shared.Progression)
local GameConfig = require(Shared.Config.GameConfig)

type Progress = Types.Progress

local LevelLogic = {}

function LevelLogic.new(): Progress
	return {
		Level = 1,
		Xp = 0,
		TotalXp = 0,
		PendingLevels = {},
	}
end

-- Añade experiencia (ya multiplicada) y devuelve cuántos niveles se han ganado.
function LevelLogic.addXp(progress: Progress, amount: number): number
	-- Rechaza NaN, infinitos, negativos y cantidades absurdas.
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return 0
	end
	amount = math.min(amount, GameConfig.Experience.MaxXpPerGrant)

	progress.Xp += amount
	progress.TotalXp += amount

	local gained = 0
	local required = Progression.xpToNext(progress.Level)
	while progress.Xp >= required do
		progress.Xp -= required
		progress.Level += 1
		table.insert(progress.PendingLevels, progress.Level)
		gained += 1
		required = Progression.xpToNext(progress.Level)
	end
	return gained
end

-- Extrae el siguiente nivel pendiente de elegir mejora (FIFO).
function LevelLogic.popPendingLevel(progress: Progress): number?
	if #progress.PendingLevels == 0 then
		return nil
	end
	return table.remove(progress.PendingLevels, 1)
end

return LevelLogic
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">RateLimiter</string>
          <string name="Source"><![CDATA[--!strict
--[[
	RateLimiter
	Limita el número de peticiones por clave (jugador) en una ventana deslizante.
	El reloj se inyecta para poder probarlo fuera de Roblox.
]]

export type RateLimiter = {
	Allow: (self: RateLimiter, key: any) -> boolean,
	Forget: (self: RateLimiter, key: any) -> (),
}

local RateLimiter = {}

function RateLimiter.new(maxRequests: number, window: number, clock: (() -> number)?): RateLimiter
	local now = clock or os.clock
	local history: { [any]: { number } } = {}

	local limiter = {}

	function limiter.Allow(_self: RateLimiter, key: any): boolean
		local t = now()
		local stamps = history[key]
		if stamps == nil then
			stamps = {}
			history[key] = stamps
		end
		-- Descarta marcas fuera de la ventana.
		local firstValid = 1
		while firstValid <= #stamps and t - stamps[firstValid] >= window do
			firstValid += 1
		end
		if firstValid > 1 then
			stamps = table.move(stamps, firstValid, #stamps, 1, {})
			history[key] = stamps
		end
		if #stamps >= maxRequests then
			return false
		end
		table.insert(stamps, t)
		return true
	end

	function limiter.Forget(_self: RateLimiter, key: any)
		history[key] = nil
	end

	return limiter :: RateLimiter
end

return RateLimiter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">RunState</string>
          <string name="Source"><![CDATA[--!strict
--[[
	RunState
	Estado autoritativo de una partida y su máquina de estados:

	  Playing ──(nivel pendiente)──► ChoosingUpgrade ──(elección válida)──► Playing
	     │                                   │
	     └──────────────(muerte)─────────────┴──────────────────────────► GameOver

	Es lógica pura (sin instancias), por lo que se prueba fuera de Roblox.
	Los servicios del servidor la envuelven con personajes, enemigos y remotes.
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Types = require(Shared.Types)
local WeaponConfig = require(Shared.Config.WeaponConfig)
local UpgradeConfig = require(Shared.Config.UpgradeConfig)
local StatSheet = require(script.Parent.StatSheet)
local LevelLogic = require(script.Parent.LevelLogic)
local UpgradeLogic = require(script.Parent.UpgradeLogic)

export type RunState = {
	Phase: Types.GamePhase,
	Elapsed: number, -- reloj de partida: solo avanza en Playing
	Kills: number,
	Progress: Types.Progress,
	Stats: Types.Stats,
	UpgradeLevels: { [string]: number },
	Weapons: { Types.WeaponState },
	ActiveOffer: Types.Offer?,
	NextOfferToken: number,
}

export type ChoiceResult = {
	Def: Types.UpgradeDef,
	HealPct: number,
}

local RunState = {}

function RunState.new(weaponIds: { string }): RunState
	local weapons: { Types.WeaponState } = {}
	for _, id in weaponIds do
		local def = WeaponConfig[id]
		assert(def ~= nil, "Arma desconocida: " .. id)
		table.insert(weapons, { Id = id, Def = def, NextAttackAt = 0 })
	end
	return {
		Phase = "Playing",
		Elapsed = 0,
		Kills = 0,
		Progress = LevelLogic.new(),
		Stats = StatSheet.new(),
		UpgradeLevels = {},
		Weapons = weapons,
		ActiveOffer = nil,
		NextOfferToken = 0,
	}
end

function RunState.isPlaying(state: RunState): boolean
	return state.Phase == "Playing"
end

function RunState.advance(state: RunState, dt: number)
	if state.Phase == "Playing" and dt > 0 then
		state.Elapsed += dt
	end
end

function RunState.addKill(state: RunState)
	if state.Phase ~= "GameOver" then
		state.Kills += 1
	end
end

-- Concede experiencia base (aplica el bonus de XP). Devuelve niveles ganados.
function RunState.grantXp(state: RunState, baseAmount: number): number
	if state.Phase == "GameOver" then
		return 0
	end
	return LevelLogic.addXp(state.Progress, StatSheet.xpGain(state.Stats, baseAmount))
end

local function contextOf(state: RunState): UpgradeLogic.Context
	return {
		Stats = state.Stats,
		Weapons = state.Weapons,
		UpgradeLevels = state.UpgradeLevels,
	}
end

--[[
	Abre una oferta si la partida está en Playing y hay niveles pendientes.
	Devuelve la oferta nueva o nil (no se superponen ofertas).
]]
function RunState.tryOpenOffer(state: RunState, rng: UpgradeLogic.Rng): Types.Offer?
	if state.Phase ~= "Playing" or state.ActiveOffer ~= nil then
		return nil
	end
	local level = LevelLogic.popPendingLevel(state.Progress)
	if level == nil then
		return nil
	end
	local options = UpgradeLogic.rollOptions(contextOf(state), rng)
	if #options == 0 then
		-- Sin opciones ni comodines: el nivel se considera resuelto.
		return nil
	end
	state.NextOfferToken += 1
	local offer: Types.Offer = {
		Token = state.NextOfferToken,
		Level = level,
		Options = options,
		Consumed = false,
	}
	state.ActiveOffer = offer
	state.Phase = "ChoosingUpgrade"
	return offer
end

--[[
	Valida y aplica una elección. Solo se acepta si la partida está esperando
	una elección y (token, id) corresponde a la oferta activa no consumida.
]]
function RunState.choose(state: RunState, token: any, upgradeId: any): (boolean, string? | ChoiceResult)
	if state.Phase ~= "ChoosingUpgrade" then
		return false, "NotChoosing"
	end
	local ok, reason = UpgradeLogic.validateChoice(state.ActiveOffer, token, upgradeId)
	if not ok then
		return false, reason
	end

	local offer = state.ActiveOffer :: Types.Offer
	local def = UpgradeConfig.ById[upgradeId :: string]
	offer.Consumed = true
	state.ActiveOffer = nil
	state.Phase = "Playing"

	local healPct = StatSheet.applyEffects(state.Stats, def.Effects)
	state.UpgradeLevels[def.Id] = (state.UpgradeLevels[def.Id] or 0) + 1

	local result: ChoiceResult = { Def = def, HealPct = healPct }
	return true, result
end

function RunState.setGameOver(state: RunState): boolean
	if state.Phase == "GameOver" then
		return false
	end
	state.Phase = "GameOver"
	if state.ActiveOffer then
		state.ActiveOffer.Consumed = true
		state.ActiveOffer = nil
	end
	return true
end

function RunState.offerPayload(state: RunState, offer: Types.Offer): Types.OfferPayload
	local options: { Types.OfferOptionPayload } = {}
	for _, id in offer.Options do
		local current = state.UpgradeLevels[id] or 0
		table.insert(options, { Id = id, CurrentLevel = current, NextLevel = current + 1 })
	end
	return { Token = offer.Token, Level = offer.Level, Options = options }
end

return RunState
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">StatSheet</string>
          <string name="Source"><![CDATA[--!strict
--[[
	StatSheet
	Estadísticas del jugador durante una partida y cálculo de los valores
	derivados (daño de arma, vida máxima, velocidad...). Lógica pura y
	determinista: no toca instancias de Roblox.
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Types = require(Shared.Types)
local GameConfig = require(Shared.Config.GameConfig)

type Stats = Types.Stats

local StatSheet = {}

function StatSheet.new(): Stats
	return {
		DamagePct = 0,
		CooldownMult = 1,
		RangePct = 0,
		MaxHealthPct = 0,
		MoveSpeedPct = 0,
		XpGainPct = 0,
		DamageTakenMult = 1,
		Luck = 0,
		ExtraProjectiles = 0,
	}
end

--[[
	Aplica los efectos de una mejora. Devuelve el porcentaje de curación
	instantánea solicitado (efectos "HealPct"), que aplica quien llama porque
	depende del Humanoid.
]]
function StatSheet.applyEffects(stats: Stats, effects: { Types.UpgradeEffect }): number
	local healPct = 0
	for _, effect in effects do
		if effect.Op == "HealPct" then
			healPct += effect.Value
		else
			local statName = effect.Stat
			assert(statName ~= nil, "Efecto sin estadística")
			local current = (stats :: any)[statName]
			assert(type(current) == "number", "Estadística desconocida: " .. tostring(statName))
			if effect.Op == "Add" then
				(stats :: any)[statName] = current + effect.Value
			elseif effect.Op == "Mul" then
				(stats :: any)[statName] = current * effect.Value
			else
				error("Operación de efecto desconocida: " .. tostring(effect.Op))
			end
		end
	end
	return healPct
end

function StatSheet.projectilesFor(stats: Stats, def: Types.WeaponDef): number
	return math.clamp(def.Projectiles + stats.ExtraProjectiles, 1, def.MaxProjectiles)
end

function StatSheet.weaponStats(stats: Stats, def: Types.WeaponDef): Types.WeaponStats
	return {
		Damage = def.Damage * (1 + stats.DamagePct),
		Cooldown = math.max(def.MinCooldown, def.Cooldown * stats.CooldownMult),
		Range = def.Range * (1 + stats.RangePct),
		Projectiles = StatSheet.projectilesFor(stats, def),
		TargetsPerProjectile = def.TargetsPerProjectile,
	}
end

function StatSheet.maxHealth(stats: Stats): number
	return math.floor(GameConfig.Player.BaseMaxHealth * (1 + stats.MaxHealthPct) + 0.5)
end

function StatSheet.walkSpeed(stats: Stats): number
	return GameConfig.Player.BaseWalkSpeed * (1 + stats.MoveSpeedPct)
end

function StatSheet.xpGain(stats: Stats, baseAmount: number): number
	return baseAmount * (1 + stats.XpGainPct)
end

function StatSheet.damageTaken(stats: Stats, rawDamage: number): number
	return math.max(0, rawDamage * stats.DamageTakenMult)
end

function StatSheet.luckyGemChance(stats: Stats): number
	local cfg = GameConfig.Experience
	return math.clamp(cfg.LuckyGemBaseChance + cfg.LuckyGemChancePerLuck * stats.Luck, 0, 1)
end

function StatSheet.summary(stats: Stats, primaryWeapon: Types.WeaponDef?): Types.StatSummary
	local weapon = primaryWeapon and StatSheet.weaponStats(stats, primaryWeapon)
	return {
		Damage = weapon and weapon.Damage or 0,
		Cooldown = weapon and weapon.Cooldown or 0,
		Range = weapon and weapon.Range or 0,
		Projectiles = weapon and weapon.Projectiles or 0,
		MoveSpeed = StatSheet.walkSpeed(stats),
		DamageReductionPct = (1 - stats.DamageTakenMult) * 100,
		XpBonusPct = stats.XpGainPct * 100,
		Luck = stats.Luck,
	}
end

return StatSheet
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">Targeting</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Targeting
	Selección de los N objetivos válidos más cercanos dentro de un alcance.
	Recorre la lista una sola vez y mantiene un pequeño top-N ordenado,
	sin crear tablas intermedias por enemigo.
]]

export type Candidate = {
	Position: Vector3,
	Dead: boolean,
}

local Targeting = {}

-- `candidates` puede contener cualquier tabla con Position y Dead (p. ej. enemigos).
function Targeting.nearest(
	candidates: { any },
	origin: Vector3,
	range: number,
	count: number,
	isValid: ((any) -> boolean)?
): { any }
	local rangeSq = range * range
	local best: { any } = {}
	local bestDist: { number } = {}
	if count <= 0 then
		return best
	end

	for _, candidate: Candidate in candidates do
		if candidate.Dead then
			continue
		end
		local offset = candidate.Position - origin
		local distSq = offset.X * offset.X + offset.Y * offset.Y + offset.Z * offset.Z
		if distSq > rangeSq then
			continue
		end
		if isValid and not isValid(candidate) then
			continue
		end
		-- Inserción ordenada en el top-N.
		local n = #best
		if n < count or distSq < bestDist[n] then
			local insertAt = n + 1
			for i = 1, n do
				if distSq < bestDist[i] then
					insertAt = i
					break
				end
			end
			table.insert(best, insertAt, candidate)
			table.insert(bestDist, insertAt, distSq)
			if #best > count then
				table.remove(best)
				table.remove(bestDist)
			end
		end
	end
	return best
end

return Targeting
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">UpgradeLogic</string>
          <string name="Source"><![CDATA[--!strict
--[[
	UpgradeLogic
	Elegibilidad, tirada aleatoria ponderada (sin repeticiones) y validación
	de elecciones de mejoras. Lógica pura: el generador aleatorio se inyecta.
]]

local Shared = game:GetService("ReplicatedStorage").Shared
local Types = require(Shared.Types)
local UpgradeConfig = require(Shared.Config.UpgradeConfig)
local StatSheet = require(script.Parent.StatSheet)

export type Rng = { NextNumber: (self: any) -> number }

export type Context = {
	Stats: Types.Stats,
	Weapons: { Types.WeaponState },
	UpgradeLevels: { [string]: number },
}

local UpgradeLogic = {}

-- Requisitos con nombre referenciados desde UpgradeConfig.Requires.
UpgradeLogic.Requirements = {
	WeaponAcceptsExtraProjectile = function(ctx: Context): boolean
		for _, weapon in ctx.Weapons do
			if StatSheet.projectilesFor(ctx.Stats, weapon.Def) < weapon.Def.MaxProjectiles then
				return true
			end
		end
		return false
	end,
} :: { [string]: (Context) -> boolean }

local function levelOf(ctx: Context, id: string): number
	return ctx.UpgradeLevels[id] or 0
end

-- ¿Puede ofrecerse esta mejora ahora mismo? (los comodines se tratan aparte)
function UpgradeLogic.isEligible(def: Types.UpgradeDef, ctx: Context): boolean
	if def.Enabled == false or def.IsFallback then
		return false
	end
	if #def.Effects == 0 then
		return false -- nunca mostrar mejoras que no hacen nada
	end
	if def.MaxLevel ~= nil and levelOf(ctx, def.Id) >= def.MaxLevel then
		return false
	end
	if def.Requires ~= nil then
		local check = UpgradeLogic.Requirements[def.Requires]
		if check == nil then
			warn("[UpgradeLogic] Requisito desconocido:", def.Requires)
			return false
		end
		if not check(ctx) then
			return false
		end
	end
	return true
end

function UpgradeLogic.weightOf(def: Types.UpgradeDef, luck: number): number
	local rarity = UpgradeConfig.Rarities[def.Rarity]
	local weight = (rarity and rarity.Weight or 1) * (def.Weight or 1)
	if def.Rarity ~= "Common" then
		weight *= 1 + math.max(0, luck) * UpgradeConfig.LuckRarityBonus
	end
	return math.max(weight, 0)
end

-- Devuelve hasta `size` ids distintos. Si hay menos mejoras válidas que
-- `size`, completa con comodines (IsFallback) para no bloquear la partida.
function UpgradeLogic.rollOptions(ctx: Context, rng: Rng, size: number?): { string }
	local offerSize = size or UpgradeConfig.OfferSize
	local pool: { Types.UpgradeDef } = {}
	for _, def in UpgradeConfig.List do
		if UpgradeLogic.isEligible(def, ctx) then
			table.insert(pool, def)
		end
	end

	local result: { string } = {}
	while #result < offerSize and #pool > 0 do
		local total = 0
		for _, def in pool do
			total += UpgradeLogic.weightOf(def, ctx.Stats.Luck)
		end
		local pickIndex = #pool
		if total > 0 then
			local roll = rng:NextNumber() * total
			for index, def in pool do
				roll -= UpgradeLogic.weightOf(def, ctx.Stats.Luck)
				if roll < 0 then
					pickIndex = index
					break
				end
			end
		end
		table.insert(result, pool[pickIndex].Id)
		table.remove(pool, pickIndex)
	end

	if #result < offerSize then
		for _, def in UpgradeConfig.List do
			if #result >= offerSize then
				break
			end
			if def.IsFallback and def.Enabled ~= false and not table.find(result, def.Id) then
				table.insert(result, def.Id)
			end
		end
	end

	return result
end

-- Comprueba que (token, id) corresponde a la oferta activa y no consumida.
function UpgradeLogic.validateChoice(offer: Types.Offer?, token: any, upgradeId: any): (boolean, string?)
	if offer == nil then
		return false, "NoActiveOffer"
	end
	if type(token) ~= "number" or token ~= offer.Token then
		return false, "StaleToken"
	end
	if offer.Consumed then
		return false, "AlreadyConsumed"
	end
	if type(upgradeId) ~= "string" or table.find(offer.Options, upgradeId) == nil then
		return false, "NotOffered"
	end
	if UpgradeConfig.ById[upgradeId] == nil then
		return false, "UnknownUpgrade"
	end
	return true, nil
end

return UpgradeLogic
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">Validation</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Validation
	Comprobaciones de tipos para los argumentos que llegan por RemoteEvents.
]]

local Validation = {}

function Validation.isFiniteNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function Validation.isPositiveInteger(value: any): boolean
	return Validation.isFiniteNumber(value) and value >= 1 and value % 1 == 0 and value < 2 ^ 31
end

-- Identificadores: solo letras y números ASCII, longitud acotada.
function Validation.isIdentifier(value: any, maxLength: number?): boolean
	if type(value) ~= "string" then
		return false
	end
	local length = #value
	if length == 0 or length > (maxLength or 64) then
		return false
	end
	return string.match(value, "^[%w_]+$") ~= nil
end

return Validation
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ModuleScript" referent="36">
      <Properties>
        <string name="Name">ServerTypes</string>
        <string name="Source"><![CDATA[--!strict
--[[
	ServerTypes
	Tipos de las estructuras internas compartidas por los servicios del servidor.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Types = require(ReplicatedStorage.Shared.Types)
local RunState = require(script.Parent.Logic.RunState)

-- Una partida en curso (una por jugador).
export type Run = {
	Player: Player,
	State: RunState.RunState,
	Active: boolean, -- false cuando la partida se ha limpiado
	Character: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Connections: { RBXScriptConnection },
	Rng: Random,
	Paused: boolean,
	InvulnerableUntil: number, -- en tiempo de partida
	HudDirty: boolean,
	LastHudSentAt: number,
	NextFallCheckAt: number,
	EndedAt: number?, -- os.clock() de la derrota
}

export type Enemy = {
	Id: number,
	Def: Types.EnemyDef,
	Run: Run,
	Model: Model,
	Root: BasePart,
	Mover: LinearVelocity,
	Facing: AlignOrientation,
	Health: number,
	MaxHealth: number,
	Damage: number,
	Speed: number,
	Dead: boolean,
	Position: Vector3, -- posición cacheada en el último tick de IA
	NextAttackAt: number,
	LastProgressPosition: Vector3,
	LastProgressAt: number,
	SidestepUntil: number,
	SidestepSign: number,
}

export type Gem = {
	Part: BasePart,
	Position: Vector3,
	Value: number,
	ExpiresAt: number,
	Collected: boolean,
}

-- Interfaz común de los servicios: Init recibe la tabla de todos los servicios
-- (inyección de dependencias, sin requires cruzados) y Start arranca la lógica.
export type Services = { [string]: any }

return {}
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="37">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[--[[
	CombatService
	Programación centralizada de los ataques automáticos. Cada partida tiene una
	lista de armas con su próximo instante de ataque (en tiempo de partida, así
	que la pausa también detiene el combate). El daño se calcula y aplica aquí;
	el cliente solo recibe la descripción visual del ataque (CombatFx).

	Para añadir un arma con otro patrón: crea su entrada en WeaponConfig con un
	`Pattern` nuevo y añade el manejador correspondiente en `Patterns`.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Net = require(Shared.Net)
local Types = require(Shared.Types)

local Logic = script.Parent.Parent.Logic
local StatSheet = require(Logic.StatSheet)
local Targeting = require(Logic.Targeting)
local ServerTypes = require(script.Parent.Parent.ServerTypes)

type Run = ServerTypes.Run
type Enemy = ServerTypes.Enemy

export type Hit = {
	Model: Model,
	Position: Vector3,
	Damage: number,
	Killed: boolean,
}

local CombatService = {}

local services: ServerTypes.Services

function CombatService.Init(allServices: ServerTypes.Services)
	services = allServices
end

function CombatService.Start() end

local function isValidTarget(enemy: Enemy): boolean
	return not enemy.Dead and enemy.Model.Parent ~= nil and not services.EnemyService.IsOutOfBounds(enemy.Position)
end

local function strike(enemy: Enemy, damage: number, hits: { Hit })
	local position = enemy.Position
	local model = enemy.Model
	local killed, dealt = services.EnemyService.Damage(enemy, damage)
	if dealt > 0 then
		table.insert(hits, { Model = model, Position = position, Damage = dealt, Killed = killed })
	end
end

-- Patrones de ataque: devuelven la lista de impactos (vacía si no hubo objetivo).
CombatService.Patterns = {
	-- Hojas espectrales: cada proyectil busca un enemigo distinto (el más cercano
	-- disponible). Con TargetsPerProjectile > 1 la hoja encadena a enemigos
	-- próximos a su objetivo.
	NearestTargets = function(run: Run, _weapon: Types.WeaponState, stats: Types.WeaponStats): { Hit }
		local hits: { Hit } = {}
		local enemies = services.EnemyService.GetEnemies(run)
		local origin = run.Root.Position
		local targets = Targeting.nearest(enemies, origin, stats.Range, stats.Projectiles, isValidTarget)
		local struck: { [Enemy]: boolean } = {}
		for _, target in targets do
			struck[target] = true
		end
		for _, target in targets do
			strike(target, stats.Damage, hits)
			local extra = stats.TargetsPerProjectile - 1
			if extra > 0 then
				local chained = Targeting.nearest(enemies, target.Position, stats.Range * 0.35, extra, function(candidate)
					return not struck[candidate] and isValidTarget(candidate)
				end)
				for _, other in chained do
					struck[other] = true
					strike(other, stats.Damage, hits)
				end
			end
		end
		return hits
	end,
} :: { [string]: (Run, Types.WeaponState, Types.WeaponStats) -> { Hit } }

function CombatService.SetupRun(run: Run)
	for _, weapon in run.State.Weapons do
		weapon.NextAttackAt = 0
	end
end

function CombatService.Step(run: Run)
	local state = run.State
	if state.Phase ~= "Playing" or run.Root.Parent == nil or run.Humanoid.Health <= 0 then
		return
	end
	local now = state.Elapsed
	for _, weapon in state.Weapons do
		if now < weapon.NextAttackAt then
			continue
		end
		local pattern = CombatService.Patterns[weapon.Def.Pattern]
		if pattern == nil then
			warn("[CombatService] Patrón desconocido:", weapon.Def.Pattern)
			weapon.NextAttackAt = math.huge
			continue
		end
		local weaponStats = StatSheet.weaponStats(state.Stats, weapon.Def)
		local origin = run.Root.Position
		local hits = pattern(run, weapon, weaponStats)
		if #hits == 0 then
			-- Sin objetivos: se vuelve a buscar en breve, no en cada frame.
			weapon.NextAttackAt = now + GameConfig.Combat.RetargetDelay
		else
			weapon.NextAttackAt = now + weaponStats.Cooldown
			Net.CombatFx:FireClient(run.Player, {
				WeaponId = weapon.Id,
				Origin = origin,
				Hits = hits,
			})
		end
		if state.Phase ~= "Playing" then
			return -- una muerte ha abierto la selección de mejoras
		end
	end
end

function CombatService.CleanupRun(_run: Run)
	-- El estado de las armas vive en RunState y se descarta con la partida.
end

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">EnemyService</string>
          <string name="Source"><![CDATA[--[[
	EnemyService
	Ciclo de vida de los enemigos: aparición, IA centralizada (persecución,
	rodeo de obstáculos, ataque por contacto), daño, muerte y limpieza.

	Un único tick de IA (GameConfig.Combat.EnemyAiInterval) recorre todos los
	enemigos de cada partida; no hay scripts ni bucles por enemigo. El
	movimiento es físico (LinearVelocity en el plano XZ), por lo que los
	enemigos chocan con paredes y rocas y no las atraviesan.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local EnemyConfig = require(Shared.Config.EnemyConfig)
local Net = require(Shared.Net)
local Types = require(Shared.Types)

local RunState = require(script.Parent.Parent.Logic.RunState)
local ModelFactory = require(script.Parent.Parent.World.ModelFactory)
local ServerTypes = require(script.Parent.Parent.ServerTypes)

type Run = ServerTypes.Run
type Enemy = ServerTypes.Enemy

type RunEnemies = {
	List: { Enemy },
	Frozen: boolean,
	NextAiAt: number,
}

export type Multipliers = { Health: number, Damage: number, Speed: number }

local EnemyService = {}

local services: ServerTypes.Services
local byRun: { [Run]: RunEnemies } = {}
local nextEnemyId = 0
local activeFolder: Folder
local templatesFolder: Folder
local EMPTY: { Enemy } = {}

local MAP_CENTER = GameConfig.Map.Center
local EDGE_RADIUS = GameConfig.Map.PlayableRadius + 4
local BOUNDS_RADIUS = GameConfig.Map.BoundsRadius
local KILL_Y = GameConfig.Map.KillY

function EnemyService.Init(allServices: ServerTypes.Services)
	services = allServices
	activeFolder = workspace:WaitForChild("ActiveEnemies") :: Folder
	templatesFolder = ServerStorage:WaitForChild("EnemyModels") :: Folder
end

function EnemyService.Start() end

-- Crea (una sola vez) las plantillas que falten en ServerStorage/EnemyModels.
function EnemyService.EnsureTemplates(folder: Folder)
	for _, def in EnemyConfig do
		if folder:FindFirstChild(def.ModelName) == nil then
			local builder = ModelFactory.Builders[def.ModelName]
			assert(builder, "No hay modelo ni constructor para " .. def.ModelName)
			builder(def).Parent = folder
		end
	end
end

function EnemyService.SetupRun(run: Run)
	byRun[run] = { List = {}, Frozen = false, NextAiAt = 0 }
end

function EnemyService.GetEnemies(run: Run): { Enemy }
	local data = byRun[run]
	return if data then data.List else EMPTY
end

function EnemyService.Count(run: Run): number
	local data = byRun[run]
	return if data then #data.List else 0
end

local function removeFromList(list: { Enemy }, enemy: Enemy)
	local index = table.find(list, enemy)
	if index then
		-- Intercambio con el último: O(1) y sin huecos.
		list[index] = list[#list]
		list[#list] = nil
	end
end

local function despawn(enemy: Enemy)
	enemy.Dead = true
	local data = byRun[enemy.Run]
	if data then
		removeFromList(data.List, enemy)
	end
	enemy.Model:Destroy()
end

local function isOutOfBounds(position: Vector3): boolean
	if position.Y < KILL_Y then
		return true
	end
	local dx, dz = position.X - MAP_CENTER.X, position.Z - MAP_CENTER.Z
	return dx * dx + dz * dz > BOUNDS_RADIUS * BOUNDS_RADIUS
end
EnemyService.IsOutOfBounds = isOutOfBounds

function EnemyService.Spawn(run: Run, enemyId: string, position: Vector3, multipliers: Multipliers): Enemy?
	local data = byRun[run]
	local def: Types.EnemyDef? = EnemyConfig[enemyId]
	if data == nil or def == nil or not run.Active then
		return nil
	end
	local template = templatesFolder:FindFirstChild(def.ModelName)
	if template == nil then
		warn("[EnemyService] Falta la plantilla", def.ModelName)
		return nil
	end

	local model = template:Clone() :: Model
	local root = model.PrimaryPart :: BasePart
	local mover = root:FindFirstChild("Mover") :: LinearVelocity
	local facing = root:FindFirstChild("Facing") :: AlignOrientation
	if not (root and mover and facing) then
		warn("[EnemyService] Plantilla incompleta", def.ModelName)
		model:Destroy()
		return nil
	end

	nextEnemyId += 1
	local maxHealth = def.MaxHealth * multipliers.Health
	model:PivotTo(CFrame.new(position))
	model:SetAttribute("EnemyId", def.Id)
	model:SetAttribute("Health", maxHealth)
	model:SetAttribute("MaxHealth", maxHealth)
	root.CollisionGroup = "Enemies"
	root.Anchored = data.Frozen
	model.Parent = activeFolder
	if not data.Frozen then
		-- El servidor es dueño de la física: el cliente no puede empujarlos.
		pcall(root.SetNetworkOwner, root, nil)
	end

	local now = run.State.Elapsed
	local enemy: Enemy = {
		Id = nextEnemyId,
		Def = def,
		Run = run,
		Model = model,
		Root = root,
		Mover = mover,
		Facing = facing,
		Health = maxHealth,
		MaxHealth = maxHealth,
		Damage = def.ContactDamage * multipliers.Damage,
		Speed = def.MoveSpeed * multipliers.Speed,
		Dead = false,
		Position = position,
		-- Pequeño margen para que un enemigo recién aparecido no golpee al instante.
		NextAttackAt = now + 0.5,
		LastProgressPosition = position,
		LastProgressAt = now,
		SidestepUntil = 0,
		SidestepSign = 1,
	}
	table.insert(data.List, enemy)
	return enemy
end

local function kill(enemy: Enemy)
	-- `Dead` se marca antes que nada: una muerte solo genera una recompensa.
	enemy.Dead = true
	local run = enemy.Run
	local position = enemy.Root.Position
	local data = byRun[run]
	if data then
		removeFromList(data.List, enemy)
	end
	enemy.Model:Destroy()

	RunState.addKill(run.State)
	Net.EnemyDied:FireClient(run.Player, { Position = position, Color = enemy.Def.Color })
	services.ExperienceService.SpawnGem(run, position, enemy.Def.XpReward)
	services.MatchService.MarkHudDirty(run)
end

-- Aplica daño calculado por el servidor. Devuelve (murió, daño aplicado).
function EnemyService.Damage(enemy: Enemy, amount: number): (boolean, number)
	if enemy.Dead or enemy.Model.Parent == nil or not enemy.Run.Active then
		return false, 0
	end
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return false, 0
	end
	local dealt = math.min(amount, enemy.Health)
	enemy.Health -= dealt
	enemy.Model:SetAttribute("Health", enemy.Health)
	if enemy.Health <= 0 then
		kill(enemy)
		return true, dealt
	end
	return false, dealt
end

function EnemyService.SetFrozen(run: Run, frozen: boolean)
	local data = byRun[run]
	if data == nil or data.Frozen == frozen then
		return
	end
	data.Frozen = frozen
	for _, enemy in data.List do
		enemy.Mover.PlaneVelocity = Vector2.zero
		enemy.Root.Anchored = frozen
		if not frozen then
			pcall(enemy.Root.SetNetworkOwner, enemy.Root, nil)
		end
	end
end

-- Dirección horizontal hacia el jugador con rodeo de obstáculos y sin salir de la isla.
local function steer(enemy: Enemy, toTarget: Vector3, now: number): Vector3
	local direction = toTarget.Unit
	if now < enemy.SidestepUntil then
		local perpendicular = Vector3.new(-direction.Z, 0, direction.X) * enemy.SidestepSign
		direction = (direction * 0.35 + perpendicular).Unit
	end
	-- No avanzar hacia el vacío: elimina la componente radial hacia fuera cerca del borde.
	local position = enemy.Position
	local radial = Vector3.new(position.X - MAP_CENTER.X, 0, position.Z - MAP_CENTER.Z)
	if radial.Magnitude > EDGE_RADIUS - 3 then
		local outward = radial.Unit
		local outwardSpeed = direction:Dot(outward)
		if outwardSpeed > 0 then
			direction -= outward * outwardSpeed
		end
	end
	return direction
end

function EnemyService.Step(run: Run)
	local data = byRun[run]
	if data == nil or data.Frozen or run.State.Phase ~= "Playing" then
		return
	end
	local now = run.State.Elapsed
	if now < data.NextAiAt then
		return
	end
	data.NextAiAt = now + GameConfig.Combat.EnemyAiInterval

	local playerAlive = run.Root.Parent ~= nil and run.Humanoid.Health > 0
	local playerPosition = run.Root.Position
	local combat = GameConfig.Combat
	local list = data.List

	for index = #list, 1, -1 do
		local enemy = list[index]
		if enemy == nil or enemy.Dead then
			continue
		end
		if enemy.Model.Parent == nil then
			despawn(enemy)
			continue
		end
		local position = enemy.Root.Position
		enemy.Position = position
		if isOutOfBounds(position) then
			-- Se cayó o salió del mapa: se elimina sin recompensa.
			despawn(enemy)
			continue
		end
		if not playerAlive then
			enemy.Mover.PlaneVelocity = Vector2.zero
			continue
		end

		local offset = playerPosition - position
		local flat = Vector3.new(offset.X, 0, offset.Z)
		local distance = flat.Magnitude

		-- Ataque por contacto con enfriamiento propio de cada enemigo.
		if distance <= enemy.Def.AttackRange and math.abs(offset.Y) < 6 and now >= enemy.NextAttackAt then
			enemy.NextAttackAt = now + enemy.Def.AttackCooldown
			services.MatchService.DamagePlayer(run, enemy.Damage)
			if run.State.Phase ~= "Playing" then
				return -- el golpe ha terminado la partida
			end
		end

		-- Detección de atasco: si apenas avanza, rodea el obstáculo un momento.
		if
			(position - enemy.LastProgressPosition).Magnitude > combat.StuckDistance
			or distance <= enemy.Def.AttackRange
		then
			enemy.LastProgressPosition = position
			enemy.LastProgressAt = now
		elseif now - enemy.LastProgressAt > combat.StuckWindow then
			enemy.SidestepUntil = now + combat.SidestepDuration
			enemy.SidestepSign = if run.Rng:NextNumber() < 0.5 then -1 else 1
			enemy.LastProgressAt = now
			enemy.LastProgressPosition = position
		end

		if distance > enemy.Def.AttackRange * 0.5 then
			local direction = steer(enemy, flat, now)
			local velocity = direction * enemy.Speed
			enemy.Mover.PlaneVelocity = Vector2.new(velocity.X, velocity.Z)
			enemy.Facing.CFrame = CFrame.lookAt(Vector3.zero, flat.Unit)
		else
			enemy.Mover.PlaneVelocity = Vector2.zero
		end
	end
end

function EnemyService.CleanupRun(run: Run)
	local data = byRun[run]
	if data == nil then
		return
	end
	byRun[run] = nil
	for _, enemy in data.List do
		enemy.Dead = true
		enemy.Model:Destroy()
	end
	table.clear(data.List)
end

return EnemyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">ExperienceService</string>
          <string name="Source"><![CDATA[--[[
	ExperienceService
	Gemas de experiencia: creación al morir un enemigo, comprobación de
	proximidad centralizada (una sola pasada por partida a frecuencia
	reducida, sin bucles ni Touched por gema), recogida única, caducidad
	y límite de gemas simultáneas.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Net = require(Shared.Net)

local StatSheet = require(script.Parent.Parent.Logic.StatSheet)
local ServerTypes = require(script.Parent.Parent.ServerTypes)

type Run = ServerTypes.Run
type Gem = ServerTypes.Gem

type RunGems = {
	Gems: { Gem },
	NextCheckAt: number,
}

local ExperienceService = {}

local services: ServerTypes.Services
local byRun: { [Run]: RunGems } = {}
local orbsFolder: Folder
local groundParams: RaycastParams

local CFG = GameConfig.Experience
local MAP = GameConfig.Map
local NORMAL_COLOR = Color3.fromRGB(80, 240, 255)
local LUCKY_COLOR = Color3.fromRGB(255, 214, 90)

function ExperienceService.Init(allServices: ServerTypes.Services)
	services = allServices
	orbsFolder = workspace:WaitForChild("ExperienceOrbs") :: Folder
	groundParams = RaycastParams.new()
	groundParams.FilterType = Enum.RaycastFilterType.Include
	groundParams.FilterDescendantsInstances = { workspace:WaitForChild("Map"):WaitForChild("Ground") }
end

function ExperienceService.Start() end

function ExperienceService.SetupRun(run: Run)
	byRun[run] = { Gems = {}, NextCheckAt = 0 }
end

-- Posición alcanzable: sobre el suelo y dentro de la isla.
local function groundedPosition(position: Vector3): Vector3
	local flat = Vector3.new(position.X - MAP.Center.X, 0, position.Z - MAP.Center.Z)
	local limit = MAP.PlayableRadius - 2
	if flat.Magnitude > limit then
		flat = flat.Unit * limit
		position = Vector3.new(MAP.Center.X + flat.X, position.Y, MAP.Center.Z + flat.Z)
	end
	local result = workspace:Raycast(position + Vector3.new(0, 6, 0), Vector3.new(0, -40, 0), groundParams)
	if result then
		return result.Position + Vector3.new(0, 1.4, 0)
	end
	return Vector3.new(position.X, MAP.SurfaceY + 1.4, position.Z)
end

local function destroyGem(gem: Gem)
	gem.Collected = true
	gem.Part:Destroy()
end

function ExperienceService.SpawnGem(run: Run, position: Vector3, baseXp: number)
	local data = byRun[run]
	if data == nil or run.State.Phase == "GameOver" then
		return
	end
	local lucky = run.Rng:NextNumber() < StatSheet.luckyGemChance(run.State.Stats)
	local value = baseXp * (if lucky then CFG.LuckyGemMultiplier else 1)

	-- Límite de gemas: la más antigua se funde en la nueva (no se pierde XP).
	if #data.Gems >= CFG.MaxGemsPerRun then
		local oldest = table.remove(data.Gems, 1)
		if oldest then
			value += oldest.Value
			destroyGem(oldest)
		end
	end

	local gemPosition = groundedPosition(position)
	local part = Instance.new("Part")
	part.Name = if lucky then "XpGemLucky" else "XpGem"
	part.Size = if lucky then Vector3.new(1.2, 1.7, 1.2) else Vector3.new(0.8, 1.2, 0.8)
	part.CFrame = CFrame.new(gemPosition) * CFrame.Angles(0, math.rad(45), math.rad(45))
	part.Color = if lucky then LUCKY_COLOR else NORMAL_COLOR
	part.Material = Enum.Material.Neon
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part:SetAttribute("Value", value)
	part.Parent = orbsFolder

	table.insert(data.Gems, {
		Part = part,
		Position = gemPosition,
		Value = value,
		ExpiresAt = run.State.Elapsed + CFG.GemLifetime,
		Collected = false,
	})
end

function ExperienceService.Step(run: Run)
	local data = byRun[run]
	local state = run.State
	if data == nil or state.Phase ~= "Playing" then
		return
	end
	local now = state.Elapsed
	if now < data.NextCheckAt then
		return
	end
	data.NextCheckAt = now + CFG.PickupCheckInterval
	if run.Root.Parent == nil or run.Humanoid.Health <= 0 then
		return
	end

	local playerPosition = run.Root.Position
	local radius = GameConfig.Player.PickupRadius
	local radiusSq = radius * radius
	local gems = data.Gems
	local collectedValue = 0
	local collectedPositions: { Vector3 } = {}

	for index = #gems, 1, -1 do
		local gem = gems[index]
		if gem.Collected or gem.Part.Parent == nil then
			table.remove(gems, index)
		elseif now >= gem.ExpiresAt then
			destroyGem(gem)
			table.remove(gems, index)
		else
			local offset = gem.Position - playerPosition
			if offset.X * offset.X + offset.Y * offset.Y + offset.Z * offset.Z <= radiusSq then
				-- Se marca y elimina antes de conceder: una gema = una concesión.
				destroyGem(gem)
				table.remove(gems, index)
				collectedValue += gem.Value
				table.insert(collectedPositions, gem.Position)
			end
		end
	end

	if collectedValue > 0 then
		Net.GemCollected:FireClient(run.Player, { Positions = collectedPositions, Value = collectedValue })
		services.LevelService.GrantExperience(run, collectedValue)
	end
end

function ExperienceService.CleanupRun(run: Run)
	local data = byRun[run]
	if data == nil then
		return
	end
	byRun[run] = nil
	for _, gem in data.Gems do
		destroyGem(gem)
	end
	table.clear(data.Gems)
end

return ExperienceService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">LevelService</string>
          <string name="Source"><![CDATA[--[[
	LevelService
	Punto único para conceder experiencia. Aplica el bonus de XP, procesa
	subidas de nivel múltiples y pide a UpgradeService que abra la oferta.
	El cliente nunca indica cuánta experiencia ha obtenido.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage.Shared.Net)
local RunState = require(script.Parent.Parent.Logic.RunState)
local ServerTypes = require(script.Parent.Parent.ServerTypes)

type Run = ServerTypes.Run

local LevelService = {}

local services: ServerTypes.Services

function LevelService.Init(allServices: ServerTypes.Services)
	services = allServices
end

function LevelService.Start() end

-- `baseAmount` lo calcula siempre el servidor (valor de las gemas recogidas).
function LevelService.GrantExperience(run: Run, baseAmount: number)
	if not run.Active then
		return
	end
	local gained = RunState.grantXp(run.State, baseAmount)
	services.MatchService.MarkHudDirty(run)
	if gained > 0 then
		Net.LevelUp:FireClient(run.Player, {
			Level = run.State.Progress.Level,
			Gained = gained,
		})
		services.UpgradeService.TryOpenOffer(run)
	end
end

return LevelService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">MatchService</string>
          <string name="Source"><![CDATA[--[[
	MatchService  (el "RunService" del diseño; renombrado para no confundirlo
	con game:GetService("RunService") de Roblox)

	Responsabilidades:
	  • Crear, pausar, terminar y reiniciar partidas (una por jugador).
	  • Bucle centralizado del servidor: un único Heartbeat que avanza todas
	    las partidas y llama a Combat/Enemy/Spawn/Experience.
	  • Vida del jugador: daño recibido, caída al vacío y derrota.
	  • Envío del HUD al cliente (agrupado y limitado en frecuencia).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Progression = require(Shared.Progression)
local Net = require(Shared.Net)
local Types = require(Shared.Types)

local Logic = script.Parent.Parent.Logic
local RunState = require(Logic.RunState)
local StatSheet = require(Logic.StatSheet)
local RateLimiter = require(Logic.RateLimiter)
local ServerTypes = require(script.Parent.Parent.ServerTypes)

type Run = ServerTypes.Run

local MatchService = {}

local services: ServerTypes.Services
local runs: { [Player]: Run } = {}
local starting: { [Player]: boolean } = {}
local readyLimiter = RateLimiter.new(GameConfig.RateLimits.ClientReady.Max, GameConfig.RateLimits.ClientReady.Window)
local restartLimiter = RateLimiter.new(GameConfig.RateLimits.RequestRestart.Max, GameConfig.RateLimits.RequestRestart.Window)

local function disconnectAll(connections: { RBXScriptConnection })
	for _, connection in connections do
		connection:Disconnect()
	end
	table.clear(connections)
end

local function setCharacterCollisionGroup(character: Model)
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = "Players"
		end
	end
end

function MatchService.Init(allServices: ServerTypes.Services)
	services = allServices
end

function MatchService.GetRun(player: Player): Run?
	return runs[player]
end

function MatchService.MarkHudDirty(run: Run)
	run.HudDirty = true
end

function MatchService.BuildHudSnapshot(run: Run): Types.HudSnapshot
	local state = run.State
	local humanoid = run.Humanoid
	local primary = state.Weapons[1]
	return {
		Phase = state.Phase,
		Level = state.Progress.Level,
		Xp = state.Progress.Xp,
		XpToNext = Progression.xpToNext(state.Progress.Level),
		Health = humanoid.Health,
		MaxHealth = humanoid.MaxHealth,
		Kills = state.Kills,
		Elapsed = state.Elapsed,
		Stats = StatSheet.summary(state.Stats, primary and primary.Def),
	}
end

local function sendHud(run: Run)
	run.HudDirty = false
	run.LastHudSentAt = os.clock()
	Net.HudUpdate:FireClient(run.Player, MatchService.BuildHudSnapshot(run))
end

--[[
	Aplica al personaje las estadísticas derivadas (vida máxima y velocidad).
	Si la vida máxima sube, cura la diferencia; `healPct` cura además un
	porcentaje de la vida máxima (mejora Bendición del Cielo).
]]
function MatchService.ApplyStats(run: Run, healPct: number?)
	local humanoid = run.Humanoid
	if humanoid.Health <= 0 then
		return
	end
	local stats = run.State.Stats
	local newMax = StatSheet.maxHealth(stats)
	local oldMax = humanoid.MaxHealth
	local health = humanoid.Health
	humanoid.MaxHealth = newMax
	if newMax > oldMax then
		health += newMax - oldMax
	end
	if healPct and healPct > 0 then
		health += newMax * healPct
	end
	humanoid.Health = math.clamp(health, 1, newMax)
	humanoid.WalkSpeed = StatSheet.walkSpeed(stats)
	run.HudDirty = true
end

-- Pausa lógica real: congela al jugador, a los enemigos, la aparición y el reloj.
function MatchService.SetPaused(run: Run, paused: boolean)
	if run.Paused == paused then
		return
	end
	run.Paused = paused
	if run.Root.Parent and run.Humanoid.Health > 0 then
		run.Root.Anchored = paused
	end
	services.EnemyService.SetFrozen(run, paused)
end

--[[
	Daño al jugador. Solo el servidor lo llama (contacto de enemigos o caídas);
	aplica la reducción de Piel de Piedra salvo que `ignoreReduction` sea true.
]]
function MatchService.DamagePlayer(run: Run, rawDamage: number, ignoreReduction: boolean?): boolean
	if not run.Active or run.State.Phase ~= "Playing" then
		return false
	end
	local humanoid = run.Humanoid
	if humanoid.Health <= 0 then
		return false
	end
	if not ignoreReduction and run.State.Elapsed < run.InvulnerableUntil then
		return false
	end
	local amount = if ignoreReduction then rawDamage else StatSheet.damageTaken(run.State.Stats, rawDamage)
	if amount <= 0 then
		return false
	end
	humanoid.Health = math.max(0, humanoid.Health - amount)
	Net.PlayerDamaged:FireClient(run.Player, {
		Amount = amount,
		Health = humanoid.Health,
		MaxHealth = humanoid.MaxHealth,
	})
	run.HudDirty = true
	return true
end

local function cleanupRun(run: Run)
	if not run.Active then
		return
	end
	run.Active = false
	disconnectAll(run.Connections)
	services.CombatService.CleanupRun(run)
	services.SpawnService.CleanupRun(run)
	services.EnemyService.CleanupRun(run)
	services.ExperienceService.CleanupRun(run)
end

-- Termina la partida (derrota). Idempotente: una muerte solo se procesa una vez.
function MatchService.EndRun(run: Run, reason: string)
	if not RunState.setGameOver(run.State) then
		return
	end
	run.EndedAt = os.clock()
	if run.Paused then
		run.Paused = false
		if run.Root.Parent then
			run.Root.Anchored = false
		end
	end
	-- Los enemigos quedan congelados detrás de la pantalla de derrota.
	services.EnemyService.SetFrozen(run, true)
	sendHud(run)
	Net.GameOver:FireClient(run.Player, {
		Elapsed = run.State.Elapsed,
		Kills = run.State.Kills,
		Level = run.State.Progress.Level,
		Reason = reason,
	})
	task.delay(GameConfig.Match.CleanupDelay, function()
		if runs[run.Player] == run then
			cleanupRun(run)
		end
	end)
end

function MatchService.StartRun(player: Player)
	if starting[player] or player.Parent ~= Players then
		return
	end
	starting[player] = true

	local previous = runs[player]
	if previous then
		cleanupRun(previous)
		runs[player] = nil
	end

	local ok, err = pcall(function()
		player:LoadCharacter()
	end)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not ok or not character or not humanoid or not root or player.Parent ~= Players then
		warn("[MatchService] No se pudo cargar el personaje de", player.Name, err)
		starting[player] = nil
		return
	end

	local run: Run = {
		Player = player,
		State = RunState.new(GameConfig.Player.StartingWeapons),
		Active = true,
		Character = character,
		Humanoid = humanoid,
		Root = root :: BasePart,
		Connections = {},
		Rng = Random.new(),
		Paused = false,
		InvulnerableUntil = 0,
		HudDirty = true,
		LastHudSentAt = 0,
		NextFallCheckAt = 0,
		EndedAt = nil,
	}

	humanoid.MaxHealth = StatSheet.maxHealth(run.State.Stats)
	humanoid.Health = humanoid.MaxHealth
	humanoid.WalkSpeed = StatSheet.walkSpeed(run.State.Stats)
	setCharacterCollisionGroup(character)

	table.insert(run.Connections, humanoid.Died:Connect(function()
		MatchService.EndRun(run, "Died")
	end))
	table.insert(run.Connections, character.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = "Players"
		end
	end))
	table.insert(run.Connections, character.AncestryChanged:Connect(function(_, parent)
		-- El personaje ha desaparecido (p. ej. destruido por el motor): derrota.
		if parent == nil and run.State.Phase ~= "GameOver" then
			MatchService.EndRun(run, "CharacterRemoved")
		end
	end))

	runs[player] = run
	services.SpawnService.SetupRun(run)
	services.EnemyService.SetupRun(run)
	services.ExperienceService.SetupRun(run)
	services.CombatService.SetupRun(run)
	starting[player] = nil
	sendHud(run)
end

-- Caída fuera del mapa: reaparición controlada con penalización de vida.
local function checkFall(run: Run)
	if run.State.Elapsed < run.NextFallCheckAt then
		return
	end
	run.NextFallCheckAt = run.State.Elapsed + GameConfig.Match.FallCheckInterval
	local root = run.Root
	if root.Parent == nil or run.Humanoid.Health <= 0 then
		return
	end
	if root.Position.Y >= GameConfig.Map.KillY then
		return
	end
	local spawnPosition = GameConfig.Map.PlayerSpawn + Vector3.new(0, 3, 0)
	run.Character:PivotTo(CFrame.new(spawnPosition))
	root.AssemblyLinearVelocity = Vector3.zero
	MatchService.DamagePlayer(run, run.Humanoid.MaxHealth * GameConfig.Player.FallDamagePct, true)
	run.InvulnerableUntil = run.State.Elapsed + GameConfig.Player.FallInvulnerability
end

local function step(dt: number)
	local now = os.clock()
	for _, run in runs do
		if not run.Active then
			continue
		end
		local state = run.State
		if state.Phase == "Playing" then
			RunState.advance(state, dt)
			services.CombatService.Step(run)
			services.SpawnService.Step(run)
			services.EnemyService.Step(run)
			services.ExperienceService.Step(run)
			if state.Phase == "Playing" then
				checkFall(run)
			end
			-- El tiempo cambia en cada frame; el HUD lo extrapola en el cliente.
		end
		if run.Active and run.HudDirty and now - run.LastHudSentAt >= GameConfig.Match.HudSendInterval then
			sendHud(run)
		end
	end
end

local function onPlayerAdded(player: Player)
	-- Si el cliente no avisa a tiempo, la partida empieza igualmente.
	task.delay(GameConfig.Match.ClientReadyTimeout, function()
		if player.Parent == Players and runs[player] == nil then
			MatchService.StartRun(player)
		end
	end)
end

local function onPlayerRemoving(player: Player)
	local run = runs[player]
	if run then
		cleanupRun(run)
		runs[player] = nil
	end
	starting[player] = nil
	readyLimiter:Forget(player)
	restartLimiter:Forget(player)
	services.UpgradeService.ForgetPlayer(player)
end

function MatchService.Start()
	Players.CharacterAutoLoads = false

	Net.ClientReady.OnServerEvent:Connect(function(player: Player)
		if not readyLimiter:Allow(player) then
			return
		end
		local run = runs[player]
		if run == nil then
			MatchService.StartRun(player)
		elseif run.Active then
			-- Resincroniza la interfaz (p. ej. si el cliente se recargó).
			sendHud(run)
			services.UpgradeService.ResendOffer(run)
		end
	end)

	Net.RequestRestart.OnServerEvent:Connect(function(player: Player)
		if not restartLimiter:Allow(player) then
			return
		end
		local run = runs[player]
		if run ~= nil then
			if run.State.Phase ~= "GameOver" then
				return -- no se puede reiniciar una partida en curso
			end
			if os.clock() - (run.EndedAt or 0) < GameConfig.Match.RestartCooldown then
				return
			end
		end
		MatchService.StartRun(player)
	end)

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end

	RunService.Heartbeat:Connect(step)
end

return MatchService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">SpawnService</string>
          <string name="Source"><![CDATA[--[[
	SpawnService
	Aparición controlada de enemigos alrededor del jugador:
	  • a una distancia entre MinRadius y MaxRadius (nunca encima del jugador),
	  • solo sobre suelo de la isla (raycast contra Map/Ground) y lejos del borde,
	  • respetando el límite de enemigos activos,
	  • con intervalo, tamaño de oleada y estadísticas que escalan con el tiempo,
	  • con un periodo de gracia al empezar y detenida fuera de Playing.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local ServerTypes = require(script.Parent.Parent.ServerTypes)

type Run = ServerTypes.Run

local SpawnService = {}

local services: ServerTypes.Services
local nextSpawnAt: { [Run]: number } = {}
local groundFolder: Instance
local raycastParams: RaycastParams

local TAU = math.pi * 2
local CFG = GameConfig.Spawn
local MAP = GameConfig.Map

function SpawnService.Init(allServices: ServerTypes.Services)
	services = allServices
	local map = workspace:WaitForChild("Map")
	groundFolder = map:WaitForChild("Ground")
	raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Include
	raycastParams.FilterDescendantsInstances = { groundFolder, map:WaitForChild("Props") }
	raycastParams.IgnoreWater = true
end

function SpawnService.Start() end

function SpawnService.SetupRun(run: Run)
	nextSpawnAt[run] = CFG.GracePeriod
end

function SpawnService.CleanupRun(run: Run)
	nextSpawnAt[run] = nil
end

-- Multiplicadores de dificultad según los minutos de partida.
function SpawnService.DifficultyAt(elapsed: number)
	local minutes = elapsed / 60
	local difficulty = GameConfig.Difficulty
	return {
		Health = 1 + difficulty.HealthPerMinute * minutes,
		Damage = 1 + difficulty.DamagePerMinute * minutes,
		Speed = math.min(difficulty.MaxSpeedMultiplier, 1 + difficulty.SpeedPerMinute * minutes),
	}
end

function SpawnService.IntervalAt(elapsed: number): number
	local minutes = elapsed / 60
	return math.max(CFG.MinInterval, CFG.InitialInterval * CFG.IntervalMultiplierPerMinute ^ minutes)
end

function SpawnService.BatchAt(elapsed: number): number
	local minutes = elapsed / 60
	return math.clamp(math.floor(CFG.InitialBatch + CFG.BatchGrowthPerMinute * minutes), 1, CFG.MaxBatch)
end

-- Busca una posición válida; devuelve nil si ningún intento es válido.
function SpawnService.FindSpawnPosition(run: Run): Vector3?
	local origin = run.Root.Position
	local maxRadius = MAP.PlayableRadius - CFG.EdgeMargin
	for _ = 1, CFG.Attempts do
		local angle = run.Rng:NextNumber() * TAU
		local distance = run.Rng:NextNumber(CFG.MinRadius, CFG.MaxRadius)
		local candidate = origin + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
		local dx, dz = candidate.X - MAP.Center.X, candidate.Z - MAP.Center.Z
		if dx * dx + dz * dz > maxRadius * maxRadius then
			continue
		end
		local rayOrigin = Vector3.new(candidate.X, MAP.SurfaceY + 60, candidate.Z)
		local result = workspace:Raycast(rayOrigin, Vector3.new(0, -120, 0), raycastParams)
		-- Debe caer sobre suelo (no sobre ruinas, árboles o rocas).
		if result and result.Instance:IsDescendantOf(groundFolder) then
			local position = result.Position + Vector3.new(0, 1.6, 0)
			local fromPlayer = Vector3.new(position.X - origin.X, 0, position.Z - origin.Z)
			if fromPlayer.Magnitude >= CFG.MinRadius * 0.9 then
				return position
			end
		end
	end
	return nil
end

function SpawnService.Step(run: Run)
	local state = run.State
	local scheduled = nextSpawnAt[run]
	if scheduled == nil or state.Phase ~= "Playing" or run.Humanoid.Health <= 0 then
		return
	end
	local now = state.Elapsed
	if now < scheduled then
		return
	end
	nextSpawnAt[run] = now + SpawnService.IntervalAt(now)

	local enemyService = services.EnemyService
	local multipliers = SpawnService.DifficultyAt(now)
	for _ = 1, SpawnService.BatchAt(now) do
		if enemyService.Count(run) >= CFG.MaxActiveEnemies then
			break
		end
		local position = SpawnService.FindSpawnPosition(run)
		if position == nil then
			break
		end
		local enemyType = CFG.EnemyTypes[run.Rng:NextInteger(1, #CFG.EnemyTypes)]
		enemyService.Spawn(run, enemyType, position, multipliers)
	end
end

return SpawnService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">UpgradeService</string>
          <string name="Source"><![CDATA[--[[
	UpgradeService
	Abre las ofertas de mejoras (una por nivel pendiente, sin superponerse),
	valida las elecciones del cliente y aplica sus efectos.

	Protocolo:
	  1. Servidor -> UpgradeOffer { Token, Level, Options = { {Id, CurrentLevel, NextLevel} } }
	  2. Cliente  -> ChooseUpgrade(Token, Id)      (solo identificadores)
	  3. Servidor valida tipo, frecuencia, estado de la partida, token y opción.
	  4. Servidor aplica la mejora, cierra la oferta y responde UpgradeResolved.
	  5. Si quedan niveles pendientes se abre la siguiente oferta; si no, se
	     reanuda la partida.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Net = require(Shared.Net)

local Logic = script.Parent.Parent.Logic
local RunState = require(Logic.RunState)
local RateLimiter = require(Logic.RateLimiter)
local Validation = require(Logic.Validation)
local ServerTypes = require(script.Parent.Parent.ServerTypes)

type Run = ServerTypes.Run

local UpgradeService = {}

local services: ServerTypes.Services
local chooseLimiter = RateLimiter.new(GameConfig.RateLimits.ChooseUpgrade.Max, GameConfig.RateLimits.ChooseUpgrade.Window)

function UpgradeService.Init(allServices: ServerTypes.Services)
	services = allServices
end

-- Abre la siguiente oferta si procede. Devuelve true si hay una oferta abierta.
function UpgradeService.TryOpenOffer(run: Run): boolean
	if not run.Active then
		return false
	end
	local offer = RunState.tryOpenOffer(run.State, run.Rng)
	if offer == nil then
		return run.State.ActiveOffer ~= nil
	end
	services.MatchService.SetPaused(run, true)
	Net.UpgradeOffer:FireClient(run.Player, RunState.offerPayload(run.State, offer))
	services.MatchService.MarkHudDirty(run)
	return true
end

-- Reenvía la oferta activa (si el cliente recargó su interfaz).
function UpgradeService.ResendOffer(run: Run)
	local offer = run.State.ActiveOffer
	if offer and not offer.Consumed then
		Net.UpgradeOffer:FireClient(run.Player, RunState.offerPayload(run.State, offer))
	end
end

function UpgradeService.ForgetPlayer(player: Player)
	chooseLimiter:Forget(player)
end

local function onChooseUpgrade(player: Player, token: any, upgradeId: any)
	if not chooseLimiter:Allow(player) then
		return
	end
	-- Tipos inválidos: petición manipulada, se ignora sin respuesta.
	if not Validation.isPositiveInteger(token) or not Validation.isIdentifier(upgradeId, 40) then
		warn(string.format("[UpgradeService] Elección malformada de %s rechazada", player.Name))
		return
	end
	local run = services.MatchService.GetRun(player)
	if run == nil or not run.Active then
		return
	end

	local ok, result = RunState.choose(run.State, token, upgradeId)
	if not ok then
		Net.UpgradeResolved:FireClient(player, { Token = token, Accepted = false, Reason = result })
		return
	end

	services.MatchService.ApplyStats(run, result.HealPct)
	Net.UpgradeResolved:FireClient(player, {
		Token = token,
		Accepted = true,
		UpgradeId = upgradeId,
		NewLevel = run.State.UpgradeLevels[upgradeId],
	})

	-- Encadena la siguiente oferta si se ganaron varios niveles a la vez.
	if not UpgradeService.TryOpenOffer(run) then
		services.MatchService.SetPaused(run, false)
	end
	services.MatchService.MarkHudDirty(run)
end

function UpgradeService.Start()
	Net.ChooseUpgrade.OnServerEvent:Connect(onChooseUpgrade)
end

return UpgradeService
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="45">
      <Properties>
        <string name="Name">Tests</string>
      </Properties>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">Progression.spec</string>
          <string name="Source"><![CDATA[-- Prueba D (curva y niveles): experiencia sobrante, varios niveles, sin duplicados.
local Shared = game:GetService("ReplicatedStorage").Shared
local Progression = require(Shared.Progression)
local LevelLogic = require(script.Parent.Parent.Logic.LevelLogic)

return function(it, expect)
	it("la curva inicial es 5, 8, 12 y sigue creciendo", function()
		expect.equal(Progression.xpToNext(1), 5)
		expect.equal(Progression.xpToNext(2), 8)
		expect.equal(Progression.xpToNext(3), 12)
		local previous = Progression.xpToNext(3)
		for level = 4, 60 do
			local required = Progression.xpToNext(level)
			expect.truthy(required > previous, "la curva debe crecer en el nivel " .. level)
			previous = required
		end
	end)

	it("sube de nivel al alcanzar el umbral y conserva la experiencia sobrante", function()
		local progress = LevelLogic.new()
		expect.equal(LevelLogic.addXp(progress, 4), 0)
		expect.equal(progress.Level, 1)
		expect.equal(LevelLogic.addXp(progress, 3), 1) -- 7 XP: 5 para subir, sobran 2
		expect.equal(progress.Level, 2)
		expect.equal(progress.Xp, 2)
		expect.equal(#progress.PendingLevels, 1)
		expect.equal(progress.PendingLevels[1], 2)
	end)

	it("procesa varios niveles con una sola concesión grande", function()
		local progress = LevelLogic.new()
		-- 5 + 8 + 12 = 25 -> nivel 4 con 1 de sobra
		expect.equal(LevelLogic.addXp(progress, 26), 3)
		expect.equal(progress.Level, 4)
		expect.equal(progress.Xp, 1)
		expect.equal(#progress.PendingLevels, 3)
		expect.equal(LevelLogic.popPendingLevel(progress), 2)
		expect.equal(LevelLogic.popPendingLevel(progress), 3)
		expect.equal(LevelLogic.popPendingLevel(progress), 4)
		expect.equal(LevelLogic.popPendingLevel(progress), nil)
	end)

	it("rechaza cantidades inválidas (negativas, NaN, infinito)", function()
		local progress = LevelLogic.new()
		expect.equal(LevelLogic.addXp(progress, -10), 0)
		expect.equal(LevelLogic.addXp(progress, 0 / 0), 0)
		expect.equal(LevelLogic.addXp(progress, 0), 0)
		expect.equal(progress.Xp, 0)
		-- math.huge se acota a MaxXpPerGrant en lugar de bloquear el servidor.
		LevelLogic.addXp(progress, math.huge)
		expect.truthy(progress.Level > 1 and progress.Level < 1000, "nivel acotado")
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">TestRunner</string>
          <string name="Source"><![CDATA[--[[
	TestRunner
	Microframework de pruebas que funciona igual en Roblox Studio (al iniciar el
	servidor, ver Bootstrap) y fuera de Roblox con Lune (tests/run.luau).

	Cada módulo *.spec devuelve function(it, expect).
]]

local TestRunner = {}

local function format(value: any): string
	if type(value) == "string" then
		return string.format("%q", value)
	end
	return tostring(value)
end

local expect = {}

function expect.equal(actual: any, expected: any, message: string?)
	if actual ~= expected then
		error(string.format("%sse esperaba %s, se obtuvo %s", message and (message .. ": ") or "", format(expected), format(actual)), 2)
	end
end

function expect.near(actual: number, expected: number, epsilon: number?, message: string?)
	if type(actual) ~= "number" or math.abs(actual - expected) > (epsilon or 1e-6) then
		error(string.format("%sse esperaba ≈%s, se obtuvo %s", message and (message .. ": ") or "", format(expected), format(actual)), 2)
	end
end

function expect.truthy(value: any, message: string?)
	if not value then
		error((message or "se esperaba un valor verdadero") .. ", se obtuvo " .. format(value), 2)
	end
end

function expect.falsy(value: any, message: string?)
	if value then
		error((message or "se esperaba un valor falso") .. ", se obtuvo " .. format(value), 2)
	end
end

TestRunner.expect = expect

export type Report = { Passed: number, Failed: number, Failures: { string } }

function TestRunner.runSpec(name: string, spec: (any, any) -> (), report: Report)
	local cases: { { name: string, fn: () -> () } } = {}
	spec(function(caseName: string, fn: () -> ())
		table.insert(cases, { name = caseName, fn = fn })
	end, expect)
	for _, case in cases do
		local ok, err = pcall(case.fn)
		if ok then
			report.Passed += 1
			print(string.format("  ✔ %s › %s", name, case.name))
		else
			report.Failed += 1
			local line = string.format("  ✘ %s › %s\n      %s", name, case.name, tostring(err))
			table.insert(report.Failures, line)
			print(line)
		end
	end
end

-- `folder` es una instancia (o un nodo simulado en Lune) con hijos *.spec.
function TestRunner.runFolder(folder: any): Report
	local report: Report = { Passed = 0, Failed = 0, Failures = {} }
	local children = folder:GetChildren()
	table.sort(children, function(a, b)
		return a.Name < b.Name
	end)
	for _, child in children do
		if string.sub(child.Name, -5) == ".spec" then
			local ok, spec = pcall(require, child)
			if ok and type(spec) == "function" then
				TestRunner.runSpec(string.sub(child.Name, 1, -6), spec, report)
			else
				report.Failed += 1
				local line = "  ✘ " .. child.Name .. " no se pudo cargar: " .. tostring(spec)
				table.insert(report.Failures, line)
				print(line)
			end
		end
	end
	print(string.format("[SkyBonk Tests] %d correctas, %d fallidas", report.Passed, report.Failed))
	return report
end

return TestRunner
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">Upgrades.spec</string>
          <string name="Source"><![CDATA[-- Pruebas D, E y G (ofertas, aplicación de mejoras y validación de elecciones).
local Shared = game:GetService("ReplicatedStorage").Shared
local UpgradeConfig = require(Shared.Config.UpgradeConfig)
local WeaponConfig = require(Shared.Config.WeaponConfig)
local Logic = script.Parent.Parent.Logic
local RunState = require(Logic.RunState)
local StatSheet = require(Logic.StatSheet)
local UpgradeLogic = require(Logic.UpgradeLogic)

-- Generador determinista (LCG) con la interfaz de Random:NextNumber().
local function makeRng(seed: number)
	local state = seed
	return {
		NextNumber = function(_self)
			state = (state * 1103515245 + 12345) % 2147483648
			return state / 2147483648
		end,
	}
end

local function newRunWithLevels(levels: number)
	local state = RunState.new({ "GaleSword" })
	local total = 0
	for level = 1, levels do
		total += require(Shared.Progression).xpToNext(level)
	end
	RunState.grantXp(state, total)
	return state
end

return function(it, expect)
	it("todas las mejoras habilitadas tienen efectos reales y datos completos", function()
		for _, def in UpgradeConfig.List do
			expect.truthy(def.DisplayName ~= "" and def.Description ~= "", def.Id .. " sin textos")
			expect.truthy(UpgradeConfig.Rarities[def.Rarity] ~= nil, def.Id .. " rareza inválida")
			if def.Enabled ~= false then
				expect.truthy(#def.Effects > 0, def.Id .. " no hace nada")
			end
		end
		-- Las 10 mejoras pedidas + el comodín.
		expect.equal(#UpgradeConfig.List, 11)
	end)

	it("una oferta tiene tres opciones distintas y válidas (1000 tiradas)", function()
		local rng = makeRng(42)
		for _ = 1, 1000 do
			local state = RunState.new({ "GaleSword" })
			local options = UpgradeLogic.rollOptions({
				Stats = state.Stats,
				Weapons = state.Weapons,
				UpgradeLevels = state.UpgradeLevels,
			}, rng)
			expect.equal(#options, 3)
			local seen = {}
			for _, id in options do
				expect.falsy(seen[id], "opción repetida " .. id)
				seen[id] = true
				local def = UpgradeConfig.ById[id]
				expect.truthy(def and def.Enabled ~= false, "opción no seleccionable " .. id)
				expect.falsy(def.IsFallback, "no debe ofrecer comodines con opciones de sobra")
			end
		end
	end)

	it("Impulso Arcano (sin mecánica en Fase 1) nunca se ofrece", function()
		local rng = makeRng(7)
		local state = RunState.new({ "GaleSword" })
		for _ = 1, 2000 do
			local options = UpgradeLogic.rollOptions({
				Stats = state.Stats,
				Weapons = state.Weapons,
				UpgradeLevels = state.UpgradeLevels,
			}, rng)
			expect.falsy(table.find(options, "ArcaneImpulse"), "se ofreció ArcaneImpulse")
		end
	end)

	it("las mejoras al nivel máximo dejan de ofrecerse y se completa con el comodín", function()
		local state = RunState.new({ "GaleSword" })
		-- Agota todo menos dos mejoras.
		for _, def in UpgradeConfig.List do
			if def.MaxLevel and def.Id ~= "SharpEdge" and def.Id ~= "HawkSteps" then
				state.UpgradeLevels[def.Id] = def.MaxLevel
			end
		end
		local options = UpgradeLogic.rollOptions({
			Stats = state.Stats,
			Weapons = state.Weapons,
			UpgradeLevels = state.UpgradeLevels,
		}, makeRng(1))
		expect.equal(#options, 3)
		expect.truthy(table.find(options, "SharpEdge"))
		expect.truthy(table.find(options, "HawkSteps"))
		expect.truthy(table.find(options, "SkyBlessing"), "debe completarse con el comodín")
	end)

	it("Hoja Doble deja de ofrecerse cuando el arma alcanza su máximo de proyectiles", function()
		local state = RunState.new({ "GaleSword" })
		state.Stats.ExtraProjectiles = WeaponConfig.GaleSword.MaxProjectiles - 1
		local ctx = { Stats = state.Stats, Weapons = state.Weapons, UpgradeLevels = state.UpgradeLevels }
		expect.falsy(UpgradeLogic.isEligible(UpgradeConfig.ById.TwinBlade, ctx))
		state.Stats.ExtraProjectiles = 0
		expect.truthy(UpgradeLogic.isEligible(UpgradeConfig.ById.TwinBlade, ctx))
	end)

	it("la Suerte aumenta el peso de las rarezas Rara y Épica", function()
		local epic = UpgradeConfig.ById.TwinBlade
		local common = UpgradeConfig.ById.SharpEdge
		expect.truthy(UpgradeLogic.weightOf(epic, 3) > UpgradeLogic.weightOf(epic, 0))
		expect.equal(UpgradeLogic.weightOf(common, 3), UpgradeLogic.weightOf(common, 0))
	end)

	it("subir de nivel abre una oferta vinculada al nivel y pausa la partida", function()
		local state = newRunWithLevels(1)
		expect.equal(state.Progress.Level, 2)
		local offer = RunState.tryOpenOffer(state, makeRng(3))
		expect.truthy(offer, "debe abrirse una oferta")
		expect.equal(offer.Level, 2)
		expect.equal(state.Phase, "ChoosingUpgrade")
		-- No se superponen ofertas.
		expect.equal(RunState.tryOpenOffer(state, makeRng(3)), nil)
		-- El reloj de partida no avanza en pausa.
		RunState.advance(state, 5)
		expect.equal(state.Elapsed, 0)
	end)

	it("aplicar una mejora cambia realmente la estadística", function()
		local cases = {
			SharpEdge = function(s)
				return StatSheet.weaponStats(s, WeaponConfig.GaleSword).Damage
			end,
			SwiftStrike = function(s)
				return StatSheet.weaponStats(s, WeaponConfig.GaleSword).Cooldown
			end,
			AstralReach = function(s)
				return StatSheet.weaponStats(s, WeaponConfig.GaleSword).Range
			end,
			BasaltHeart = StatSheet.maxHealth,
			HawkSteps = StatSheet.walkSpeed,
			ConcentratedEssence = function(s)
				return StatSheet.xpGain(s, 10)
			end,
			StoneSkin = function(s)
				return StatSheet.damageTaken(s, 10)
			end,
			CelestialFortune = StatSheet.luckyGemChance,
			TwinBlade = function(s)
				return StatSheet.weaponStats(s, WeaponConfig.GaleSword).Projectiles
			end,
		}
		local expected = {
			SharpEdge = 12 * 1.15,
			SwiftStrike = 1.4 * 0.9,
			AstralReach = 28 * 1.15,
			BasaltHeart = 120,
			HawkSteps = 18 * 1.1,
			ConcentratedEssence = 11.5,
			StoneSkin = 9,
			TwinBlade = 2,
		}
		for id, measure in cases do
			local state = newRunWithLevels(1)
			local before = measure(state.Stats)
			local offer = RunState.tryOpenOffer(state, makeRng(9))
			-- Fuerza la opción a probar dentro de la oferta activa.
			offer.Options[1] = id
			local ok, result = RunState.choose(state, offer.Token, id)
			expect.truthy(ok, "elección rechazada: " .. id .. " " .. tostring(result))
			local after = measure(state.Stats)
			expect.truthy(after ~= before, id .. " no cambió la estadística")
			if expected[id] then
				expect.near(after, expected[id], 1e-6, id)
			end
			expect.equal(state.UpgradeLevels[id], 1)
			expect.equal(state.Phase, "Playing")
		end
	end)

	it("el comodín devuelve una curación del 30 %", function()
		local state = newRunWithLevels(1)
		local offer = RunState.tryOpenOffer(state, makeRng(5))
		offer.Options[1] = "SkyBlessing"
		local ok, result = RunState.choose(state, offer.Token, "SkyBlessing")
		expect.truthy(ok)
		expect.near(result.HealPct, 0.3)
	end)

	it("rechaza selecciones inventadas, fuera de tiempo y repetidas", function()
		local state = newRunWithLevels(2) -- dos niveles pendientes
		-- Fuera de tiempo: aún no hay oferta.
		state.Phase = "Playing"
		local ok, reason = RunState.choose(state, 1, "SharpEdge")
		expect.falsy(ok)
		expect.equal(reason, "NotChoosing")

		local offer = RunState.tryOpenOffer(state, makeRng(11))
		local notOffered
		for _, def in UpgradeConfig.List do
			if not table.find(offer.Options, def.Id) then
				notOffered = def.Id
				break
			end
		end

		ok, reason = RunState.choose(state, offer.Token, "HackDeLaMuerte")
		expect.falsy(ok)
		expect.equal(reason, "NotOffered")
		ok, reason = RunState.choose(state, offer.Token, notOffered)
		expect.falsy(ok)
		expect.equal(reason, "NotOffered")
		ok, reason = RunState.choose(state, offer.Token + 1, offer.Options[1])
		expect.falsy(ok)
		expect.equal(reason, "StaleToken")
		ok, reason = RunState.choose(state, tostring(offer.Token), offer.Options[1])
		expect.falsy(ok)
		ok, reason = RunState.choose(state, offer.Token, { offer.Options[1] })
		expect.falsy(ok)

		-- Elección válida.
		local chosen = offer.Options[1]
		ok = RunState.choose(state, offer.Token, chosen)
		expect.truthy(ok)
		expect.equal(state.UpgradeLevels[chosen], 1)

		-- Repetir la misma petición no duplica el efecto.
		ok, reason = RunState.choose(state, offer.Token, chosen)
		expect.falsy(ok)
		expect.equal(state.UpgradeLevels[chosen], 1)

		-- Segundo nivel pendiente: nueva oferta con token nuevo; el antiguo no sirve.
		local second = RunState.tryOpenOffer(state, makeRng(12))
		expect.truthy(second)
		expect.equal(second.Level, 3)
		expect.truthy(second.Token ~= offer.Token)
		ok, reason = RunState.choose(state, offer.Token, second.Options[1])
		expect.falsy(ok)
		expect.equal(reason, "StaleToken")
		expect.equal(RunState.tryOpenOffer(state, makeRng(13)), nil)
	end)

	it("tras la derrota no se conceden experiencia, muertes ni elecciones", function()
		local state = newRunWithLevels(1)
		local offer = RunState.tryOpenOffer(state, makeRng(2))
		expect.truthy(RunState.setGameOver(state))
		expect.falsy(RunState.setGameOver(state), "la derrota solo se procesa una vez")
		local ok = RunState.choose(state, offer.Token, offer.Options[1])
		expect.falsy(ok)
		expect.equal(RunState.grantXp(state, 100), 0)
		RunState.addKill(state)
		expect.equal(state.Kills, 0)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">Utilities.spec</string>
          <string name="Source"><![CDATA[-- Prueba B (selección de objetivos) y G (validación y límite de frecuencia).
local Logic = script.Parent.Parent.Logic
local Targeting = require(Logic.Targeting)
local RateLimiter = require(Logic.RateLimiter)
local Validation = require(Logic.Validation)

return function(it, expect)
	it("elige los objetivos vivos más cercanos dentro del alcance", function()
		local enemies = {
			{ Name = "lejos", Position = Vector3.new(40, 0, 0), Dead = false },
			{ Name = "cerca", Position = Vector3.new(5, 0, 0), Dead = false },
			{ Name = "muerto", Position = Vector3.new(1, 0, 0), Dead = true },
			{ Name = "medio", Position = Vector3.new(0, 0, 12), Dead = false },
			{ Name = "borde", Position = Vector3.new(0, 0, -27.9), Dead = false },
		}
		local one = Targeting.nearest(enemies, Vector3.zero, 28, 1)
		expect.equal(#one, 1)
		expect.equal(one[1].Name, "cerca")

		local many = Targeting.nearest(enemies, Vector3.zero, 28, 10)
		expect.equal(#many, 3, "solo 3 válidos dentro del alcance")
		expect.equal(many[1].Name, "cerca")
		expect.equal(many[2].Name, "medio")
		expect.equal(many[3].Name, "borde")

		local filtered = Targeting.nearest(enemies, Vector3.zero, 28, 2, function(e)
			return e.Name ~= "cerca"
		end)
		expect.equal(filtered[1].Name, "medio")
		expect.equal(#Targeting.nearest(enemies, Vector3.zero, 28, 0), 0)
		expect.equal(#Targeting.nearest({}, Vector3.zero, 28, 3), 0)
	end)

	it("el limitador de frecuencia bloquea el spam y se recupera tras la ventana", function()
		local now = 0
		local limiter = RateLimiter.new(3, 1, function()
			return now
		end)
		expect.truthy(limiter:Allow("p"))
		expect.truthy(limiter:Allow("p"))
		expect.truthy(limiter:Allow("p"))
		expect.falsy(limiter:Allow("p"), "la cuarta petición debe rechazarse")
		expect.truthy(limiter:Allow("otro"), "las claves son independientes")
		now = 1.01
		expect.truthy(limiter:Allow("p"))
		limiter:Forget("p")
		expect.truthy(limiter:Allow("p"))
	end)

	it("valida los tipos de los argumentos remotos", function()
		expect.truthy(Validation.isPositiveInteger(3))
		expect.falsy(Validation.isPositiveInteger(0))
		expect.falsy(Validation.isPositiveInteger(1.5))
		expect.falsy(Validation.isPositiveInteger(0 / 0))
		expect.falsy(Validation.isPositiveInteger(math.huge))
		expect.falsy(Validation.isPositiveInteger("3"))
		expect.truthy(Validation.isIdentifier("SharpEdge"))
		expect.falsy(Validation.isIdentifier(""))
		expect.falsy(Validation.isIdentifier("Sharp Edge"))
		expect.falsy(Validation.isIdentifier(string.rep("a", 100)))
		expect.falsy(Validation.isIdentifier({}))
		expect.falsy(Validation.isIdentifier(nil))
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">World.spec</string>
          <string name="Source"><![CDATA[-- Prueba A (mapa válido) y comprobaciones de la plantilla del enemigo.
local Shared = game:GetService("ReplicatedStorage").Shared
local GameConfig = require(Shared.Config.GameConfig)
local EnemyConfig = require(Shared.Config.EnemyConfig)
local MapBuilder = require(script.Parent.Parent.World.MapBuilder)
local ModelFactory = require(script.Parent.Parent.World.ModelFactory)

local function countParts(root: Instance): (number, number)
	local total, colliding = 0, 0
	for _, descendant in root:GetDescendants() do
		if descendant:IsA("BasePart") then
			total += 1
			if descendant.CanCollide then
				colliding += 1
			end
		end
	end
	return total, colliding
end

return function(it, expect)
	it("el mapa tiene suelo, zona de aparición y un número de piezas ligero", function()
		local holder = Instance.new("Folder")
		local map = MapBuilder.build(holder)
		local ground = map:FindFirstChild("Ground")
		expect.truthy(ground, "falta Ground")
		expect.truthy(map:FindFirstChild("Props"), "falta Props")
		expect.truthy(map:FindFirstChild("Decor"), "falta Decor")
		local spawn = ground:FindFirstChild("PlayerSpawn")
		expect.truthy(spawn and spawn:IsA("SpawnLocation"), "falta SpawnLocation")
		local offset = spawn.CFrame.Position - GameConfig.Map.PlayerSpawn
		expect.truthy(math.abs(offset.X) < 0.01 and math.abs(offset.Z) < 0.01, "spawn desplazado")

		local total = countParts(map)
		expect.truthy(total > 60, "mapa demasiado vacío: " .. total)
		expect.truthy(total < 320, "demasiadas piezas para móvil: " .. total)

		for _, descendant in map:GetDescendants() do
			if descendant:IsA("BasePart") then
				expect.truthy(descendant.Anchored, descendant:GetFullName() .. " no anclada")
			end
		end
		for _, descendant in map.Decor:GetDescendants() do
			if descendant:IsA("BasePart") then
				expect.falsy(descendant.CanCollide, descendant.Name .. " decorativa con colisión")
				expect.falsy(descendant.CanQuery, descendant.Name .. " decorativa consultable")
			end
		end

		-- La superficie cubre el radio jugable: algún bloque de suelo llega al borde.
		local maxReach = 0
		for _, part in ground:GetChildren() do
			if part:IsA("BasePart") and string.find(part.Name, "IslandRim") then
				local p = part.CFrame.Position
				local reach = math.sqrt(p.X * p.X + p.Z * p.Z) + part.Size.Z / 2
				maxReach = math.max(maxReach, reach)
			end
		end
		expect.truthy(maxReach >= GameConfig.Map.PlayableRadius, "el borde no cubre el radio jugable")
		holder:Destroy()
	end)

	it("la plantilla del Slime del Vacío tiene todas las piezas necesarias", function()
		local def = EnemyConfig.VoidSlime
		local model = ModelFactory.Builders[def.ModelName](def)
		local root = model:FindFirstChild("Root")
		expect.truthy(root and model.PrimaryPart == root, "Root no es PrimaryPart")
		expect.truthy(root:FindFirstChild("RootAttachment"))
		expect.truthy(root:FindFirstChild("Mover"))
		expect.truthy(root:FindFirstChild("Facing"))
		local bar = root:FindFirstChild("HealthBar")
		expect.truthy(bar and bar:FindFirstChild("Back") and bar.Back:FindFirstChild("Fill"), "falta barra de vida")
		local body = model:FindFirstChild("Body")
		expect.truthy(body and body:FindFirstChild("BodyWeld") and body:FindFirstChild("BodyMesh"))
		local total, colliding = countParts(model)
		expect.equal(colliding, 1, "solo Root debe colisionar")
		expect.truthy(total <= 10, "demasiadas piezas por enemigo: " .. total)
		model:Destroy()
	end)
end
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="51">
      <Properties>
        <string name="Name">World</string>
      </Properties>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--[[
	MapBuilder
	Construye la isla flotante de pruebas con Parts low-poly (sin recursos
	externos). Es determinista (semilla en GameConfig.Map.Seed).

	Jerarquía generada:
	  Map/
	    Ground/   superficies caminables (válidas para generar enemigos)
	    Props/    obstáculos sólidos: ruinas, árboles, cristales, rocas del borde
	    Decor/    elementos sin colisión: islas lejanas, nubes, arbustos
	    PlayerSpawn (SpawnLocation)

	Si Workspace ya contiene un Map con Ground, Bootstrap lo respeta y no lo
	regenera, de modo que el mapa puede editarse a mano en Studio.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local MapBuilder = {}

local TAU = math.pi * 2

local PALETTE = {
	Grass = Color3.fromRGB(112, 186, 84),
	GrassDark = Color3.fromRGB(88, 160, 72),
	Rim = Color3.fromRGB(206, 190, 136),
	Rock1 = Color3.fromRGB(142, 122, 106),
	Rock2 = Color3.fromRGB(120, 102, 92),
	Rock3 = Color3.fromRGB(100, 86, 84),
	Rock4 = Color3.fromRGB(84, 72, 76),
	Rock5 = Color3.fromRGB(70, 60, 68),
	Stone = Color3.fromRGB(216, 204, 182),
	StoneDark = Color3.fromRGB(168, 156, 140),
	Trunk = Color3.fromRGB(122, 84, 58),
	Leaf1 = Color3.fromRGB(70, 150, 84),
	Leaf2 = Color3.fromRGB(96, 178, 92),
	Leaf3 = Color3.fromRGB(150, 206, 104),
	Cloud = Color3.fromRGB(248, 250, 255),
	CrystalCyan = Color3.fromRGB(98, 232, 255),
	CrystalViolet = Color3.fromRGB(178, 120, 255),
	CrystalPink = Color3.fromRGB(255, 132, 214),
	Rune = Color3.fromRGB(140, 230, 255),
}

-- Generador congruencial determinista (independiente de Random para poder
-- ejecutar este módulo también fuera de Roblox en las pruebas).
local function makeRng(seed: number)
	local state = seed % 2147483647
	if state <= 0 then
		state += 2147483646
	end
	local rng = {}
	function rng.next(): number
		state = (state * 48271) % 2147483647
		return state / 2147483647
	end
	function rng.range(min: number, max: number): number
		return min + (max - min) * rng.next()
	end
	function rng.pick<T>(list: { T }): T
		return list[math.floor(rng.next() * #list) + 1]
	end
	return rng
end

local function newPart(className: string, props: { [string]: any }, parent: Instance): BasePart
	local part = Instance.new(className) :: BasePart
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		(part :: any)[key] = value
	end
	part.Parent = parent
	return part
end

-- Elemento sin colisión ni consultas (no afecta a la física ni a los raycasts).
local function decorProps(props: { [string]: any }): { [string]: any }
	props.CanCollide = false
	props.CanQuery = false
	props.CanTouch = false
	return props
end

--[[
	Capa poligonal: N bloques que, unidos, forman un polígono regular de
	circunradio `radius`. Cada bloque va del centro a la apotema y su cara
	exterior es un lado del polígono (aspecto facetado low-poly).
]]
local function polygonLayer(
	folder: Instance,
	name: string,
	sides: number,
	radius: number,
	topY: number,
	thickness: number,
	color: Color3,
	angleOffset: number
)
	local apothem = radius * math.cos(math.pi / sides)
	local side = 2 * radius * math.sin(math.pi / sides)
	for i = 0, sides - 1 do
		local angle = angleOffset + i * TAU / sides
		local direction = Vector3.new(-math.sin(angle), 0, -math.cos(angle))
		local center = direction * (apothem / 2) + Vector3.new(0, topY - thickness / 2, 0)
		newPart("Part", {
			Name = string.format("%s_%02d", name, i + 1),
			Size = Vector3.new(side, thickness, apothem),
			CFrame = CFrame.new(center) * CFrame.Angles(0, angle, 0),
			Color = color,
		}, folder)
	end
end

local function buildIsland(ground: Folder, props: Folder)
	local surfaceY = GameConfig.Map.SurfaceY
	polygonLayer(ground, "IslandSurface", 14, 101, surfaceY, 4, PALETTE.Grass, 0)
	-- Anillo exterior algo más bajo y de otro color: marca claramente el borde.
	polygonLayer(ground, "IslandRim", 14, 110, surfaceY - 0.5, 5, PALETTE.Rim, math.pi / 14)
	-- Cuerpo rocoso invertido bajo la isla.
	polygonLayer(props, "Cliff1", 12, 108, surfaceY - 5, 9, PALETTE.Rock1, 0.2)
	polygonLayer(props, "Cliff2", 10, 92, surfaceY - 13, 12, PALETTE.Rock2, 0.5)
	polygonLayer(props, "Cliff3", 9, 70, surfaceY - 24, 14, PALETTE.Rock3, 0.1)
	polygonLayer(props, "Cliff4", 8, 44, surfaceY - 37, 16, PALETTE.Rock4, 0.7)
	polygonLayer(props, "Cliff5", 7, 20, surfaceY - 52, 16, PALETTE.Rock5, 0.3)
end

-- Colina low-poly: meseta + 4 rampas (WedgeParts) caminables.
local function buildHill(ground: Folder, name: string, center: Vector3, width: number, depth: number, height: number)
	local run = height * 2.2
	local baseY = GameConfig.Map.SurfaceY
	local model = Instance.new("Model")
	model.Name = name
	newPart("Part", {
		Name = "Top",
		Size = Vector3.new(width, height, depth),
		CFrame = CFrame.new(center.X, baseY + height / 2, center.Z),
		Color = PALETTE.GrassDark,
	}, model)
	local sides = {
		{ Vector3.new(0, 0, -1), width, depth },
		{ Vector3.new(0, 0, 1), width, depth },
		{ Vector3.new(1, 0, 0), depth, width },
		{ Vector3.new(-1, 0, 0), depth, width },
	}
	for index, info in sides do
		local outward: Vector3 = info[1]
		local along: number = info[2]
		local across: number = info[3]
		local position = Vector3.new(center.X, baseY + height / 2, center.Z) + outward * (across / 2 + run / 2)
		-- La cara frontal (LookVector) de una WedgePart es el extremo bajo de la rampa.
		newPart("WedgePart", {
			Name = "Ramp" .. index,
			Size = Vector3.new(along, height, run),
			CFrame = CFrame.lookAt(position, position + outward),
			Color = PALETTE.Grass,
		}, model)
	end
	model.Parent = ground
end

local function buildSpawnPlatform(ground: Folder, decor: Folder): SpawnLocation
	local spawnPosition = GameConfig.Map.PlayerSpawn
	local surfaceY = GameConfig.Map.SurfaceY
	newPart("Part", {
		Name = "SpawnPlaza",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 22, 22),
		CFrame = CFrame.new(spawnPosition.X, surfaceY + 0.3, spawnPosition.Z) * CFrame.Angles(0, 0, math.pi / 2),
		Color = PALETTE.Stone,
		Material = Enum.Material.Slate,
	}, ground)
	newPart("Part", decorProps({
		Name = "SpawnRuneRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.65, 14, 14),
		CFrame = CFrame.new(spawnPosition.X, surfaceY + 0.3, spawnPosition.Z) * CFrame.Angles(0, 0, math.pi / 2),
		Color = PALETTE.Rune,
		Material = Enum.Material.Neon,
		Transparency = 0.55,
	}), decor)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "PlayerSpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0 -- sin campo de fuerza
	spawn.Size = Vector3.new(6, 0.8, 6)
	spawn.CFrame = CFrame.new(spawnPosition.X, surfaceY + 0.6, spawnPosition.Z)
	spawn.Color = PALETTE.StoneDark
	spawn.Material = Enum.Material.Slate
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = ground
	return spawn
end

local function buildRuins(props: Folder, rng)
	local surfaceY = GameConfig.Map.SurfaceY
	-- Arco en ruinas.
	local arch = Instance.new("Model")
	arch.Name = "RuinedArch"
	local archCenter = Vector3.new(-22, surfaceY, -52)
	for _, offset in { -6, 6 } do
		newPart("Part", {
			Name = "ArchPillar",
			Size = Vector3.new(3, 12, 3),
			CFrame = CFrame.new(archCenter + Vector3.new(offset, 6, 0)),
			Color = PALETTE.Stone,
		}, arch)
	end
	newPart("Part", {
		Name = "ArchLintel",
		Size = Vector3.new(16, 2.5, 4),
		CFrame = CFrame.new(archCenter + Vector3.new(0, 13.2, 0)) * CFrame.Angles(0, 0, math.rad(4)),
		Color = PALETTE.StoneDark,
	}, arch)
	arch.Parent = props

	-- Columnas rotas repartidas por la isla.
	local pillarSpots = {
		Vector3.new(48, 0, 22),
		Vector3.new(-60, 0, -14),
		Vector3.new(30, 0, -70),
		Vector3.new(-38, 0, 64),
		Vector3.new(72, 0, -36),
		Vector3.new(-74, 0, 40),
	}
	for index, spot in pillarSpots do
		local pillar = Instance.new("Model")
		pillar.Name = "BrokenPillar" .. index
		local height = rng.range(4, 9)
		local yaw = rng.range(0, TAU)
		newPart("Part", {
			Name = "Base",
			Size = Vector3.new(4.5, 1, 4.5),
			CFrame = CFrame.new(spot.X, surfaceY + 0.5, spot.Z) * CFrame.Angles(0, yaw, 0),
			Color = PALETTE.StoneDark,
		}, pillar)
		newPart("Part", {
			Name = "Shaft",
			Size = Vector3.new(2.8, height, 2.8),
			CFrame = CFrame.new(spot.X, surfaceY + 1 + height / 2, spot.Z) * CFrame.Angles(0, yaw + math.pi / 4, 0),
			Color = PALETTE.Stone,
		}, pillar)
		newPart("Part", {
			Name = "FallenPiece",
			Size = Vector3.new(2.6, 2.6, rng.range(3, 5)),
			CFrame = CFrame.new(spot.X + 3.5, surfaceY + 1.2, spot.Z + 1.5)
				* CFrame.Angles(math.rad(rng.range(-8, 8)), yaw, math.rad(rng.range(5, 20))),
			Color = PALETTE.Stone,
		}, pillar)
		pillar.Parent = props
	end

	-- Muros derruidos.
	local walls = {
		{ Vector3.new(14, 0, 34), 12, 4.5, 0.4 },
		{ Vector3.new(-16, 0, 30), 9, 3, -0.9 },
		{ Vector3.new(58, 0, 58), 11, 5, 2.2 },
	}
	for index, wall in walls do
		local position: Vector3 = wall[1]
		newPart("Part", {
			Name = "RuinedWall" .. index,
			Size = Vector3.new(wall[2], wall[3], 2),
			CFrame = CFrame.new(position.X, surfaceY + wall[3] / 2, position.Z) * CFrame.Angles(0, wall[4], 0),
			Color = PALETTE.StoneDark,
		}, props)
	end
end

local function buildCrystalCluster(parent: Instance, name: string, base: Vector3, rng, withLight: boolean)
	local cluster = Instance.new("Model")
	cluster.Name = name
	local color = rng.pick({ PALETTE.CrystalCyan, PALETTE.CrystalViolet, PALETTE.CrystalPink })
	for index = 1, 3 do
		local height = rng.range(2.5, 6.5)
		local shard = newPart("Part", {
			Name = "Shard" .. index,
			Size = Vector3.new(1.3, height, 1.3),
			CFrame = CFrame.new(base + Vector3.new(rng.range(-1.2, 1.2), height / 2 - 0.3, rng.range(-1.2, 1.2)))
				* CFrame.Angles(math.rad(rng.range(-22, 22)), rng.range(0, TAU), math.rad(rng.range(-22, 22))),
			Color = color,
			Material = if index == 1 then Enum.Material.Neon else Enum.Material.Glass,
			Transparency = if index == 1 then 0 else 0.25,
			CastShadow = false,
		}, cluster)
		if index == 1 and withLight then
			local light = Instance.new("PointLight")
			light.Color = color
			light.Range = 12
			light.Brightness = 1.4
			light.Shadows = false
			light.Parent = shard
		end
	end
	cluster.Parent = parent
end

local function buildTree(props: Folder, decor: Folder, name: string, base: Vector3, rng)
	local tree = Instance.new("Model")
	tree.Name = name
	local trunkHeight = rng.range(6, 9)
	newPart("Part", {
		Name = "Trunk",
		Size = Vector3.new(1.8, trunkHeight, 1.8),
		CFrame = CFrame.new(base + Vector3.new(0, trunkHeight / 2, 0)) * CFrame.Angles(0, rng.range(0, TAU), 0),
		Color = PALETTE.Trunk,
	}, tree)
	local canopyColors = { PALETTE.Leaf1, PALETTE.Leaf2, PALETTE.Leaf3 }
	local canopySizes = { 7, 5.5, 3.5 }
	for index = 1, 3 do
		local size = canopySizes[index]
		newPart("Part", decorProps({
			Name = "Canopy" .. index,
			Size = Vector3.new(size, size * 0.8, size),
			CFrame = CFrame.new(base + Vector3.new(0, trunkHeight + (index - 1) * 2.2, 0))
				* CFrame.Angles(math.rad(rng.range(-15, 15)), rng.range(0, TAU), math.rad(25)),
			Color = canopyColors[index],
		}), decor)
	end
	tree.Parent = props
end

local function buildEdgeMarkers(props: Folder, rng)
	local surfaceY = GameConfig.Map.SurfaceY
	local count = 16
	for index = 1, count do
		-- Huecos regulares: el borde se ve, pero no es una pared.
		if index % 4 ~= 0 then
			local angle = index * TAU / count + rng.range(-0.08, 0.08)
			local radius = rng.range(103, 106)
			local size = rng.range(2, 3.4)
			newPart("Part", {
				Name = "EdgeStone" .. index,
				Size = Vector3.new(size, size * 0.9, size * 1.2),
				CFrame = CFrame.new(math.sin(angle) * radius, surfaceY + size * 0.3, math.cos(angle) * radius)
					* CFrame.Angles(math.rad(rng.range(-20, 20)), rng.range(0, TAU), math.rad(rng.range(-20, 20))),
				Color = rng.pick({ PALETTE.Rock1, PALETTE.Rock2 }),
			}, props)
		end
	end
	-- Cristales luminosos en los cuatro puntos cardinales del borde.
	for index = 0, 3 do
		local angle = index * TAU / 4 + math.pi / 4
		buildCrystalCluster(props, "EdgeBeacon" .. (index + 1), Vector3.new(math.sin(angle) * 104, surfaceY, math.cos(angle) * 104), rng, true)
	end
end

local function buildFloatingRocks(decor: Folder, rng)
	for index = 1, 6 do
		local angle = (index / 6) * TAU + rng.range(-0.3, 0.3)
		local distance = rng.range(155, 230)
		local center = Vector3.new(math.sin(angle) * distance, rng.range(-15, 35), math.cos(angle) * distance)
		local size = rng.range(10, 20)
		local yaw = rng.range(0, TAU)
		local rock = Instance.new("Model")
		rock.Name = "FloatingRock" .. index
		newPart("Part", decorProps({
			Name = "GrassTop",
			Size = Vector3.new(size, 2, size * 0.85),
			CFrame = CFrame.new(center) * CFrame.Angles(0, yaw, 0),
			Color = PALETTE.Grass,
		}), rock)
		newPart("Part", decorProps({
			Name = "RockBody",
			Size = Vector3.new(size * 0.7, size * 0.7, size * 0.7),
			CFrame = CFrame.new(center - Vector3.new(0, size * 0.42, 0)) * CFrame.Angles(math.rad(45), yaw, math.rad(35)),
			Color = PALETTE.Rock2,
		}), rock)
		newPart("Part", decorProps({
			Name = "Crystal",
			Size = Vector3.new(1.4, size * 0.35, 1.4),
			CFrame = CFrame.new(center + Vector3.new(size * 0.15, size * 0.17 + 1, 0)) * CFrame.Angles(0.2, yaw, 0.25),
			Color = rng.pick({ PALETTE.CrystalCyan, PALETTE.CrystalViolet }),
			Material = Enum.Material.Neon,
			CastShadow = false,
		}), rock)
		rock.Parent = decor
	end
end

local function buildClouds(decor: Folder, rng)
	for index = 1, 8 do
		local angle = rng.range(0, TAU)
		local distance = rng.range(70, 280)
		local center = Vector3.new(math.sin(angle) * distance, rng.range(-75, -30), math.cos(angle) * distance)
		local cloud = Instance.new("Model")
		cloud.Name = "Cloud" .. index
		for puff = 1, 3 do
			local size = rng.range(14, 26)
			newPart("Part", decorProps({
				Name = "Puff" .. puff,
				Shape = Enum.PartType.Ball,
				Size = Vector3.new(size, size, size),
				CFrame = CFrame.new(center + Vector3.new((puff - 2) * size * 0.6, rng.range(-2, 3), rng.range(-4, 4))),
				Color = PALETTE.Cloud,
				Transparency = 0.15,
				CastShadow = false,
			}), cloud)
		end
		cloud.Parent = decor
	end
end

-- Construye el mapa completo dentro de `parent` y devuelve la carpeta Map.
function MapBuilder.build(parent: Instance): Folder
	local rng = makeRng(GameConfig.Map.Seed)
	local map = Instance.new("Folder")
	map.Name = "Map"
	local ground = Instance.new("Folder")
	ground.Name = "Ground"
	ground.Parent = map
	local props = Instance.new("Folder")
	props.Name = "Props"
	props.Parent = map
	local decor = Instance.new("Folder")
	decor.Name = "Decor"
	decor.Parent = map

	buildIsland(ground, props)
	buildHill(ground, "Hill1", Vector3.new(36, 0, -28), 14, 14, 3)
	buildHill(ground, "Hill2", Vector3.new(-46, 0, 18), 18, 12, 4)
	buildHill(ground, "Hill3", Vector3.new(12, 0, 62), 12, 16, 2.5)
	buildSpawnPlatform(ground, decor)
	buildRuins(props, rng)
	buildEdgeMarkers(props, rng)

	local crystalSpots = {
		Vector3.new(20, 0, -18),
		Vector3.new(-30, 0, -36),
		Vector3.new(66, 0, 8),
		Vector3.new(-62, 0, 52),
		Vector3.new(4, 0, 84),
	}
	for index, spot in crystalSpots do
		buildCrystalCluster(props, "CrystalCluster" .. index, spot, rng, index <= 2)
	end

	local treeSpots = {
		Vector3.new(-30, 0, 8),
		Vector3.new(44, 0, 44),
		Vector3.new(-50, 0, -50),
		Vector3.new(80, 0, 24),
		Vector3.new(-20, 0, 82),
	}
	for index, spot in treeSpots do
		buildTree(props, decor, "Tree" .. index, spot, rng)
	end

	for index = 1, 8 do
		local angle = rng.range(0, TAU)
		local distance = rng.range(25, 90)
		local size = rng.range(2.4, 4)
		newPart("Part", decorProps({
			Name = "Bush" .. index,
			Size = Vector3.new(size, size * 0.75, size),
			CFrame = CFrame.new(math.sin(angle) * distance, size * 0.3, math.cos(angle) * distance)
				* CFrame.Angles(0, rng.range(0, TAU), math.rad(12)),
			Color = rng.pick({ PALETTE.Leaf1, PALETTE.Leaf2 }),
		}), decor)
	end

	buildFloatingRocks(decor, rng)
	buildClouds(decor, rng)

	map.Parent = parent
	return map
end

-- Iluminación de fantasía luminosa, atmósfera y nubes volumétricas.
function MapBuilder.applyLighting()
	local Lighting = game:GetService("Lighting")
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(104, 104, 132)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 176)
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.GlobalShadows = true

	local function ensure(className: string, name: string, parent: Instance): Instance
		local existing = parent:FindFirstChild(name)
		if existing and existing.ClassName == className then
			return existing
		end
		local created = Instance.new(className)
		created.Name = name
		created.Parent = parent
		return created
	end

	local atmosphere = ensure("Atmosphere", "SkyAtmosphere", Lighting) :: Atmosphere
	atmosphere.Density = 0.3
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(196, 222, 255)
	atmosphere.Decay = Color3.fromRGB(110, 146, 206)
	atmosphere.Glare = 0.3
	atmosphere.Haze = 1.4

	local sky = ensure("Sky", "SkyboxSky", Lighting) :: Sky
	sky.SunAngularSize = 14
	sky.MoonAngularSize = 8
	sky.CelestialBodiesShown = true

	local bloom = ensure("BloomEffect", "SkyBloom", Lighting) :: BloomEffect
	bloom.Intensity = 0.55
	bloom.Size = 24
	bloom.Threshold = 1.6

	local grading = ensure("ColorCorrectionEffect", "SkyColorGrade", Lighting) :: ColorCorrectionEffect
	grading.Saturation = 0.15
	grading.Contrast = 0.06
	grading.TintColor = Color3.fromRGB(255, 250, 244)

	local rays = ensure("SunRaysEffect", "SkySunRays", Lighting) :: SunRaysEffect
	rays.Intensity = 0.06
	rays.Spread = 0.8

	local clouds = ensure("Clouds", "SkyClouds", workspace.Terrain) :: Clouds
	clouds.Cover = 0.55
	clouds.Density = 0.55
	clouds.Color = Color3.fromRGB(255, 255, 255)
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">ModelFactory</string>
          <string name="Source"><![CDATA[--[[
	ModelFactory
	Construye las plantillas de enemigos (low-poly, solo Parts). EnemyService
	las clona desde ServerStorage/EnemyModels; si un diseñador coloca allí un
	modelo con el mismo nombre (con Root, RootAttachment, Mover, Facing y
	HealthBar), se usa ese en lugar del generado.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Types = require(ReplicatedStorage.Shared.Types)

local ModelFactory = {}

local function weld(part0: BasePart, part1: BasePart, name: string): Weld
	local w = Instance.new("Weld")
	w.Name = name
	w.Part0 = part0
	w.Part1 = part1
	w.C0 = part0.CFrame:Inverse() * part1.CFrame
	w.Parent = part1
	return w
end

local function visualPart(props: { [string]: any }, parent: Instance): BasePart
	local part = Instance.new(props.ClassName or "Part") :: BasePart
	props.ClassName = nil
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		(part :: any)[key] = value
	end
	part.Parent = parent
	return part
end

local function buildHealthBar(root: BasePart)
	local gui = Instance.new("BillboardGui")
	gui.Name = "HealthBar"
	gui.Adornee = root
	gui.Size = UDim2.new(3.6, 0, 0.42, 0)
	gui.StudsOffset = Vector3.new(0, 2.9, 0)
	gui.MaxDistance = 110
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.ResetOnSpawn = false

	local back = Instance.new("Frame")
	back.Name = "Back"
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Color3.fromRGB(26, 18, 40)
	back.BorderSizePixel = 0
	back.Parent = gui
	local backCorner = Instance.new("UICorner")
	backCorner.CornerRadius = UDim.new(0.5, 0)
	backCorner.Parent = back

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(236, 84, 120)
	fill.BorderSizePixel = 0
	fill.Parent = back
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0.5, 0)
	fillCorner.Parent = fill

	gui.Parent = root
end

-- Slime del Vacío: caja física invisible + cuerpo elipsoidal y detalles soldados.
function ModelFactory.buildVoidSlime(def: Types.EnemyDef): Model
	local model = Instance.new("Model")
	model.Name = def.ModelName

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(3.4, 2.6, 3.4)
	root.CFrame = CFrame.new(0, 1.3, 0)
	root.Transparency = 1
	root.Anchored = false
	root.CanCollide = true
	root.CanTouch = false
	root.CastShadow = false
	-- Sin fricción ni rebote: se desliza de forma estable por el terreno.
	root.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0, 0, 100, 100)
	root.Parent = model
	model.PrimaryPart = root

	local attachment = Instance.new("Attachment")
	attachment.Name = "RootAttachment"
	attachment.Parent = root

	-- Movimiento horizontal (la gravedad sigue actuando en Y).
	local mover = Instance.new("LinearVelocity")
	mover.Name = "Mover"
	mover.Attachment0 = attachment
	mover.RelativeTo = Enum.ActuatorRelativeTo.World
	mover.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	mover.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	mover.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	mover.PlaneVelocity = Vector2.new(0, 0)
	mover.ForceLimitMode = Enum.ForceLimitMode.Magnitude
	mover.MaxForce = 20000
	mover.Parent = root

	-- Mantiene al slime erguido y mirando hacia su objetivo.
	local facing = Instance.new("AlignOrientation")
	facing.Name = "Facing"
	facing.Mode = Enum.OrientationAlignmentMode.OneAttachment
	facing.Attachment0 = attachment
	facing.Responsiveness = 25
	facing.MaxTorque = 1e6
	facing.RigidityEnabled = false
	facing.CFrame = CFrame.new()
	facing.Parent = root

	local body = visualPart({
		Name = "Body",
		Size = Vector3.new(4, 3, 4),
		CFrame = CFrame.new(0, 1.5, 0),
		Color = def.Color,
		Transparency = 0.08,
		Reflectance = 0.05,
	}, model)
	local mesh = Instance.new("SpecialMesh")
	mesh.Name = "BodyMesh"
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = body
	-- El cliente anima BodyWeld.C0 y BodyMesh.Scale (rebote), solo visualmente.
	weld(root, body, "BodyWeld")

	local core = visualPart({
		Name = "Core",
		ClassName = "Part",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.4, 1.4, 1.4),
		CFrame = CFrame.new(0, 1.5, 0),
		Color = def.Color:Lerp(Color3.new(1, 1, 1), 0.45),
		Material = Enum.Material.Neon,
	}, model)
	weld(body, core, "CoreWeld")

	for _, side in { -1, 1 } do
		local eye = visualPart({
			Name = "Eye",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.85, 0.85, 0.85),
			CFrame = CFrame.new(side * 0.75, 2, -1.55),
			Color = Color3.fromRGB(250, 248, 255),
		}, model)
		weld(body, eye, "EyeWeld")
		local pupil = visualPart({
			Name = "Pupil",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.42, 0.42, 0.42),
			CFrame = CFrame.new(side * 0.75, 2, -1.92),
			Color = Color3.fromRGB(24, 10, 40),
		}, model)
		weld(body, pupil, "PupilWeld")
	end

	local crown = visualPart({
		Name = "CrownCrystal",
		Size = Vector3.new(0.7, 1.5, 0.7),
		CFrame = CFrame.new(0.3, 3.1, 0.2) * CFrame.Angles(0.25, 0.6, -0.3),
		Color = Color3.fromRGB(80, 230, 255),
		Material = Enum.Material.Neon,
	}, model)
	weld(body, crown, "CrownWeld")

	buildHealthBar(root)
	return model
end

-- Constructores por nombre de modelo (EnemyConfig.ModelName).
ModelFactory.Builders = {
	VoidSlime = ModelFactory.buildVoidSlime,
} :: { [string]: (Types.EnemyDef) -> Model }

return ModelFactory
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="54">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Folder" referent="55">
      <Properties>
        <string name="Name">EnemyModels</string>
      </Properties>
    </Item>
  </Item>
  <Item class="SoundService" referent="56">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="57">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">48</float>
      <float name="CameraMinZoomDistance">10</float>
      <token name="CameraMode">0</token>
      <float name="CharacterJumpPower">50</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">18</float>
      <token name="DevComputerMovementMode">0</token>
      <token name="DevTouchMovementMode">0</token>
    </Properties>
    <Item class="StarterCharacterScripts" referent="58">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="Script" referent="59">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Sustituye al script "Health" por defecto de Roblox: en SkyBonk la vida no se
-- regenera sola; solo el servidor la modifica (daño, mejoras y curaciones).
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="60">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="61">
        <Properties>
          <string name="Name">ClientBootstrap</string>
          <string name="Source"><![CDATA[--[[
	ClientBootstrap
	Arranca los controladores del cliente (Init -> Start) y avisa al servidor
	de que la interfaz está lista para empezar la partida.
]]

-- Espera a que termine la replicación inicial y a que Roblox copie el
-- contenido de StarterPlayerScripts a PlayerScripts: este script puede
-- ejecutarse antes de que existan sus carpetas hermanas.
if not game:IsLoaded() then
	game.Loaded:Wait()
end

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local root = script.Parent

local function waitFor(parent: Instance, path: { string }): Instance
	local current = parent
	for _, name in path do
		current = current:WaitForChild(name)
	end
	return current
end

local REQUIRED_CLIENT_MODULES = {
	{ "UI", "Theme" },
	{ "Util", "Sfx" },
	{ "Controllers", "InputController" },
	{ "Controllers", "CameraController" },
	{ "Controllers", "HUDController" },
	{ "Controllers", "UpgradeController" },
	{ "Controllers", "GameOverController" },
	{ "Controllers", "CombatEffectsController" },
}
for _, path in REQUIRED_CLIENT_MODULES do
	waitFor(root, path)
end
local Shared = ReplicatedStorage:WaitForChild("Shared")
for _, path in { { "Net" }, { "Signal" }, { "Types" }, { "Progression" }, { "Remotes" }, { "Config", "GameConfig" }, { "Config", "WeaponConfig" }, { "Config", "EnemyConfig" }, { "Config", "UpgradeConfig" } } do
	waitFor(Shared, path)
end

local Net = require(Shared.Net)
local Theme = require(root.UI.Theme)

local ControllersFolder = root.Controllers
local controllers = {
	InputController = require(ControllersFolder.InputController),
	CameraController = require(ControllersFolder.CameraController),
	HUDController = require(ControllersFolder.HUDController),
	UpgradeController = require(ControllersFolder.UpgradeController),
	GameOverController = require(ControllersFolder.GameOverController),
	CombatEffectsController = require(ControllersFolder.CombatEffectsController),
}
local START_ORDER = {
	"InputController",
	"CameraController",
	"HUDController",
	"UpgradeController",
	"GameOverController",
	"CombatEffectsController",
}

Theme.StartAutoScale()
for _, name in START_ORDER do
	controllers[name].Init(controllers)
end
for _, name in START_ORDER do
	local ok, err = pcall(controllers[name].Start)
	if not ok then
		warn("[SkyBonk] Error al iniciar", name, err)
	end
end

Net.ClientReady:FireServer()
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="62">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">CameraController</string>
            <string name="Source"><![CDATA[--[[
	CameraController
	Cámara en tercera persona estándar de Roblox (modo Classic) con zoom
	inicial alejado para ver a los enemigos cercanos, límites de zoom y
	una sacudida muy suave al recibir daño (vía Humanoid.CameraOffset, sin
	pelear con los scripts de cámara por defecto).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Net = require(Shared.Net)

local CameraController = {}

local player = Players.LocalPlayer
local shakeUntil = 0
local shakeConnection: RBXScriptConnection? = nil

local function applyZoom()
	local cfg = GameConfig.Player
	player.CameraMaxZoomDistance = cfg.CameraMaxZoom
	-- Truco estándar: fijar el mínimo al zoom deseado fuerza la distancia
	-- inicial; después se restaura el mínimo real.
	player.CameraMinZoomDistance = cfg.CameraStartZoom
	task.delay(0.2, function()
		player.CameraMinZoomDistance = cfg.CameraMinZoom
	end)
	local camera = Workspace.CurrentCamera
	if camera then
		camera.FieldOfView = cfg.CameraFieldOfView
	end
end

local function shake()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid == nil then
		return
	end
	shakeUntil = os.clock() + GameConfig.Effects.CameraShakeTime
	if shakeConnection then
		return
	end
	shakeConnection = RunService.RenderStepped:Connect(function()
		local remaining = shakeUntil - os.clock()
		if remaining <= 0 or humanoid.Parent == nil then
			humanoid.CameraOffset = Vector3.zero
			if shakeConnection then
				shakeConnection:Disconnect()
				shakeConnection = nil
			end
			return
		end
		local strength = GameConfig.Effects.CameraShakeStrength * (remaining / GameConfig.Effects.CameraShakeTime)
		humanoid.CameraOffset = Vector3.new(
			(math.random() - 0.5) * strength,
			(math.random() - 0.5) * strength,
			(math.random() - 0.5) * strength
		)
	end)
end

function CameraController.Init(_controllers) end

function CameraController.Start()
	player.CameraMode = Enum.CameraMode.Classic
	player.CharacterAdded:Connect(function()
		applyZoom()
	end)
	if player.Character then
		applyZoom()
	end
	Net.PlayerDamaged.OnClientEvent:Connect(shake)
end

return CameraController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">CombatEffectsController</string>
            <string name="Source"><![CDATA[--[[
	CombatEffectsController
	Presentación local de todo lo que calcula el servidor. Nada de lo que
	ocurre aquí afecta al resultado de la partida.

	  • Hojas de la Espada del Vendaval (proyectil visual con estela).
	  • Números de daño, destello de impacto y chispas.
	  • Explosión al morir un enemigo.
	  • Gemas que vuelan hacia el jugador al recogerlas.
	  • Aura y anillo al subir de nivel; resalte rojo al recibir daño.
	  • Animación de rebote de los slimes, barras de vida y giro de las gemas.

	Todo se anima desde un único RenderStepped y los objetos temporales
	(hojas y números de daño) se reutilizan mediante pools.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local WeaponConfig = require(Shared.Config.WeaponConfig)
local Net = require(Shared.Net)
local Sfx = require(script.Parent.Parent.Util.Sfx)

local CombatEffectsController = {}

local FX = GameConfig.Effects
local player = Players.LocalPlayer

local effectsFolder: Folder
local anchorPart: Part -- se mueve a cada posición antes de emitir partículas
local numbersAnchor: Part -- fijo en el origen; sostiene los adjuntos de los números
local hitEmitter: ParticleEmitter
local burstEmitter: ParticleEmitter
local sparkleEmitter: ParticleEmitter
local damageHighlight: Highlight

-- Animaciones activas (una sola actualización por frame para todas).
type Blade = { Part: BasePart, Trail: Trail, From: Vector3, To: Vector3, Start: number, Hit: any, Spin: number }
type FlyingGem = { Part: BasePart, From: Vector3, Start: number }
type EnemyVisual = {
	Model: Model,
	Weld: Weld?,
	BaseC0: CFrame,
	Mesh: SpecialMesh?,
	Body: BasePart?,
	BodyColor: Color3,
	Fill: Frame?,
	Phase: number,
	FlashUntil: number,
	Connection: RBXScriptConnection?,
}
type GemVisual = { Part: BasePart, Base: CFrame, Phase: number }

local blades: { Blade } = {}
local flyingGems: { FlyingGem } = {}
local enemyVisuals: { [Model]: EnemyVisual } = {}
local gemVisuals: { [BasePart]: GemVisual } = {}

local bladePool: { Blade } = {}
local numberPool: { { Attachment: Attachment, Gui: BillboardGui, Label: TextLabel } } = {}
local gemComboUntil = 0
local gemCombo = 0

local function rootPosition(): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root and (root :: BasePart).Position
end

local function makeEmitter(name: string, props: { [string]: any }): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = name
	emitter.Enabled = false
	emitter.LightEmission = 0.8
	emitter.LockedToPart = false
	for key, value in props do
		(emitter :: any)[key] = value
	end
	emitter.Parent = anchorPart
	return emitter
end

local function emitAt(emitter: ParticleEmitter, position: Vector3, count: number, color: Color3?)
	anchorPart.CFrame = CFrame.new(position)
	if color then
		emitter.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	end
	emitter:Emit(count)
end

------------------------------------------------------------------ Números
local function acquireNumber()
	local entry = table.remove(numberPool)
	if entry then
		return entry
	end
	local attachment = Instance.new("Attachment")
	attachment.Parent = numbersAnchor
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(90, 40)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 140
	gui.Adornee = attachment
	gui.Parent = attachment
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextSize = 26
	label.TextStrokeTransparency = 0.2
	label.Parent = gui
	return { Attachment = attachment, Gui = gui, Label = label }
end

local function showDamageNumber(position: Vector3, amount: number, killed: boolean)
	local entry = acquireNumber()
	entry.Attachment.WorldPosition = position + Vector3.new((math.random() - 0.5) * 1.5, 2.5, 0)
	entry.Label.Text = tostring(math.max(1, math.floor(amount + 0.5)))
	entry.Label.TextColor3 = if killed then Color3.fromRGB(255, 214, 90) else Color3.fromRGB(255, 255, 255)
	entry.Label.TextSize = if killed then 30 else 24
	entry.Label.TextTransparency = 0
	entry.Label.TextStrokeTransparency = 0.2
	entry.Gui.StudsOffset = Vector3.zero
	entry.Gui.Enabled = true
	local info = TweenInfo.new(FX.DamageNumberLifetime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(entry.Gui, info, { StudsOffset = Vector3.new(0, 2.2, 0) }):Play()
	TweenService:Create(entry.Label, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	task.delay(FX.DamageNumberLifetime, function()
		entry.Gui.Enabled = false
		table.insert(numberPool, entry)
	end)
end

------------------------------------------------------------------- Hojas
local function acquireBlade(color: Color3): Blade
	local blade = table.remove(bladePool)
	if blade == nil then
		local part = Instance.new("Part")
		part.Name = "GaleBlade"
		part.Size = Vector3.new(0.25, 0.25, 2.8)
		part.Material = Enum.Material.Neon
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 0, -1.3)
		a0.Parent = part
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, 0, 1.3)
		a1.Parent = part
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 0.16
		trail.LightEmission = 1
		trail.FaceCamera = true
		trail.Transparency = NumberSequence.new(0.2, 1)
		trail.Parent = part
		blade = { Part = part, Trail = trail, From = Vector3.zero, To = Vector3.zero, Start = 0, Hit = nil, Spin = 0 }
	end
	local b = blade :: Blade
	b.Part.Color = color
	b.Trail.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	return b
end

local function releaseBlade(blade: Blade)
	blade.Trail.Enabled = false
	blade.Part.Parent = nil
	blade.Hit = nil
	table.insert(bladePool, blade)
end

local function onBladeArrived(blade: Blade)
	local hit = blade.Hit
	if hit == nil then
		return
	end
	emitAt(hitEmitter, blade.To, 6)
	showDamageNumber(blade.To, hit.Damage, hit.Killed)
	local visual = hit.Model and enemyVisuals[hit.Model]
	if visual and visual.Body then
		visual.FlashUntil = os.clock() + FX.HitFlashTime
		visual.Body.Color = Color3.new(1, 1, 1)
	end
end

local function onCombatFx(attack)
	if type(attack) ~= "table" or type(attack.Hits) ~= "table" or typeof(attack.Origin) ~= "Vector3" then
		return
	end
	local weapon = WeaponConfig[attack.WeaponId]
	local color = weapon and weapon.Color or Color3.new(1, 1, 1)
	local origin = (rootPosition() or attack.Origin) + Vector3.new(0, 1.2, 0)
	Sfx.Play("Attack", 0.95 + math.random() * 0.15)
	for index, hit in attack.Hits do
		if typeof(hit.Position) ~= "Vector3" then
			continue
		end
		local blade = acquireBlade(color)
		blade.From = origin
		blade.To = hit.Position + Vector3.new(0, 0.8, 0)
		blade.Start = os.clock() + (index - 1) * 0.04
		blade.Hit = hit
		blade.Spin = math.random() * math.pi
		blade.Part.CFrame = CFrame.lookAt(blade.From, blade.To)
		blade.Part.Parent = effectsFolder
		blade.Trail:Clear()
		blade.Trail.Enabled = true
		table.insert(blades, blade)
	end
	task.delay(FX.BladeTravelTime, function()
		Sfx.Play("Hit", 0.9 + math.random() * 0.2)
	end)
end

------------------------------------------------------------- Enemigos
local function trackEnemy(model: Instance)
	if not model:IsA("Model") or enemyVisuals[model] then
		return
	end
	local body = model:FindFirstChild("Body") :: BasePart?
	local weld = body and body:FindFirstChild("BodyWeld") :: Weld?
	local mesh = body and body:FindFirstChild("BodyMesh") :: SpecialMesh?
	local root = model:FindFirstChild("Root")
	local bar = root and root:FindFirstChild("HealthBar")
	local fill = bar and bar:FindFirstChild("Back") and bar.Back:FindFirstChild("Fill") :: Frame?

	local visual: EnemyVisual = {
		Model = model,
		Weld = weld,
		BaseC0 = weld and weld.C0 or CFrame.new(),
		Mesh = mesh,
		Body = body,
		BodyColor = body and body.Color or Color3.new(1, 1, 1),
		Fill = fill,
		Phase = math.random() * math.pi * 2,
		FlashUntil = 0,
		Connection = nil,
	}
	local function updateBar()
		local health = model:GetAttribute("Health")
		local maxHealth = model:GetAttribute("MaxHealth")
		if fill and type(health) == "number" and type(maxHealth) == "number" and maxHealth > 0 then
			fill.Size = UDim2.fromScale(math.clamp(health / maxHealth, 0, 1), 1)
		end
	end
	visual.Connection = model:GetAttributeChangedSignal("Health"):Connect(updateBar)
	updateBar()
	enemyVisuals[model] = visual
end

local function untrackEnemy(model: Instance)
	local visual = enemyVisuals[model :: Model]
	if visual then
		if visual.Connection then
			visual.Connection:Disconnect()
		end
		enemyVisuals[model :: Model] = nil
	end
end

local function onEnemyDied(info)
	if type(info) ~= "table" or typeof(info.Position) ~= "Vector3" then
		return
	end
	local color = if typeof(info.Color) == "Color3" then info.Color else Color3.fromRGB(150, 80, 230)
	emitAt(burstEmitter, info.Position, FX.DeathBurstParticles, color)
	Sfx.Play("EnemyDeath", 0.9 + math.random() * 0.25)
end

------------------------------------------------------------------- Gemas
local function trackGem(part: Instance)
	if part:IsA("BasePart") and not gemVisuals[part] then
		gemVisuals[part] = { Part = part, Base = part.CFrame, Phase = math.random() * math.pi * 2 }
	end
end

local function untrackGem(part: Instance)
	gemVisuals[part :: BasePart] = nil
end

local function onGemCollected(info)
	if type(info) ~= "table" or type(info.Positions) ~= "table" then
		return
	end
	local now = os.clock()
	gemCombo = if now < gemComboUntil then math.min(gemCombo + 1, 12) else 0
	gemComboUntil = now + 0.6
	Sfx.Play("GemPickup", 1 + gemCombo * 0.05)
	for index, position in info.Positions do
		if typeof(position) ~= "Vector3" or index > 12 then
			continue
		end
		local part = Instance.new("Part")
		part.Size = Vector3.new(0.6, 0.9, 0.6)
		part.Material = Enum.Material.Neon
		part.Color = Color3.fromRGB(80, 240, 255)
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.CFrame = CFrame.new(position)
		part.Parent = effectsFolder
		table.insert(flyingGems, { Part = part, From = position, Start = now })
	end
end

-------------------------------------------------------------- Jugador
local function onLevelUp()
	local position = rootPosition()
	Sfx.Play("LevelUp")
	if position == nil then
		return
	end
	emitAt(sparkleEmitter, position, 40)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.3, 4, 4)
	ring.CFrame = CFrame.new(position - Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(255, 214, 90)
	ring.Transparency = 0.2
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Parent = effectsFolder
	TweenService:Create(ring, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.3, 26, 26),
		Transparency = 1,
	}):Play()
	task.delay(0.65, function()
		ring:Destroy()
	end)
end

local highlightToken = 0
local function onPlayerDamaged()
	Sfx.Play("PlayerHurt", 0.95 + math.random() * 0.1)
	local character = player.Character
	if character == nil then
		return
	end
	highlightToken += 1
	local token = highlightToken
	damageHighlight.Adornee = character
	damageHighlight.Enabled = true
	task.delay(0.15, function()
		if token == highlightToken then
			damageHighlight.Enabled = false
		end
	end)
end

--------------------------------------------------------- Bucle visual
local function update()
	local now = os.clock()

	-- Hojas en vuelo (arco ligero + giro).
	for index = #blades, 1, -1 do
		local blade = blades[index]
		local t = (now - blade.Start) / FX.BladeTravelTime
		if t >= 1 then
			table.remove(blades, index)
			onBladeArrived(blade)
			releaseBlade(blade)
		elseif t >= 0 then
			local position = blade.From:Lerp(blade.To, t) + Vector3.new(0, math.sin(t * math.pi) * 1.5, 0)
			blade.Part.CFrame = CFrame.lookAt(position, blade.To) * CFrame.Angles(0, 0, blade.Spin + t * 8)
		end
	end

	-- Gemas recogidas volando hacia el jugador.
	local target = rootPosition()
	for index = #flyingGems, 1, -1 do
		local gem = flyingGems[index]
		local t = (now - gem.Start) / FX.GemFlyTime
		if t >= 1 or target == nil then
			gem.Part:Destroy()
			table.remove(flyingGems, index)
		else
			gem.Part.CFrame = CFrame.new(gem.From:Lerp(target :: Vector3, t * t)) * CFrame.Angles(0, t * 10, 0)
			gem.Part.Size = Vector3.new(0.6, 0.9, 0.6) * (1 - t * 0.6)
		end
	end

	-- Rebote de los slimes (solo visual, sobre la soldadura del cuerpo).
	for model, visual in enemyVisuals do
		if model.Parent == nil then
			untrackEnemy(model)
			continue
		end
		local wave = math.sin(now * 7 + visual.Phase)
		if visual.Weld then
			visual.Weld.C0 = visual.BaseC0 * CFrame.new(0, math.abs(wave) * 0.45, 0)
		end
		if visual.Mesh then
			local squash = wave * 0.08
			visual.Mesh.Scale = Vector3.new(1 + squash, 1 - squash, 1 + squash)
		end
		if visual.Body and visual.FlashUntil > 0 and now >= visual.FlashUntil then
			visual.FlashUntil = 0
			visual.Body.Color = visual.BodyColor
		end
	end

	-- Gemas en el suelo: giro y flotación.
	for part, visual in gemVisuals do
		if part.Parent == nil then
			gemVisuals[part] = nil
			continue
		end
		part.CFrame = visual.Base
			* CFrame.new(0, math.sin(now * 3 + visual.Phase) * 0.25, 0)
			* CFrame.Angles(0, now * 2.5, 0)
	end
end

function CombatEffectsController.Init(_controllers) end

function CombatEffectsController.Start()
	effectsFolder = Instance.new("Folder")
	effectsFolder.Name = "ClientEffects"
	effectsFolder.Parent = Workspace

	anchorPart = Instance.new("Part")
	anchorPart.Name = "FxAnchor"
	anchorPart.Size = Vector3.new(0.2, 0.2, 0.2)
	anchorPart.Transparency = 1
	anchorPart.Anchored = true
	anchorPart.CanCollide = false
	anchorPart.CanQuery = false
	anchorPart.CanTouch = false
	anchorPart.Parent = effectsFolder
	numbersAnchor = anchorPart:Clone()
	numbersAnchor.Name = "NumbersAnchor"
	numbersAnchor.CFrame = CFrame.new()
	numbersAnchor.Parent = effectsFolder

	hitEmitter = makeEmitter("HitSparks", {
		Color = ColorSequence.new(Color3.fromRGB(180, 250, 255), Color3.new(1, 1, 1)),
		Size = NumberSequence.new(0.6, 0),
		Lifetime = NumberRange.new(0.2, 0.35),
		Speed = NumberRange.new(12, 20),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 6,
	})
	burstEmitter = makeEmitter("DeathBurst", {
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.1), NumberSequenceKeypoint.new(1, 0) }),
		Lifetime = NumberRange.new(0.35, 0.6),
		Speed = NumberRange.new(10, 18),
		SpreadAngle = Vector2.new(180, 180),
		Acceleration = Vector3.new(0, -30, 0),
		Drag = 3,
	})
	sparkleEmitter = makeEmitter("LevelSparkles", {
		Color = ColorSequence.new(Color3.fromRGB(255, 220, 110), Color3.fromRGB(120, 240, 255)),
		Size = NumberSequence.new(0.8, 0),
		Lifetime = NumberRange.new(0.6, 1),
		Speed = NumberRange.new(6, 14),
		SpreadAngle = Vector2.new(60, 60),
		EmissionDirection = Enum.NormalId.Top,
		Acceleration = Vector3.new(0, 8, 0),
	})

	damageHighlight = Instance.new("Highlight")
	damageHighlight.Name = "DamageHighlight"
	damageHighlight.FillColor = Color3.fromRGB(255, 60, 60)
	damageHighlight.FillTransparency = 0.45
	damageHighlight.OutlineTransparency = 1
	damageHighlight.DepthMode = Enum.HighlightDepthMode.Occluded
	damageHighlight.Enabled = false
	damageHighlight.Parent = effectsFolder

	Sfx.Preload()

	local enemies = Workspace:WaitForChild("ActiveEnemies")
	enemies.ChildAdded:Connect(trackEnemy)
	enemies.ChildRemoved:Connect(untrackEnemy)
	for _, child in enemies:GetChildren() do
		trackEnemy(child)
	end
	local orbs = Workspace:WaitForChild("ExperienceOrbs")
	orbs.ChildAdded:Connect(trackGem)
	orbs.ChildRemoved:Connect(untrackGem)
	for _, child in orbs:GetChildren() do
		trackGem(child)
	end

	Net.CombatFx.OnClientEvent:Connect(onCombatFx)
	Net.EnemyDied.OnClientEvent:Connect(onEnemyDied)
	Net.GemCollected.OnClientEvent:Connect(onGemCollected)
	Net.LevelUp.OnClientEvent:Connect(onLevelUp)
	Net.PlayerDamaged.OnClientEvent:Connect(onPlayerDamaged)

	RunService.RenderStepped:Connect(update)
end

return CombatEffectsController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">GameOverController</string>
            <string name="Source"><![CDATA[--[[
	GameOverController
	Pantalla de derrota (StarterGui equivalente: GameOverScreen): tiempo
	sobrevivido, enemigos derrotados, nivel alcanzado y botón para volver a
	jugar. El servidor decide si el reinicio es válido. (La Fase 1 no tiene
	menú principal, por eso no se muestra el botón "Volver al menú".)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Net = require(Shared.Net)
local Theme = require(script.Parent.Parent.UI.Theme)
local Sfx = require(script.Parent.Parent.Util.Sfx)

local GameOverController = {}

local C = Theme.Colors
local New = Theme.New

local controllers
local gui: ScreenGui
local overlay: Frame
local panel: Frame
local values: { [string]: TextLabel } = {}
local restartButton: TextButton
local restartLabel: TextLabel
local shownAt = 0
local requested = false

local function tween(instance: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?)
	TweenService:Create(instance, TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
end

local function requestRestart()
	if not gui.Enabled or requested then
		return
	end
	-- Mismo enfriamiento que el servidor para evitar peticiones inútiles.
	if os.clock() - shownAt < GameConfig.Match.RestartCooldown then
		return
	end
	requested = true
	restartLabel.Text = "Cargando..."
	Sfx.Play("UiSelect")
	Net.RequestRestart:FireServer()
	-- Si el servidor no responde (petición rechazada), se permite reintentar.
	task.delay(3, function()
		if gui.Enabled and requested then
			requested = false
			restartLabel.Text = controllers.InputController.IsTouchOnly() and "VOLVER A JUGAR" or "VOLVER A JUGAR  [R]"
		end
	end)
end

local function hide()
	gui.Enabled = false
	requested = false
end

local function show(summary)
	if type(summary) ~= "table" then
		return
	end
	values.Time.Text = Theme.FormatTime(tonumber(summary.Elapsed) or 0)
	values.Kills.Text = tostring(tonumber(summary.Kills) or 0)
	values.Level.Text = tostring(tonumber(summary.Level) or 1)
	restartLabel.Text = controllers.InputController.IsTouchOnly() and "VOLVER A JUGAR" or "VOLVER A JUGAR  [R]"
	requested = false
	shownAt = os.clock()
	gui.Enabled = true
	overlay.BackgroundTransparency = 1
	panel.Position = UDim2.fromScale(0.5, 0.58)
	tween(overlay, 0.5, { BackgroundTransparency = 0.35 })
	tween(panel, 0.45, { Position = UDim2.fromScale(0.5, 0.5) }, Enum.EasingStyle.Back)
end

local function statRow(order: number, label: string, key: string)
	local row = New("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = C.PanelLight,
		BackgroundTransparency = 0.3,
		Parent = panel:FindFirstChild("Rows"),
	}, { Theme.Corner(8) })
	Theme.Label({
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(0.65, -14, 1, 0),
		Text = label,
		TextSize = 19,
		TextColor3 = C.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})
	values[key] = Theme.Label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 0),
		Size = UDim2.new(0.35, 0, 1, 0),
		Text = "-",
		Font = Theme.Fonts.Title,
		TextSize = 24,
		TextColor3 = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})
end

function GameOverController.Init(allControllers)
	controllers = allControllers
end

function GameOverController.Start()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui = Theme.ScreenGui("GameOverScreen", 20, playerGui)
	gui.Enabled = false

	overlay = New("Frame", {
		Name = "Overlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(20, 6, 18),
		BackgroundTransparency = 1,
		Active = true,
		Parent = gui,
	})
	panel = New("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(460, 400),
		BackgroundColor3 = C.Panel,
		Parent = gui,
	}, {
		Theme.Corner(16),
		Theme.Stroke(C.Danger, 3, 0.1),
		New("UIGradient", { Rotation = 90, Color = ColorSequence.new(C.PanelLight, C.Panel) }),
	})
	Theme.Scaled(panel)

	Theme.Label({
		Position = UDim2.fromOffset(0, 18),
		Size = UDim2.new(1, 0, 0, 52),
		Text = "HAS CAÍDO",
		Font = Theme.Fonts.Title,
		TextSize = 48,
		TextColor3 = C.Danger,
		TextStrokeTransparency = 0.3,
		Parent = panel,
	})
	Theme.Label({
		Position = UDim2.fromOffset(0, 70),
		Size = UDim2.new(1, 0, 0, 24),
		Text = "La isla reclama a otro aventurero...",
		TextSize = 17,
		TextColor3 = C.TextDim,
		Parent = panel,
	})
	New("Frame", {
		Name = "Rows",
		Position = UDim2.fromOffset(30, 108),
		Size = UDim2.new(1, -60, 0, 140),
		BackgroundTransparency = 1,
		Parent = panel,
	}, {
		New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }),
	})
	statRow(1, "Tiempo sobrevivido", "Time")
	statRow(2, "Enemigos derrotados", "Kills")
	statRow(3, "Nivel alcanzado", "Level")

	restartButton = New("TextButton", {
		Name = "RestartButton",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(320, 64),
		BackgroundColor3 = C.Gold,
		AutoButtonColor = true,
		Text = "",
		Parent = panel,
	}, {
		Theme.Corner(12),
		Theme.Stroke(C.Shadow, 3, 0.2),
	})
	restartLabel = Theme.Label({
		Size = UDim2.fromScale(1, 1),
		Text = "VOLVER A JUGAR",
		Font = Theme.Fonts.Title,
		TextSize = 26,
		TextColor3 = C.Shadow,
		TextStrokeTransparency = 1,
		Parent = restartButton,
	})
	restartButton.Activated:Connect(requestRestart)

	Net.GameOver.OnClientEvent:Connect(show)
	Net.HudUpdate.OnClientEvent:Connect(function(snapshot)
		-- Una partida nueva cierra la pantalla de derrota.
		if gui.Enabled and type(snapshot) == "table" and snapshot.Phase == "Playing" then
			hide()
		end
	end)
	controllers.InputController.Confirm:Connect(requestRestart)
end

return GameOverController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">HUDController</string>
            <string name="Source"><![CDATA[--[[
	HUDController
	Interfaz durante la partida (StarterGui equivalente: MainHUD):
	  • nivel, barra de experiencia, tiempo y enemigos derrotados (arriba),
	  • vida actual/máxima (arriba a la izquierda),
	  • panel de estadísticas plegable (Tab / C o botón táctil),
	  • rótulo de subida de nivel y viñeta roja al recibir daño.
	Solo muestra el estado que envía el servidor; no decide nada.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local Net = require(Shared.Net)
local Types = require(Shared.Types)
local Theme = require(script.Parent.Parent.UI.Theme)

local HUDController = {}

local C = Theme.Colors
local New = Theme.New

local controllers
local gui: ScreenGui
local refs: { [string]: any } = {}
local snapshot: Types.HudSnapshot? = nil
local elapsedBase = 0
local elapsedReceivedAt = 0
local lastShownSecond = -1
local statsVisible = true

local STAT_ROWS = {
	{ Key = "Damage", Label = "Daño", Format = "%.1f" },
	{ Key = "Cooldown", Label = "Enfriamiento", Format = "%.2f s" },
	{ Key = "Range", Label = "Alcance", Format = "%.1f" },
	{ Key = "Projectiles", Label = "Hojas", Format = "%d" },
	{ Key = "MoveSpeed", Label = "Velocidad", Format = "%.1f" },
	{ Key = "DamageReductionPct", Label = "Reducción daño", Format = "%.0f %%" },
	{ Key = "XpBonusPct", Label = "Bonus XP", Format = "+%.0f %%" },
	{ Key = "Luck", Label = "Suerte", Format = "%d" },
}

local function tween(instance: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?)
	local t = TweenService:Create(instance, TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

local function buildTopPanel()
	local panel = New("Frame", {
		Name = "TopPanel",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(560, 62),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Theme.Scaled(panel)

	local badge = New("Frame", {
		Name = "LevelBadge",
		Size = UDim2.fromOffset(62, 62),
		BackgroundColor3 = C.Panel,
		Parent = panel,
	}, {
		Theme.Corner(14),
		Theme.Stroke(C.Gold, 3, 0),
	})
	Theme.Label({
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.fromOffset(0, 5),
		Text = "NIVEL",
		Font = Theme.Fonts.Bold,
		TextSize = 12,
		TextColor3 = C.Gold,
		Parent = badge,
	})
	refs.Level = Theme.Label({
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.fromOffset(0, 21),
		Text = "1",
		Font = Theme.Fonts.Title,
		TextSize = 30,
		Parent = badge,
	})

	local xpBar, xpFill, xpText = Theme.Bar({
		Name = "XpBar",
		Position = UDim2.fromOffset(72, 4),
		Size = UDim2.new(1, -72, 0, 24),
		Parent = panel,
	}, C.Xp, C.XpDark)
	refs.XpBar, refs.XpFill, refs.XpText = xpBar, xpFill, xpText

	local infoRow = New("Frame", {
		Name = "InfoRow",
		Position = UDim2.fromOffset(72, 32),
		Size = UDim2.new(1, -72, 0, 28),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.25,
		Parent = panel,
	}, { Theme.Corner(8) })
	refs.Timer = Theme.Label({
		Size = UDim2.new(0.5, -8, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		Text = "⏱ 00:00",
		Font = Theme.Fonts.Bold,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = infoRow,
	})
	refs.Kills = Theme.Label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 0),
		Size = UDim2.new(0.5, -8, 1, 0),
		Text = "☠ 0",
		Font = Theme.Fonts.Bold,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = infoRow,
	})
end

-- Columna izquierda escalada: vida + estadísticas (sin solaparse a ninguna escala).
local function buildLeftColumn()
	refs.LeftColumn = New("Frame", {
		Name = "LeftColumn",
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.fromOffset(250, 300),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		New("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
		}),
	})
	Theme.Scaled(refs.LeftColumn)
end

local function buildHealthPanel()
	local panel = New("Frame", {
		Name = "HealthPanel",
		LayoutOrder = 1,
		Size = UDim2.fromOffset(250, 40),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.15,
		Parent = refs.LeftColumn,
	}, {
		Theme.Corner(10),
		Theme.Stroke(C.PanelStroke, 2, 0.4),
	})
	Theme.Label({
		Size = UDim2.fromOffset(34, 40),
		Text = "❤",
		TextSize = 22,
		TextColor3 = C.Health,
		Parent = panel,
	})
	local bar, fill, text = Theme.Bar({
		Name = "HealthBar",
		Position = UDim2.fromOffset(36, 8),
		Size = UDim2.new(1, -46, 0, 24),
		Parent = panel,
	}, C.Health, C.HealthDark)
	refs.HealthBar, refs.HealthFill, refs.HealthText = bar, fill, text
end

local function buildStatsPanel()
	local panel = New("Frame", {
		Name = "StatsPanel",
		LayoutOrder = 2,
		Size = UDim2.fromOffset(210, 36 + #STAT_ROWS * 22),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.2,
		Parent = refs.LeftColumn,
	}, {
		Theme.Corner(10),
		Theme.Stroke(C.PanelStroke, 2, 0.5),
	})

	local header = New("TextButton", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 1,
		Text = "",
		Parent = panel,
	})
	refs.StatsHeaderLabel = Theme.Label({
		Size = UDim2.new(1, -16, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		Text = "ESTADÍSTICAS  ▾",
		Font = Theme.Fonts.Title,
		TextSize = 16,
		TextColor3 = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = header,
	})
	header.Activated:Connect(function()
		HUDController.ToggleStats()
	end)

	local rows = New("Frame", {
		Name = "Rows",
		Position = UDim2.fromOffset(10, 30),
		Size = UDim2.new(1, -20, 0, #STAT_ROWS * 22),
		BackgroundTransparency = 1,
		Parent = panel,
	}, {
		New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	refs.StatValues = {}
	for index, row in STAT_ROWS do
		local line = New("Frame", {
			LayoutOrder = index,
			Size = UDim2.new(1, 0, 0, 22),
			BackgroundTransparency = 1,
			Parent = rows,
		})
		Theme.Label({
			Size = UDim2.fromScale(0.62, 1),
			Text = row.Label,
			TextSize = 15,
			TextColor3 = C.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = line,
		})
		refs.StatValues[row.Key] = Theme.Label({
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.fromScale(0.38, 1),
			Text = "-",
			Font = Theme.Fonts.Bold,
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = line,
		})
	end
	refs.StatsPanel = panel
	refs.StatsRows = rows
end

local function buildBannerAndVignette()
	refs.Banner = Theme.Label({
		Name = "LevelUpBanner",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(600, 80),
		Text = "",
		Font = Theme.Fonts.Title,
		TextSize = 54,
		TextColor3 = C.Gold,
		TextStrokeTransparency = 0.2,
		TextTransparency = 1,
		Parent = gui,
	})
	Theme.Scaled(refs.Banner)

	-- Viñeta: cuatro bordes rojos con degradado hacia el centro.
	local vignette = New("Frame", {
		Name = "DamageVignette",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	local edges = {
		{ UDim2.fromScale(1, 0.22), UDim2.fromScale(0, 0), 90 },
		{ UDim2.fromScale(1, 0.22), UDim2.fromScale(0, 0.78), -90 },
		{ UDim2.fromScale(0.16, 1), UDim2.fromScale(0, 0), 0 },
		{ UDim2.fromScale(0.16, 1), UDim2.fromScale(0.84, 0), 180 },
	}
	for _, edge in edges do
		New("Frame", {
			Size = edge[1],
			Position = edge[2],
			BackgroundColor3 = C.Danger,
			BorderSizePixel = 0,
			Parent = vignette,
		}, {
			New("UIGradient", {
				Rotation = edge[3],
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.35),
					NumberSequenceKeypoint.new(1, 1),
				}),
			}),
		})
	end
	refs.Vignette = vignette
end

function HUDController.ToggleStats()
	statsVisible = not statsVisible
	refs.StatsRows.Visible = statsVisible
	refs.StatsPanel.Size = UDim2.fromOffset(210, if statsVisible then 36 + #STAT_ROWS * 22 else 30)
	refs.StatsHeaderLabel.Text = if statsVisible then "ESTADÍSTICAS  ▾" else "ESTADÍSTICAS  ▸"
end

local function applySnapshot(data: Types.HudSnapshot)
	local previous = snapshot
	snapshot = data
	elapsedBase = data.Elapsed
	elapsedReceivedAt = os.clock()

	refs.Level.Text = tostring(data.Level)
	local xpRatio = math.clamp(data.Xp / math.max(data.XpToNext, 1), 0, 1)
	if previous and previous.Level ~= data.Level then
		refs.XpFill.Size = UDim2.fromScale(0, 1)
	end
	tween(refs.XpFill, 0.15, { Size = UDim2.fromScale(xpRatio, 1) })
	refs.XpText.Text = string.format("XP  %d / %d", math.floor(data.Xp), data.XpToNext)

	local healthRatio = math.clamp(data.Health / math.max(data.MaxHealth, 1), 0, 1)
	tween(refs.HealthFill, 0.12, { Size = UDim2.fromScale(healthRatio, 1) })
	refs.HealthText.Text = string.format("%d / %d", math.ceil(data.Health), math.floor(data.MaxHealth))

	refs.Kills.Text = "☠ " .. data.Kills

	for _, row in STAT_ROWS do
		local value = (data.Stats :: any)[row.Key]
		if type(value) == "number" then
			refs.StatValues[row.Key].Text = string.format(row.Format, value)
		end
	end
end

local function showLevelBanner(level: number)
	local banner = refs.Banner
	banner.Text = "¡NIVEL " .. level .. "!"
	banner.TextTransparency = 0
	banner.TextStrokeTransparency = 0.2
	banner.Size = UDim2.fromOffset(420, 60)
	tween(banner, 0.25, { Size = UDim2.fromOffset(600, 80) }, Enum.EasingStyle.Back)
	task.delay(GameConfig.Effects.LevelUpBannerTime, function()
		if banner.Text == "¡NIVEL " .. level .. "!" then
			tween(banner, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
	end)
end

local vignetteToken = 0
local function flashVignette()
	vignetteToken += 1
	local token = vignetteToken
	refs.Vignette.Visible = true
	task.delay(GameConfig.Effects.DamageVignetteTime, function()
		if token == vignetteToken then
			refs.Vignette.Visible = false
		end
	end)
end

function HUDController.GetSnapshot(): Types.HudSnapshot?
	return snapshot
end

function HUDController.Init(allControllers)
	controllers = allControllers
end

function HUDController.Start()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui = Theme.ScreenGui("MainHUD", 1, playerGui)
	buildTopPanel()
	buildLeftColumn()
	buildHealthPanel()
	buildStatsPanel()
	buildBannerAndVignette()
	if controllers.InputController.IsTouchOnly() then
		HUDController.ToggleStats() -- plegado por defecto en móvil
	end

	controllers.InputController.ToggleStats:Connect(HUDController.ToggleStats)
	Net.HudUpdate.OnClientEvent:Connect(applySnapshot)
	Net.LevelUp.OnClientEvent:Connect(function(info)
		if type(info) == "table" and type(info.Level) == "number" then
			showLevelBanner(info.Level)
		end
	end)
	Net.PlayerDamaged.OnClientEvent:Connect(flashVignette)

	-- El tiempo se extrapola localmente entre actualizaciones del servidor.
	RunService.RenderStepped:Connect(function()
		local data = snapshot
		if data == nil then
			return
		end
		local elapsed = elapsedBase
		if data.Phase == "Playing" then
			elapsed += os.clock() - elapsedReceivedAt
		end
		local second = math.floor(elapsed)
		if second ~= lastShownSecond then
			lastShownSecond = second
			refs.Timer.Text = "⏱ " .. Theme.FormatTime(elapsed)
		end
	end)
end

return HUDController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">InputController</string>
            <string name="Source"><![CDATA[--[[
	InputController
	Atajos de teclado y mando para la interfaz. El movimiento, el salto y la
	cámara usan los controles estándar de Roblox (teclado/ratón, joystick y
	botón de salto táctiles), que ya cumplen los requisitos.

	Señales:
	  SelectOption(index)  teclas 1/2/3 (o botones X/Y/B del mando)
	  Confirm()            Enter / R / botón A (reiniciar tras la derrota)
	  ToggleStats()        Tab / C
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Signal = require(ReplicatedStorage.Shared.Signal)

local InputController = {}

InputController.SelectOption = Signal.new()
InputController.Confirm = Signal.new()
InputController.ToggleStats = Signal.new()

local OPTION_KEYS: { [Enum.KeyCode]: number } = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.KeypadOne] = 1,
	[Enum.KeyCode.KeypadTwo] = 2,
	[Enum.KeyCode.KeypadThree] = 3,
	[Enum.KeyCode.ButtonX] = 1,
	[Enum.KeyCode.ButtonY] = 2,
	[Enum.KeyCode.ButtonB] = 3,
}

local CONFIRM_KEYS: { [Enum.KeyCode]: boolean } = {
	[Enum.KeyCode.Return] = true,
	[Enum.KeyCode.KeypadEnter] = true,
	[Enum.KeyCode.R] = true,
	[Enum.KeyCode.ButtonA] = true,
}

local STATS_KEYS: { [Enum.KeyCode]: boolean } = {
	[Enum.KeyCode.Tab] = true,
	[Enum.KeyCode.C] = true,
}

-- Dispositivo táctil sin teclado (móvil/tableta).
function InputController.IsTouchOnly(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

function InputController.Init(_controllers) end

function InputController.Start()
	UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
		if gameProcessed then
			return -- escribiendo en el chat, etc.
		end
		local key = input.KeyCode
		local option = OPTION_KEYS[key]
		if option then
			InputController.SelectOption:Fire(option)
		elseif CONFIRM_KEYS[key] then
			InputController.Confirm:Fire()
		elseif STATS_KEYS[key] then
			InputController.ToggleStats:Fire()
		end
	end)
end

return InputController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">UpgradeController</string>
            <string name="Source"><![CDATA[--[[
	UpgradeController
	Pantalla de subida de nivel (StarterGui equivalente: UpgradeSelection).
	Muestra las opciones que envía el servidor y devuelve SOLO el token de la
	oferta y el id elegido. Los textos se leen de UpgradeConfig únicamente
	para mostrarlos. Admite ratón, toque y teclas 1/2/3.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local UpgradeConfig = require(Shared.Config.UpgradeConfig)
local Net = require(Shared.Net)
local Types = require(Shared.Types)
local Theme = require(script.Parent.Parent.UI.Theme)
local Sfx = require(script.Parent.Parent.Util.Sfx)

local UpgradeController = {}

local C = Theme.Colors
local New = Theme.New

local CARD_WIDTH, CARD_HEIGHT = 270, 340

local controllers
local gui: ScreenGui
local overlay: Frame
local container: Frame
local title: TextLabel
local subtitle: TextLabel
local cardRow: Frame
local hint: TextLabel

type Card = { Button: TextButton, Scale: UIScale, Stroke: UIStroke, Id: string }

local cards: { Card } = {}
local activeOffer: Types.OfferPayload? = nil
local waitingResponse = false

local function tween(instance: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?)
	local t = TweenService:Create(instance, TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

local function clearCards()
	for _, card in cards do
		card.Button:Destroy()
	end
	table.clear(cards)
end

local function setCardsEnabled(enabled: boolean)
	for _, card in cards do
		card.Button.Active = enabled
		card.Button.AutoButtonColor = false
		card.Stroke.Transparency = if enabled then 0 else 0.5
	end
end

local function choose(index: number)
	local offer = activeOffer
	local card = cards[index]
	if offer == nil or card == nil or waitingResponse then
		return
	end
	waitingResponse = true
	setCardsEnabled(false)
	Sfx.Play("UiSelect")
	tween(card.Scale, 0.12, { Scale = 1.08 }, Enum.EasingStyle.Back)
	Net.ChooseUpgrade:FireServer(offer.Token, card.Id)
end

local function levelText(option: Types.OfferOptionPayload, def: Types.UpgradeDef): string
	if def.IsFallback then
		return "Bendición instantánea"
	end
	if option.CurrentLevel == 0 then
		return "¡NUEVA!"
	end
	local maxText = if def.MaxLevel then " / " .. def.MaxLevel else ""
	return string.format("Nv. %d → %d%s", option.CurrentLevel, option.NextLevel, maxText)
end

local function buildCard(index: number, option: Types.OfferOptionPayload, showKeys: boolean): Card?
	local def = UpgradeConfig.ById[option.Id]
	if def == nil then
		return nil -- id desconocido para este cliente: no se muestra
	end
	local rarity = UpgradeConfig.Rarities[def.Rarity]
	local rarityColor = rarity and rarity.Color or C.PanelStroke

	local button = New("TextButton", {
		Name = "Card" .. index,
		LayoutOrder = index,
		Size = UDim2.fromOffset(CARD_WIDTH, CARD_HEIGHT),
		BackgroundColor3 = C.Panel,
		AutoButtonColor = false,
		Text = "",
		Selectable = true,
		Parent = cardRow,
	}, {
		Theme.Corner(14),
		New("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(C.PanelLight, C.Panel),
		}),
	})
	local stroke = Theme.Stroke(rarityColor, 3, 0)
	stroke.Parent = button
	local scale = New("UIScale", { Scale = 0.85, Parent = button })

	New("Frame", {
		Name = "RarityBand",
		Size = UDim2.new(1, -24, 0, 6),
		Position = UDim2.fromOffset(12, 10),
		BackgroundColor3 = rarityColor,
		BorderSizePixel = 0,
		Parent = button,
	}, { Theme.Corner(3) })

	local iconCircle = New("Frame", {
		Name = "Icon",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 26),
		Size = UDim2.fromOffset(76, 76),
		BackgroundColor3 = rarityColor:Lerp(C.Panel, 0.55),
		Parent = button,
	}, {
		New("UICorner", { CornerRadius = UDim.new(1, 0) }),
		Theme.Stroke(rarityColor, 2, 0.1),
	})
	Theme.Label({
		Size = UDim2.fromScale(1, 1),
		Text = def.Icon,
		TextSize = 38,
		Font = Theme.Fonts.Bold,
		Parent = iconCircle,
	})

	Theme.Label({
		Name = "UpgradeName",
		Position = UDim2.fromOffset(12, 108),
		Size = UDim2.new(1, -24, 0, 32),
		Text = def.DisplayName,
		Font = Theme.Fonts.Title,
		TextSize = 25,
		TextWrapped = true,
		Parent = button,
	})
	Theme.Label({
		Name = "Rarity",
		Position = UDim2.fromOffset(12, 140),
		Size = UDim2.new(1, -24, 0, 20),
		Text = string.format("%s · %s", rarity and rarity.DisplayName or def.Rarity, def.Category),
		Font = Theme.Fonts.Bold,
		TextSize = 16,
		TextColor3 = rarityColor,
		Parent = button,
	})
	Theme.Label({
		Name = "Description",
		Position = UDim2.fromOffset(16, 170),
		Size = UDim2.new(1, -32, 0, 110),
		Text = def.Description,
		TextSize = 19,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = C.Text,
		Parent = button,
	})
	New("Frame", {
		Name = "LevelTag",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.new(1, -36, 0, 34),
		BackgroundColor3 = C.Shadow,
		BackgroundTransparency = 0.3,
		Parent = button,
	}, {
		Theme.Corner(8),
		Theme.Label({
			Size = UDim2.fromScale(1, 1),
			Text = levelText(option, def),
			Font = Theme.Fonts.Bold,
			TextSize = 17,
			TextColor3 = if option.CurrentLevel == 0 then C.Gold else C.Text,
		}),
	})
	if showKeys then
		New("Frame", {
			Name = "KeyHint",
			Position = UDim2.fromOffset(10, 22),
			Size = UDim2.fromOffset(30, 30),
			BackgroundColor3 = C.Shadow,
			Parent = button,
		}, {
			Theme.Corner(8),
			Theme.Stroke(C.TextDim, 1, 0.3),
			Theme.Label({
				Size = UDim2.fromScale(1, 1),
				Text = tostring(index),
				Font = Theme.Fonts.Bold,
				TextSize = 17,
			}),
		})
	end

	local card: Card = { Button = button, Scale = scale, Stroke = stroke, Id = def.Id }
	button.MouseEnter:Connect(function()
		if button.Active and not waitingResponse then
			Sfx.Play("UiHover", 1.1)
			tween(scale, 0.12, { Scale = 1.05 })
		end
	end)
	button.MouseLeave:Connect(function()
		if not waitingResponse then
			tween(scale, 0.12, { Scale = 1 })
		end
	end)
	button.Activated:Connect(function()
		local position = table.find(cards, card)
		if position then
			choose(position)
		end
	end)
	return card
end

local function hide()
	activeOffer = nil
	waitingResponse = false
	if not gui.Enabled then
		return
	end
	tween(overlay, 0.2, { BackgroundTransparency = 1 })
	tween(container, 0.2, { Position = UDim2.fromScale(0.5, 0.56) })
	task.delay(0.2, function()
		if activeOffer == nil then
			gui.Enabled = false
			clearCards()
		end
	end)
end

local function show(offer: Types.OfferPayload)
	if type(offer) ~= "table" or type(offer.Token) ~= "number" or type(offer.Options) ~= "table" then
		return
	end
	clearCards()
	activeOffer = offer
	waitingResponse = false
	local showKeys = not controllers.InputController.IsTouchOnly()

	title.Text = "¡SUBISTE DE NIVEL!"
	subtitle.Text = string.format("Nivel %d · Elige una mejora", offer.Level)
	hint.Visible = showKeys
	for index, option in offer.Options do
		local card = buildCard(index, option, showKeys)
		if card then
			table.insert(cards, card)
		end
	end

	gui.Enabled = true
	overlay.BackgroundTransparency = 1
	container.Position = UDim2.fromScale(0.5, 0.56)
	tween(overlay, 0.25, { BackgroundTransparency = 0.4 })
	tween(container, 0.3, { Position = UDim2.fromScale(0.5, 0.5) }, Enum.EasingStyle.Back)
	for index, card in cards do
		task.delay((index - 1) * GameConfig.Effects.UpgradeCardStagger, function()
			if card.Button.Parent then
				tween(card.Scale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
			end
		end)
	end
end

local function onResolved(result)
	if type(result) ~= "table" then
		return
	end
	local offer = activeOffer
	if offer == nil or result.Token ~= offer.Token then
		return
	end
	if result.Accepted then
		hide()
	else
		-- Rechazada (p. ej. petición repetida): se permite volver a elegir.
		waitingResponse = false
		setCardsEnabled(true)
		for _, card in cards do
			tween(card.Scale, 0.1, { Scale = 1 })
		end
	end
end

function UpgradeController.IsOpen(): boolean
	return activeOffer ~= nil
end

function UpgradeController.Init(allControllers)
	controllers = allControllers
end

function UpgradeController.Start()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui = Theme.ScreenGui("UpgradeSelection", 10, playerGui)
	gui.Enabled = false

	overlay = New("Frame", {
		Name = "Overlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		Active = true, -- bloquea clics al mundo mientras se elige
		Parent = gui,
	})
	container = New("Frame", {
		Name = "Container",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(3 * CARD_WIDTH + 2 * 20, 470),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Theme.Scaled(container)
	title = Theme.Label({
		Size = UDim2.new(1, 0, 0, 56),
		Text = "",
		Font = Theme.Fonts.Title,
		TextSize = 46,
		TextColor3 = C.Gold,
		TextStrokeTransparency = 0.3,
		Parent = container,
	})
	subtitle = Theme.Label({
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 0, 26),
		Text = "",
		Font = Theme.Fonts.Bold,
		TextSize = 20,
		TextColor3 = C.Text,
		Parent = container,
	})
	cardRow = New("Frame", {
		Name = "Cards",
		Position = UDim2.fromOffset(0, 92),
		Size = UDim2.new(1, 0, 0, CARD_HEIGHT),
		BackgroundTransparency = 1,
		Parent = container,
	}, {
		New("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 20),
		}),
	})
	hint = Theme.Label({
		Position = UDim2.fromOffset(0, 92 + CARD_HEIGHT + 8),
		Size = UDim2.new(1, 0, 0, 24),
		Text = "Pulsa 1, 2 o 3 · o haz clic en una carta",
		TextSize = 16,
		TextColor3 = C.TextDim,
		Parent = container,
	})

	Net.UpgradeOffer.OnClientEvent:Connect(show)
	Net.UpgradeResolved.OnClientEvent:Connect(onResolved)
	Net.GameOver.OnClientEvent:Connect(function()
		if activeOffer then
			hide()
		end
	end)
	controllers.InputController.SelectOption:Connect(function(index: number)
		if activeOffer then
			choose(index)
		end
	end)
end

return UpgradeController
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="69">
        <Properties>
          <string name="Name">UI</string>
        </Properties>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">Theme</string>
            <string name="Source"><![CDATA[--[[
	Theme
	Estilo visual común (fantasía low-poly) y utilidades para construir la
	interfaz por código: colores, fuentes, esquinas, bordes y escalado
	adaptable a la resolución (PC y móvil).
]]

local Workspace = game:GetService("Workspace")

local Theme = {}

Theme.Colors = {
	Panel = Color3.fromRGB(22, 26, 52),
	PanelLight = Color3.fromRGB(36, 42, 82),
	PanelStroke = Color3.fromRGB(120, 140, 220),
	Gold = Color3.fromRGB(255, 208, 96),
	Text = Color3.fromRGB(240, 244, 255),
	TextDim = Color3.fromRGB(170, 182, 220),
	Xp = Color3.fromRGB(80, 230, 255),
	XpDark = Color3.fromRGB(20, 60, 90),
	Health = Color3.fromRGB(236, 72, 96),
	HealthDark = Color3.fromRGB(70, 20, 34),
	Danger = Color3.fromRGB(255, 70, 70),
	Shadow = Color3.fromRGB(8, 8, 20),
}

Theme.Fonts = {
	Title = Enum.Font.FredokaOne,
	Body = Enum.Font.GothamMedium,
	Bold = Enum.Font.GothamBold,
}

-- Resolución de diseño. La interfaz se escala para caber en pantallas pequeñas
-- sin que el texto baje de un tamaño legible.
local DESIGN_SIZE = Vector2.new(1280, 720)
local MIN_SCALE, MAX_SCALE = 0.72, 1.3

local scales: { UIScale } = {}
local currentScale = 1

-- Crea una instancia con propiedades e hijos.
function Theme.New(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Theme.Corner(radius: number?): UICorner
	return Theme.New("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function Theme.Stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return Theme.New("UIStroke", {
		Color = color or Theme.Colors.PanelStroke,
		Thickness = thickness or 2,
		Transparency = transparency or 0.2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Theme.Label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		TextColor3 = Theme.Colors.Text,
		Font = Theme.Fonts.Body,
		TextSize = 18,
		TextStrokeTransparency = 0.6,
		TextStrokeColor3 = Theme.Colors.Shadow,
	}
	for key, value in props do
		defaults[key] = value
	end
	return Theme.New("TextLabel", defaults)
end

-- Barra con fondo y relleno; devuelve (contenedor, relleno, texto).
function Theme.Bar(props: { [string]: any }, fillColor: Color3, backColor: Color3): (Frame, Frame, TextLabel)
	local container = Theme.New("Frame", props, {
		Theme.Corner(8),
		Theme.Stroke(Theme.Colors.Shadow, 2, 0.3),
	})
	container.BackgroundColor3 = backColor
	container.BorderSizePixel = 0
	local fill = Theme.New("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = fillColor,
		BorderSizePixel = 0,
		Parent = container,
	}, {
		Theme.Corner(8),
		Theme.New("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 0.25),
			}),
		}),
	})
	local text = Theme.Label({
		Name = "Text",
		Size = UDim2.fromScale(1, 1),
		Font = Theme.Fonts.Bold,
		TextSize = 16,
		ZIndex = 3,
		Parent = container,
	})
	return container, fill, text
end

-- ScreenGui estándar (no se reinicia al reaparecer y respeta zonas seguras).
function Theme.ScreenGui(name: string, displayOrder: number, parent: Instance): ScreenGui
	return Theme.New("ScreenGui", {
		Name = name,
		DisplayOrder = displayOrder,
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = parent,
	})
end

local function computeScale(): number
	local camera = Workspace.CurrentCamera
	local viewport = camera and camera.ViewportSize or DESIGN_SIZE
	local scale = math.min(viewport.X / DESIGN_SIZE.X, viewport.Y / DESIGN_SIZE.Y)
	return math.clamp(scale, MIN_SCALE, MAX_SCALE)
end

-- Añade un UIScale adaptable a un panel (no a overlays de pantalla completa).
function Theme.Scaled(panel: GuiObject): UIScale
	local uiScale = Theme.New("UIScale", { Scale = currentScale, Parent = panel })
	table.insert(scales, uiScale)
	return uiScale
end

function Theme.GetScale(): number
	return currentScale
end

function Theme.StartAutoScale()
	local function update()
		currentScale = computeScale()
		for index = #scales, 1, -1 do
			local uiScale = scales[index]
			if uiScale.Parent then
				uiScale.Scale = currentScale
			else
				table.remove(scales, index)
			end
		end
	end
	local function bindCamera()
		local camera = Workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
		end
		update()
	end
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)
	bindCamera()
end

function Theme.FormatTime(seconds: number): string
	local total = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", total // 60, total % 60)
end

return Theme

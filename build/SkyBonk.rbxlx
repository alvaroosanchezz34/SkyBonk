        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">EnemyConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	EnemyConfig
	Definición de criaturas. EnemyService usa la misma lógica para todas;
	una criatura nueva solo necesita su entrada aquí y un modelo en
	ServerStorage/EnemyModels (o un constructor en World/ModelFactory).
]]

local Types = require(script.Parent.Parent.Types)

local EnemyConfig: { [string]: Types.EnemyDef } = {
	VoidSlime = {
		Id = "VoidSlime",
		DisplayName = "Slime del Vacío",
		ModelName = "VoidSlime",
		MaxHealth = 35,
		ContactDamage = 5,
		MoveSpeed = 9, -- studs por segundo
		AttackRange = 3.6, -- distancia horizontal para golpear al jugador
		AttackCooldown = 1.0, -- segundos entre golpes del mismo slime
		XpReward = 1,
		Color = Color3.fromRGB(132, 72, 214),
	},
}

return EnemyConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	GameConfig
	Parámetros globales de la partida. Todo valor de balance o de presentación
	que pueda necesitar ajustes debe vivir aquí (o en WeaponConfig, EnemyConfig
	y UpgradeConfig), nunca repartido por los servicios.
]]

local GameConfig = {}

-- Geometría de la isla. El centro de la isla es el origen del mundo.
GameConfig.Map = {
	Center = Vector3.new(0, 0, 0),
	-- Radio (horizontal) de la zona jugable. Más allá empieza el borde/vacío.
	PlayableRadius = 100,
	-- Radio a partir del cual cualquier entidad se considera fuera de los límites.
	BoundsRadius = 135,
	-- Altura de la superficie principal.
	SurfaceY = 0,
	PlayerSpawn = Vector3.new(0, 3, 0),
	-- Si el personaje baja de esta altura se considera caída fuera del mapa.
	KillY = -45,
	-- Semilla del generador procedural de decoración (mapa determinista).
	Seed = 7331,
}

-- Estadísticas base del jugador (antes de mejoras).
GameConfig.Player = {
	BaseMaxHealth = 100,
	BaseWalkSpeed = 18,
	-- Distancia a la que se recogen las gemas de experiencia.
	PickupRadius = 7.5,
	-- Penalización al caer al vacío: porcentaje de la vida máxima.
	FallDamagePct = 0.25,
	-- Invulnerabilidad tras reaparecer por una caída (segundos de partida).
	FallInvulnerability = 1.5,
	-- Armas con las que empieza cada partida (ids de WeaponConfig).
	StartingWeapons = { "GaleSword" },
	-- Zoom inicial de la cámara en tercera persona (studs).
	CameraStartZoom = 24,
	CameraMinZoom = 10,
	CameraMaxZoom = 48,
	CameraFieldOfView = 72,
}

-- Curva de experiencia: xpToNext(n) = Base + Linear*(n-1) + Quadratic*(n-1)^2
-- Nv1→2: 5, Nv2→3: 8, Nv3→4: 12, Nv4→5: 17, Nv5→6: 23 ...
GameConfig.Progression = {
	BaseXp = 5,
	LinearXp = 2.5,
	QuadraticXp = 0.5,
}

-- Aparición de enemigos (SpawnService).
GameConfig.Spawn = {
	MaxActiveEnemies = 35,
	InitialInterval = 1.5, -- segundos entre oleadas al inicio
	MinInterval = 0.45, -- intervalo mínimo alcanzable
	IntervalMultiplierPerMinute = 0.8, -- el intervalo se multiplica por esto cada minuto
	InitialBatch = 1, -- enemigos por oleada al inicio
	BatchGrowthPerMinute = 0.75, -- enemigos extra por oleada por minuto
	MaxBatch = 5,
	MinRadius = 30, -- distancia mínima al jugador
	MaxRadius = 50, -- distancia máxima al jugador
	EdgeMargin = 6, -- distancia mínima al borde de la isla
	Attempts = 8, -- intentos para encontrar una posición válida por enemigo
	GracePeriod = 3, -- segundos sin enemigos al empezar la partida
	EnemyTypes = { "VoidSlime" },
}

-- Dificultad creciente según los minutos de partida (tiempo de juego, no real).
GameConfig.Difficulty = {
	HealthPerMinute = 0.08, -- +20 % de vida enemiga por minuto
	DamagePerMinute = 0.1, -- +10 % de daño enemigo por minuto
	SpeedPerMinute = 0.04, -- +4 % de velocidad enemiga por minuto
	MaxSpeedMultiplier = 1.45,
}

-- Experiencia y gemas (ExperienceService).
GameConfig.Experience = {
	GemLifetime = 60, -- segundos de partida antes de desaparecer
	MaxGemsPerRun = 120, -- si se supera, se elimina la gema más antigua
	PickupCheckInterval = 0.1, -- frecuencia de la comprobación de proximidad
	-- Gemas brillantes: dependen de la Suerte (mejora Fortuna Celeste).
	LuckyGemBaseChance = 0.02,
	LuckyGemChancePerLuck = 0.05,
	LuckyGemMultiplier = 3,
	MaxXpPerGrant = 1000, -- cota de seguridad por concesión
}

-- Combate (CombatService / EnemyService).
GameConfig.Combat = {
	-- Si un arma no encuentra objetivo, vuelve a buscar tras este tiempo.
	RetargetDelay = 0.15,
	-- Frecuencia de la IA de enemigos (movimiento y ataques).
	EnemyAiInterval = 0.1,
	-- Si un enemigo se desplaza menos que esto en StuckWindow, rodea el obstáculo.
	StuckDistance = 0.6,
	StuckWindow = 0.6,
	SidestepDuration = 0.7,
}

-- Seguridad de los RemoteEvents: máximo de peticiones por ventana (segundos).
GameConfig.RateLimits = {
	ClientReady = { Max = 3, Window = 5 },
	ChooseUpgrade = { Max = 6, Window = 1 },
	RequestRestart = { Max = 2, Window = 2 },
}

GameConfig.Match = {
	-- Tiempo mínimo entre la derrota y el reinicio.
	RestartCooldown = 1.0,
	-- Tiempo tras la derrota antes de limpiar enemigos y gemas.
	CleanupDelay = 2.0,
	-- Si el cliente no avisa de que está listo, la partida empieza igualmente.
	ClientReadyTimeout = 8,
	-- Frecuencia máxima de envío del HUD al cliente.
	HudSendInterval = 0.1,
	-- Frecuencia de la comprobación de caída.
	FallCheckInterval = 0.2,
}

-- Presentación (solo cliente).
GameConfig.Effects = {
	BladeTravelTime = 0.14,
	DamageNumberLifetime = 0.7,
	DeathBurstParticles = 14,
	HitFlashTime = 0.1,
	LevelUpBannerTime = 1.4,
	CameraShakeTime = 0.18,
	CameraShakeStrength = 0.25,
	DamageVignetteTime = 0.35,
	GemFlyTime = 0.18,
	UpgradeCardStagger = 0.07,
}

-- Sonidos incluidos con el propio cliente de Roblox (rbxasset://), sin recursos
-- externos. Pueden sustituirse por ids propios desde aquí.
GameConfig.Sounds = {
	Attack = { Id = "rbxasset://sounds/swordslash.wav", Volume = 0.35 },
	Hit = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.25 },
	EnemyDeath = { Id = "rbxasset://sounds/splat.wav", Volume = 0.35 },
	GemPickup = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.25 },
	LevelUp = { Id = "rbxasset://sounds/victory.wav", Volume = 0.4 },
	UiSelect = { Id = "rbxasset://sounds/button.wav", Volume = 0.5 },
	UiHover = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.25 },
	PlayerHurt = { Id = "rbxasset://sounds/uuhhh.mp3", Volume = 0.3 },
}

GameConfig.Debug = {
	-- Ejecuta las pruebas unitarias de ServerScriptService/Tests al iniciar en Studio.
	RunSelfTestsInStudio = true,
	-- Expone _G.SkyBonkDebug (solo en Studio) para forzar experiencia, etc.
	ExposeStudioDebugApi = true,
}

return GameConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">UpgradeConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	UpgradeConfig
	Catálogo de mejoras. El cliente solo envía el `Id` de la opción elegida;
	el servidor aplica `Effects` mediante StatSheet.applyEffects.

	Campos:
	  Id          identificador estable (nunca cambiar una vez publicado)
	  Rarity      Common/Rare/Epic -> peso base en Rarities
	  MaxLevel    veces que puede elegirse (nil = ilimitado)
	  Requires    requisito con nombre evaluado en UpgradeLogic.Requirements
	  Enabled     false -> nunca aparece (efecto aún sin mecánica real)
	  IsFallback  solo se ofrece cuando no hay suficientes opciones válidas
]]

local Types = require(script.Parent.Parent.Types)

local UpgradeConfig = {}

UpgradeConfig.OfferSize = 3

-- Peso base de cada rareza. La Suerte multiplica el peso de Rare y Epic por
-- (1 + Suerte * LuckRarityBonus).
UpgradeConfig.LuckRarityBonus = 0.25

UpgradeConfig.Rarities = {
	Common = { DisplayName = "Común", Weight = 100, Color = Color3.fromRGB(176, 196, 214), Order = 1 },
	Rare = { DisplayName = "Rara", Weight = 45, Color = Color3.fromRGB(84, 170, 255), Order = 2 },
	Epic = { DisplayName = "Épica", Weight = 16, Color = Color3.fromRGB(196, 110, 255), Order = 3 },
}

local list: { Types.UpgradeDef } = {
	{
		Id = "SharpEdge",
		DisplayName = "Filo Afilado",
		Description = "+15 % de daño de las armas.",
		Rarity = "Common",
		Category = "Ataque",
		Icon = "⚔",
		MaxLevel = 8,
		Effects = { { Op = "Add", Stat = "DamagePct", Value = 0.15 } },
	},
	{
		Id = "SwiftStrike",
		DisplayName = "Golpe Veloz",
		Description = "-10 % de enfriamiento de ataque.",
		Rarity = "Common",
		Category = "Ataque",
		Icon = "⚡",
		MaxLevel = 6,
		Effects = { { Op = "Mul", Stat = "CooldownMult", Value = 0.9 } },
	},
	{
		Id = "AstralReach",
		DisplayName = "Alcance Astral",
		Description = "+15 % de alcance de las armas.",
		Rarity = "Common",
		Category = "Ataque",
		Icon = "✦",
		MaxLevel = 5,
		Effects = { { Op = "Add", Stat = "RangePct", Value = 0.15 } },
	},
	{
		Id = "BasaltHeart",
		DisplayName = "Corazón de Basalto",
		Description = "+20 % de vida máxima (y te cura esa cantidad).",
		Rarity = "Common",
		Category = "Defensa",
		Icon = "❤",
		MaxLevel = 5,
		Effects = { { Op = "Add", Stat = "MaxHealthPct", Value = 0.2 } },
	},
	{
		Id = "HawkSteps",
		DisplayName = "Pasos del Halcón",
		Description = "+10 % de velocidad de movimiento.",
		Rarity = "Common",
		Category = "Movilidad",
		Icon = "➶",
		MaxLevel = 5,
		Effects = { { Op = "Add", Stat = "MoveSpeedPct", Value = 0.1 } },
	},
	{
		Id = "ConcentratedEssence",
		DisplayName = "Esencia Concentrada",
		Description = "+15 % de experiencia obtenida.",
		Rarity = "Rare",
		Category = "Utilidad",
		Icon = "◆",
		MaxLevel = 5,
		Effects = { { Op = "Add", Stat = "XpGainPct", Value = 0.15 } },
	},
	{
		Id = "StoneSkin",
		DisplayName = "Piel de Piedra",
		Description = "-10 % de daño recibido.",
		Rarity = "Rare",
		Category = "Defensa",
		Icon = "⛨",
		MaxLevel = 5,
		Effects = { { Op = "Mul", Stat = "DamageTakenMult", Value = 0.9 } },
	},
	{
		Id = "CelestialFortune",
		DisplayName = "Fortuna Celeste",
		Description = "+1 Suerte: más mejoras raras/épicas y más gemas brillantes (x3 XP).",
		Rarity = "Rare",
		Category = "Utilidad",
		Icon = "☘",
		MaxLevel = 5,
		Effects = { { Op = "Add", Stat = "Luck", Value = 1 } },
	},
	{
		Id = "TwinBlade",
		DisplayName = "Hoja Doble",
		Description = "+1 hoja por ataque (cada hoja busca un objetivo distinto).",
		Rarity = "Epic",
		Category = "Ataque",
		Icon = "⚔⚔",
		MaxLevel = 3,
		Requires = "WeaponAcceptsExtraProjectile",
		Effects = { { Op = "Add", Stat = "ExtraProjectiles", Value = 1 } },
	},
	{
		-- Sin habilidades activas en la Fase 1: queda fuera de las opciones
		-- seleccionables hasta que exista la mecánica (no mostramos mejoras vacías).
		Id = "ArcaneImpulse",
		DisplayName = "Impulso Arcano",
		Description = "-10 % de enfriamiento de habilidades activas.",
		Rarity = "Rare",
		Category = "Habilidad",
		Icon = "✺",
		MaxLevel = 5,
		Enabled = false,
		DisabledReason = "Requiere habilidades activas (Fase 2).",
		Effects = {},
	},
	{
		-- Comodín: completa la oferta cuando quedan menos de 3 mejoras válidas.
		Id = "SkyBlessing",
		DisplayName = "Bendición del Cielo",
		Description = "Recupera un 30 % de la vida máxima.",
		Rarity = "Common",
		Category = "Curación",
		Icon = "✚",
		IsFallback = true,
		Effects = { { Op = "HealPct", Value = 0.3 } },
	},
}

UpgradeConfig.List = list

local byId: { [string]: Types.UpgradeDef } = {}
for _, def in list do
	assert(byId[def.Id] == nil, "Id de mejora duplicado: " .. def.Id)
	byId[def.Id] = def
end
UpgradeConfig.ById = byId

return UpgradeConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">WeaponConfig</string>
            <string name="Source"><![CDATA[--!strict
--[[
	WeaponConfig
	Definición de las armas automáticas. CombatService programa los ataques
	de forma centralizada según `Pattern`; añadir un arma nueva consiste en
	añadir una entrada aquí y, si su patrón es nuevo, un manejador en
	CombatService.Patterns.
]]

local Types = require(script.Parent.Parent.Types)

local WeaponConfig: { [string]: Types.WeaponDef } = {
	GaleSword = {
		Id = "GaleSword",
		DisplayName = "Espada del Vendaval",
		Description = "Lanza hojas espectrales de viento contra el enemigo más cercano.",
		Pattern = "NearestTargets",
		Damage = 12, -- daño base por impacto
		Cooldown = 1.4, -- segundos entre ataques
		MinCooldown = 0.35, -- límite inferior tras mejoras
		Range = 28, -- alcance máximo (studs)
		Projectiles = 1, -- hojas lanzadas por ataque (cada una a un objetivo distinto)
		MaxProjectiles = 4, -- máximo admitido (limita la mejora Hoja Doble)
		TargetsPerProjectile = 1, -- enemigos que golpea cada hoja
		Color = Color3.fromRGB(120, 235, 255),
	},
}

return WeaponConfig
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--[[
	Net
	Acceso tipado a los RemoteEvents definidos en Shared/Remotes.

	Cliente -> Servidor (el servidor valida tipos, estado y frecuencia):
	  ClientReady()                         el cliente ha cargado su interfaz
	  ChooseUpgrade(token: number, id: string) elección de la oferta activa
	  RequestRestart()                      reiniciar tras la derrota

	Servidor -> Cliente (solo presentación):
	  HudUpdate(snapshot)        estado de la partida para el HUD
	  UpgradeOffer(offer)        abrir la pantalla de mejoras
	  UpgradeResolved(result)    la oferta se ha cerrado (o la elección se rechazó)
	  CombatFx(attack)           efectos visuales de un ataque
	  EnemyDied(info)            efecto de muerte de un enemigo
	  GemCollected(info)         efecto de recogida de experiencia
	  PlayerDamaged(info)        indicador de daño recibido
	  LevelUp(info)              efecto de subida de nivel
	  GameOver(summary)          pantalla de derrota
]]

local RemotesFolder = script.Parent:WaitForChild("Remotes")

local NAMES = {
	"ClientReady",
	"ChooseUpgrade",
	"RequestRestart",
	"HudUpdate",
	"UpgradeOffer",
	"UpgradeResolved",
	"CombatFx",
	"EnemyDied",
	"GemCollected",
	"PlayerDamaged",
	"LevelUp",
	"GameOver",
}

local Net = {} :: { [string]: RemoteEvent }

for _, name in NAMES do
	local remote = RemotesFolder:WaitForChild(name, 10)
	assert(remote and remote:IsA("RemoteEvent"), "Falta el RemoteEvent " .. name)
	Net[name] = remote :: RemoteEvent
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Progression
	Función centralizada de la curva de experiencia (servidor y HUD).
]]

local GameConfig = require(script.Parent.Config.GameConfig)

local Progression = {}

-- Experiencia necesaria para pasar de `level` a `level + 1`.
function Progression.xpToNext(level: number): number
	local curve = GameConfig.Progression
	local n = math.max(math.floor(level), 1) - 1
	local required = curve.BaseXp + curve.LinearXp * n + curve.QuadraticXp * n * n
	return math.max(1, math.floor(required + 1e-6))
end

return Progression
]]></string>
        </Properties>
      </Item>

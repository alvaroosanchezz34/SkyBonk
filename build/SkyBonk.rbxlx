		Crystal = Color3.fromRGB(200, 40, 90),
		Crystal2 = Color3.fromRGB(150, 70, 255),
		Grass = Color3.fromRGB(86, 96, 92),
	},
	Celestial = {
		Center = Vector3.new(0, 2, 120),
		Radius = 26,
		Tint = Color3.fromRGB(255, 246, 228),
		Stone = Color3.fromRGB(245, 240, 228),
